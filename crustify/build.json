{
  "_comment": "FFmpeg @ 1019f8f036 prebuilds for crustify campaign 20261005. FFmpeg has no configure switch for deprecated APIs (FF_API_* is hard-defined in version_major.h), so deprecated items are excluded at schedule time, not here. --disable-autodetect keeps the build hermetic; platform/vendor hwcontext backends are out of scope. tsan is kept separate from asan-ubsan (conflicting runtimes); bsan builds the C with the bsan toolchain's matched clang and pass plugin; its runtime is linked once, into executables only, and exported (-rdynamic) to the libraries, which leave __bsan_* undefined. The bsan runtime (bsan 0.1.0, 3f210d63ae) reports a false use-after-free when realloc(NULL, n) runs in a non-inlined function and its result is later freed; av_realloc hits it in the instrumented C executables (ffmpeg, FATE tools), which abort. Rust test binaries under cargo bsan (CRUSTIFY_FFMPEG_VARIANT=bsan) run clean against it, av_realloc(NULL, n) paths included.",
  "version": 3,
  "build_commands": {
    "configure": "./configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite",
    "build": "make -j48",
    "test": "LD_LIBRARY_PATH=$(printf '%s:' \"$PWD\"/lib*) make -k -j48 fate"
  },
  "variants": {
    "plain": {
      "dir": "crustify/builds/plain",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite",
      "build": "make -j48"
    },
    "coverage": {
      "dir": "crustify/builds/coverage",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --toolchain=gcov",
      "build": "make -j48"
    },
    "asan-ubsan": {
      "dir": "crustify/builds/asan-ubsan",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --toolchain=clang-asan-ubsan",
      "build": "make -j48"
    },
    "tsan": {
      "dir": "crustify/builds/tsan",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --toolchain=clang-tsan",
      "build": "make -j48"
    },
    "bsan": {
      "dir": "crustify/builds/bsan",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --cc=/root/.rustup/toolchains/bsan/bin/clang --cxx=/root/.rustup/toolchains/bsan/bin/clang++ --extra-cflags='-fpass-plugin=/root/.rustup/toolchains/bsan/lib/libbsan_plugin.so -fno-omit-frame-pointer' --extra-ldexeflags='-rdynamic -Wl,--whole-archive /root/.rustup/toolchains/bsan/lib/libclang_rt.bsan-x86_64.a -Wl,--no-whole-archive' --extra-libs='/root/.rustup/toolchains/bsan/lib/libbsan_rt.a -lgcc_s -lm -lpthread -ldl'",
      "build": "make -j48"
    }
  }
}
