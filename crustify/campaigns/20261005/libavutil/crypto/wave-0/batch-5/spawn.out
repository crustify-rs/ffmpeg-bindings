from pathlib import Path
for tu,t in [('md5','Md5'),('murmur3','Murmur3')]:
 p=Path('crustify/rust/ffmpeg/libavutil')/(tu+'.rs');s=p.read_text(); pos=s.index('    #[test]\\n    fn layout_and_handle_sizes')
 test=f'''    #[test]
    #[cfg_attr(miri, ignore)]
    fn allocation_failure() {{
        const FLAG: &str = \"CRUSTIFY_{tu.upper()}_FAILURE_CHILD\";
        if std::env::var_os(FLAG).is_some() {{
            // SAFETY: this isolated child runs only this exact test, before any
            // FFmpeg allocation, so no concurrent C allocator reads or writes
            // the process-global limit. Rust's allocator does not use this limit.
            unsafe {{ ffi::av_max_alloc(0) }};
            assert"'!({t}::new().is_none());
'"'''
 if tu=='murmur3':test+='            assert"'!(Murmur3::with_seed(u64::MAX).is_none());'"\\n'
 test+=f'''            return;
        }}
        let status = std::process::Command::new(std::env::current_exe().unwrap())
            .args([\"--exact\", \"libavutil::{tu}::unit_tests::allocation_failure\", \"--test-threads=1\"])
            .env(FLAG, \"1\")
            .status().unwrap();
        assert"'!(status.success());
    }}
'"'''
 p.write_text(s[:pos]+test+s[pos:])
 p=Path('crustify/rust/ffmpeg/tests/equiv')/(tu+'.rs');s=p.read_text()
 raw='av_md5' if tu=='md5' else 'av_murmur3'
 s+=f'''
#[test]
fn interleaved_update_and_final_match_after_each_step() {{
    let mut wrapped = {t}::new().unwrap();
    let reference = {t}::new().unwrap();
    for chunk in [&b\"one\"[..], &b\"\"[..], &b\"two\"[..], &[0xff; 80][..]] {{
        wrapped.as_mut().update(chunk);
        let mut expected = [0; 16];
        // SAFETY: reference solely owns initialized C storage, chunk supplies
        // readable bytes, and the output is exactly 16 writable bytes. None of
        // these pointers is retained and no Rust handles cover the reference.
        unsafe {{
            ffi::{raw}_update(reference.as_c_ptr(), chunk.as_ptr(), chunk.len());
            ffi::{raw}_final(reference.as_c_ptr(), expected.as_mut_ptr());
        }}
        assert_eq"'!(wrapped.as_mut().finalize(), expected);
    }}
}}
'"'''
 p.write_text(s)
PY
