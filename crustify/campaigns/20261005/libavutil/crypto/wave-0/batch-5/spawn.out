{
  "_comment": "FFmpeg @ 1019f8f036 prebuilds for crustify campaign 20261005. FFmpeg has no configure switch for deprecated APIs (FF_API_* is hard-defined in version_major.h), so deprecated items are excluded at schedule time, not here. --disable-autodetect keeps the build hermetic; platform/vendor hwcontext backends are out of scope. tsan is kept separate from asan-ubsan (conflicting runtimes); bsan builds the C with the bsan toolchain's matched clang and pass plugin; its runtime is linked once, into executables only, and exported (-rdynamic) to the libraries, which leave __bsan_* undefined. The bsan runtime (bsan 0.1.0, 3f210d63ae) reports a false use-after-free when realloc(NULL, n) runs in a non-inlined function and its result is later freed; av_realloc hits it in the instrumented C executables (ffmpeg, FATE tools), which abort. Rust test binaries under cargo bsan (CRUSTIFY_FFMPEG_VARIANT=bsan) run clean against it, av_realloc(NULL, n) paths included.",
  "version": 3,
  "build_commands": {
    "configure": "./configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite",
    "build": "make -j48",
    "test": "LD_LIBRARY_PATH=$(printf '%s:' \"$PWD\"/lib*) make -k -j48 fate"
  },
  "variants": {
    "plain": {
      "dir": "crustify/builds/plain",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite",
      "build": "make -j48"
    },
    "coverage": {
      "dir": "crustify/builds/coverage",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --toolchain=gcov",
      "build": "make -j48"
    },
    "asan-ubsan": {
      "dir": "crustify/builds/asan-ubsan",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --toolchain=clang-asan-ubsan",
      "build": "make -j48"
    },
    "tsan": {
      "dir": "crustify/builds/tsan",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --toolchain=clang-tsan",
      "build": "make -j48"
    },
    "bsan": {
      "dir": "crustify/builds/bsan",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --cc=/root/.rustup/toolchains/bsan/bin/clang --cxx=/root/.rustup/toolchains/bsan/bin/clang++ --extra-cflags='-fpass-plugin=/root/.rustup/toolchains/bsan/lib/libbsan_plugin.so -fno-omit-frame-pointer' --extra-ldexeflags='-rdynamic -Wl,--whole-archive /root/.rustup/toolchains/bsan/lib/libclang_rt.bsan-x86_64.a -Wl,--no-whole-archive' --extra-libs='/root/.rustup/toolchains/bsan/lib/libbsan_rt.a -lgcc_s -lm -lpthread -ldl'",
      "build": "make -j48"
    }
  }
}
[workspace]
resolver = "3"
members = [
    "libavutil-sys",
    "libswresample-sys",
    "libswscale-sys",
    "libavcodec-sys",
    "libavformat-sys",
    "libavfilter-sys",
    "libavdevice-sys",
    "ffmpeg",
]
[workspace.package]
version = "0.1.0"
edition = "2024"
license = "LGPL-2.1-or-later"
publish = false
[workspace.dependencies]
bindgen = { version = "0.73", features = ["experimental"] }
cc = "1.5"
ffibox = { path = "/opt/venv/share/ffibox" }
serde_json = "1"
trybuild = "1"
libavutil-sys = { path = "libavutil-sys" }
libswresample-sys = { path = "libswresample-sys" }
libswscale-sys = { path = "libswscale-sys" }
libavcodec-sys = { path = "libavcodec-sys" }
libavformat-sys = { path = "libavformat-sys" }
libavfilter-sys = { path = "libavfilter-sys" }
libavdevice-sys = { path = "libavdevice-sys" }
[workspace.lints.clippy]
undocumented_unsafe_blocks = "deny"
module_inception = "allow"
[package]
name = "ffmpeg"
description = "Safe Rust wrappers over FFmpeg's public C API"
build = "build.rs"
version.workspace = true
edition.workspace = true
license.workspace = true
publish.workspace = true
[lib]
path = "lib.rs"
[features]
default = ["libavutil", "libswresample", "libswscale", "libavcodec", "libavformat", "libavfilter", "libavdevice"]
libavutil = ["dep:libavutil-sys"]
libswresample = ["dep:libswresample-sys", "libavutil"]
libswscale = ["dep:libswscale-sys", "libavutil"]
libavcodec = ["dep:libavcodec-sys", "libswresample", "libavutil"]
libavformat = ["dep:libavformat-sys", "libavcodec", "libavutil"]
libavfilter = ["dep:libavfilter-sys", "libswscale", "libavformat", "libavcodec", "libswresample", "libavutil"]
libavdevice = ["dep:libavdevice-sys", "libavfilter", "libavformat", "libavcodec", "libavutil"]
[dependencies]
ffibox.workspace = true
libavutil-sys = { workspace = true, optional = true }
libswresample-sys = { workspace = true, optional = true }
libswscale-sys = { workspace = true, optional = true }
libavcodec-sys = { workspace = true, optional = true }
libavformat-sys = { workspace = true, optional = true }
libavfilter-sys = { workspace = true, optional = true }
libavdevice-sys = { workspace = true, optional = true }
[dev-dependencies]
trybuild.workspace = true
[lints]
workspace = true
usage: wavefront [-h] [--config PATH]
                 repo_root {extract-ql,schedule,query} ...
Semantic analysis, ownership findings, and deterministic scheduling for C.
positional arguments:
  repo_root             Full path to the repository root. Explicit — Wavefront
                        never walks the filesystem to find it.
  {extract-ql,schedule,query}
    extract-ql          Run the T1 (entities) + T2 (edges) .ql batches against
                        the CodeQL database below the config's state_dir and
                        write one CSV per query under its codeql/{t1,t2}/. The
                        database is NOT created here — build the project under
                        `codeql database create` yourself first. Everything
                        else derives from these tables on demand. Takes
                        minutes — run it only when the extraction is genuinely
                        stale.
    schedule            Build an objective-neutral schedule with sequential
                        waves.
    query               Read-only oracle. `types`/`symbols` enumerate
                        (filtered, as a name list) or introspect one (--name)
                        as the whole record. `files` lists the targeted /
                        imported section file sets. `dag` does the graph walks
                        (closure / layer / scc).
options:
  -h, --help            show this help message and exit
  --config PATH         Explicit wavefront-config.json for extraction, query,
                        or schedule. Relative paths are resolved from
                        REPO_ROOT.
exec
/bin/bash -lc "cat /opt/venv/share/ffibox/README.md | sed -n '370,530p'; cat crustify/TASK.md; cat crustify/rust/ffmpeg/libavutil/{md5,murmur3,sha,mem,mod}.rs; cat crustify/rust/sys-build.rs; find crustify/campaigns/20261005 -maxdepth 4 -type f | head -60; ls -l crustify/builds" in /target/crustify/.worktrees/crustify/batches/20261005/libavutil/crypto/wave-0/batch-5
 succeeded in 0ms:
// A resource-free struct needs no wrapper: the `define_ctype!` type is the value.
define_ctype!(Rational, RationalRef, RationalMut, sys::rational_st);
impl RationalMut<'_> {
    pub fn set_num(&mut self, v: i32) {
        unsafe { core::ptr::addr_of_mut!((*self.as_mut_ptr()).num).write(v) }
    }
}
// SAFETY: 0/0 is a value every accessor accepts; nothing reads it as a divisor.
unsafe impl CZeroable for Rational {}
let mut q = Rational::zeroed();
q.as_mut().set_num(1);
```
### A buffer and a string — `CVec` / `CStrBox`
```rust,no_run
use ffibox::{impl_cdrop_str, impl_cdupclone_str, impl_clendrop, CStrBox, CVec};
mod sys {
    use core::ffi::c_char;
    extern "C" {
        pub fn oids_new(n: usize) -> *mut u32;
        pub fn oids_free(p: *mut u32, n: usize);
        pub fn lib_name() -> *mut c_char;
        pub fn lib_str_free(s: *mut c_char);
        pub fn lib_strdup(s: *const c_char) -> *mut c_char;
    }
}
#[derive(Clone, Copy, Debug, Default)]
pub struct OidsFree;
// Freeing needs the element count back: an adapter, passed by path.
unsafe fn oids_free(ptr: *mut u8, byte_len: usize) {
    unsafe { sys::oids_free(ptr.cast(), byte_len / core::mem::size_of::<u32>()) }
}
impl_clendrop!(OidsFree, oids_free);
pub type Oids = CVec<u32, OidsFree>;
#[derive(Clone, Copy, Debug, Default)]
pub struct LibStrFree;
impl_cdrop_str!(LibStrFree, sys::lib_str_free);     // takes *mut c_char
impl_cdupclone_str!(LibStrFree, sys::lib_strdup);
pub type LibStr = CStrBox<LibStrFree>;
let v = unsafe { Oids::from_raw_parts(sys::oids_new(3), 3) }.unwrap();
assert_eq!(v.as_slice().len(), 3);
let s = unsafe { LibStr::from_raw(sys::lib_name()) }.unwrap();
assert_eq!(s.to_str(), Ok("name"));
```
---
## 1. The types you get
This is the reference table for what each type is; the rustdoc links here
rather than repeating it.
| Scope | Type | From | Role |
|-------|------|------|------|
| per C type | `Foo` | `define_ctype!` | the layout, the C struct's size: `#[repr(transparent)]` over `ffi::foo`, embeds by value in a `#[repr(C)]` mirror, and is what a `CBox` points at. Never referenced over C-owned memory. Also the value itself when it owns no resources (a rational `{ num, den }`). |
| | `FooRef<'a>` | `define_ctype!` | shared borrow, one pointer wide, `Copy`; the getters |
| | `FooMut<'a>` | `define_ctype!` | exclusive borrow, move-only; the setters, and the getters through `as_ref()` |
| owners | `CBox<Foo, P>` | ffibox | the sole owner of an object behind a pointer, released by `P` on drop; `Clone` when `P` deep-copies; built safely by `new` / `new_zeroed` / `new_uninit` when `P` constructs |
| | `CVal<Foo, P>` | ffibox | an owned value held inline, its resources disposed by `P` on drop |
| | `CStrBox<P>` | ffibox | an owned NUL-terminated `char *`; read-only `CStr` / `str` / byte views |
| | `CVec<T, P>` | ffibox | an owned `(ptr, len)` array, NULL when empty; `&[T]` for plain elements, `CSlice` for wrapped C objects; `from_slice` copies a Rust slice into `P`'s allocator |
| per C lock | `FooLocked<'a>` | `impl_cguarded!` | exclusive borrow under the C lock, move-only; getters and setters for the state the lock protects, the unlocked getters through `as_ref()` |
| shared owner | `CArc<Foo, P>` | ffibox | one counted reference to a refcounted object; `Clone` through the up_ref; the shared handle always, `get_mut` / `make_mut` when the count proves it sole or after a copy, and `lock()` → `CGuard` when `Foo` is `CGuarded` |
| lock | `CGuard<'a, Foo>` | ffibox | a held C lock, unlocking on drop — `MutexGuard`; `as_locked()` → `FooLocked<'_>`, `as_ref()` → `FooRef<'_>` |
| guarded borrow | `CGuardedRef<'a, Foo>` | ffibox | an object under one lock covering all of it (`CGuardedAll`), never released — typically a C global (`'static`); only `lock()`, whose `as_locked()` is `FooMut` — `&Mutex<_>` |
| views | `CSlice<'a, T>` / `CSliceMut<'a, T>` | ffibox | any borrowed run of elements — a buffer's, a struct field's, a getter's — as handles or copies, never a `&[T]` |
A wrapper that needs generic parameters (a lifetime-carrying layout type, or
derived sub-types over a generic field) is written by hand against the same
contract — see [Under the hood](#4-under-the-hood-hand-written-wrappers).
### Conventions
- **Accessors live on the handles.** Getters on `FooRef<'a>` taking `&self`,
  setters on `FooMut<'a>` taking `&mut self`; `FooMut` reaches the getters with
  `as_ref()`, so they are written once. Both project a raw pointer out of the
  handle and read or write through `addr_of!` / `addr_of_mut!`.
- **Every holder reaches the handles the same way:** `as_ref()` / `as_mut()` on
  `Foo`, `CBox`, `CVal` and `FooMut` itself (where `as_mut()` is the reborrow
  `&mut` gets implicitly: `helper(m.as_mut())` keeps `m`); `as_ref()` alone on
  `CArc`; `as_ref()` / `as_locked()` on a `CGuard` and on `FooLocked` (where
  `as_locked()` reborrows). `CSliceMut` reborrows the same
  way, and splits and sub-ranges like `&mut [T]`. Never `Deref`:
  `Deref::Target` cannot name a lifetime taken from `&self`, and since `FooRef`
  is `Copy`, a `Deref<Target = FooRef<'a>>` on `FooMut` would let safe code copy
  a shared handle out while keeping the exclusive one.
- **No reference covers C memory.** `&FooRef` covers one pointer of Rust stack,
  never the object. The one place a reference covers a C struct's bytes is
  `Foo::as_ref` / `as_mut` on a value Rust holds inline.
- **Adopting a pointer is `unsafe`; giving one out is not — as on `Box`.**
  `from_raw*` / `from_c*` are `unsafe`, since they assert ownership of what the
  pointer addresses; `into_raw*` / `into_c` and `as_ptr` / `as_c_ptr` are safe,
  since a raw pointer asserts nothing until someone dereferences it. The
  owners' `from_raw` / `into_raw` / `as_ptr` speak the Rust-side pointee; `CBox`'s `from_c` / `into_c` /
  `as_c_ptr` speak the C type, so C interop is cast-free. The handles' seams
  (`from_ptr`, `as_ptr`, `as_mut_ptr`, the `void *` pair) are `pub(crate)`
  in the crate that invokes `define_ctype!`.
- **Constructing through the policy is safe.** `new`, `new_zeroed` and
  `new_uninit` (each with a `_with(policy)` form) allocate through the routine
  the owner frees with, and return `None` when C fails, as `from_raw` does on
  NULL. The one `unsafe` step is `assume_init`, which promotes storage C has
  filled through `as_c_ptr`. There is no safe `write(value)`: a C object is
  initialised where it lives.
- **`from_raw*` adopts ownership; `from_ptr*` borrows.** Pick the verb by what
  you return.
- **Thread safety is opt-in for wrapped C types, opt-out for raw memory.**
  `Foo` carries a zero-sized marker withholding `Send` / `Sync`; `CBox`,
  `CVal`, `CVec` and the views over a `Foo` inherit them once the wrapper
  writes `unsafe impl Send / Sync for Foo` with a safety proof, on the terms
  of their std counterparts — `CBox` like `Box`, `CArc` with
  `Foo: Send + Sync` like `Arc`, and `CGuardedRef` with `Foo: Send` like
  `&Mutex<_>`.
  Owners that never name a `Foo` — `CStrBox` and a `CVec` of
  plain elements (`CVec<u8, _>`) — follow their policy alone, and a unit-struct
  policy is `Send + Sync`, so **they cross threads by default**. That is right
  for an allocator any thread may free into (`free`, a library's
  `lib_free`); for one that must free on the allocating thread, opt out by
  giving the policy a `PhantomData<*const ()>` field.
---
## 2. Policies — what teardown means
Every owner's destructor is a **policy**: a type you declare, usually a unit
struct deriving `Clone, Copy, Debug, Default`, implementing the lifecycle
traits. Bind a C routine to it with the `impl_*!` macros, or implement the
traits by hand when teardown needs runtime state. A unit struct is
`Send + Sync`, which makes a `CStrBox` or plain-element `CVec`
under it free on whichever thread drops it; a thread-bound allocator's policy
carries `PhantomData<*const ()>` instead (see the conventions in
[section 1](#1-the-types-you-get)).
| Trait | Defines | Macro | Drives |
|-------|---------|-------|--------|
| `CDrop<T>` | `c_drop` — a `*_free`, or a refcount down-ref | `impl_cdrop!(P, Foo, f)`; `_str` for `c_char` | `CBox`, `CStrBox`, `CArc` |
| `CDupClone<T>: CDrop<T>` | `c_dup` — a deep copy (a NEW pointer, NULL on failure) | `impl_cdupclone!(P, Foo, f)`; `_str` for `strdup` | `Clone` / `try_clone` |
| `CRefClone<T>: CDrop<T>` | `c_up_ref` — a refcount increment on the SAME pointer; `c_is_sole_owner` (default `false`) | `impl_crefclone!(P, Foo, f)`; `…, ok = |r| r == 1`, `…, sole = g` | `CArc`'s `Clone`, `get_mut`, `make_mut` |
| `CLenDrop` | `c_drop_len` — a buffer free, given the byte length | `impl_clendrop!(P, f)` | `CVec` |
| `CLenClone: CLenDrop` | `c_clone_len` — a buffer memdup (`T: Copy` only) from any readable source; `ALIGN` (default 1) bounds the element types it can copy | `impl_clenclone!(P, f)`, `impl_clenclone!(P, f, align = 16)` | `CVec`'s `Clone`, `CVec::from_slice`, `CSlice::to_cvec` |
| `CDispose<T>` | `c_dispose` — `*_uninit` / `*_clear` on a value | `impl_cdispose!(P, Foo, f)` | `CVal` |
| `CNew<T>: CDrop<T>` | `c_new` — a zero-argument `*_alloc` / `*_new` | by hand | `CBox::new`, `CArc::new` |
| `CAlloc<T>: CDrop<T> + CDrop<MaybeUninit<T>>` | `c_alloc` — uninitialised storage (`malloc`); the free must not read it | by hand | `CBox::new_uninit` |
| `CAllocZeroed<T>: CDrop<T>` | `c_alloc_zeroed` — zero-filled storage (`calloc`) | by hand | `CBox::new_zeroed`, `CArc::new_zeroed` |
| `CZeroable`, on `Foo` | all-zero is valid for every accessor, safe wrapper and paired teardown; provides `Foo::zeroed()` | `unsafe impl CZeroable for Foo {}` | `new_zeroed`, `Foo::zeroed()` |
| `CGuarded`, on `Foo` | `c_lock` / `c_unlock`; the `Locked` handle; the `Scope` it covers | `impl_cguarded!(Foo, FooLocked, lock = f, unlock = g)`; `…, ok = |r| r == 1`; `impl_cguarded!(Foo, all, …)` for `CGuardedAll` | `CArc::lock`, `CGuardedRef::lock` |
**Because the policy is a type parameter, an owner cannot exist without a
destructor, and one C type can have several.** `CBox<Foo, FooFree>` next to
`CBox<Foo, FooUnref>`: exactly one ever runs per box, chosen by its type. And
since each clone trait sits on the same policy as the drop trait, a `*_dup` is
always settled by its `*_free`.
**`CBox` is a sole owner; `CArc` shares.** `CBox::as_mut` hands out the
exclusive handle, which is sound only while nothing else uses the object, so
`CBox` clones only by deep copy. A refcounted object fits a `CBox` while the
# Mandatory questions
## Campaign
1. **Which repository and revision should this campaign use?** (`id: source`)
   - Answer: ffmpeg's existing checkout mounted at `/target`, at its current checked-out
     revision
2. **Should this campaign port the C implementation to Rust, or create safe
   Rust wrappers?** (`id: objective`)
   - Answer: `wrap`
3. **What should this campaign target: a named subset of subsystems, or a named
   subset of functions and types, or the whole target repo? You can define them
   now or we can brainstorm them during the live session. You can also let the
   orchestrator decide.** (`id: scope`)
   - Answer: the whole public API of the target, excluding deprecated items
4. **Which model and billing should do the translation work?**
   (`id: translate-agent`)
   - Answer: `openrouter/anthropic/claude-opus-5.5, api`
5. **Do you want agentic review after translated work lands? If so, which
   model and billing should perform each review?** (`id: review-agent`)
   - Answer: `openrouter/anthropic/claude-fable-5.1, api`, after each wave
6. **Should I run fully autonomously end to end?** (`id: autonomy`)
   - Answer: `no`
# Optional questions
Unanswered optional questions use their defaults.
## Campaign execution
7. **Should the campaign use the default batching and parallelism settings, or
   customize them?** (`id: workload`)
   - Answer: `max-types: 2, max-syms: 25, max-loc: 500`, at least 20 fields per type
     batch; parallelism is orchestrator's choice
8. **What batch caps should review agents use? We recommend the same caps as
   translation by default.** (`id: review-workload`)
   - Answer: `as many as the reviewed wave requires`
## Autonomy (if question 6 is answered `no`)
Answer these approval-gate questions only if question 6 is answered `no`.
9. **Should I wait for your approval before starting the setup phase?** (`id: gates.setup`)
   - Answer: `no`
10. **Should I wait for your approval before starting the translation phase?**
    (`id: gates.translation`)
    - Answer: `yes`
11. **Should I wait for your approval between sub-campaigns?** (`id: gates.sub-campaign`)
    - Answer: `no`
12. **Should I wait for your approval before starting review passes?** (`id: gates.review`)
    - Answer: `no`
# Benchmark recording questions
13. **Where and in what format should results be recorded?** (`id: results`)
    - Answer: `<repo-checkout>/crustify/results.md`, `standard` template
# Additional instructions
Unless otherwise stated, preserve the format of the results doc exactly.
//! Safe wrappers over `libavutil/md5.h`.
//! Safe wrappers over `libavutil/murmur3.h`.
//! Safe wrappers over `libavutil/sha.h`.
//! Safe wrappers over `libavutil/mem.h`.
//!
//! [`Heap`] is the lifecycle policy of the `av_malloc` family: every block
//! `av_malloc`, `av_mallocz`, `av_malloc_array`, `av_calloc` or `av_memdup`
//! returns is released by `av_free`. Owners name it as their policy:
//!
//! - one object: [`HeapBox<T>`], built by `HeapBox::<T>::new_zeroed()`
//!   (`av_mallocz`) or `HeapBox::<T>::new_uninit()` (`av_malloc`), and
//!   `Clone` (`av_memdup`) when `T: Copy`;
//! - an array: [`HeapVec<T>`], built by [`alloc_array`] (`av_malloc_array`),
//!   [`alloc_array_zeroed`] / [`alloc_cell_array_zeroed`] (`av_calloc`),
//!   [`alloc_array_from_fn`], or `HeapVec::from_slice` and `Clone`
//!   (`av_memdup`).
//!
//! The policy frees storage only. A wrapped type whose object owns
//! sub-allocations is released by its own destructor policy instead.
//!
//! [`StringHeap`] is the same allocator as a string policy: a NUL-terminated
//! string from `av_strdup`, `av_strndup` or any other `av_malloc`-family
//! routine is a [`HeapString`], built by [`string_from_c_str`] (`av_strdup`)
//! or [`string_from_bytes_until_nul`] (`av_strndup`), `Clone` through
//! `av_strdup`, and released by `av_free`.
//!
//! The `av_realloc` family resizes those arrays: [`realloc_array`] and
//! [`realloc_bytes`] hand the array back on failure, [`realloc_array_or_free`]
//! frees it, and [`realloc_array_in_place`] / [`realloc_bytes_in_place`]
//! resize the array in a slot, leaving it empty on failure.
//! [`resize_array_with`] resizes an initialised array, filling what it adds.
//! A resized block keeps `realloc`'s alignment, not `av_malloc`'s.
//! [`checked_size_mul`] is the overflow-checked size product they compute.
//!
//! Two growable owners keep C's in-place growth protocols:
//!
//! - [`DynArray<T>`] is the `av_dynarray` family's `(tab, nb)` pair, grown by
//!   [`push_or_clear`](DynArray::push_or_clear) (`av_dynarray2_add`) and, for
//!   pointer elements, [`push_ptr_or_clear`](DynArray::push_ptr_or_clear)
//!   (`av_dynarray_add`) and [`try_push_ptr`](DynArray::try_push_ptr)
//!   (`av_dynarray_add_nofree`), and released by `av_freep`;
//! - [`FastBuffer`] and [`ZeroedFastBuffer`] are the `(ptr, size)` pair of a
//!   buffer reused while large enough, grown by `av_fast_realloc`,
//!   `av_fast_malloc` and `av_fast_mallocz`, and released by `av_free`.
//!
//! [`set_max_alloc`] sets the process-wide size limit every one of these
//! allocations obeys, and [`copy_back_reference`] is the LZ77-style
//! overlapping copy within one buffer.
use core::ffi::{CStr, c_char, c_double, c_int, c_longlong, c_uint, c_void};
use core::fmt;
use core::marker::PhantomData;
use core::mem::{MaybeUninit, align_of, size_of};
use core::ptr::NonNull;
use ffibox::{
    CAlloc, CAllocZeroed, CBox, CCell, CDrop, CDupClone, CPlainElem, CSlice, CSliceMut, CStrBox,
    CVec, CZeroable, impl_cdupclone_str, impl_clenclone, impl_clendrop,
};
use super::ffi;
/// Alignment of every `av_malloc`-family block: `ALIGN` in `mem.c` is 64, 32
/// or 16 by the build's SIMD configuration, and never less than 16.
const ALIGN: usize = 16;
/// The `av_malloc` family's allocator and `av_free`, as one policy.
///
/// Thread-agnostic: a block may be freed on any thread, so the owners it
/// parameterizes cross threads on their elements' terms.
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
pub struct Heap;
/// One object in an `av_malloc`-family block, released by `av_free`.
pub type HeapBox<T> = CBox<T, Heap>;
/// An array in an `av_malloc`-family block, released by `av_free`.
pub type HeapVec<T> = CVec<T, Heap>;
/// Wraps: av_free
// SAFETY: `av_free` releases any `av_malloc`-family block exactly once and
// never reads it, so it is sound for storage before (`MaybeUninit<T>`) and
// after it holds a `T`. It releases the storage only: a `T` owning
// sub-allocations is adopted under its own destructor policy, as `CAlloc`
// leaves to the policy to document.
unsafe impl<T> CDrop<T> for Heap {
    #[inline]
    unsafe fn c_drop(&self, ptr: NonNull<T>) {
        // SAFETY: the caller hands over a live `av_malloc`-family block whose
        // claim it owns; `av_free` releases it once.
        unsafe { ffi::av_free(ptr.as_ptr().cast()) }
    }
}
/// Wraps: av_free
///
/// # Safety
///
/// `ptr` must be a live `av_malloc`-family block the caller owns.
unsafe fn free_len(ptr: *mut u8, _byte_len: usize) {
    // SAFETY: the caller hands over a live block it owns; `av_free` releases
    // the whole block whatever its length, touching none of it.
    unsafe { ffi::av_free(ptr.cast()) }
}
impl_clendrop!(Heap, free_len);
/// Wraps: av_memdup
///
/// # Safety
///
/// `ptr` must be valid for reads of `byte_len` bytes, from any allocator.
unsafe fn memdup(ptr: *mut u8, byte_len: usize) -> *mut u8 {
    // SAFETY: the caller guarantees `byte_len` readable bytes at `ptr`, which
    // `av_memdup` only reads. It returns a fresh `av_malloc(byte_len)` block,
    // aligned to `ALIGN` and released by `av_free`, or NULL on failure.
    unsafe { ffi::av_memdup(ptr.cast_const().cast(), byte_len) }.cast()
}
impl_clenclone!(Heap, memdup, align = ALIGN);
/// Wraps: av_memdup
///
/// The singleton form of the deep copy, giving [`HeapBox<T>`] its `Clone`. A
/// byte copy is a sound clone only of a `T` whose bytes own nothing, which
/// `T: Copy` asserts; a wrapped type without it is not cloneable here:
///
/// ```compile_fail,E0599
/// use ffibox::define_ctype;
/// use ffmpeg::libavutil::{ffi, mem::HeapBox};
/// define_ctype!(Rational, RationalRef, RationalMut, ffi::AVRational); // not `Copy`
/// fn copy(b: &HeapBox<Rational>) -> HeapBox<Rational> {
///     b.clone()
/// }
/// ```
// SAFETY: `av_memdup` returns a fresh `av_malloc(size_of::<T>())` block (one
// byte for a zero-sized `T`), aligned to `ALIGN`, which the const assertion
// bounds `align_of::<T>()` by, holding a byte copy of the source, or NULL on
// failure. `T: Copy` makes that copy an independent, valid `T` that shares no
// owned state with the source, and `CDrop` above releases it.
unsafe impl<T: CCell + Copy> CDupClone<T> for Heap {
    #[inline]
    unsafe fn c_dup(&self, ptr: NonNull<T>) -> Option<NonNull<T>> {
        const { assert!(align_of::<T>() <= ALIGN, "av_memdup cannot align T") };
        // SAFETY: the caller hands a live `T`, so `size_of::<T>()` bytes at
        // `ptr` are readable; `av_memdup` only reads them.
        let copy = unsafe { ffi::av_memdup(ptr.as_ptr().cast_const().cast(), size_of::<T>()) };
        NonNull::new(copy.cast())
    }
}
/// Wraps: av_malloc
// SAFETY: `av_malloc` returns a fresh, uniquely-owned block of `size_of::<T>()`
// bytes (one byte for a zero-sized `T`) aligned to `ALIGN`, which the const
// assertion bounds `align_of::<T>()` by, or NULL on failure; `CDrop` above
// frees it without reading it.
unsafe impl<T: CCell> CAlloc<T> for Heap {
    #[inline]
    fn c_alloc(&self) -> Option<NonNull<MaybeUninit<T>>> {
        const { assert!(align_of::<T>() <= ALIGN, "av_malloc cannot align T") };
