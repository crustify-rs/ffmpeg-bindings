export BSAN_OPTIONS=gc_hang_threshold_ms=600000 CRUSTIFY_FFMPEG_VARIANT=bsan CARGO_TARGET_DIR=/tmp/rw2b0/bsan-lib
: > /tmp/rw2b0/lib-extra.txt
for i in $(seq 1 60); do
  skips=$(cat $SKIP /tmp/rw2b0/lib-extra.txt | awk '$1=="ffmpeg" {printf " --skip %s", $2}')
  L=/tmp/rw2b0/logs/bsan-land-lib-iter$i.log
  s=$(date +%s); timeout 7000 cargo bsan test -p ffmpeg --lib -- --skip compile_fail --exact --test-threads=1 $skips > $L 2>&1; r=$?
  echo "exit=$r secs=$(( $(date +%s)-s ))" >> $L
