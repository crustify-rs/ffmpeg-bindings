# Keep the full peer enum unchanged; add our wrapper and a single unit suite.
tpre=tpre[tpre.index('use ffibox::CPlainElem;'):]
opre=opre[opre.index('use ffibox::{CBox'):].replace('use super::ffi;\\n','')
header=ours[:ours.index('use ffibox::{CBox')]
combined=header+tpre+'\\n'+opre+'\\n#[cfg(test)]\\nmod unit_tests {\\n    use super::*;'+tbody+obody+'}\\n'
combined=combined.replace('algorithm: ffi::AVHMACType, key:', 'algorithm: HmacType, key:').replace('ffi::av_hmac_alloc(algorithm)', 'ffi::av_hmac_alloc(algorithm.into_raw())')
combined=combined.replace('''    /// The raw enum is a temporary dependency seam for "'`AVHMACType`'"'s
    /// separately scheduled wrapper; no pointer or ownership obligation is
    /// exposed. All integer algorithm encodings are checked by C.''','''    /// The algorithm is a typed value; unknown integer encodings preserved
    /// by ["'`HmacType`] are rejected by C without forming an owner.'"''')
combined=combined.replace('use ffmpeg::libavutil::{ffi, hmac::Hmac};','use ffmpeg::libavutil::hmac::{Hmac, HmacType};')
combined=combined.replace('Hmac::new(ffi::AVHMACType(u32::MAX), b\"key\")','Hmac::new(HmacType::from_raw(ffi::AVHMACType(u32::MAX)), b\"key\")')
for n in ['MD5','SHA1','SHA224','SHA256','SHA384','SHA512']:
 combined=combined.replace('Hmac::new(ffi::AVHMACType::AV_HMAC_'+n, 'Hmac::new(HmacType::'+n)
Path(p).write_text(combined)
for suite in ['ub_safe','equiv']:
 p=f'crustify/rust/ffmpeg/tests/{suite}/hmac.rs'
 theirs=show('HEAD',p);ours=show('stash@{0}"'^3'"',p)
 ours=ours.replace('use ffmpeg::libavutil::{ffi, hmac::Hmac};','use ffmpeg::libavutil::hmac::Hmac;')
 # Constructor algorithms use the safe wrapper; raw reference fixture keeps FFI.
 for n in ['MD5','SHA1','SHA224','SHA256','SHA384','SHA512']:
  ours=ours.replace('ffi::AVHMACType::AV_HMAC_'+n, 'HmacType::'+n)
 if suite=='equiv':ours=ours.replace('Reference::new(algorithm);','Reference::new(algorithm.into_raw());')
 Path(p).write_text(theirs+'\\n'+ours)
for suite in ['ub_safe','equiv']:
 p=f'crustify/rust/ffmpeg/tests/{suite}/main.rs'
 t=show('HEAD',p)
 if 'mod des;' not in t: t=t.replace('mod dict;', 'mod des;\\nmod dict;')
 Path(p).write_text(t)
p='crustify/rust/libavutil-sys/allowlist.txt'
theirs=show('HEAD',p);ours=show('stash@{0}',p)
extra=ours[ours.index('# Crypto wave 0, batch 3:'):]
existing=set(theirs.splitlines())
extra='\\n'.join(l for l in extra.splitlines() if not l.startswith('function ') or l not in existing)
Path(p).write_text(theirs+'\\n'+extra+'\\n')
p='crustify/wavefront/ownership-store.json'
theirs=json.loads(show('HEAD',p)); ours=json.loads(show('stash@{0}',p)); base=json.loads(show('stash@{0}"'^1'"',p))
for key in ['types','symbols']:
 def index(a):return {(x['name'],x.get('defined_in')):x for x in a[key]}
 b=index(base); o=index(ours); t=index(theirs)
 for k,v in o.items():
  if b.get(k)"'!=v:t[k]=v
 theirs[key]=sorted(t.values(),key=lambda x:(x['"'name'],x.get('defined_in') or ''))
Path(p).write_text(json.dumps(theirs,indent=1,ensure_ascii=False)+'\\n')
