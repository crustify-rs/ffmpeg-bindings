}
impl<U> sealed::Sealed for *const U {
    fn into_void(self) -> *mut c_void {
        self.cast_mut().cast()
    }
}
impl<U> DynPtr for *const U {}
impl<U> sealed::Sealed for *mut U {
    fn into_void(self) -> *mut c_void {
        self.cast()
    }
}
impl<U> DynPtr for *mut U {}
impl<T> DynArray<T> {
    /// An empty array, which owns no block.
