/// }
/// fn reset(mut m: PtMut<'_>) { m.set_x(0); }
/// // SAFETY: any `x` is valid, zero included.
/// unsafe impl ffibox::CZeroable for Pt {}
///
/// let mut p = <Pt as ffibox::CZeroable>::zeroed();
/// let mut m = p.as_mut();
/// reset(m.as_mut());  // a reborrow ...
/// m.set_x(1);         // ... so `m` is still usable
