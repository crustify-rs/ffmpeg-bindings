#[test]
fn keyed_owners_and_reborrows() {
    for algorithm in [
        ffi::AVHMACType::AV_HMAC_MD5, ffi::AVHMACType::AV_HMAC_SHA1,
        ffi::AVHMACType::AV_HMAC_SHA224, ffi::AVHMACType::AV_HMAC_SHA256,
