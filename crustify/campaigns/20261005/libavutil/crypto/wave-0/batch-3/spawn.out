//! Safe wrappers over `libavutil/aes.h`.
//!
//! C owns allocation and the private layout. Keys are copied during initialization;
//! no caller buffer is retained. A context has no sub-allocations or C clone routine.
//! Processing routines are wrapped by the symbol batch, not this lifecycle module.
use core::{fmt, mem::MaybeUninit, ptr::NonNull};
use ffibox::{CAlloc, CBox, CDrop, define_ctype};
use super::{ffi, mem::Heap};
/// The key schedule to install in an AES context.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Direction {
    Encrypt,
    Decrypt,
}
impl Direction {
    pub(crate) fn as_int(self) -> i32 {
        i32::from(self == Self::Decrypt)
    }
}
/// Failure to construct or reinitialize an AES context.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum InitError {
    /// AES accepts exactly 16, 24 or 32 key bytes.
    InvalidKeyLength,
    AllocationFailed,
    /// The initializer returned a negative C error code.
    InitializationFailed(i32),
}
impl fmt::Display for InitError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::InvalidKeyLength => f.write_str("AES key must contain 16, 24 or 32 bytes"),
            Self::AllocationFailed => f.write_str("AES allocation failed"),
            Self::InitializationFailed(code) => write!(f, "AES initialization failed ({code})"),
        }
    }
}
impl std::error::Error for InitError {}
define_ctype!(
    /// Wraps: AVAES
    ///
    /// An initialized AES context. The public C type is opaque: this layout
    /// names the FFI pointee only, never its private size or fields. Construct
    /// an owner with [`Aes::new`], not an inline value or a generic allocator.
    /// An adopted context must have a valid 128-, 192- or 256-bit key schedule.
    Aes, AesRef, AesMut, ffi::AVAES
);
/// Storage allocated by `av_aes_alloc`, released by the existing [`Heap`] policy.
#[derive(Clone, Copy, Debug, Default)]
pub struct AesFree;
// SAFETY: an AES context owns no resources besides its av_malloc-family storage.
unsafe impl CDrop<Aes> for AesFree {
    /// # Safety
    /// `ptr` must be a uniquely owned, live `av_aes_alloc` allocation.
    unsafe fn c_drop(&self, ptr: NonNull<Aes>) {
        // SAFETY: the caller transfers the live allocation to be freed exactly once.
        unsafe { Heap.c_drop(ptr) }
    }
}
// SAFETY: Heap frees storage without reading it, including before initialization.
unsafe impl CDrop<MaybeUninit<Aes>> for AesFree {
    /// # Safety
    /// `ptr` must be a uniquely owned, live `av_aes_alloc` allocation.
    unsafe fn c_drop(&self, ptr: NonNull<MaybeUninit<Aes>>) {
        // SAFETY: the caller transfers the live allocation to be freed exactly once.
        unsafe { Heap.c_drop(ptr) }
    }
}
/// Wraps: av_aes_alloc
// SAFETY: C allocates the full private body with its required alignment, not
// size_of::<Aes>() (the public forward declaration has no body). AesFree releases it.
unsafe impl CAlloc<Aes> for AesFree {
    fn c_alloc(&self) -> Option<NonNull<MaybeUninit<Aes>>> {
        // SAFETY: the allocator takes no arguments and transfers fresh storage.
        NonNull::new(unsafe { ffi::av_aes_alloc() }.cast())
    }
}
/// Sole ownership of an initialized context. No C clone or thread-safety assertion.
///
/// Handles cannot outlive the owner:
/// ```compile_fail,E0505
/// use ffmpeg::libavutil::aes::{Aes, AesRef, Direction};
/// fn inspect(_: AesRef<'_>) {}
/// let aes = Aes::new(&[0; 16], Direction::Encrypt).unwrap();
/// let view = aes.as_ref();
/// drop(aes);
/// inspect(view);
/// ```
/// A shared reborrow excludes reinitialization:
/// ```compile_fail,E0502
/// use ffmpeg::libavutil::aes::{Aes, AesRef, Direction};
/// fn inspect(_: AesRef<'_>) {}
/// let mut aes = Aes::new(&[0; 16], Direction::Encrypt).unwrap();
/// let mut handle = aes.as_mut();
/// let view = handle.as_ref();
/// handle.init(&[1; 16], Direction::Decrypt).unwrap();
/// inspect(view);
/// ```
pub type AesBox = CBox<Aes, AesFree>;
fn key_bits(key: &[u8]) -> Result<i32, InitError> {
    match key.len() {
        16 => Ok(128),
        24 => Ok(192),
        32 => Ok(256),
        _ => Err(InitError::InvalidKeyLength),
    }
}
impl Aes {
    /// Allocate and initialize a context. The key may be dropped immediately.
    pub fn new(key: &[u8], direction: Direction) -> Result<AesBox, InitError> {
        let bits = key_bits(key)?;
        let mut storage = AesBox::new_uninit().ok_or(InitError::AllocationFailed)?;
        // SAFETY: storage is the full C-allocated context, exclusively held here;
        // the checked key has exactly bits/8 readable bytes. C copies it and retains
        // no caller pointer. Direction selects a supported key schedule.
        let code = unsafe {
            // C copies the key into its private schedule.
            ffi::av_aes_init(storage.as_c_ptr(), key.as_ptr(), bits, direction.as_int())
        };
        if code < 0 {
            return Err(InitError::InitializationFailed(code));
        }
        // SAFETY: successful C initialization installed the key schedule, rounds
        // and crypt function. No handle to the construction-phase storage escaped.
        Ok(unsafe { storage.assume_init() })
    }
}
impl AesMut<'_> {
    /// Wraps: av_aes_init
    ///
    /// Replace the key schedule. Invalid key lengths leave the context unchanged.
    pub fn init(&mut self, key: &[u8], direction: Direction) -> Result<(), InitError> {
        // C changes rounds/crypt even on invalid key lengths: reject before FFI.
        let bits = key_bits(key)?;
        // SAFETY: the handle grants exclusive access to the full initialized C
        // allocation; the key has exactly bits/8 readable bytes and is not retained.
        let code = unsafe {
            // C replaces the schedule without retaining the key pointer.
            ffi::av_aes_init(self.as_mut_ptr(), key.as_ptr(), bits, direction.as_int())
        };
        if code < 0 {
            Err(InitError::InitializationFailed(code))
        } else {
            Ok(())
        }
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn key_validation_and_error_messages() {
//! Owned and borrowed views of the opaque TEA context.
//!
//! C keeps the layout private. The context contains only inline key words and
//! a round count; no key pointer is retained and there is no clone primitive.
//! Storage remains C-allocated and is released by the [`super::mem::Heap`] policy.
use ffibox::define_ctype;
use super::{ffi, mem::HeapBox};
define_ctype!(
    /// Wraps: AVTEA
    ///
    /// An initialized TEA context. Its private C fields are not exposed.
    /// No `Send`/`Sync` guarantee is added.
    ///
    /// Handles cannot outlive their owner:
    /// ```compile_fail
    /// use ffmpeg::libavutil::tea::{Tea, TeaRef};
    /// fn dangling() -> TeaRef<'static> {
    ///     let owner = Tea::new(&[0; 16], 64).unwrap();
    ///     owner.as_ref()
    /// }
    /// ```
    /// Exclusive handles cannot alias:
    /// ```compile_fail
    /// use ffmpeg::libavutil::tea::Tea;
    /// let mut owner = Tea::new(&[0; 16], 64).unwrap();
    /// let mut first = owner.as_mut();
    /// let mut second = owner.as_mut();
    /// first.init(&[1; 16], 64);
    /// second.init(&[2; 16], 64);
    /// ```
    Tea, TeaRef, TeaMut, ffi::AVTEA
);
/// Sole ownership of a C-allocated TEA context, freed with `av_free`.
pub type TeaBox = HeapBox<Tea>;
impl Tea {
    /// Wraps: av_tea_alloc
    ///
    /// Allocate and initialize a context; `None` means allocation failed.
    /// `rounds` is passed unchanged (64 is the standard round count).
    /// The key is copied, so its borrow ends when this call returns.
    pub fn new(key: &[u8; 16], rounds: i32) -> Option<TeaBox> {
        // SAFETY: the allocator returns fresh, zero-filled C storage with no
        // nested resources. Heap frees it with the paired av_free. The owner
        // stays private until init has established the context's key/rounds.
        let mut owner = unsafe { TeaBox::from_c(ffi::av_tea_alloc()) }?;
        owner.as_mut().init(key, rounds);
        Some(owner)
    }
}
impl TeaMut<'_> {
    /// Wraps: av_tea_init
    ///
    /// Replace the key and round count. C copies the 16 key bytes and retains
    /// no pointer to the key. All signed round counts are accepted by C.
    pub fn init(&mut self, key: &[u8; 16], rounds: i32) {
        // SAFETY: the handle exclusively borrows a full C allocation. C writes
        // only that context and reads exactly the 16 live key bytes, retaining
        // neither pointer. The scalar round count is stored without arithmetic.
        unsafe { ffi::av_tea_init(self.as_mut_ptr(), key.as_ptr(), rounds) }
    }
}
/// Wraps: av_tea_size
///
/// The C context's size in bytes, borrowed from immutable C static storage.
pub fn context_size() -> &'static i32 {
    // SAFETY: C defines this global as `const int = sizeof(context)`; it has
    // static lifetime and no writer anywhere in the library.
    unsafe { &ffi::av_tea_size }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn layout_matches_ffi() {
        assert_eq!(
            core::mem::size_of::<Tea>(),
            core::mem::size_of::<ffi::AVTEA>()
        );
        assert_eq!(
            core::mem::align_of::<Tea>(),
            core::mem::align_of::<ffi::AVTEA>()
        );
        assert_eq!(
            core::mem::size_of::<TeaRef<'_>>(),
            core::mem::size_of::<usize>()
        );
        assert_eq!(
            core::mem::size_of::<TeaMut<'_>>(),
            core::mem::size_of::<usize>()
        );
    }
    #[test]
    #[cfg(not(miri))]
    fn raw_ownership_round_trip() {
        let owner = Tea::new(&[7; 16], 64).unwrap();
        let ptr = owner.into_c();
        // SAFETY: into_c transferred the sole live allocation, still initialized
        // and paired with Heap's av_free; no borrow remains.
        let owner = unsafe { TeaBox::from_c(ptr) }.unwrap();
        drop(owner);
    }
}
use ffibox::CZeroable;
use ffmpeg::libavutil::des::{Des, DesBox};
#[test]
fn inline_heap_fields_and_reborrows() {
    #[repr(align(8))]
    struct KeyStorage([u8; 25]);
    let unaligned = KeyStorage([0xA5; 25]);
    let mut inline = Des::new(&[1; 8], false).unwrap();
    let mut heap = Des::new_boxed(&[2; 24], true).unwrap();
    let mut zeroed = Des::zeroed();
    let mut allocated = DesBox::new().unwrap();
    let mut allocated_zeroed = DesBox::new_zeroed().unwrap();
    for mut handle in [
        inline.as_mut(),
        heap.as_mut(),
        zeroed.as_mut(),
        allocated.as_mut(),
        allocated_zeroed.as_mut(),
    ] {
        let shared = handle.as_ref();
        let copy = shared;
        assert_eq!(shared.round_keys(), copy.round_keys());
        for flag in [i32::MIN, -1, 0, 1, i32::MAX] {
            handle.as_mut().set_triple_des(flag);
            handle.as_mut().set_round_keys([[u64::MAX; 16]; 3]);
            assert_eq!(handle.as_ref().triple_des(), flag);
            assert_eq!(handle.as_ref().round_keys(), [[u64::MAX; 16]; 3]);
        }
        handle.as_mut().init(&unaligned.0[1..25], false).unwrap();
        handle.as_mut().init(&unaligned.0[1..9], true).unwrap();
        assert_eq!(handle.as_ref().triple_des(), 0);
    }
    // The copied field snapshot owns its integers and survives its parent.
    let keys = heap.as_ref().round_keys();
    drop(heap);
    assert_ne!(keys[0], [0; 16]);
}
#[test]
fn repeated_construction_and_destruction() {
    for _ in 0..128 {
        let mut owner = Des::new_boxed(&[0; 24], false).unwrap();
        owner.as_mut().init(&[255; 8], true).unwrap();
        assert_eq!(owner.as_ref().triple_des(), 0);
    }
}
#[test]
fn rust_only_layout_projection() {
    // This safe public-API path deliberately makes no foreign call, so Miri
    // can validate layout projection and lifetimes as well as the sanitizers.
    let mut inline = Des::zeroed();
    assert_eq!(inline.as_ref().round_keys(), [[0; 16]; 3]);
    let mut exclusive = inline.as_mut();
    for flag in [i32::MIN, 0, i32::MAX] {
        exclusive.as_mut().set_triple_des(flag);
        exclusive.as_mut().set_round_keys([[flag as u64; 16]; 3]);
        let shared = exclusive.as_ref();
        let copied = shared;
        assert_eq!(copied.triple_des(), flag);
        assert_eq!(copied.round_keys(), [[flag as u64; 16]; 3]);
    }
}
