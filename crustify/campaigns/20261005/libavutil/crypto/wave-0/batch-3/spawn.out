[workspace]
resolver = "3"
members = [
    "libavutil-sys",
    "libswresample-sys",
    "libswscale-sys",
    "libavcodec-sys",
    "libavformat-sys",
    "libavfilter-sys",
    "libavdevice-sys",
    "ffmpeg",
]
[workspace.package]
version = "0.1.0"
edition = "2024"
license = "LGPL-2.1-or-later"
publish = false
[workspace.dependencies]
bindgen = { version = "0.73", features = ["experimental"] }
cc = "1.5"
ffibox = { path = "/opt/venv/share/ffibox" }
serde_json = "1"
trybuild = "1"
libavutil-sys = { path = "libavutil-sys" }
libswresample-sys = { path = "libswresample-sys" }
libswscale-sys = { path = "libswscale-sys" }
libavcodec-sys = { path = "libavcodec-sys" }
libavformat-sys = { path = "libavformat-sys" }
libavfilter-sys = { path = "libavfilter-sys" }
libavdevice-sys = { path = "libavdevice-sys" }
[workspace.lints.clippy]
undocumented_unsafe_blocks = "deny"
module_inception = "allow"
[package]
name = "ffmpeg"
description = "Safe Rust wrappers over FFmpeg's public C API"
build = "build.rs"
version.workspace = true
edition.workspace = true
license.workspace = true
publish.workspace = true
[lib]
path = "lib.rs"
[features]
default = ["libavutil", "libswresample", "libswscale", "libavcodec", "libavformat", "libavfilter", "libavdevice"]
libavutil = ["dep:libavutil-sys"]
libswresample = ["dep:libswresample-sys", "libavutil"]
libswscale = ["dep:libswscale-sys", "libavutil"]
libavcodec = ["dep:libavcodec-sys", "libswresample", "libavutil"]
libavformat = ["dep:libavformat-sys", "libavcodec", "libavutil"]
libavfilter = ["dep:libavfilter-sys", "libswscale", "libavformat", "libavcodec", "libswresample", "libavutil"]
libavdevice = ["dep:libavdevice-sys", "libavfilter", "libavformat", "libavcodec", "libavutil"]
[dependencies]
ffibox.workspace = true
libavutil-sys = { workspace = true, optional = true }
libswresample-sys = { workspace = true, optional = true }
