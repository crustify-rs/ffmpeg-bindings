     1	//! Safe wrappers over `libavutil/des.h`.
     2	//!
     3	//! [`Des`] is resource-free, so it can live inline or behind [`DesBox`].
     4	//! C retains no pointer passed to initialization. All three key schedules
     5	//! are initialized, including the two inactive schedules in single-DES mode.
     6	//! DES is obsolete and should not be used for new security protocols.
     7	
     8	use core::ptr::{NonNull, addr_of, addr_of_mut};
     9	
    10	use ffibox::{CNew, CZeroable, define_ctype};
    11	
    12	use super::ffi;
    13	use super::mem::{Heap, HeapBox};
    14	
    15	// SAFETY: The generated handles match the public ffi::AVDES layout; all raw fields are integer scalars or arrays, and borrow lifetimes govern access.
    16	define_ctype!(
    17	    /// Wraps: AVDES
    18	    ///
    19	    /// The public DES layout. Fields are reached through [`DesRef`] and
    20	    /// [`DesMut`], never references to a C-owned object.
