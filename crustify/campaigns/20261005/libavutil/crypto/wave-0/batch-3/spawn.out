usage: wavefront repo_root query symbols [-h] [--imported-only |
                                         --targeted-only] [--api-only]
                                         [--out-of-tree | --in-tree]
                                         [--name NAME [NAME ...]]
                                         [--file FILE [FILE ...]]
                                         [--update FINDINGS | --update-help |
                                         --schema | --lifetime-for SPEC |
                                         --taking SPEC | --returning SPEC |
                                         --callees | --callers]
