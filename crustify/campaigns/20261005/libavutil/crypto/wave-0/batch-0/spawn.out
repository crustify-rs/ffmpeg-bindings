diff --git a/crustify/rust/ffmpeg/libavutil/aes.rs b/crustify/rust/ffmpeg/libavutil/aes.rs
index b5f8d6c83563c98feb82428dba0032d19bcb41fc..0330035b694efae0160343e13304198f34f90e62
--- a/crustify/rust/ffmpeg/libavutil/aes.rs
+++ b/crustify/rust/ffmpeg/libavutil/aes.rs
@@ -1 +1,196 @@
 //! Safe wrappers over `libavutil/aes.h`.
+//!
+//! C owns allocation and the private layout. Keys are copied during initialization;
+//! no caller buffer is retained. A context has no sub-allocations or C clone routine.
+//! Processing routines are wrapped by the symbol batch, not this lifecycle module.
+
+use core::{fmt, mem::MaybeUninit, ptr::NonNull};
+use ffibox::{CAlloc, CBox, CDrop, define_ctype};
+
+use super::{ffi, mem::Heap};
+
+/// The key schedule to install in an AES context.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Direction {
+    Encrypt,
+    Decrypt,
+}
+
+impl Direction {
+    pub(crate) fn as_int(self) -> i32 {
+        i32::from(self == Self::Decrypt)
+    }
+}
+
+/// Failure to construct or reinitialize an AES context.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum InitError {
+    /// AES accepts exactly 16, 24 or 32 key bytes.
+    InvalidKeyLength,
+    AllocationFailed,
+    /// The initializer returned a negative C error code.
+    InitializationFailed(i32),
+}
+
+impl fmt::Display for InitError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidKeyLength => f.write_str("AES key must contain 16, 24 or 32 bytes"),
+            Self::AllocationFailed => f.write_str("AES allocation failed"),
+            Self::InitializationFailed(code) => write!(f, "AES initialization failed ({code})"),
+        }
+    }
+}
+
+impl std::error::Error for InitError {}
+
+define_ctype!(
+    /// Wraps: AVAES
+    ///
+    /// An initialized AES context. The public C type is opaque: this layout
+    /// names the FFI pointee only, never its private size or fields. Construct
+    /// an owner with [`Aes::new`], not an inline value or a generic allocator.
+    /// An adopted context must have a valid 128-, 192- or 256-bit key schedule.
+    Aes, AesRef, AesMut, ffi::AVAES
+);
+
+/// Storage allocated by `av_aes_alloc`, released by the existing [`Heap`] policy.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct AesFree;
+
+// SAFETY: an AES context owns no resources besides its av_malloc-family storage.
+unsafe impl CDrop<Aes> for AesFree {
+    unsafe fn c_drop(&self, ptr: NonNull<Aes>) {
+        // SAFETY: the caller transfers the live allocation to be freed exactly once.
+        unsafe { Heap.c_drop(ptr) }
+    }
+}
+
+// SAFETY: Heap frees storage without reading it, including before initialization.
+unsafe impl CDrop<MaybeUninit<Aes>> for AesFree {
+    unsafe fn c_drop(&self, ptr: NonNull<MaybeUninit<Aes>>) {
+        // SAFETY: the caller transfers the live allocation to be freed exactly once.
+        unsafe { Heap.c_drop(ptr) }
+    }
+}
+
+/// Wraps: av_aes_alloc
+// SAFETY: C allocates the full private body with its required alignment, not
+// size_of::<Aes>() (the public forward declaration has no body). AesFree releases it.
+unsafe impl CAlloc<Aes> for AesFree {
+    fn c_alloc(&self) -> Option<NonNull<MaybeUninit<Aes>>> {
+        // SAFETY: the allocator takes no arguments and transfers fresh storage.
+        NonNull::new(unsafe { ffi::av_aes_alloc() }.cast())
+    }
+}
+
+/// Sole ownership of an initialized context. No C clone or thread-safety assertion.
+///
+/// Handles cannot outlive the owner:
+/// ```compile_fail,E0505
+/// use ffmpeg::libavutil::aes::{Aes, Direction};
+/// let aes = Aes::new(&[0; 16], Direction::Encrypt).unwrap();
+/// let view = aes.as_ref();
+/// drop(aes);
+/// let _ = view;
+/// ```
+/// A shared reborrow excludes reinitialization:
+/// ```compile_fail,E0502
+/// use ffmpeg::libavutil::aes::{Aes, Direction};
+/// let mut aes = Aes::new(&[0; 16], Direction::Encrypt).unwrap();
+/// let mut handle = aes.as_mut();
+/// let view = handle.as_ref();
+/// handle.init(&[1; 16], Direction::Decrypt).unwrap();
+/// let _ = view;
+/// ```
+pub type AesBox = CBox<Aes, AesFree>;
+
+fn key_bits(key: &[u8]) -> Result<i32, InitError> {
+    match key.len() {
+        16 => Ok(128),
+        24 => Ok(192),
+        32 => Ok(256),
+        _ => Err(InitError::InvalidKeyLength),
+    }
+}
+
+impl Aes {
+    /// Allocate and initialize a context. The key may be dropped immediately.
+    pub fn new(key: &[u8], direction: Direction) -> Result<AesBox, InitError> {
+        let bits = key_bits(key)?;
+        let mut storage = AesBox::new_uninit().ok_or(InitError::AllocationFailed)?;
+        // SAFETY: storage is the full C-allocated context, exclusively held here;
+        // the checked key has exactly bits/8 readable bytes. C copies it and retains
+        // no caller pointer. Direction selects a supported key schedule.
+        let code = unsafe {
+            ffi::av_aes_init(storage.as_c_ptr(), key.as_ptr(), bits, direction.as_int())
+        };
+        if code < 0 {
+            return Err(InitError::InitializationFailed(code));
+        }
+        // SAFETY: successful C initialization installed the key schedule, rounds
+        // and crypt function. No handle to the construction-phase storage escaped.
+        Ok(unsafe { storage.assume_init() })
+    }
+}
+
+impl AesMut<'_> {
+    /// Wraps: av_aes_init
+    ///
+    /// Replace the key schedule. Invalid key lengths leave the context unchanged.
+    pub fn init(&mut self, key: &[u8], direction: Direction) -> Result<(), InitError> {
+        // C changes rounds/crypt even on invalid key lengths: reject before FFI.
+        let bits = key_bits(key)?;
+        // SAFETY: the handle grants exclusive access to the full initialized C
+        // allocation; the key has exactly bits/8 readable bytes and is not retained.
+        let code = unsafe {
+            ffi::av_aes_init(self.as_mut_ptr(), key.as_ptr(), bits, direction.as_int())
+        };
+        if code < 0 {
+            Err(InitError::InitializationFailed(code))
+        } else {
+            Ok(())
+        }
+    }
+}
+
+#[cfg(test)]
+mod unit_tests {
+    use super::*;
+
+    #[test]
+    fn key_validation_and_error_messages() {
+        for len in 0..=64 {
+            assert_eq!(key_bits(&vec![0; len]).is_ok(), matches!(len, 16 | 24 | 32));
+        }
+        assert_eq!(key_bits(&[0; 16]), Ok(128));
+        assert_eq!(key_bits(&[0; 24]), Ok(192));
+        assert_eq!(key_bits(&[0; 32]), Ok(256));
+        assert!(!InitError::InvalidKeyLength.to_string().is_empty());
+        assert!(!InitError::AllocationFailed.to_string().is_empty());
+        assert!(InitError::InitializationFailed(-22).to_string().contains("-22"));
+        assert_eq!(Direction::Encrypt.as_int(), 0);
+        assert_eq!(Direction::Decrypt.as_int(), 1);
+    }
+
+    #[test]
+    fn invalid_construction_does_not_call_c() {
+        for len in [0, 1, 15, 17, 23, 25, 31, 33] {
+            assert!(matches!(Aes::new(&vec![0; len], Direction::Encrypt),
+                Err(InitError::InvalidKeyLength)));
+        }
+    }
+
+    #[test]
+    #[cfg(not(miri))]
+    fn raw_roundtrip_and_construction_phase_drop() {
+        let owner = Aes::new(&[0; 16], Direction::Encrypt).unwrap();
+        let ptr = owner.into_c();
+        // SAFETY: into_c transferred this initialized allocation; adopt it once.
+        let owner = unsafe { AesBox::from_c(ptr) }.unwrap();
+        assert_eq!(owner.as_c_ptr(), ptr);
+        drop(owner);
+        // Exercises storage-only release without exposing an uninitialized handle.
+        drop(AesBox::new_uninit().unwrap());
+    }
+}
diff --git a/crustify/rust/ffmpeg/libavutil/aes_ctr.rs b/crustify/rust/ffmpeg/libavutil/aes_ctr.rs
index 500fd9b3d5007805a933ac11c86b84ae1626ec66..4ad00ad8b86ba57930617803d41b407261937c08
--- a/crustify/rust/ffmpeg/libavutil/aes_ctr.rs
+++ b/crustify/rust/ffmpeg/libavutil/aes_ctr.rs
@@ -1 +1,120 @@
 //! Safe wrappers over `libavutil/aes_ctr.h`.
+//!
+//! The private context contains an inline AES context, counters and a block offset;
+//! it owns no pointers. Initialization copies the key and resets the counter and
+//! offset. Only C knows its size and alignment. IV and processing operations belong
+//! to the subsequent symbol batch.
+
+use core::{mem::MaybeUninit, ptr::NonNull};
+use ffibox::{CAlloc, CBox, CDrop, define_ctype, impl_cdrop};
+use super::{aes::InitError, ffi};
+
+define_ctype!(
+    /// Wraps: AVAESCTR
+    ///
+    /// An initialized AES-128 CTR context, opaque in the public C API. An adopted
+    /// context must have been successfully initialized by `av_aes_ctr_init`.
+    /// Use [`AesCtr::new`] rather than an inline value or a generic allocator.
+    AesCtr, AesCtrRef, AesCtrMut, ffi::AVAESCTR
+);
+
+/// Wraps: av_aes_ctr_free
+///
+/// Release a context's full C allocation, including its inline AES state.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct AesCtrFree;
+
+// SAFETY: av_aes_ctr_free releases the av_malloc-family allocation once. The
+// context has no separate owned pointers or resources, and C retains no alias.
+impl_cdrop!(AesCtrFree, AesCtr, ffi::av_aes_ctr_free);
+
+// SAFETY: av_aes_ctr_free calls av_free without reading construction-phase bytes.
+unsafe impl CDrop<MaybeUninit<AesCtr>> for AesCtrFree {
+    unsafe fn c_drop(&self, ptr: NonNull<MaybeUninit<AesCtr>>) {
+        // SAFETY: the caller transfers the live C allocation for one release;
+        // free neither reads the context nor requires successful initialization.
+        unsafe { ffi::av_aes_ctr_free(ptr.as_ptr().cast()) }
+    }
+}
+
+/// Wraps: av_aes_ctr_alloc
+// SAFETY: C allocates its full private body with the right size and alignment;
+// AesCtrFree pairs with the allocator for both construction and initialized storage.
+unsafe impl CAlloc<AesCtr> for AesCtrFree {
+    fn c_alloc(&self) -> Option<NonNull<MaybeUninit<AesCtr>>> {
+        // SAFETY: the allocator takes no arguments and transfers fresh storage.
+        NonNull::new(unsafe { ffi::av_aes_ctr_alloc() }.cast())
+    }
+}
+
+/// Sole ownership of a CTR context, with shared and exclusive borrowed handles.
+///
+/// An exclusive handle cannot outlive its owner:
+/// ```compile_fail,E0505
+/// use ffmpeg::libavutil::aes_ctr::AesCtr;
+/// let mut ctr = AesCtr::new(&[0; 16]).unwrap();
+/// let mut handle = ctr.as_mut();
+/// drop(ctr);
+/// handle.init(&[1; 16]).unwrap();
+/// ```
+/// Reborrows cannot alias a mutation:
+/// ```compile_fail,E0499
+/// use ffmpeg::libavutil::aes_ctr::AesCtr;
+/// let mut ctr = AesCtr::new(&[0; 16]).unwrap();
+/// let mut first = ctr.as_mut();
+/// let mut second = ctr.as_mut();
+/// first.init(&[1; 16]).unwrap();
+/// second.init(&[2; 16]).unwrap();
+/// ```
+pub type AesCtrBox = CBox<AesCtr, AesCtrFree>;
+
+impl AesCtr {
+    /// Allocate and initialize AES-CTR with a copied 16-byte key and a zero IV.
+    /// Set an appropriate IV through the processing API before encrypting messages;
+    /// never reuse a key/IV combination.
+    pub fn new(key: &[u8; 16]) -> Result<AesCtrBox, InitError> {
+        let mut storage = AesCtrBox::new_uninit().ok_or(InitError::AllocationFailed)?;
+        // SAFETY: storage holds the full, exclusively owned C allocation; the
+        // fixed-size key provides the 16 bytes C copies without retaining a pointer.
+        let code = unsafe { ffi::av_aes_ctr_init(storage.as_c_ptr(), key.as_ptr()) };
+        if code < 0 {
+            return Err(InitError::InitializationFailed(code));
+        }
+        // SAFETY: C initialized the inline AES schedule and reset counter/offset.
+        // The encrypted-counter scratch buffer is only read after C fills it.
+        Ok(unsafe { storage.assume_init() })
+    }
+}
+
+impl AesCtrMut<'_> {
+    /// Wraps: av_aes_ctr_init
+    ///
+    /// Replace the copied key and reset the full counter and partial-block state.
+    pub fn init(&mut self, key: &[u8; 16]) -> Result<(), InitError> {
+        // SAFETY: the handle exclusively borrows an initialized full C context;
+        // C copies exactly 16 key bytes and does not retain the caller pointer.
+        let code = unsafe { ffi::av_aes_ctr_init(self.as_mut_ptr(), key.as_ptr()) };
+        if code < 0 {
+            Err(InitError::InitializationFailed(code))
+        } else {
+            Ok(())
+        }
+    }
+}
+
+#[cfg(test)]
+mod unit_tests {
+    use super::*;
+
+    #[test]
+    #[cfg(not(miri))]
+    fn raw_roundtrip_and_construction_phase_drop() {
+        let owner = AesCtr::new(&[0; 16]).unwrap();
+        let ptr = owner.into_c();
+        // SAFETY: into_c transferred this initialized allocation; adopt it once.
+        let owner = unsafe { AesCtrBox::from_c(ptr) }.unwrap();
+        assert_eq!(owner.as_c_ptr(), ptr);
+        drop(owner);
+        drop(AesCtrBox::new_uninit().unwrap());
+    }
+}
