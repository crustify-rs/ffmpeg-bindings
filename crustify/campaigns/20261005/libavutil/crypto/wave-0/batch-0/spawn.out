(root/'equiv/aes.rs').write_text('''//"'! Compare lifecycle state through C observers; processing wrappers are scheduled
//! separately. Neither observer adopts the safe owner'"'s allocation.
use ffmpeg::libavutil::{aes::{Aes, Direction}, ffi};
struct Reference(*mut ffi::AVAES);
impl Reference {
    fn new() -> Self {
        // SAFETY: allocation has no preconditions; the test releases its result once.
        let ptr = unsafe { ffi::av_aes_alloc() };
        assert"'!(!ptr.is_null());
        Self(ptr)
    }
}
impl Drop for Reference {
    fn drop(&mut self) {
        // SAFETY: this reference fixture solely owns the live av_malloc allocation.
        unsafe { ffi::av_free(self.0.cast()) }
    }
}
/// Observe an initialized, exclusively accessed C context.
/// # Safety
/// ptr must address a full initialized AES context; no other handle is used here.
unsafe fn observe(ptr: *mut ffi::AVAES, direction: Direction) -> ([u8; 64], [u8; 16]) {
    let input = [0x45; 64];
    let mut output = [0; 64];
    let mut iv = [0x31; 16];
    let decrypt = i32::from(direction == Direction::Decrypt);
    for offset in [0, 32] {
        // SAFETY: caller provides a live initialized context. These disjoint
        // local buffers each have 32 bytes at offset; IV is writable for 16 bytes.
        unsafe { ffi::av_aes_crypt(ptr, output.as_mut_ptr().add(offset),
            input.as_ptr().add(offset), 2, iv.as_mut_ptr(), decrypt) };
    }
    (output, iv)
}
#[test]
fn constructors_and_reinitialization_match_c() {
    let reference = Reference::new();
    for direction in [Direction::Encrypt, Direction::Decrypt] {
        for len in [16, 24, 32] {
            let mut key = vec![0x91; len];
            let mut owner = Aes::new(&key, direction).unwrap();
            // SAFETY: reference owns full C storage; key has exactly len valid bytes.
            assert_eq!(unsafe { ffi::av_aes_init(reference.0, key.as_ptr(),
                (len * 8) as i32, i32::from(direction == Direction::Decrypt)) }, 0);
            key.fill(0); // both initializers copied the original key.
            // SAFETY: both independently owned contexts have been initialized;
            // no borrowed handle remains alive across their exclusive C observers.
            assert_eq!(unsafe { observe(owner.as_c_ptr(), direction) },
                unsafe { observe(reference.0, direction) });
            for next_len in [32, 24, 16] {
                let key = vec![next_len as u8; next_len];
                owner.as_mut().init(&key, direction).unwrap();
                // SAFETY: full reference storage, valid key length; no retained alias.
                assert_eq!(unsafe { ffi::av_aes_init(reference.0, key.as_ptr(),
                    (next_len * 8) as i32, i32::from(direction == Direction::Decrypt)) }, 0);
                // SAFETY: successful reinitialization restored both key schedules.
                let actual = unsafe { observe(owner.as_c_ptr(), direction) };
                // SAFETY: same reference context validity and exclusive access.
                let expected = unsafe { observe(reference.0, direction) };
                assert_eq!(actual, expected);
            }
        }
    }
}
'"''')
(root/'equiv/aes_ctr.rs').write_text('''//"'! Observe the private lifecycle state through the unchanged C processing API.
use ffmpeg::libavutil::{aes_ctr::AesCtr, ffi};
struct Reference(*mut ffi::AVAESCTR);
impl Reference {
    fn new() -> Self {
        // SAFETY: allocation has no preconditions; the test releases it once.
        let ptr = unsafe { ffi::av_aes_ctr_alloc() };
        assert!(!ptr.is_null());
        Self(ptr)
    }
}
impl Drop for Reference {
    fn drop(&mut self) {
        // SAFETY: this fixture solely owns the C allocation.
        unsafe { ffi::av_aes_ctr_free(self.0) }
    }
}
/// # Safety
/// ptr must be an initialized full CTR context, exclusively accessed for this call.
unsafe fn observe(ptr: *mut ffi::AVAESCTR, len: usize) -> (Vec<u8>, [u8; 16]) {
    let input = vec![0x61; len.max(1)];
    let mut output = vec![0; len.max(1)];
    // SAFETY: caller supplies exclusive initialized context; buffers are valid
    // for len bytes, including a real address on the zero-length path.
    unsafe { ffi::av_aes_ctr_crypt(ptr, output.as_mut_ptr(), input.as_ptr(), len as i32) };
    // SAFETY: get_iv returns the inline, fully initialized counter[16]. Copy it
    // immediately; no reference to C memory survives a subsequent write or free.
    let iv = unsafe { ffi::av_aes_ctr_get_iv(ptr).cast::<[u8; 16]>().read() };
    output.truncate(len);
    (output, iv)
}
#[test]
fn constructors_and_reset_partial_block_match_c() {
    let reference = Reference::new();
    let mut key = [0x42; 16];
    let mut owner = AesCtr::new(&key).unwrap();
    // SAFETY: full reference storage and exactly 16 key bytes, copied by C.
    assert_eq!(unsafe { ffi::av_aes_ctr_init(reference.0, key.as_ptr()) }, 0);
    key.fill(0); // initialization must not retain the key.
    for seed in 0..3 {
        for len in [0, 1, 15, 17, 31, 1] {
            // SAFETY: both contexts initialized and exclusively observed.
            let actual = unsafe { observe(owner.as_c_ptr(), len) };
            // SAFETY: independently owned initialized reference context.
            let expected = unsafe { observe(reference.0, len) };
            assert_eq!(actual, expected);
        }
        // Reset after ending on a partial block: next crypt must not use old scratch.
        owner.as_mut().init(&[seed; 16]).unwrap();
        // SAFETY: full reference allocation, exactly 16 key bytes, no retained alias.
        assert_eq!(unsafe { ffi::av_aes_ctr_init(reference.0, [seed; 16].as_ptr()) }, 0);
        // SAFETY: both have just been reinitialized; counters must be zero.
        let actual = unsafe { observe(owner.as_c_ptr(), 0) };
        // SAFETY: same initialized reference allocation.
        let expected = unsafe { observe(reference.0, 0) };
        assert_eq!(actual, (Vec::new(), [0; 16]));
        assert_eq!(actual, expected);
    }
}
'"''')
