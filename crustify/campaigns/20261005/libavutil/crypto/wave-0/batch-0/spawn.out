for suite in ['ub_safe','equiv']:
 p=Path(f'crustify/rust/ffmpeg/tests/{suite}/main.rs')
 original=subprocess.check_output(['git','show',f'HEAD:{p}'],text=True)
 p.write_text(original.replace('mod avstring;','mod aes;\\nmod aes_ctr;\\nmod avstring;'))
