import json
p={'scalar':{'by_val':True},'array':None,'string':False,'owned':False,'borrowed':{'lifetime':'static'},'nullable':True,'mutable':False,'note':'av_aes_alloc zeroes crypt (construction only); av_aes_init and ff_init_aes_x86 replace it with process-lifetime C/assembly functions. No ownership or captured caller data. Initialized contexts have a non-null crypt function. Internal, not published in aes.h.'}
json.dump({'fields':{'crypt':{'ptr':p}},'_comment_agent':'Public forward declaration only. av_aes_alloc allocates aligned, zeroed private storage; av_aes_init copies 16/24/32 bytes into the inline round schedule. state is scratch, rounds/crypt select dispatch. No retained key or other resource. Invalid key bits alter rounds/crypt before returning EINVAL, so validate before safe reinitialization. Every observed holder exclusively accesses its context and frees it with av_free/av_freep. No clone API; no Send/Sync asserted.'},open('/tmp/crypto-b0-AES-findings.json','w'))
json.dump({'fields':{},'_comment_agent':'Public forward declaration only. Counter[16], encrypted_counter[16], block_offset and inline AVAES, no owned/borrowed pointer fields. av_aes_ctr_alloc uses av_mallocz; init copies key, initializes embedded AES, resets counter/offset; av_aes_ctr_free calls av_free without reading storage. get_iv returns a borrowed pointer into counter, invalidated by free and changed by crypt/setters/reinit. No clone API. C never retains caller key, IV or processing buffers.'},open('/tmp/crypto-b0-CTR-findings.json','w'))
def ptr(owned=False,borrowed=None,array=False,nullable=False,mutable=True,note=''):
 return {'scalar':None if array else {'by_val':True},'array':{'by_val':True} if array else None,'string':False,'owned':owned,'borrowed':{'lifetime':borrowed} if borrowed else None,'nullable':nullable,'mutable':mutable,'note':note}
def life(target,alloc=False,init=False,drop=False):
