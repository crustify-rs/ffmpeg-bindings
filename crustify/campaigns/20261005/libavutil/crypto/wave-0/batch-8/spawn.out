version = "0.1.0"
edition = "2024"
license = "LGPL-2.1-or-later"
publish = false
[workspace.dependencies]
bindgen = { version = "0.73", features = ["experimental"] }
cc = "1.5"
ffibox = { path = "/opt/venv/share/ffibox" }
serde_json = "1"
trybuild = "1"
libavutil-sys = { path = "libavutil-sys" }
libswresample-sys = { path = "libswresample-sys" }
libswscale-sys = { path = "libswscale-sys" }
libavcodec-sys = { path = "libavcodec-sys" }
libavformat-sys = { path = "libavformat-sys" }
libavfilter-sys = { path = "libavfilter-sys" }
libavdevice-sys = { path = "libavdevice-sys" }
[workspace.lints.clippy]
undocumented_unsafe_blocks = "deny"
module_inception = "allow"
usage: wavefront [-h] [--config PATH]
                 repo_root {extract-ql,schedule,query} ...
Semantic analysis, ownership findings, and deterministic scheduling for C.
positional arguments:
  repo_root             Full path to the repository root. Explicit — Wavefront
                        never walks the filesystem to find it.
  {extract-ql,schedule,query}
    extract-ql          Run the T1 (entities) + T2 (edges) .ql batches against
                        the CodeQL database below the config's state_dir and
                        write one CSV per query under its codeql/{t1,t2}/. The
                        database is NOT created here — build the project under
                        `codeql database create` yourself first. Everything
                        else derives from these tables on demand. Takes
                        minutes — run it only when the extraction is genuinely
                        stale.
    schedule            Build an objective-neutral schedule with sequential
                        waves.
    query               Read-only oracle. `types`/`symbols` enumerate
                        (filtered, as a name list) or introspect one (--name)
                        as the whole record. `files` lists the targeted /
                        imported section file sets. `dag` does the graph walks
                        (closure / layer / scc).
options:
  -h, --help            show this help message and exit
  --config PATH         Explicit wavefront-config.json for extraction, query,
                        or schedule. Relative paths are resolved from
                        REPO_ROOT.
