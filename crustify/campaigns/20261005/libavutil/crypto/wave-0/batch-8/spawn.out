#"'!/bin/bash
set -euo pipefail
ROOT=$1; TAG=$2; LOG=/tmp/crypto-b8/$TAG; mkdir -p "$LOG"
cd "$ROOT/crustify/rust"
export CRUSTIFY_FFMPEG_VARIANT=asan-ubsan CRUSTIFY_FFMPEG_BUILD_DIR=/tmp/crypto-b8/builds/asan-ubsan CARGO_TARGET_DIR=/tmp/crypto-b8/regression CC=/usr/bin/clang-18 CFLAGS='"'-fsanitize=address,undefined -fno-omit-frame-pointer' RUSTFLAGS='-C linker=/usr/bin/clang-18 -C link-arg=-fsanitize=address,undefined' ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1
export RUSTDOCFLAGS=\""'$RUSTFLAGS"
cargo check --workspace > "$LOG/check.log" 2>&1
cargo clippy --workspace > "$LOG/clippy.log" 2>&1
cargo clippy --workspace --all-targets > "$LOG/clippy-all.log" 2>&1
set +e
cargo test --workspace > "$LOG/workspace.log" 2>&1
result=$?
set -e
echo "full_workspace_status=$result"
# No unrelated golden files are blessed by this batch.
if [ "$result" != 0 ]; then
 grep -q '"'2 of .* tests failed' \""'$LOG/workspace.log"
 grep -q '"'intfloat_mut_handle_sent_past_value.rs ... mismatch' \""'$LOG/workspace.log"
 grep -q '"'intreadwrite_view_sent_past_bytes.rs ... mismatch' \""'$LOG/workspace.log"
fi
cargo test --workspace -- --skip compile_fail > "$LOG/runtime-and-docs.log" 2>&1
cargo test -p libavutil-sys > "$LOG/sys.log" 2>&1
echo "workspace_except_known_snapshots=passed"
EOF
