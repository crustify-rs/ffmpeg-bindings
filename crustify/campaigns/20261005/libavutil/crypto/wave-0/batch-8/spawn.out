r=subprocess.run([tc+'llvm-cov','export','-format=lcov','-instr-profile='+str(tmp/'merged.profdata')]+sum([['-object',x] for x in exes],[]),text=True,capture_output=True,check=True)
(tmp/'rust.lcov').write_text(r.stdout)
cur=None; counts={}
for l in r.stdout.splitlines():
 if l.startswith('SF:'):cur=l[3:]
 elif l.startswith('DA:') and cur and cur.endswith(('/tea.rs','/twofish.rs')) and '/tests/' not in cur:
  ln,c=l[3:].split(',')[:2];counts.setdefault(cur,{})[int(ln)]=int(c)
summary={}
for f,lines in counts.items():
 # Exclude inline test modules.
 start=pathlib.Path(f).read_text().splitlines().index('#[cfg(test)]')+1
 lines={n:c for n,c in lines.items() if n<start}
 summary[f]={'hit':sum(c>0 for c in lines.values()),'total':len(lines),'uncovered':[n for n,c in lines.items() if c==0]}
gcov=tmp/'gcov';gcov.mkdir(exist_ok=True)
for name in ['tea','twofish']:
 b=pathlib.Path('/tmp/crypto-b8/builds/coverage/libavutil')
 for suffix in ['gcno','gcda']:
  src=b/f'{name}.{suffix}' if suffix=='gcno' else tmp/'gcda'/str(b).lstrip('/')/f'{name}.{suffix}'
  dst=gcov/src.name
  if dst.exists():dst.unlink()
  dst.symlink_to(src)
 r=subprocess.run(['gcov','-b','-c','-o',str(gcov),str(gcov/f'{name}.gcno')],cwd=gcov,text=True,capture_output=True,check=True)
 (tmp/f'{name}-gcov.log').write_text(r.stdout+r.stderr)
summary['C_logs']={n:(tmp/f'{n}-gcov.log').read_text() for n in ['tea','twofish']}
(tmp/'summary.json').write_text(json.dumps(summary,indent=2));print(json.dumps(summary,indent=2))
