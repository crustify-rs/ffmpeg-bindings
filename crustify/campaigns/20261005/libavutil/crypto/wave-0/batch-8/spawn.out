#"'!/bin/bash
set -euo pipefail
ROOT=$1
for variant in asan-ubsan tsan coverage; do
  (
    build=/tmp/crypto-b8/builds/$variant
    mkdir -p "$build"; cd "$build"
    case $variant in
      asan-ubsan) flags=(--toolchain=clang-asan-ubsan --cc=/usr/bin/clang-23);;
      tsan) flags=(--toolchain=clang-tsan --cc=/usr/bin/clang-23);;
      coverage) flags=(--toolchain=gcov --cc=/usr/bin/gcc);;
    esac
    "$ROOT/configure" --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite "${flags[@]}" > /tmp/crypto-b8/logs/configure-$variant.log 2>&1
    make -j8 libavutil/libavutil.so > /tmp/crypto-b8/logs/build-$variant.log 2>&1
    # Untouched link-unit libraries are needed only to link the workspace;
    # the authored FFI calls all target the private libavutil replacement.
    for lib in libswresample libswscale libavcodec libavformat libavfilter libavdevice; do
      mkdir -p "$lib"
      for so in /target/crustify/builds/$variant/$lib/*.so*; do ln -s "$so" "$lib/$(basename "$so")"; done
    done
    echo "$variant ready"
  ) &
done
wait
EOF
