#!/bin/bash
# usage: validate.sh <tag>
TAG=$1; W=/target/crustify/.worktrees/crustify/review-batches/20261005/libavutil/options/wave-2/batch-0/crustify/rust
L=/tmp/rw2b0/logs
( cd $W && CARGO_TARGET_DIR=/tmp/rw2b0/plain cargo test --workspace > $L/plain-$TAG.log 2>&1; echo "exit=$?" >> $L/plain-$TAG.log ) &
( cd $W && CRUSTIFY_FFMPEG_VARIANT=asan-ubsan RUSTFLAGS=-Zsanitizer=address CARGO_TARGET_DIR=/tmp/rw2b0/asan cargo +nightly test -Zbuild-std --target x86_64-unknown-linux-gnu -p ffmpeg --lib --tests --no-fail-fast -- --skip compile_fail > $L/asan-$TAG.log 2>&1; echo "exit=$?" >> $L/asan-$TAG.log ) &
( cd $W && CRUSTIFY_FFMPEG_VARIANT=tsan RUSTFLAGS=-Zsanitizer=thread CARGO_TARGET_DIR=/tmp/rw2b0/tsan cargo +nightly test -Zbuild-std --target x86_64-unknown-linux-gnu -p ffmpeg --lib --tests --no-fail-fast -- --skip compile_fail > $L/tsan-$TAG.log 2>&1; echo "exit=$?" >> $L/tsan-$TAG.log ) &
wait
echo done
#!/bin/bash
# usage: pertest.sh <bsan target dir> <tag>  -- runs every test alone, 40 in parallel
O=$1/bsan/x86_64-unknown-linux-gnu/debug/build/ffmpeg; TAG=$2
D=/tmp/rw2b0/pertest-$TAG; mkdir -p $D
export BSAN_OPTIONS=gc_hang_threshold_ms=600000 CRUSTIFY_FFMPEG_VARIANT=bsan BSAN_SYMBOLIZER=/root/.rustup/toolchains/bsan/bin/llvm-symbolizer
: > $D/jobs
for b in $O/*/out/{ffmpeg,equiv,ub_safe,ub_unsafe}-*; do
  [ -x "$b" ] || continue
  n=$(basename $b | sed 's/-[0-9a-f]*$//')
  $b --list 2>/dev/null | sed -n 's/: test$//p' | grep -v compile_fail | while read t; do echo "$b $n $t"; done >> $D/jobs
done
run() { b=$1; n=$2; t=$3; f=$D/$n/$(echo "$t" | tr ':' '_').log; mkdir -p $D/$n
  s=$(date +%s); cd $WD; timeout 3000 $b --exact "$t" --test-threads=1 > $f 2>&1; echo "exit=$? secs=$(( $(date +%s)-s ))" >> $f; }
export -f run; export D WD=${3:-/tmp/rw2b0/tip}/crustify/rust/ffmpeg
xargs -P 40 -L 1 bash -c 'run "$@"' _ < $D/jobs
echo done
