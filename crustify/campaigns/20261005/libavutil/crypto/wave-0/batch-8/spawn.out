 try:x=json.loads(line)
 except:continue
 if x.get('reason')=='compiler-artifact' and x.get('executable') and x['profile']['test'] and x['target']['name'] in ['ffmpeg','ub_safe','equiv']:
  exes.append(x['executable'])
for exe in exes:
 for target in ['tea::','twofish::']:
