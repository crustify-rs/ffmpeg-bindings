enum hashtype {
#define HASH_TYPE(TYPE, NAME, SIZE) TYPE,
    HASHES(HASH_TYPE)
    NUM_HASHES
};
typedef struct AVHashContext {
    void *ctx;
    enum hashtype type;
    const AVCRC *crctab;
    uint32_t crc;
} AVHashContext;
#define HASH_MAX_SIZE(TYPE, NAME, SIZE) \
    HASH_MAX_SIZE_BEFORE_ ## TYPE,      \
    HASH_MAX_SIZE_UNTIL_ ## TYPE ## _MINUS_ONE = FFMAX(SIZE, HASH_MAX_SIZE_BEFORE_ ## TYPE) - 1,
enum {
    HASHES(HASH_MAX_SIZE)
    MAX_HASH_SIZE
};
static_assert(AV_HASH_MAX_SIZE >= MAX_HASH_SIZE, "AV_HASH_MAX_SIZE needs to be updated!");
#define HASH_MAX_NAME_SIZE(TYPE, NAME, SIZE) \
    HASH_MAX_NAME_SIZE_BEFORE_ ## TYPE,      \
    HASH_MAX_NAME_SIZE_UNTIL_ ## TYPE ## _MINUS_ONE = FFMAX(sizeof(NAME), HASH_MAX_NAME_SIZE_BEFORE_ ## TYPE) - 1,
enum {
    HASHES(HASH_MAX_NAME_SIZE)
    MAX_HASH_NAME_SIZE
};
static const struct {
    const char name[MAX_HASH_NAME_SIZE];
    int size;
} hashdesc[] = {
#define HASH_DESC(TYPE, NAME, SIZE) [TYPE] = { NAME, SIZE },
    HASHES(HASH_DESC)
};
const char *av_hash_names(int i)
{
    if (i < 0 || i >= NUM_HASHES) return NULL;
    return hashdesc[i].name;
}
const char *av_hash_get_name(const AVHashContext *ctx)
{
    return hashdesc[ctx->type].name;
}
int av_hash_get_size(const AVHashContext *ctx)
{
    return hashdesc[ctx->type].size;
}
int av_hash_alloc(AVHashContext **ctx, const char *name)
{
    AVHashContext *res;
    int i;
    *ctx = NULL;
    for (i = 0; i < NUM_HASHES; i++)
        if (av_strcasecmp(name, hashdesc[i].name) == 0)
            break;
    if (i >= NUM_HASHES) return AVERROR(EINVAL);
    res = av_mallocz(sizeof(*res));
    if (!res) return AVERROR(ENOMEM);
    res->type = i;
    switch (i) {
    case MD5:     res->ctx = av_md5_alloc(); break;
    case MURMUR3: res->ctx = av_murmur3_alloc(); break;
    case RIPEMD128:
    case RIPEMD160:
    case RIPEMD256:
    case RIPEMD320: res->ctx = av_ripemd_alloc(); break;
    case SHA160:
    case SHA224:
    case SHA256:  res->ctx = av_sha_alloc(); break;
    case SHA512_224:
    case SHA512_256:
    case SHA384:
    case SHA512:  res->ctx = av_sha512_alloc(); break;
    case CRC32:   res->crctab = av_crc_get_table(AV_CRC_32_IEEE_LE); break;
    case ADLER32: break;
    }
    if (i != ADLER32 && i != CRC32 && !res->ctx) {
        av_free(res);
        return AVERROR(ENOMEM);
    }
    *ctx = res;
    return 0;
}
void av_hash_init(AVHashContext *ctx)
{
    switch (ctx->type) {
    case MD5:     av_md5_init(ctx->ctx); break;
    case MURMUR3: av_murmur3_init(ctx->ctx); break;
    case RIPEMD128: av_ripemd_init(ctx->ctx, 128); break;
    case RIPEMD160: av_ripemd_init(ctx->ctx, 160); break;
    case RIPEMD256: av_ripemd_init(ctx->ctx, 256); break;
    case RIPEMD320: av_ripemd_init(ctx->ctx, 320); break;
    case SHA160:  av_sha_init(ctx->ctx, 160); break;
    case SHA224:  av_sha_init(ctx->ctx, 224); break;
    case SHA256:  av_sha_init(ctx->ctx, 256); break;
    case SHA512_224:  av_sha512_init(ctx->ctx, 224); break;
    case SHA512_256:  av_sha512_init(ctx->ctx, 256); break;
    case SHA384:  av_sha512_init(ctx->ctx, 384); break;
    case SHA512:  av_sha512_init(ctx->ctx, 512); break;
    case CRC32:   ctx->crc = UINT32_MAX; break;
    case ADLER32: ctx->crc = 1; break;
    }
}
void av_hash_update(AVHashContext *ctx, const uint8_t *src, size_t len)
{
    switch (ctx->type) {
    case MD5:     av_md5_update(ctx->ctx, src, len); break;
    case MURMUR3: av_murmur3_update(ctx->ctx, src, len); break;
    case RIPEMD128:
    case RIPEMD160:
    case RIPEMD256:
    case RIPEMD320: av_ripemd_update(ctx->ctx, src, len); break;
    case SHA160:
    case SHA224:
    case SHA256:  av_sha_update(ctx->ctx, src, len); break;
    case SHA512_224:
    case SHA512_256:
    case SHA384:
    case SHA512:  av_sha512_update(ctx->ctx, src, len); break;
    case CRC32:   ctx->crc = av_crc(ctx->crctab, ctx->crc, src, len); break;
    case ADLER32: ctx->crc = av_adler32_update(ctx->crc, src, len); break;
    }
}
void av_hash_final(AVHashContext *ctx, uint8_t *dst)
{
    switch (ctx->type) {
    case MD5:     av_md5_final(ctx->ctx, dst); break;
    case MURMUR3: av_murmur3_final(ctx->ctx, dst); break;
    case RIPEMD128:
    case RIPEMD160:
    case RIPEMD256:
    case RIPEMD320: av_ripemd_final(ctx->ctx, dst); break;
    case SHA160:
    case SHA224:
    case SHA256:  av_sha_final(ctx->ctx, dst); break;
    case SHA512_224:
    case SHA512_256:
    case SHA384:
    case SHA512:  av_sha512_final(ctx->ctx, dst); break;
    case CRC32:   AV_WB32(dst, ctx->crc ^ UINT32_MAX); break;
    case ADLER32: AV_WB32(dst, ctx->crc); break;
    }
}
void av_hash_final_bin(struct AVHashContext *ctx, uint8_t *dst, int size)
{
    uint8_t buf[AV_HASH_MAX_SIZE];
    unsigned rsize = av_hash_get_size(ctx);
    av_hash_final(ctx, buf);
    memcpy(dst, buf, FFMIN(size, rsize));
    if (size > rsize)
        memset(dst + rsize, 0, size - rsize);
}
void av_hash_final_hex(struct AVHashContext *ctx, uint8_t *dst, int size)
{
    uint8_t buf[AV_HASH_MAX_SIZE];
    unsigned rsize = av_hash_get_size(ctx), i;
    av_hash_final(ctx, buf);
    for (i = 0; i < FFMIN(rsize, size / 2); i++)
        snprintf(dst + i * 2, size - i * 2, "%02x", buf[i]);
}
void av_hash_final_b64(struct AVHashContext *ctx, uint8_t *dst, int size)
{
    uint8_t buf[AV_HASH_MAX_SIZE], b64[AV_BASE64_SIZE(AV_HASH_MAX_SIZE)];
    unsigned rsize = av_hash_get_size(ctx), osize;
    av_hash_final(ctx, buf);
    av_base64_encode(b64, sizeof(b64), buf, rsize);
    osize = AV_BASE64_SIZE(rsize);
    memcpy(dst, b64, FFMIN(osize, size));
    if (size < osize)
        dst[size - 1] = 0;
}
void av_hash_freep(AVHashContext **ctx)
{
    if (*ctx)
        av_freep(&(*ctx)->ctx);
    av_freep(ctx);
}
//! Safe wrappers over `libavutil/samplefmt.h`.
//!
//! Audio samples live in planes: one plane holding every channel interleaved
//! for a packed [`SampleFormat`], or one plane per channel for a planar one,
//! all in one buffer and `linesize` bytes apart. [`samples_buffer_size`]
//! computes that layout (`av_samples_get_buffer_size`); [`SampleBuffer`] owns
//! a buffer C allocates in it (`av_samples_alloc`), and
//! [`SampleBufferWithPointers`] also the C array of plane pointers
//! (`av_samples_alloc_array_and_samples`). [`SamplesRef`] and [`SamplesMut`]
//! view an owner's planes, or lay them out over a caller's bytes
//! (`av_samples_fill_arrays`); the exclusive view sets samples to silence
//! (`av_samples_set_silence`) and copies them (`av_samples_copy`).
//!
//! [`SampleFormat`]'s C names and lookups ([`SampleFormat::name`],
//! [`SampleFormat::from_name`], [`SampleFormat::describe`]) and its packed
//! and planar forms ([`SampleFormat::packed`], [`SampleFormat::planar`]) are
//! methods on it.
use core::ffi::{CStr, c_int};
use core::fmt;
use core::mem::MaybeUninit;
use core::ptr;
use ffibox::CPlainElem;
use super::ffi;
use super::mem::HeapVec;
/// Wraps: AVSampleFormat
/// Handwritten
///
/// The format of an audio sample: its native-endian C type (`u8`, `i16`,
/// `i32`, `i64`, `f32` or `f64`) and whether the channels are interleaved in
/// one plane (packed) or each held in a plane of its own (planar, the `P`
/// constants).
///
/// A newtype over the C enum rather than a Rust `enum`: C stores the value in
/// public struct fields its users write directly (`AVCodecContext.sample_fmt`,
/// `AVFrame.format`) and in `NONE`-terminated arrays, so it may hold any
/// `int`, and a Rust view of that memory must accept every one. Match on the
/// associated constants, with a `_` arm for the values C does not name:
///
/// ```
/// use ffmpeg::libavutil::samplefmt::SampleFormat;
/// fn is_float(f: SampleFormat) -> bool {
///     matches!(
///         f,
///         SampleFormat::FLT | SampleFormat::FLTP | SampleFormat::DBL | SampleFormat::DBLP
///     )
/// }
/// assert!(is_float(SampleFormat::FLTP));
/// assert!(!is_float(SampleFormat::NONE));
/// ```
///
/// The default is [`NONE`](Self::NONE), the value C gives an unset format:
/// `av_frame_alloc` writes it (as `-1`) into `AVFrame.format`, and it is the
/// default of `AVCodecContext.sample_fmt`.
///
/// No ffibox primitive covers a C enum: it owns nothing, has no handles, and
/// is `Send + Sync` as the integer it is.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct SampleFormat(ffi::AVSampleFormat);
impl SampleFormat {
    /// No sample format: unknown or unset.
    pub const NONE: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_NONE);
    /// Unsigned 8 bits.
    pub const U8: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_U8);
    /// Signed 16 bits.
    pub const S16: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_S16);
    /// Signed 32 bits.
    pub const S32: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_S32);
    /// `float`.
    pub const FLT: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_FLT);
    /// `double`.
    pub const DBL: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_DBL);
    /// Unsigned 8 bits, planar.
    pub const U8P: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_U8P);
    /// Signed 16 bits, planar.
    pub const S16P: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_S16P);
    /// Signed 32 bits, planar.
    pub const S32P: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_S32P);
    /// `float`, planar.
    pub const FLTP: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_FLTP);
    /// `double`, planar.
    pub const DBLP: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_DBLP);
    /// Signed 64 bits.
    pub const S64: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_S64);
    /// Signed 64 bits, planar.
    pub const S64P: Self = Self(ffi::AVSampleFormat::AV_SAMPLE_FMT_S64P);
    /// The number of sample formats from [`U8`](Self::U8) to
    /// [`S64P`](Self::S64P) these bindings were generated with
    /// (`AV_SAMPLE_FMT_NB`): the length of an array indexed by
    /// [`index`](Self::index).
    ///
    /// A newer libavutil of the same major version may append formats, which
    /// [`index`](Self::index) reports as `None`; this is why C warns against
    /// `AV_SAMPLE_FMT_NB` when linking dynamically.
    pub const COUNT: usize = ffi::AVSampleFormat::AV_SAMPLE_FMT_NB.0 as usize;
    /// The sample format C encodes as `raw`, whatever its value.
    #[inline]
    pub const fn from_raw(raw: ffi::AVSampleFormat) -> Self {
        Self(raw)
    }
    /// The C encoding of this sample format.
    #[inline]
    pub const fn into_raw(self) -> ffi::AVSampleFormat {
        self.0
    }
    /// This sample format's position in `0..COUNT`, or `None` for
    /// [`NONE`](Self::NONE) and any value C does not name.
    #[inline]
    pub const fn index(self) -> Option<usize> {
        let raw = self.0.0;
        if raw >= 0 && (raw as usize) < Self::COUNT {
            Some(raw as usize)
        } else {
            None
        }
    }
    /// The name of the constant this value equals, if any.
    const fn constant_name(self) -> Option<&'static str> {
        Some(match self {
            Self::NONE => "NONE",
            Self::U8 => "U8",
            Self::S16 => "S16",
            Self::S32 => "S32",
            Self::FLT => "FLT",
            Self::DBL => "DBL",
            Self::U8P => "U8P",
            Self::S16P => "S16P",
            Self::S32P => "S32P",
            Self::FLTP => "FLTP",
            Self::DBLP => "DBLP",
            Self::S64 => "S64",
            Self::S64P => "S64P",
            _ => return None,
        })
    }
}
impl Default for SampleFormat {
    #[inline]
    fn default() -> Self {
        Self::NONE
    }
}
impl fmt::Debug for SampleFormat {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self.constant_name() {
            Some(name) => f.write_str(name),
            None => f.debug_tuple("SampleFormat").field(&self.0.0).finish(),
        }
    }
}
impl From<ffi::AVSampleFormat> for SampleFormat {
    #[inline]
    fn from(raw: ffi::AVSampleFormat) -> Self {
        Self::from_raw(raw)
    }
}
impl From<SampleFormat> for ffi::AVSampleFormat {
    #[inline]
    fn from(f: SampleFormat) -> Self {
        f.into_raw()
    }
}
// SAFETY: `SampleFormat` is `#[repr(transparent)]` over `ffi::AVSampleFormat`,
// itself `#[repr(transparent)]` over a `c_int`, so every bit pattern is a
// valid value, and it is a value with no C-side identity: a copy read out of C
//! Safe wrappers over `libavutil/eval.h`.
//!
//! [`parse_number`] reads a number with FFmpeg's SI, binary and `dB`
//! suffixes (`av_strtod`).
//!
//! [`Expr`] is a parsed arithmetic expression (`AVExpr`), opaque outside
//! `eval.c`: a tree of `av_malloc` nodes whose root also owns the
//! expression's `st()`/`ld()` registers and random-number state. It is owned
//! as an [`ExprBox`], built by [`Expr::parse`] (or
//! [`Expr::parse_with_context`], which logs a failure under a parent context)
//! and released with its whole tree by `av_expr_free`. C has no copy routine,
//! so the box is not `Clone`.
//!
//! Parsing reads the constant and function names only during the call: a
//! node records the *position* of the constant it names, and a copy of the
//! function pointer it calls. Evaluation therefore needs one value for each
//! constant position the expression uses, which the expression cannot report
//! (`AVExpr` keeps no count), so a caller that evaluates must keep the
//! constant count it parsed with.
//!
//! [`parse_and_eval`] evaluates an arithmetic expression such as
//! `"1+2^3+5*5+sin(2/3)"` in one step, with named constants and Rust
//! functions the expression may call by name. The evaluator converts some
//! values to integers without a range check, which is undefined behaviour in
//! C for an out-of-range value; the wrapper refuses, before C runs, the
//! expressions that could reach such a conversion (see [`parse_and_eval`]).
//!
//! [`Expression`] is a parsed expression that evaluates safely: it keeps the
//! constant count it was parsed with, which [`Expression::eval`] needs a value
//! for each of, and refuses at parse time what [`parse_and_eval`] refuses. A
//! tree's constants and user-function calls are counted through its handle
//! ([`ExprRef::count_constants`], [`ExprRef::count_functions`]).
//!
//! A raw seam remains where the dependency has no safe handle: the opaque
//! pointer a user function receives from the evaluator.
use core::any::Any;
use core::cell::Cell;
use core::ffi::{CStr, c_char, c_int, c_void};
use core::fmt;
use core::ptr;
use std::panic::{self, AssertUnwindSafe};
use ffibox::{CBox, define_ctype, impl_cdrop};
use super::ffi;
use super::opt::{AVERROR_BUG, ObjectRef};
/// Wraps: av_strtod
///
/// The number at the start of `numstr`, and the rest of `numstr` after it.
///
/// The number is what `strtod` reads (decimal or hexadecimal floats,
/// `inf`, `nan`), or, after `0x` or `0X`, a hexadecimal integer as `strtoul`
/// reads it. A suffix may follow: `dB` turns the value from decibels into a
/// ratio (`10^(d / 20)`); one of the SI prefixes `y z a f p n u m c d h k K M
/// G T P E Z Y` scales it by its power of 10, or of 1024 with an `i` after
/// it (`Ki`, `Mi`, ...); then a `B` multiplies it by 8.
///
/// When nothing parses (an empty string, only whitespace, no number), the
/// value is 0 and the rest is all of `numstr`.
///
/// ```
/// use ffmpeg::libavutil::eval::parse_number;
/// assert_eq!(parse_number(c"1.5KiB, more"), (12288.0, c", more"));
/// assert_eq!(parse_number(c"none"), (0.0, c"none"));
/// ```
pub fn parse_number(numstr: &CStr) -> (f64, &CStr) {
    let start = numstr.as_ptr();
    let mut tail: *mut c_char = ptr::null_mut();
    // SAFETY: `numstr` is a live NUL-terminated string that C only reads (a
    // suffix byte only after a non-NUL one), and `tail` a writable local, in
    // which C stores the address of the first byte of `numstr` it did not
    // consume.
    let value = unsafe { ffi::av_strtod(start, &mut tail) };
    let bytes = numstr.to_bytes_with_nul();
    let parsed = (tail as usize).wrapping_sub(start as usize);
    assert!(parsed < bytes.len(), "av_strtod left the string");
    let rest = CStr::from_bytes_with_nul(&bytes[parsed..]).expect("the suffix keeps the NUL");
    (value, rest)
}
/// `AVERROR(EINVAL)`.
const AVERROR_EINVAL: c_int = -(ffi::EINVAL as c_int);
define_ctype!(
    /// Wraps: AVExpr
    ///
    /// A parsed expression, owned as an [`ExprBox`]. Its layout is private
    /// to `eval.c`, so the handles have no field accessors; C routines read
    /// and evaluate it through a pointer.
    ///
    /// Every handle addresses a tree [`Expr::parse`] built, or one adopted
    /// under the same guarantees: each user function it calls stays callable
    /// for the tree's lifetime and accepts any opaque pointer from any
    /// thread, as the safe `extern "C" fn`s [`Expr::parse`] takes do.
    Expr,
    ExprRef,
    ExprMut,
    ffi::AVExpr
);
// A parsed tree is `av_malloc` nodes plus the root's `var` and `prng_state`
// blocks, all released by `av_expr_free` through `av_free`, which any thread
// may call; `av_expr_parse` hands the whole tree over to its caller and keeps
// no pointer to it. Not `Sync`: evaluation writes the root's registers.
//
// SAFETY: a node holds only scalars, child pointers of the same tree and
// function pointers: libm builtins, or user functions that, per `Expr`'s
// invariant, any thread may call. Nothing in it is tied to a thread, so the
// sole owner, or an exclusive handle, moves between threads as a `Box` of a
// tree does.
unsafe impl Send for Expr {}
// SAFETY: as for `Expr`: an exclusive handle is the only access to the tree
// while it lives.
unsafe impl Send for ExprMut<'_> {}
/// Wraps: av_expr_free
///
/// The release policy of an owned [`Expr`]: `av_expr_free` frees every node
/// of the tree, then the root's registers and random-number state.
///
/// Thread-agnostic: it releases through `av_free`, which any thread may
/// call, so an [`ExprBox`] is `Send`.
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
pub struct ExprFree;
// SAFETY (of the binding): `av_expr_free` releases a tree `av_expr_parse`
// built, recursively and exactly once; it reads only the tree.
impl_cdrop!(ExprFree, Expr, ffi::av_expr_free);
/// An owned parsed expression, released with its whole tree by
/// `av_expr_free`.
///
/// Not `Clone`: C has no routine that copies a tree.
///
/// ```compile_fail,E0599
/// use ffmpeg::libavutil::eval::ExprBox;
/// fn copy(e: &ExprBox) -> ExprBox {
///     e.clone()
/// }
/// ```
///
/// Not `Sync` either: evaluation writes the tree's registers, so two threads
/// never share one.
///
/// ```compile_fail,E0277
/// use ffmpeg::libavutil::eval::ExprBox;
/// fn share(e: &ExprBox) {
///     std::thread::scope(|s| {
///         s.spawn(|| e.as_ref());
///     });
/// }
/// ```
pub type ExprBox = CBox<Expr, ExprFree>;
/// A function of one argument an expression calls by name, as `funcs1` of
/// `av_expr_parse` holds them: it receives the opaque pointer the evaluator
/// is given, then the argument's value.
///
/// Safe, so calling it is sound whatever opaque pointer the evaluator
/// passes; a function that reads through that pointer must check it itself.
/// A panic in it aborts the process, as for any `extern "C" fn`.
pub type UnaryFn = extern "C" fn(*mut c_void, f64) -> f64;
/// A function of two arguments an expression calls by name, as `funcs2` of
/// `av_expr_parse` holds them; otherwise as [`UnaryFn`].
pub type BinaryFn = extern "C" fn(*mut c_void, f64, f64) -> f64;
/// `items` followed by `end`: the NULL-terminated arrays `av_expr_parse`
/// takes, built from Rust slices.
fn terminated<T: Copy>(items: impl Iterator<Item = T>, end: T) -> Vec<T> {
    items.chain(core::iter::once(end)).collect()
}
impl Expr {
    /// Wraps: av_expr_parse
