base=Path('/tmp/crypto-b4')
def ptr(scalar={'by_val':True},array=None,string=False,owned=False,lifetime=None,nullable=False,mutable=False,note=''):
 return dict(scalar=scalar,array=array,string=string,owned=owned,borrowed={'lifetime':lifetime} if lifetime else None,nullable=nullable,mutable=mutable,note=note)
def save(n,x): (base/(n+'.json')).write_text(json.dumps(x,indent=2))
save('AVHMACType',{'_comment_agent':'Resource-free enum. All six integer values select algorithms in av_hmac_alloc; other values return NULL. No storage lifecycle, fields, or retained pointers.'})
save('AVHashContext',{'fields':{'ctx':{'ptr':ptr(owned=True,nullable=True,mutable=True,note='Owned singleton: AVMD5, AVMurMur3, AVRIPEMD, AVSHA, or AVSHA512 selected by type. av_hash_alloc allocates it; av_hash_init/update/final mutate it; av_hash_freep av_freep frees it. NULL for CRC32 and ADLER32; no clone/retain/transfer path.')},'crctab':{'ptr':ptr(scalar=None,array={'by_val':True},lifetime='static',nullable=True,note='CRC32 borrows the immutable 257-element table returned by av_crc_get_table(AV_CRC_32_IEEE_LE); NULL for other algorithms. Never freed.')}},'_comment_agent':'Public API opaque. av_hash_alloc owns context plus child; requires separate av_hash_init before hashing. Safe constructor combines allocation/init, av_hash_freep releases both. Metadata independent of initialization/finalization; name points into static hashdesc. All field touchers are in hash.c; consumers allocate/init/use/free opaque pointers. No clone, refcount, inline dispose, or public field surface; C owns layout/storage. No Send/Sync assertion.'})
save('av_hash_alloc',{'ptr_args':{'0':{'ptr':ptr(scalar={'by_ref':{'owned':True,'borrowed':None}},lifetime='arg:ctx',mutable=True,note='Borrows output slot, writes NULL first, transfers fresh allocated context on success. Frees partial storage on failure. Hashing state requires av_hash_init.')},'1':{'ptr':ptr(scalar=None,string=True,lifetime='arg:name',note='Case-insensitive name read only during call; never retained.')}},'lifetime':None})
save('av_hash_init',{'ptr_args':{'0':{'ptr':ptr(lifetime='arg:ctx',mutable=True,note='Exclusive transient borrow; initializes or resets child hash state or crc. Retains no new pointer.')}},'lifetime':{'for':'ctx','is_dropper':False,'is_disposer':False,'is_cloner':None,'is_constructor':{'alloc':False,'init':True}}})
save('av_hash_freep',{'ptr_args':{'0':{'ptr':ptr(scalar={'by_ref':{'owned':True,'borrowed':None}},owned=True,lifetime='arg:ctx',mutable=True,note='Ownership consumed for inner context and child only; outer caller slot borrowed, not freed, written NULL. Inner context may be NULL; outer slot must not be NULL.')}},'lifetime':{'for':'ctx','is_dropper':True,'is_disposer':False,'is_cloner':None,'is_constructor':None}})
for n in ['av_hash_get_name','av_hash_get_size']:
 x={'ptr_args':{'0':{'ptr':ptr(lifetime='arg:ctx',note='Read-only live context with valid algorithm; no retention.')}},'lifetime':None}
 if n.endswith('name'): x['ptr_ret']={'ptr':ptr(scalar=None,string=True,lifetime='static',note='NUL-terminated immutable static hashdesc name; nonnull for valid context; independent of context lifetime.')}
 save(n,x)
