#include <assert.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include "hash.h"
#include "adler32.h"
#include "crc.h"
#include "md5.h"
#include "murmur3.h"
#include "ripemd.h"
#include "sha.h"
#include "sha512.h"
#include "avstring.h"
#include "base64.h"
#include "error.h"
#include "intreadwrite.h"
#include "mem.h"
// ENTRY(HASH_TYPE, HASH_NAME, HASH_SIZE)
#define HASHES(ENTRY)                   \
    ENTRY(MD5,        "MD5",        16) \
    ENTRY(MURMUR3,    "murmur3",    16) \
    ENTRY(RIPEMD128,  "RIPEMD128",  16) \
    ENTRY(RIPEMD160,  "RIPEMD160",  20) \
    ENTRY(RIPEMD256,  "RIPEMD256",  32) \
    ENTRY(RIPEMD320,  "RIPEMD320",  40) \
    ENTRY(SHA160,     "SHA160",     20) \
    ENTRY(SHA224,     "SHA224",     28) \
    ENTRY(SHA256,     "SHA256",     32) \
    ENTRY(SHA512_224, "SHA512/224", 28) \
    ENTRY(SHA512_256, "SHA512/256", 32) \
    ENTRY(SHA384,     "SHA384",     48) \
    ENTRY(SHA512,     "SHA512",     64) \
    ENTRY(CRC32,      "CRC32",       4) \
    ENTRY(ADLER32,    "adler32",     4) \
enum hashtype {
#define HASH_TYPE(TYPE, NAME, SIZE) TYPE,
    HASHES(HASH_TYPE)
    NUM_HASHES
};
typedef struct AVHashContext {
    void *ctx;
    enum hashtype type;
    const AVCRC *crctab;
    uint32_t crc;
} AVHashContext;
#define HASH_MAX_SIZE(TYPE, NAME, SIZE) \
    HASH_MAX_SIZE_BEFORE_ ## TYPE,      \
    HASH_MAX_SIZE_UNTIL_ ## TYPE ## _MINUS_ONE = FFMAX(SIZE, HASH_MAX_SIZE_BEFORE_ ## TYPE) - 1,
enum {
    HASHES(HASH_MAX_SIZE)
    MAX_HASH_SIZE
};
static_assert(AV_HASH_MAX_SIZE >= MAX_HASH_SIZE, "AV_HASH_MAX_SIZE needs to be updated!");
#define HASH_MAX_NAME_SIZE(TYPE, NAME, SIZE) \
    HASH_MAX_NAME_SIZE_BEFORE_ ## TYPE,      \
    HASH_MAX_NAME_SIZE_UNTIL_ ## TYPE ## _MINUS_ONE = FFMAX(sizeof(NAME), HASH_MAX_NAME_SIZE_BEFORE_ ## TYPE) - 1,
enum {
    HASHES(HASH_MAX_NAME_SIZE)
    MAX_HASH_NAME_SIZE
};
static const struct {
    const char name[MAX_HASH_NAME_SIZE];
    int size;
} hashdesc[] = {
#define HASH_DESC(TYPE, NAME, SIZE) [TYPE] = { NAME, SIZE },
    HASHES(HASH_DESC)
};
const char *av_hash_names(int i)
{
    if (i < 0 || i >= NUM_HASHES) return NULL;
    return hashdesc[i].name;
}
const char *av_hash_get_name(const AVHashContext *ctx)
{
    return hashdesc[ctx->type].name;
}
int av_hash_get_size(const AVHashContext *ctx)
{
    return hashdesc[ctx->type].size;
}
int av_hash_alloc(AVHashContext **ctx, const char *name)
{
    AVHashContext *res;
    int i;
    *ctx = NULL;
    for (i = 0; i < NUM_HASHES; i++)
        if (av_strcasecmp(name, hashdesc[i].name) == 0)
            break;
    if (i >= NUM_HASHES) return AVERROR(EINVAL);
    res = av_mallocz(sizeof(*res));
    if (!res) return AVERROR(ENOMEM);
    res->type = i;
    switch (i) {
    case MD5:     res->ctx = av_md5_alloc(); break;
    case MURMUR3: res->ctx = av_murmur3_alloc(); break;
    case RIPEMD128:
    case RIPEMD160:
    case RIPEMD256:
    case RIPEMD320: res->ctx = av_ripemd_alloc(); break;
    case SHA160:
    case SHA224:
    case SHA256:  res->ctx = av_sha_alloc(); break;
    case SHA512_224:
    case SHA512_256:
    case SHA384:
    case SHA512:  res->ctx = av_sha512_alloc(); break;
    case CRC32:   res->crctab = av_crc_get_table(AV_CRC_32_IEEE_LE); break;
    case ADLER32: break;
    }
    if (i != ADLER32 && i != CRC32 && !res->ctx) {
        av_free(res);
        return AVERROR(ENOMEM);
    }
    *ctx = res;
    return 0;
}
void av_hash_init(AVHashContext *ctx)
{
    switch (ctx->type) {
    case MD5:     av_md5_init(ctx->ctx); break;
    case MURMUR3: av_murmur3_init(ctx->ctx); break;
    case RIPEMD128: av_ripemd_init(ctx->ctx, 128); break;
    case RIPEMD160: av_ripemd_init(ctx->ctx, 160); break;
    case RIPEMD256: av_ripemd_init(ctx->ctx, 256); break;
    case RIPEMD320: av_ripemd_init(ctx->ctx, 320); break;
    case SHA160:  av_sha_init(ctx->ctx, 160); break;
    case SHA224:  av_sha_init(ctx->ctx, 224); break;
    case SHA256:  av_sha_init(ctx->ctx, 256); break;
    case SHA512_224:  av_sha512_init(ctx->ctx, 224); break;
    case SHA512_256:  av_sha512_init(ctx->ctx, 256); break;
    case SHA384:  av_sha512_init(ctx->ctx, 384); break;
    case SHA512:  av_sha512_init(ctx->ctx, 512); break;
    case CRC32:   ctx->crc = UINT32_MAX; break;
    case ADLER32: ctx->crc = 1; break;
    }
}
void av_hash_update(AVHashContext *ctx, const uint8_t *src, size_t len)
{
    switch (ctx->type) {
    case MD5:     av_md5_update(ctx->ctx, src, len); break;
    case MURMUR3: av_murmur3_update(ctx->ctx, src, len); break;
    case RIPEMD128:
    case RIPEMD160:
    case RIPEMD256:
    case RIPEMD320: av_ripemd_update(ctx->ctx, src, len); break;
    case SHA160:
    case SHA224:
    case SHA256:  av_sha_update(ctx->ctx, src, len); break;
    case SHA512_224:
    case SHA512_256:
    case SHA384:
    case SHA512:  av_sha512_update(ctx->ctx, src, len); break;
    case CRC32:   ctx->crc = av_crc(ctx->crctab, ctx->crc, src, len); break;
    case ADLER32: ctx->crc = av_adler32_update(ctx->crc, src, len); break;
    }
}
void av_hash_final(AVHashContext *ctx, uint8_t *dst)
{
    switch (ctx->type) {
    case MD5:     av_md5_final(ctx->ctx, dst); break;
    case MURMUR3: av_murmur3_final(ctx->ctx, dst); break;
    case RIPEMD128:
    case RIPEMD160:
    case RIPEMD256:
    case RIPEMD320: av_ripemd_final(ctx->ctx, dst); break;
    case SHA160:
    case SHA224:
    case SHA256:  av_sha_final(ctx->ctx, dst); break;
    case SHA512_224:
    case SHA512_256:
    case SHA384:
    case SHA512:  av_sha512_final(ctx->ctx, dst); break;
    case CRC32:   AV_WB32(dst, ctx->crc ^ UINT32_MAX); break;
    case ADLER32: AV_WB32(dst, ctx->crc); break;
    }
}
void av_hash_final_bin(struct AVHashContext *ctx, uint8_t *dst, int size)
{
    uint8_t buf[AV_HASH_MAX_SIZE];
    unsigned rsize = av_hash_get_size(ctx);
    av_hash_final(ctx, buf);
    memcpy(dst, buf, FFMIN(size, rsize));
    if (size > rsize)
        memset(dst + rsize, 0, size - rsize);
}
void av_hash_final_hex(struct AVHashContext *ctx, uint8_t *dst, int size)
{
    uint8_t buf[AV_HASH_MAX_SIZE];
    unsigned rsize = av_hash_get_size(ctx), i;
    av_hash_final(ctx, buf);
    for (i = 0; i < FFMIN(rsize, size / 2); i++)
        snprintf(dst + i * 2, size - i * 2, "%02x", buf[i]);
}
void av_hash_final_b64(struct AVHashContext *ctx, uint8_t *dst, int size)
{
    uint8_t buf[AV_HASH_MAX_SIZE], b64[AV_BASE64_SIZE(AV_HASH_MAX_SIZE)];
    unsigned rsize = av_hash_get_size(ctx), osize;
    av_hash_final(ctx, buf);
    av_base64_encode(b64, sizeof(b64), buf, rsize);
    osize = AV_BASE64_SIZE(rsize);
    memcpy(dst, b64, FFMIN(osize, size));
    if (size < osize)
        dst[size - 1] = 0;
}
void av_hash_freep(AVHashContext **ctx)
{
    if (*ctx)
        av_freep(&(*ctx)->ctx);
    av_freep(ctx);
}
[workspace]
resolver = "3"
members = [
    "libavutil-sys",
    "libswresample-sys",
    "libswscale-sys",
    "libavcodec-sys",
    "libavformat-sys",
    "libavfilter-sys",
    "libavdevice-sys",
    "ffmpeg",
]
[workspace.package]
version = "0.1.0"
edition = "2024"
license = "LGPL-2.1-or-later"
publish = false
[workspace.dependencies]
bindgen = { version = "0.73", features = ["experimental"] }
cc = "1.5"
ffibox = { path = "/opt/venv/share/ffibox" }
serde_json = "1"
trybuild = "1"
libavutil-sys = { path = "libavutil-sys" }
libswresample-sys = { path = "libswresample-sys" }
libswscale-sys = { path = "libswscale-sys" }
libavcodec-sys = { path = "libavcodec-sys" }
libavformat-sys = { path = "libavformat-sys" }
libavfilter-sys = { path = "libavfilter-sys" }
libavdevice-sys = { path = "libavdevice-sys" }
[workspace.lints.clippy]
undocumented_unsafe_blocks = "deny"
module_inception = "allow"
[package]
name = "ffmpeg"
description = "Safe Rust wrappers over FFmpeg's public C API"
build = "build.rs"
version.workspace = true
edition.workspace = true
license.workspace = true
publish.workspace = true
[lib]
path = "lib.rs"
[features]
default = ["libavutil", "libswresample", "libswscale", "libavcodec", "libavformat", "libavfilter", "libavdevice"]
libavutil = ["dep:libavutil-sys"]
libswresample = ["dep:libswresample-sys", "libavutil"]
libswscale = ["dep:libswscale-sys", "libavutil"]
libavcodec = ["dep:libavcodec-sys", "libswresample", "libavutil"]
libavformat = ["dep:libavformat-sys", "libavcodec", "libavutil"]
libavfilter = ["dep:libavfilter-sys", "libswscale", "libavformat", "libavcodec", "libswresample", "libavutil"]
libavdevice = ["dep:libavdevice-sys", "libavfilter", "libavformat", "libavcodec", "libavutil"]
[dependencies]
ffibox.workspace = true
libavutil-sys = { workspace = true, optional = true }
libswresample-sys = { workspace = true, optional = true }
libswscale-sys = { workspace = true, optional = true }
libavcodec-sys = { workspace = true, optional = true }
libavformat-sys = { workspace = true, optional = true }
libavfilter-sys = { workspace = true, optional = true }
libavdevice-sys = { workspace = true, optional = true }
[dev-dependencies]
trybuild.workspace = true
[lints]
workspace = true
// Build logic shared by every `*-sys` crate, `include!`d from each crate's build.rs.
//
// The C side is never built here: it links the prebuilt FFmpeg variant named by
// `CRUSTIFY_FFMPEG_VARIANT` (default `plain`) from `crustify/build.json`, or the
// directory in `CRUSTIFY_FFMPEG_BUILD_DIR` for a private build.
//
// Bindings come from `wrapper.h` restricted to the crate's agent-owned
// `allowlist.txt` plus the orchestrator-owned `api-types.txt` (every public type). Items published by the link units in `deps` are blocklisted and
// reached through their crates' re-exports instead, so each C type has one Rust type.
// Allowlisted `static inline` functions get compiled wrappers (bindgen
// `wrap_static_fns`), and `shim.c` holds the `crustify_<NAME>` macro shims.
use std::env;
use std::path::{Path, PathBuf};
fn repo_root() -> PathBuf {
    // crustify/rust/<crate>/ -> repo root
    let manifest = PathBuf::from(env::var("CARGO_MANIFEST_DIR").unwrap());
    manifest.ancestors().nth(3).unwrap().to_path_buf()
}
fn build_dir(root: &Path) -> PathBuf {
    println!("cargo:rerun-if-env-changed=CRUSTIFY_FFMPEG_BUILD_DIR");
    println!("cargo:rerun-if-env-changed=CRUSTIFY_FFMPEG_VARIANT");
    if let Ok(dir) = env::var("CRUSTIFY_FFMPEG_BUILD_DIR") {
        return PathBuf::from(dir);
    }
    let variant = env::var("CRUSTIFY_FFMPEG_VARIANT").unwrap_or_else(|_| "plain".into());
    let build_json = root.join("crustify/build.json");
    println!("cargo:rerun-if-changed={}", build_json.display());
    let spec: serde_json::Value =
        serde_json::from_str(&std::fs::read_to_string(&build_json).expect("crustify/build.json"))
            .expect("valid build.json");
    let dir = spec["variants"][&variant]["dir"]
        .as_str()
        .unwrap_or_else(|| panic!("no variant {variant:?} in crustify/build.json"));
    root.join(dir)
}
/// Parse `allowlist.txt`: `function|type|var|item <regex>` per line, `#` comments.
fn allowlist(path: &Path) -> Vec<(String, String)> {
    println!("cargo:rerun-if-changed={}", path.display());
    std::fs::read_to_string(path)
        .unwrap_or_default()
        .lines()
        .map(|l| l.split('#').next().unwrap().trim())
        .filter(|l| !l.is_empty())
        .map(|l| {
            let (kind, pat) = l.split_once(char::is_whitespace).expect("`<kind> <regex>`");
            (kind.to_string(), pat.trim().to_string())
        })
        .collect()
}
/// Parse `api-types.txt`: one type regex per line, `#` comments.
fn allowlist_types(path: &Path) -> Vec<String> {
    println!("cargo:rerun-if-changed={}", path.display());
    std::fs::read_to_string(path)
        .unwrap_or_default()
        .lines()
        .map(|l| l.split('#').next().unwrap().trim().to_string())
        .filter(|l| !l.is_empty())
        .collect()
}
/// `lib`: link unit (e.g. "libavcodec"); `deps`: link units it links against.
pub fn build(lib: &str, deps: &[&str]) {
    let root = repo_root();
    let build = build_dir(&root);
    let manifest = PathBuf::from(env::var("CARGO_MANIFEST_DIR").unwrap());
    let out = PathBuf::from(env::var("OUT_DIR").unwrap());
    assert!(
        build.join(lib).join(format!("{lib}.so")).exists(),
        "{lib}.so missing under {}: build the variant first (crustify/build.json)",
        build.display()
    );
    let includes = [root.clone(), build.clone(), manifest.clone()];
    let mut b = bindgen::Builder::default()
        .header(manifest.join("wrapper.h").to_str().unwrap())
        .clang_args(includes.iter().map(|i| format!("-I{}", i.display())))
        .allowlist_item("crustify_.*")
        .default_enum_style(bindgen::EnumVariation::NewType { is_bitfield: false, is_global: false })
        .derive_default(true)
        .generate_comments(true)
        .wrap_static_fns(true)
        .wrap_static_fns_path(out.join("static_fns"))
        .parse_callbacks(Box::new(bindgen::CargoCallbacks::new()));
    for (kind, pat) in allowlist(&manifest.join("allowlist.txt")) {
        b = match kind.as_str() {
            "function" => b.allowlist_function(pat),
            "type" => b.allowlist_type(pat),
            "var" => b.allowlist_var(pat),
            "item" => b.allowlist_item(pat),
            k => panic!("allowlist.txt: unknown kind {k:?}"),
        };
    }
    for pat in allowlist_types(&manifest.join("api-types.txt")) {
        b = b.allowlist_type(pat);
    }
    for d in deps {
        // Definitions in the dependency's headers, and forward declarations of its
        // types in ours, both belong to the dependency's crate.
        b = b.blocklist_file(format!(".*/{d}/[^/]*\\.h"));
        for pat in allowlist_types(&manifest.join(format!("../{d}-sys/api-types.txt"))) {
            b = b.blocklist_type(pat);
        }
    }
    // bindgen writes static_fns.c only when the allowlist reaches a static
    // inline function, so drop a previous build's copy rather than compile it.
    let static_fns = out.join("static_fns.c");
    let _ = std::fs::remove_file(&static_fns);
    b.generate()
        .expect("bindgen")
        .write_to_file(out.join("bindings.rs"))
        .expect("write bindings.rs");
    let mut cc = cc::Build::new();
    cc.file(manifest.join("shim.c"))
        .includes(&includes)
        .include(&manifest)
        .warnings(false);
    if static_fns.exists() {
        cc.file(&static_fns);
    }
    cc.compile(&format!("crustify_{lib}_shim"));
    println!("cargo:rerun-if-changed={}", manifest.join("shim.c").display());
    println!("cargo:rerun-if-changed={}", manifest.join("shim.h").display());
    println!("cargo:rerun-if-changed={}", manifest.join("wrapper.h").display());
    let lib_dir = build.join(lib);
    println!("cargo:rustc-link-search=native={}", lib_dir.display());
    println!("cargo:rustc-link-lib=dylib={}", &lib[3..]);
    // DT_RPATH, not DT_RUNPATH: it also resolves the FFmpeg libraries' own NEEDED entries.
    println!("cargo:rustc-link-arg=-Wl,--disable-new-dtags");
    println!("cargo:rustc-link-arg=-Wl,-rpath,{}", lib_dir.display());
    println!("cargo:lib_dir={}", lib_dir.display());
}
