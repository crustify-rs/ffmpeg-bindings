import json,os,subprocess,shutil
from pathlib import Path
out=Path('/tmp/crypto-b4'); root=Path.cwd(); cov=out/'coverage-results';cov.mkdir(exist_ok=True)
art=[]
for line in (out/'coverage-artifacts.jsonl').read_text().splitlines():
 try: d=json.loads(line)
 except: continue
 if d.get('reason')=='compiler-artifact' and d.get('executable') and d.get('profile',{}).get('test'):
  art.append((d['target']['name'],d['executable']))
exes=dict(art)
print(exes)
for n in ['ffmpeg','ub_safe','equiv']:
 for f in ['hash','hmac']:
  env=dict(os.environ,CRUSTIFY_FFMPEG_VARIANT='coverage',GCOV_PREFIX=str(cov/'gcda'),GCOV_PREFIX_STRIP='0',LLVM_PROFILE_FILE=str(cov/f'{n}-{f}-%p.profraw'))
  subprocess.run([exes[n],f if n"'!='"'ffmpeg' else f'libavutil::{f}::unit_tests::'],env=env,check=True,stdout=open(cov/f'{n}-{f}.log','w'),stderr=subprocess.STDOUT)
tc='/root/.rustup/toolchains/nightly-x86_64-unknown-linux-gnu/lib/rustlib/x86_64-unknown-linux-gnu/bin/'
subprocess.run([tc+'llvm-profdata','merge','-sparse','-o',str(cov/'merged.profdata')]+[str(p) for p in cov.glob('*.profraw')],check=True)
objs=[]
for n in ['ffmpeg','ub_safe','equiv']: objs+=['-object',exes[n]]
with (cov/'rust.lcov').open('w') as stdout:subprocess.run([tc+'llvm-cov','export','-format=lcov','-instr-profile',str(cov/'merged.profdata')]+objs,stdout=stdout,check=True)
for tu in ['hash','hmac']:
 work=cov/tu;work.mkdir(exist_ok=True)
 shutil.copy('/target/crustify/builds/coverage/libavutil/'+tu+'.gcno',work/(tu+'.gcno'))
 shutil.copy(cov/'gcda/target/crustify/builds/coverage/libavutil'/ (tu+'.gcda'),work/(tu+'.gcda'))
 p=subprocess.run(['gcov','-b','-c',str(work/(tu+'.gcno'))],cwd=work,text=True,capture_output=True)
 (work/'summary.txt').write_text(p.stdout+p.stderr); print(tu,p.stdout,p.stderr)
# Authored module line coverage and uncovered lines, excluding inline test blocks.
cur=None;lines={}
for l in (cov/'rust.lcov').read_text().splitlines():
 if l.startswith('SF:'):cur=l[3:]
 if l.startswith('DA:') and cur and any(cur.endswith('/libavutil/'+tu+'.rs') for tu in ['hash','hmac']):
  i,c,*_=l[3:].split(',');lines.setdefault(cur,{})[int(i)]=int(c)
for p,ls in lines.items():
 stop=Path(p).read_text().splitlines().index('#[cfg(test)]')+1
 sel={i:c for i,c in ls.items() if i<stop}
 print(p,'covered',sum(c>0 for c in sel.values()),'of',len(sel),'uncovered',[i for i,c in sel.items() if not c])
