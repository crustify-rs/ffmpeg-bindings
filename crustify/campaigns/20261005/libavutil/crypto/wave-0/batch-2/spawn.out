import json, os, subprocess, pathlib, shutil
root=pathlib.Path.cwd(); dest=pathlib.Path('/tmp/crypto-b2/cov-runtime');dest.mkdir(exist_ok=True)
exes={}
for line in pathlib.Path('/tmp/crypto-b2/coverage-build.json').read_text().splitlines():
 try: r=json.loads(line)
 except ValueError: continue
 if r.get('reason')=='compiler-artifact' and r.get('executable') and r['profile']['test'] and r['package_id'].split('#')[-1].startswith('ffmpeg'):
  exes['unit' if r['target']['kind']==['lib'] else r['target']['name']]=r['executable']
# Package ID names depend on Cargo version; use the declared target instead.
if not exes:
 for line in pathlib.Path('/tmp/crypto-b2/coverage-build.json').read_text().splitlines():
  try:r=json.loads(line)
  except ValueError:continue
  if r.get('reason')=='compiler-artifact' and r.get('executable') and r['profile']['test'] and r['target']['name'] in ('ffmpeg','ub_safe','equiv'):
   exes['unit' if r['target']['name']=='ffmpeg' else r['target']['name']]=r['executable']
print(exes)
env=dict(os.environ,LLVM_PROFILE_FILE=str(dest/'rust-%p-%m.profraw'),GCOV_PREFIX=str(dest/'gcda'),GCOV_PREFIX_STRIP='0')
for suite,filters in [('unit',['libavutil::cast5::','libavutil::crc::']),('ub_safe',['cast5::','crc::']),('equiv',['cast5::','crc::'])]:
 for filt in filters:
  r=subprocess.run([exes[suite],filt],cwd=root/'crustify/rust/ffmpeg',env=env,text=True,capture_output=True)
  (dest/f'{suite}-{filt.replace(\":\",\"\")}.log').write_text(r.stdout+r.stderr)
  print(suite,filt,r.returncode)
  r.check_returncode()
tc=pathlib.Path('/root/.rustup/toolchains/nightly-x86_64-unknown-linux-gnu/lib/rustlib/x86_64-unknown-linux-gnu/bin')
subprocess.run([str(tc/'llvm-profdata'),'merge','-sparse','-o',str(dest/'rust.profdata'),*map(str,dest.glob('*.profraw'))],check=True)
objects=[]
for exe in exes.values(): objects.extend(['-object',exe])
files=[str(root/'crustify/rust/ffmpeg/libavutil'/f) for f in ('cast5.rs','crc.rs')]
r=subprocess.run([str(tc/'llvm-cov'),'report','-instr-profile',str(dest/'rust.profdata'),*objects[1:],*files],text=True,capture_output=True,check=True)
(dest/'rust-report.txt').write_text(r.stdout+r.stderr);print(r.stdout)
r=subprocess.run([str(tc/'llvm-cov'),'show','-instr-profile',str(dest/'rust.profdata'),*objects[1:],*files],text=True,capture_output=True,check=True)
(dest/'rust-lines.txt').write_text(r.stdout)
gdir=dest/'gcov';gdir.mkdir(exist_ok=True)
for tu in ('cast5','crc'):
 gcno=pathlib.Path('/target/crustify/builds/coverage/libavutil')/f'{tu}.gcno'
 shutil.copy(gcno,gdir/gcno.name)
 gcda=list((dest/'gcda').rglob(f'{tu}.gcda'))
 if gcda:shutil.copy(gcda[0],gdir/gcda[0].name)
 r=subprocess.run(['gcov','-b','-c',str(gdir/f'{tu}.gcno')],cwd=gdir,text=True,capture_output=True,check=True)
 (dest/f'c-{tu}-report.txt').write_text(r.stdout+r.stderr);print(r.stdout)
