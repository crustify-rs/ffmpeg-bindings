import os, subprocess, json, pathlib, concurrent.futures
root=pathlib.Path.cwd();base=pathlib.Path('/tmp/crypto-b2')
common=['--manifest-path',str(root/'crustify/rust/Cargo.toml')]
def run(name,commands,env):
 codes=[]
 with (base/f'{name}-land.log').open('w') as f:
  for command in commands:
   f.write('"'$ '"'+' '.join(command)+'\\n');f.flush()
   r=subprocess.run(command,cwd=root/'crustify/rust',env=dict(os.environ,**env),stdout=f,stderr=subprocess.STDOUT)
   codes.append(r.returncode)
   if r.returncode:break
 print(name,codes,flush=True)
 return name,codes
jobs=[('plain',[['cargo','check','--workspace',*common],['cargo','clippy','--workspace','--all-targets',*common],['cargo','test','--workspace',*common]],dict(CARGO_TARGET_DIR=str(base/'plain')))]
for name,variant,sanitizer in [('asan','asan-ubsan','address'),('tsan','tsan','thread')]:
 commands=[['cargo','+nightly','test','-Zbuild-std','--target','x86_64-unknown-linux-gnu',*common,'-p','ffmpeg','--lib','--tests',f,'--','--skip','compile_fail'] for f in ['cast5','crc']]
 jobs.append((name,commands,dict(CARGO_TARGET_DIR=str(base/name),CRUSTIFY_FFMPEG_VARIANT=variant,RUSTFLAGS=f'-Zsanitizer={sanitizer}')))
with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
 results=dict(pool.map(lambda job:run(*job),jobs))
(base/'validation-status.json').write_text(json.dumps(results,indent=2)+'\\n')
if any(any(codes) for codes in results.values()):raise SystemExit(1)
PY
