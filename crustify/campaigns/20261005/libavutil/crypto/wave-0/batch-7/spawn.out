from pathlib import Path
import json
base={'scalar':{'by_val':True},'array':None,'string':False,'owned':False,'borrowed':{'lifetime':'static'},'nullable':True,'mutable':False,'note':'Zero-filled allocation has NULL before init. Successful init stores sha1_transform or sha256_transform, static functions with no ownership or freeing; update invokes it on context state (5 or 8 u32 words) and a 64-byte read-only block. Not public; callers cannot set or invoke it independently.'}
Path('/tmp/crypto-batch7/AVSHA.json').write_text(json.dumps({'fields':{'transform':{'ptr':base}},'_comment_agent':'Public forward declaration only. C owns concrete layout/allocation. av_sha_alloc is av_mallocz(sizeof AVSHA); successful av_sha_init (160/224/256) establishes transform and resets count; reinit may change algorithm and leaves stale buffer bytes unread until filled. Hash/HMAC/Mov owners free through av_free/av_freep; random_seed uses adequately sized aligned inline scratch and init. No refcount, heap fields, retained input, clone, or field disposer. Safe wrapper exposes full-sized allocated initialized owners and borrowed handles; no public field access.'}))
Path('/tmp/crypto-batch7/AVSHA512.json').write_text(json.dumps({'_comment_agent':'Public forward declaration only; all fields are by-value integers/arrays private to sha512.c. av_sha512_alloc calls av_mallocz(sizeof AVSHA512), successful init (224/256/384/512) sets state/digest_len and count=0. C hash/HMAC owners release through av_freep; no refcount, heap fields, retained input, clone or field disposer. Reinit leaves stale buffer bytes which update overwrites before reading. Safe wrapper only uses full-sized initialized C allocations behind ffibox handles.'}))
for tu in ['sha','sha512']:
 alloc=base|{'borrowed':None,'owned':True,'mutable':True,'note':'Fresh unique av_mallocz allocation of the full private struct, NULL on OOM. Zero-fill alone is not an initialized hash context; init must succeed before hashing. Single object released through av_free; no owned fields.'}
 init=base|{'borrowed':{'lifetime':'call'},'nullable':False,'mutable':True,'note':'Exclusive borrowed full-sized context/storage; never retained or released. Resets count, state and digest_len for supported bits; AVSHA also sets static transform. Invalid bits return EINVAL after partially changing digest_len, so the Rust enum excludes them.'}
 for op,ptr,lfor,allocflag,initflag in [('alloc',alloc,'return',True,False),('init',init,'ctx',False,True)]:
  data={'lifetime':{'for':lfor,'is_dropper':False,'is_disposer':False,'is_cloner':None,'is_constructor':{'alloc':allocflag,'init':initflag}}}
  data.update({'ptr_ret':{'ptr':ptr}} if op=='alloc' else {'ptr_args':{'0':{'ptr':ptr}}})
  Path(f'/tmp/crypto-batch7/av_{tu}_{op}.json').write_text(json.dumps(data))
