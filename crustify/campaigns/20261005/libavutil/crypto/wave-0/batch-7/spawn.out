/// fundamental C type, so at least that of `double`, `long long` and a pointer.
const REALLOC_ALIGN: usize = {
    let (d, ll, p) = (
        align_of::<c_double>(),
        align_of::<c_longlong>(),
        align_of::<*const u8>(),
