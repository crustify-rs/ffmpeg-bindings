   cur=p.name;summary[cur]={'covered':0,'total':0,'uncovered':[]}
 elif cur and line.startswith('DA:'):
  ln,c=map(int,line[3:].split(',')[:2])
  if ln<stop:
   summary[cur]['total']+=1;summary[cur]['covered']+=c>0
