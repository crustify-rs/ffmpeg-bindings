for tu,typ in [('sha','Sha'),('sha512','Sha512')]:
 p=Path(f'crustify/rust/ffmpeg/libavutil/{tu}.rs')
 s=p.read_text().replace('.map(|owner| owner.into_raw())','.and_then(|owner| NonNull::new(owner.into_raw()))')
 p.write_text(s)
 variants=['Sha1','Sha224','Sha256'] if tu=='sha' else ['Sha512_224','Sha512_256','Sha384','Sha512']
 default=variants[-1]
 tests=f'''//"'! Safe lifecycle exercises: no raw or unsafe FFI fixtures.
use ffmpeg::libavutil::{tu}::{{Algorithm, {typ}, {typ}Box}};
const ALGORITHMS: [Algorithm; {len(variants)}] = [{'"', '.join('Algorithm::'+v for v in variants)}];
#[test]
fn owners_and_reborrows() {{
    for algorithm in ALGORITHMS {{
        for _ in 0..32 {{
            let mut owner = {typ}::new(algorithm).unwrap();
            let shared = owner.as_ref();
            let copied = shared;
            assert_eq"'!(format!("{{shared:?}}"), format!("{{copied:?}}"));
            let mut exclusive = owner.as_mut();
            for next in ALGORITHMS {{
                exclusive.as_mut().init(next);
                let shared = exclusive.as_ref();
                assert!(!format!("{{shared:?}}").is_empty());
            }}
        }}
    }}
    let mut owner = {typ}Box::new().unwrap();
    owner.as_mut().init(Algorithm::{default});
}}
#[test]
fn allocation_failure() {{
    // The allocator limit is global. Isolate the failure in a child process,
    // so other tests'"' live contexts and allocations are unaffected.
    const CHILD: &str = \"CRUSTIFY_BATCH7_{tu.upper()}_OOM\";
    if std::env::var_os(CHILD).is_some() {{
        ffmpeg::libavutil::mem::set_max_alloc(0);
        assert"'!({typ}::new(Algorithm::{default}).is_none());
        assert!({typ}Box::new().is_none());
    }} else {{
        let status = std::process::Command::new(std::env::current_exe().unwrap())
            .env(CHILD, "1")
            .args(["--exact", "{tu}::allocation_failure"])
            .status().unwrap();
        assert!(status.success());
    }}
}}
'"'''
 Path(f'crustify/rust/ffmpeg/tests/ub_safe/{tu}.rs').write_text(tests)
 for suite in ['ub_safe','equiv']:
  p=Path(f'crustify/rust/ffmpeg/tests/{suite}/main.rs')
  s=p.read_text().replace('mod samplefmt;','mod samplefmt;\\nmod sha;\\nmod sha512;')
  p.write_text(s)
