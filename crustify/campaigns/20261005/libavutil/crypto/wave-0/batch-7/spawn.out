cmd=[tc+'llvm-cov','export','-format=lcov','-instr-profile',str(out/'m.profdata'),exes['ffmpeg']]
for name in ['ub_safe','equiv']:cmd+=['-object',exes[name]]
lcov=subprocess.check_output(cmd,text=True)
(out/'rust.lcov').write_text(lcov)
summary={};cur=None
for line in lcov.splitlines():
 if line.startswith('SF:'):
  p=Path(line[3:]);cur=None
  if p.name in ['sha.rs','sha512.rs'] and p.parent.name=='libavutil':
