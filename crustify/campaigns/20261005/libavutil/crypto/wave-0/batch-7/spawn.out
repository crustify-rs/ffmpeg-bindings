#!/bin/bash
# usage: bsan_gate2.sh <tree> <tag> <skiplist> -- per-binary BSan runs with exact skips, in parallel
T=$1; TAG=$2; SKIP=$3
cd $T/crustify/rust || exit 2
export BSAN_OPTIONS=gc_hang_threshold_ms=600000 CRUSTIFY_FFMPEG_VARIANT=bsan CARGO_TARGET_DIR=/tmp/rw2b0/bsan-$TAG
cargo bsan test -p ffmpeg --lib --tests --no-run > /tmp/rw2b0/logs/bsan-$TAG-build.log 2>&1 || { echo build failed; exit 3; }
pids=()
for spec in "ffmpeg --lib" "equiv --test equiv" "ub_safe --test ub_safe" "ub_unsafe --test ub_unsafe"; do
  set -- $spec; n=$1; shift
  skips=$(awk -v n=$n '$1==n {printf " --skip %s", $2}' $SKIP)
  ( s=$(date +%s); timeout 7000 cargo bsan test -p ffmpeg "$@" -- --skip compile_fail --exact $skips > /tmp/rw2b0/logs/bsan-$TAG-$n.log 2>&1; echo "exit=$? secs=$(( $(date +%s)-s ))" >> /tmp/rw2b0/logs/bsan-$TAG-$n.log ) &
  pids+=($!)
done
wait "${pids[@]}"
echo done
