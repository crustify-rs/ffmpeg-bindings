import hashlib
for tu,typ,variants in [('sha','Sha',[('Sha1',160,'sha1'),('Sha224',224,'sha224'),('Sha256',256,'sha256')]),('sha512','Sha512',[('Sha512_224',224,'sha512_224'),('Sha512_256',256,'sha512_256'),('Sha384',384,'sha384'),('Sha512',512,'sha512')])]:
