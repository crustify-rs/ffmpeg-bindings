use core::ptr::{addr_of, addr_of_mut};
use ffmpeg::libavutil::{des::Des, ffi};
struct Reference(*mut ffi::AVDES);
impl Reference {
    fn new() -> Self {
        // SAFETY: the allocator takes no arguments and returns a fresh zeroed
        // context. This test fixture releases its allocation exactly once.
        let ptr = unsafe { ffi::av_des_alloc() };
        assert!(!ptr.is_null());
        Self(ptr)
    }
    fn fields(&self) -> (i32, [[u64; 16]; 3]) {
        // SAFETY: this fixture owns a live, fully initialized context; it is
        // not mutated during these raw field projections, which form no references.
        unsafe {
            (
                addr_of!((*self.0).triple_des).read(),
                addr_of!((*self.0).round_keys).read(),
            )
        }
    }
}
impl Drop for Reference {
    fn drop(&mut self) {
        // SAFETY: the fixture uniquely owns this av_des_alloc allocation,
        // which has no owned fields and is released by av_free.
        unsafe { ffi::av_free(self.0.cast()) }
    }
}
#[repr(align(8))]
struct Blocks([u8; 16]);
#[test]
fn lifecycle_fields_and_multicall_state_agree() {
    let raw = Reference::new();
    let mut safe = Des::new_boxed(&[0; 8], false).unwrap();
    for (key, decrypt) in [
        (vec![0; 8], false),
        (vec![0xA5; 24], true),
        ((0..8).collect(), true),
        (vec![0xFF; 24], false),
    ] {
        safe.as_mut().init(&key, decrypt).unwrap();
        let inline = Des::new(&key, decrypt).unwrap();
        // SAFETY: raw owns a live context and key contains the exact 8 or 24
        // readable bytes promised by key_bits; C retains no key pointer.
        let ret = unsafe {
            ffi::av_des_init(
                raw.0,
                key.as_ptr(),
                (key.len() * 8) as i32,
                i32::from(decrypt),
            )
        };
        assert_eq!(ret, 0);
        let (flag, keys) = raw.fields();
        assert_eq!(safe.as_ref().triple_des(), flag);
        assert_eq!(safe.as_ref().round_keys(), keys);
        assert_eq!(inline.as_ref().triple_des(), flag);
        assert_eq!(inline.as_ref().round_keys()[0], keys[0]);
        if key.len() == 24 {
            assert_eq!(inline.as_ref().round_keys(), keys);
        } else {
            assert_eq!(inline.as_ref().round_keys()[1..], [[0; 16]; 2]);
        }
        let input = Blocks(*b"0123456789abcdef");
        let mut output_raw = Blocks([0; 16]);
        let mut output_safe = Blocks([0; 16]);
        for decrypt in [false, true, false] {
            // C crypt is an unwrapped observer of this type run's initialized
            // context. Both contexts are independently owned and keyed above.
            // SAFETY: both pointers are live contexts, buffers are aligned to
            // 8 bytes and hold two blocks, input/output do not alias, and C
            // retains no pointer. No Rust context handle is live during the calls.
            unsafe {
                ffi::av_des_crypt(
                    raw.0,
                    output_raw.0.as_mut_ptr(),
                    input.0.as_ptr(),
                    2,
                    core::ptr::null_mut(),
                    i32::from(decrypt),
                );
                ffi::av_des_crypt(
                    safe.as_c_ptr(),
                    output_safe.0.as_mut_ptr(),
                    input.0.as_ptr(),
                    2,
                    core::ptr::null_mut(),
                    i32::from(decrypt),
                );
            }
            assert_eq!(output_safe.0, output_raw.0);
        }
    }
    for flag in [i32::MIN, -1, 0, 1, i32::MAX] {
        let keys = [[flag as u64; 16]; 3];
        safe.as_mut().set_triple_des(flag);
        safe.as_mut().set_round_keys(keys);
        // SAFETY: the fixture owns the entire initialized context exclusively;
        // integers accept these values and the projections create no references.
        unsafe {
            addr_of_mut!((*raw.0).triple_des).write(flag);
            addr_of_mut!((*raw.0).round_keys).write(keys);
        }
        assert_eq!(safe.as_ref().triple_des(), raw.fields().0);
        assert_eq!(safe.as_ref().round_keys(), raw.fields().1);
    }
    let before = raw.fields();
    assert_eq!(safe.as_mut().init(&[0; 7], false), Err(-22));
    // SAFETY: raw is a live context. C rejects the invalid bit count before
    // inspecting the key pointer or changing any state.
    let result = unsafe { ffi::av_des_init(raw.0, core::ptr::null(), 56, 0) };
    assert_eq!(result, -22);
    assert_eq!(raw.fields(), before);
    assert_eq!(safe.as_ref().round_keys(), before.1);
    assert_eq!(safe.as_ref().triple_des(), before.0);
}
#[test]
fn copies_and_clones_track_c_struct_copies() {
    let key: Vec<u8> = (0..24).map(|i| (i * 29 + 3) as u8).collect();
    let raw = Reference::new();
    // SAFETY: raw owns a live context; the key has the 24 bytes C reads for
    // 192 bits, and C retains no pointer to it.
    let ret = unsafe { ffi::av_des_init(raw.0, key.as_ptr(), 192, 0) };
    assert_eq!(ret, 0);
    let raw_copy = Reference::new();
    // SAFETY: two distinct live AVDES allocations; C code copies the struct
    // by assignment, which this byte copy of its whole size mirrors.
    unsafe { core::ptr::copy_nonoverlapping(raw.0, raw_copy.0, 1) };
    let original = Des::new_boxed(&key, false).unwrap();
    let mut boxed = original.clone();
    let mut inline = Des::new(&key, false).unwrap();
    let inline_copy = inline;
    // Diverge the originals: neither the clone nor any copy may follow.
    drop(original);
    inline.as_mut().init(&[0x11; 8], false).unwrap();
    // SAFETY: raw is live; the 8-byte key matches 64 bits and is not retained.
    let ret = unsafe { ffi::av_des_init(raw.0, [0x11; 8].as_ptr(), 64, 0) };
    assert_eq!(ret, 0);
    let crypt = |ctx: *mut ffi::AVDES, decrypt: i32| {
        let input = Blocks(*b"fedcba9876543210");
        let mut output = Blocks([0; 16]);
        // SAFETY: ctx is a live keyed context; both buffers are 8-byte aligned
        // two-block arrays that do not alias, ECB uses no IV, nothing is retained.
        unsafe {
            ffi::av_des_crypt(
                ctx,
                output.0.as_mut_ptr(),
                input.0.as_ptr(),
                2,
                core::ptr::null_mut(),
                decrypt,
            )
        };
        output.0
    };
    for decrypt in [0, 1] {
        let expected = crypt(raw_copy.0, decrypt);
        assert_eq!(crypt(boxed.as_c_ptr(), decrypt), expected);
    }
    assert_eq!(boxed.as_ref().round_keys(), raw_copy.fields().1);
    assert_eq!(inline_copy.as_ref().round_keys(), raw_copy.fields().1);
    assert_eq!(inline_copy.as_ref().triple_des(), raw_copy.fields().0);
    assert_eq!(inline.as_ref().round_keys()[0], raw.fields().1[0]);
    boxed.as_mut().set_triple_des(0);
    assert_eq!(inline_copy.as_ref().triple_des(), 1);
}
//! The safe constructor/reset and metadata agree with independently owned C
//! inputs. Raw update/final calls observe initialization, not a safe hashing
//! API (those symbols belong to a later batch).
use core::ffi::CStr;
use core::ptr;
use ffmpeg::libavutil::{ffi, hash::HashContext};
struct Reference(*mut ffi::AVHashContext);
impl Reference {
    fn new(name: &CStr) -> Self {
        let mut context = ptr::null_mut();
        // SAFETY: valid output slot and name; C transfers the allocation.
        let result = unsafe { ffi::av_hash_alloc(&mut context, name.as_ptr()) };
        assert_eq!(result, 0);
        assert!(!context.is_null());
        // SAFETY: the fresh allocation has valid algorithm storage; initialize
        // its hashing state before any observation.
        unsafe { ffi::av_hash_init(context) };
        Self(context)
    }
}
impl Drop for Reference {
    fn drop(&mut self) {
        // SAFETY: this fixture uniquely owns the context and its children.
        unsafe { ffi::av_hash_freep(&mut self.0) };
        assert!(self.0.is_null());
    }
}
#[test]
fn allocation_initialization_metadata_and_reset_match() {
    for name in [
        c"MD5",
        c"murmur3",
        c"RIPEMD128",
        c"RIPEMD160",
        c"RIPEMD256",
        c"RIPEMD320",
        c"SHA160",
        c"SHA224",
        c"sHa256",
        c"SHA512/224",
        c"SHA512/256",
        c"SHA384",
        c"SHA512",
        c"CRC32",
        c"adler32",
    ] {
        let mut safe = HashContext::new(name).unwrap();
        let reference = Reference::new(name);
        // SAFETY: reference is live and C returns an immutable static string.
        let expected_name = unsafe { CStr::from_ptr(ffi::av_hash_get_name(reference.0)) };
        // SAFETY: reference's algorithm is valid and the operation only reads.
        let size = unsafe { ffi::av_hash_get_size(reference.0) } as usize;
        assert_eq!(safe.as_ref().name(), expected_name);
        assert_eq!(safe.as_ref().size(), size);
        for bytes in [b"".as_slice(), b"abc", &[0; 257][..]] {
            let mut actual = vec![0; size];
            let mut expected = vec![0; size];
            // SAFETY: both contexts are independent, initialized sole-owned
            // allocations with no outstanding handles. Input is read only for
            // its length and not retained. Each output has the digest's size.
            // Each context is finalized once and reset before its next use.
            unsafe {
                ffi::av_hash_update(safe.as_c_ptr(), bytes.as_ptr(), bytes.len());
                ffi::av_hash_update(reference.0, bytes.as_ptr(), bytes.len());
                ffi::av_hash_final(safe.as_c_ptr(), actual.as_mut_ptr());
                ffi::av_hash_final(reference.0, expected.as_mut_ptr());
            }
            assert_eq!(actual, expected, "{name:?}");
            safe.as_mut().as_mut().init();
            // SAFETY: uniquely owned valid context, reset after finalization.
            unsafe { ffi::av_hash_init(reference.0) };
            assert_eq!(safe.as_mut().as_ref().name(), expected_name);
            assert_eq!(safe.as_ref().size(), size);
        }
    }
}
#[test]
fn failed_allocations_match_and_clear_the_output() {
    for name in [c"", c"unknown", c"SHA999", c"\xff"] {
        let mut context = ptr::null_mut();
        // SAFETY: writable output slot, live NUL-terminated name; C clears
        // the slot and allocates nothing for these unsupported names.
        let expected = unsafe { ffi::av_hash_alloc(&mut context, name.as_ptr()) };
        assert!(context.is_null());
        assert_eq!(HashContext::new(name).err(), Some(expected));
    }
}
use ffmpeg::libavutil::hash;
#[test]
fn batch10_registry_indices_match_c() {
    for i in [i32::MIN, -1].into_iter().chain(0..64).chain([i32::MAX]) {
        // SAFETY: C checks every integer index and returns null or a static
        // immutable NUL-terminated string which is never freed.
        let ptr = unsafe { ffi::av_hash_names(i) };
        let raw = if ptr.is_null() {
            None
        } else {
            // SAFETY: non-null hashdesc names are immutable NUL-terminated statics.
            Some(unsafe { std::ffi::CStr::from_ptr(ptr) })
        };
        assert_eq!(hash::name(i), raw);
    }
}
#[test]
fn allocation_failures_match_c() {
    // The av_max_alloc limit is process-global: run in an isolated child.
    const ISOLATED: &str = "CRUSTIFY_HASH_ALLOC_LIMIT_CHILD";
    if std::env::var_os(ISOLATED).is_none() {
        let status = std::process::Command::new(std::env::current_exe().unwrap())
            .args([
                "--exact",
                "hash::allocation_failures_match_c",
                "--test-threads=1",
            ])
            .env(ISOLATED, "1")
            .status()
            .unwrap();
        assert!(status.success());
        return;
    }
    let names = [
        c"MD5",
        c"murmur3",
        c"RIPEMD320",
        c"SHA256",
        c"SHA512",
        c"CRC32",
        c"adler32",
    ];
    // A limit at which the parent context fits (adler32, which has no child,
    // succeeds) while another algorithm fails reaches av_hash_alloc's
    // partial-failure path: the child allocation fails and C frees the parent.
    let mut child_failures = 0;
    for limit in [0, 1, 8, 16, 24, 32, 48, 64, 96, 128, 192, 256, 512, 4096] {
        ffmpeg::libavutil::mem::set_max_alloc(limit);
        let mut failures = 0;
        let mut parent_fits = false;
        for name in names {
            let mut context = ptr::null_mut();
            // SAFETY: valid output slot and NUL-terminated name; on success C
            // transfers an allocation this test frees below.
            let expected = unsafe { ffi::av_hash_alloc(&mut context, name.as_ptr()) };
            let actual = HashContext::new(name);
            if expected < 0 {
                assert!(context.is_null());
                assert_eq!(actual.err(), Some(expected), "{name:?} at {limit}");
                failures += 1;
            } else {
                assert!(!context.is_null());
                assert_eq!(actual.unwrap().as_ref().name(), name_of(context));
                parent_fits |= name == c"adler32";
                // SAFETY: this test owns the fresh context and frees it once.
                unsafe { ffi::av_hash_freep(&mut context) };
            }
        }
        if parent_fits {
            child_failures += failures;
        }
    }
    ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
    assert!(
        child_failures > 0,
        "no limit separated parent and child sizes"
    );
}
fn name_of(context: *const ffi::AVHashContext) -> &'static CStr {
    // SAFETY: context is a live allocated context with a valid algorithm; C
    // returns a NUL-terminated name in static storage.
    unsafe { CStr::from_ptr(ffi::av_hash_get_name(context)) }
}
//! C allocation observes the enum's ABI values, including invalid encodings.
use ffmpeg::libavutil::{ffi, hmac::HmacType};
fn c_accepts(algorithm: ffi::AVHMACType) -> bool {
    // SAFETY: C accepts all enum integers and returns NULL for unknown ones.
    // A successful allocation is uniquely owned, and even an uninitialized
    // hashing state is valid for av_hmac_free. No pointer escapes this helper.
    unsafe {
        let context = ffi::av_hmac_alloc(algorithm);
        let success = !context.is_null();
        ffi::av_hmac_free(context);
        success
    }
}
#[test]
fn algorithm_values_match_c_consumption() {
    for (safe, raw) in [
        (HmacType::MD5, ffi::AVHMACType::AV_HMAC_MD5),
        (HmacType::SHA1, ffi::AVHMACType::AV_HMAC_SHA1),
        (HmacType::SHA224, ffi::AVHMACType::AV_HMAC_SHA224),
        (HmacType::SHA256, ffi::AVHMACType::AV_HMAC_SHA256),
        (HmacType::SHA384, ffi::AVHMACType::AV_HMAC_SHA384),
        (HmacType::SHA512, ffi::AVHMACType::AV_HMAC_SHA512),
    ] {
        assert_eq!(safe.into_raw(), raw);
        assert_eq!(c_accepts(safe.into_raw()), c_accepts(raw));
        assert!(c_accepts(safe.into_raw()));
    }
    for value in [6, 100, u32::MAX, 1 << 31] {
        let raw = ffi::AVHMACType(value);
        let safe = HmacType::from_raw(raw);
        assert_eq!(c_accepts(safe.into_raw()), c_accepts(raw));
        assert!(!c_accepts(safe.into_raw()));
    }
}
use ffmpeg::libavutil::hmac::Hmac;
struct Reference(*mut ffi::AVHMAC);
impl Reference {
    fn new(algorithm: ffi::AVHMACType) -> Self {
        // SAFETY: C validates algorithm and allocates a fresh context, owned
        // by this fixture and released through the paired av_hmac_free.
        let ptr = unsafe { ffi::av_hmac_alloc(algorithm) };
        assert!(!ptr.is_null());
        Self(ptr)
    }
}
impl Drop for Reference {
    fn drop(&mut self) {
        // SAFETY: the fixture owns this context and its private hash uniquely;
        // av_hmac_free releases both exactly once.
        unsafe { ffi::av_hmac_free(self.0) }
    }
}
#[test]
fn keyed_construction_and_reinitialization_agree() {
    for (algorithm, digest_len) in [
        (HmacType::MD5, 16),
        (HmacType::SHA1, 20),
        (HmacType::SHA224, 28),
        (HmacType::SHA256, 32),
        (HmacType::SHA384, 48),
        (HmacType::SHA512, 64),
    ] {
        let raw = Reference::new(algorithm.into_raw());
        let mut safe = Hmac::new(algorithm, b"").unwrap();
        for len in [0, 1, 63, 64, 65, 127, 128, 129, 1024] {
            let key = vec![0xA5; len];
            safe.as_mut().init(&key).unwrap();
            let empty = 0u8;
            let source = if key.is_empty() {
                &raw const empty
            } else {
                key.as_ptr()
            };
            // SAFETY: raw is a live context with valid callbacks/hash, and
            // source supplies exactly len readable bytes; C copies or hashes
            // them immediately and retains no input pointer.
            unsafe { ffi::av_hmac_init(raw.0, source, len as u32) };
            drop(key);
            // The non-lifecycle symbols are unwrapped C observers of the
            // initialization state. No context handles live across a call.
            for chunk in [b"first".as_slice(), b"", b"second chunk"] {
                let empty = 0u8;
                let source = if chunk.is_empty() {
                    &raw const empty
                } else {
                    chunk.as_ptr()
                };
                // SAFETY: both independent contexts are keyed; source is
                // readable for chunk.len() bytes, and update keeps no pointer.
                unsafe {
                    ffi::av_hmac_update(raw.0, source, chunk.len() as u32);
                    ffi::av_hmac_update(safe.as_c_ptr(), source, chunk.len() as u32);
                }
            }
            let mut a = [0xCC; 80];
            let mut b = [0xCC; 80];
            // SAFETY: both contexts are keyed and live, and both independent
            // output arrays hold 80 writable bytes. The short final is rejected
            // without touching state or output; the following full final fits.
            unsafe {
                assert_eq!(
                    ffi::av_hmac_final(raw.0, a.as_mut_ptr(), digest_len - 1),
                    -22
                );
                assert_eq!(
                    ffi::av_hmac_final(safe.as_c_ptr(), b.as_mut_ptr(), digest_len - 1),
                    -22
                );
                assert_eq!(
                    ffi::av_hmac_final(raw.0, a.as_mut_ptr(), 80),
                    digest_len as i32
                );
                assert_eq!(
                    ffi::av_hmac_final(safe.as_c_ptr(), b.as_mut_ptr(), 80),
                    digest_len as i32
                );
            }
            assert_eq!(a, b);
            assert_eq!(
                &b[digest_len as usize..],
                &[0xCC; 80][digest_len as usize..]
            );
        }
    }
}
//! Compare independent contexts through every multi-call state transition.
use ffmpeg::libavutil::{ffi, md5::Md5};
#[test]
fn streaming_reset_and_post_final_match_c() {
    let mut wrapped = Md5::new().unwrap();
    let reference = Md5::new().unwrap();
    let data: Vec<_> = (0..258).map(|i| (i * 73) as u8).collect();
    for len in 0..=256 {
        let input = &data[1..1 + len]; // unaligned, and non-null even when empty
        for step in [1, 7, 16, 55, 64, 65, 257] {
            wrapped.as_mut().reset();
            // SAFETY: reference solely owns the full C context, no handles live.
            unsafe { ffi::av_md5_init(reference.as_c_ptr()) };
            for chunk in input.chunks(step) {
                wrapped.as_mut().update(chunk);
                wrapped.as_mut().update(&[]);
                // SAFETY: exclusive C context, live input of chunk.len() bytes,
                // and a non-null empty input. C retains neither input pointer.
                unsafe {
                    ffi::av_md5_update(reference.as_c_ptr(), chunk.as_ptr(), chunk.len());
                    ffi::av_md5_update(reference.as_c_ptr(), data.as_ptr(), 0);
                }
            }
            let mut expected = [0; 16];
            // SAFETY: initialized exclusively owned context, 16 writable bytes.
            unsafe { ffi::av_md5_final(reference.as_c_ptr(), expected.as_mut_ptr()) };
            assert_eq!(
                wrapped.as_mut().finalize(),
                expected,
                "len={len}, step={step}"
            );
            let mut one_shot = [0; 16];
            // SAFETY: input is readable for len bytes and output has 16 writable
            // bytes. The buffers do not overlap, and C retains no pointer.
            unsafe { ffi::av_md5_sum(one_shot.as_mut_ptr(), input.as_ptr(), input.len()) };
            assert_eq!(expected, one_shot);
            // Final changes MD5's state; compare repeated final and a subsequent
            // update rather than silently imposing Rust-only reset semantics.
            for suffix in [&b""[..], &b"post-final"[..]] {
                wrapped.as_mut().update(suffix);
                // SAFETY: independent live context, borrowed readable suffix,
                // and 16 writable output bytes. Neither buffer is retained.
                unsafe {
                    let src = if suffix.is_empty() {
                        data.as_ptr()
                    } else {
                        suffix.as_ptr()
                    };
                    ffi::av_md5_update(reference.as_c_ptr(), src, suffix.len());
                    ffi::av_md5_final(reference.as_c_ptr(), expected.as_mut_ptr());
                }
                assert_eq!(wrapped.as_mut().finalize(), expected);
            }
        }
    }
}
#[test]
fn interleaved_update_and_final_match_after_each_step() {
    let mut wrapped = Md5::new().unwrap();
    let reference = Md5::new().unwrap();
    for chunk in [&b"one"[..], &b""[..], &b"two"[..], &[0xff; 80][..]] {
        wrapped.as_mut().update(chunk);
        let mut expected = [0; 16];
        // SAFETY: reference solely owns initialized C storage, chunk supplies
        // readable bytes, and the output is exactly 16 writable bytes. None of
        // these pointers is retained and no Rust handles cover the reference.
        unsafe {
            let src = if chunk.is_empty() {
                b"live allocation".as_ptr()
            } else {
                chunk.as_ptr()
            };
            ffi::av_md5_update(reference.as_c_ptr(), src, chunk.len());
            ffi::av_md5_final(reference.as_c_ptr(), expected.as_mut_ptr());
        }
        assert_eq!(wrapped.as_mut().finalize(), expected);
    }
}
use ffmpeg::libavutil::md5;
#[test]
fn batch10_size_is_the_c_global() {
    for _ in 0..4 {
        // SAFETY: this global is an immutable const int with static lifetime.
        let raw = unsafe { &ffi::av_md5_size };
        assert_eq!(md5::context_size(), raw);
        assert!(std::ptr::eq(md5::context_size(), raw));
    }
}
#[test]
fn batch10_digest_sequences_match_c() {
    let data: Vec<_> = (0..1025).map(|i| (i * 97) as u8).collect();
    for len in [0, 1, 55, 56, 63, 64, 65, 119, 120, 127, 128, 1024] {
        let mut raw = [0xAA; 16];
        let input = data[1..1 + len].to_vec();
        let empty = 0u8;
        let ptr = if input.is_empty() {
            &raw const empty
        } else {
            input.as_ptr()
        };
        // SAFETY: source is readable for its length; destination is exclusive
        // 16-byte storage and cannot overlap the separately owned source.
        unsafe { ffi::av_md5_sum(raw.as_mut_ptr(), ptr, input.len()) };
        assert_eq!(md5::sum(&data[1..1 + len]), raw);
    }
}
//! Compare independent C contexts, seeds, chunking, reset and finalization.
use ffmpeg::libavutil::{ffi, murmur3::Murmur3};
#[test]
fn streaming_seeds_reset_and_post_final_match_c() {
    let mut wrapped = Murmur3::new().unwrap();
    let reference = Murmur3::new().unwrap();
    let data: Vec<_> = (0..130).map(|i| (i * 73) as u8).collect();
    for seed in [0, 1, u64::MAX, 0x725acc55daddca55] {
        let mut seeded = Murmur3::with_seed(seed).unwrap();
        // SAFETY: exclusively owned full reference context, any seed accepted.
        unsafe { ffi::av_murmur3_init_seeded(reference.as_c_ptr(), seed) };
        let mut expected = [0; 16];
        // SAFETY: live initialized reference and 16 writable output bytes.
        unsafe { ffi::av_murmur3_final(reference.as_c_ptr(), expected.as_mut_ptr()) };
        assert_eq!(seeded.as_mut().finalize(), expected);
        for len in 0..=128 {
            let input = &data[1..1 + len];
            for step in [1, 3, 8, 15, 16, 17, 129] {
                wrapped.as_mut().reset_seeded(seed);
                // SAFETY: exclusive live reference context of C's full size.
                unsafe { ffi::av_murmur3_init_seeded(reference.as_c_ptr(), seed) };
                for chunk in input.chunks(step) {
                    wrapped.as_mut().update(chunk);
                    wrapped.as_mut().update(&[]);
                    // SAFETY: exclusive initialized reference, chunk.len()
                    // readable input bytes; empty update reads nothing.
                    unsafe {
                        ffi::av_murmur3_update(reference.as_c_ptr(), chunk.as_ptr(), chunk.len());
                        ffi::av_murmur3_update(reference.as_c_ptr(), b"".as_ptr(), 0);
                    }
                }
                // Compare final state transitions at each step, then update
                // after final: C's padded partial block remains valid storage.
                for suffix in [&b""[..], &b""[..], &b"post-final"[..]] {
                    wrapped.as_mut().update(suffix);
                    // SAFETY: live exclusive context, borrowed suffix, and
                    // exactly 16 writable output bytes, never retained by C.
                    unsafe {
                        ffi::av_murmur3_update(reference.as_c_ptr(), suffix.as_ptr(), suffix.len());
                        ffi::av_murmur3_final(reference.as_c_ptr(), expected.as_mut_ptr());
                    }
                    assert_eq!(
                        wrapped.as_mut().finalize(),
                        expected,
                        "seed={seed}, len={len}, step={step}"
                    );
                }
            }
        }
    }
    wrapped.as_mut().reset();
    let mut expected = [0; 16];
    // SAFETY: exclusively owned full reference context; init accepts any
    // previous state and final writes exactly 16 bytes without retaining them.
    unsafe {
        ffi::av_murmur3_init(reference.as_c_ptr());
        ffi::av_murmur3_final(reference.as_c_ptr(), expected.as_mut_ptr());
    }
    assert_eq!(wrapped.as_mut().finalize(), expected);
}
#[test]
fn interleaved_update_and_final_match_after_each_step() {
    let mut wrapped = Murmur3::new().unwrap();
    let reference = Murmur3::new().unwrap();
    for chunk in [&b"one"[..], &b""[..], &b"two"[..], &[0xff; 80][..]] {
        wrapped.as_mut().update(chunk);
        let mut expected = [0; 16];
        // SAFETY: reference solely owns initialized C storage, chunk supplies
        // readable bytes, and the output is exactly 16 writable bytes. None of
        // these pointers is retained and no Rust handles cover the reference.
        unsafe {
            ffi::av_murmur3_update(reference.as_c_ptr(), chunk.as_ptr(), chunk.len());
            ffi::av_murmur3_final(reference.as_c_ptr(), expected.as_mut_ptr());
        }
        assert_eq!(wrapped.as_mut().finalize(), expected);
    }
}
use ffibox::CZeroable;
use ffmpeg::libavutil::des::{Des, DesBox};
#[test]
fn inline_heap_fields_and_reborrows() {
    #[repr(align(8))]
    struct KeyStorage([u8; 25]);
    let unaligned = KeyStorage([0xA5; 25]);
    let mut inline = Des::new(&[1; 8], false).unwrap();
    let mut heap = Des::new_boxed(&[2; 24], true).unwrap();
    let mut zeroed = Des::zeroed();
    let mut allocated = DesBox::new().unwrap();
    let mut allocated_zeroed = DesBox::new_zeroed().unwrap();
    for mut handle in [
        inline.as_mut(),
        heap.as_mut(),
        zeroed.as_mut(),
        allocated.as_mut(),
        allocated_zeroed.as_mut(),
    ] {
        let shared = handle.as_ref();
        let copy = shared;
        assert_eq!(shared.round_keys(), copy.round_keys());
        for flag in [i32::MIN, -1, 0, 1, i32::MAX] {
            handle.as_mut().set_triple_des(flag);
            handle.as_mut().set_round_keys([[u64::MAX; 16]; 3]);
            assert_eq!(handle.as_ref().triple_des(), flag);
            assert_eq!(handle.as_ref().round_keys(), [[u64::MAX; 16]; 3]);
        }
        handle.as_mut().init(&unaligned.0[1..25], false).unwrap();
        handle.as_mut().init(&unaligned.0[1..9], true).unwrap();
        assert_eq!(handle.as_ref().triple_des(), 0);
    }
    // The copied field snapshot owns its integers and survives its parent.
    let keys = heap.as_ref().round_keys();
    drop(heap);
    assert_ne!(keys[0], [0; 16]);
}
#[test]
fn repeated_construction_and_destruction() {
    for _ in 0..128 {
        let mut owner = Des::new_boxed(&[0; 24], false).unwrap();
        owner.as_mut().init(&[255; 8], true).unwrap();
        assert_eq!(owner.as_ref().triple_des(), 0);
    }
}
#[test]
fn rust_only_layout_projection() {
    // This safe public-API path deliberately makes no foreign call, so Miri
    // can validate layout projection and lifetimes as well as the sanitizers.
    let mut inline = Des::zeroed();
    assert_eq!(inline.as_ref().round_keys(), [[0; 16]; 3]);
    let mut exclusive = inline.as_mut();
    for flag in [i32::MIN, 0, i32::MAX] {
        exclusive.as_mut().set_triple_des(flag);
        exclusive.as_mut().set_round_keys([[flag as u64; 16]; 3]);
        let shared = exclusive.as_ref();
        let copied = shared;
        assert_eq!(copied.triple_des(), flag);
        assert_eq!(copied.round_keys(), [[flag as u64; 16]; 3]);
    }
}
#[test]
fn copies_and_clones_outlive_their_sources() {
    let mut clones = Vec::new();
    for len in [8, 24] {
        let mut source = Des::new_boxed(&vec![0x3C; len], false).unwrap();
        let first = source.clone();
        {
            let mut handle = source.as_mut();
            handle.as_mut().set_round_keys([[u64::MAX; 16]; 3]);
            handle.init(&[0x99; 8], true).unwrap();
        }
        let second = source.clone();
        drop(source); // Parent first: clones own separate av_memdup blocks.
        assert_ne!(first.as_ref().round_keys(), second.as_ref().round_keys());
        clones.push(first.clone());
        clones.push(first);
        clones.push(second);
    }
    let allocated = DesBox::new().unwrap();
    clones.push(allocated.clone());
    drop(allocated);
    for clone in &mut clones {
        let mut copy = clone.clone();
        copy.as_mut().set_triple_des(-1);
        clone.as_mut().init(&[0x01; 24], false).unwrap();
        assert_eq!(copy.as_ref().triple_des(), -1);
    }
    // Inline copies are independent values that need no teardown.
    let mut inline = Des::new(&[0x42; 24], false).unwrap();
    let copy = inline;
    inline.as_mut().set_triple_des(0);
    assert_eq!(copy.as_ref().triple_des(), 1);
}
//! Public ownership and borrow paths; no foreign memory is referenced in Rust.
use ffmpeg::libavutil::hash::HashContext;
const NAMES: [&std::ffi::CStr; 15] = [
    c"MD5",
    c"murmur3",
    c"RIPEMD128",
    c"RIPEMD160",
    c"RIPEMD256",
    c"RIPEMD320",
    c"SHA160",
    c"SHA224",
    c"SHA256",
    c"SHA512/224",
    c"SHA512/256",
    c"SHA384",
    c"SHA512",
    c"CRC32",
    c"adler32",
];
#[test]
fn owners_shared_views_and_exclusive_reborrows() {
    for name in NAMES {
        for _ in 0..8 {
            let mut owner = HashContext::new(name).unwrap();
            let shared = owner.as_ref();
            let copy = shared;
            assert_eq!(shared.name(), copy.name());
            assert!(shared.size() > 0);
            let static_name = shared.name();
            let mut mutable = owner.as_mut();
            assert_eq!(mutable.as_ref().name(), name);
            mutable.as_mut().init();
            mutable.init();
            assert_eq!(mutable.as_ref().name(), static_name);
            drop(owner);
            // The name is static, unlike the borrowed context handle.
            assert_eq!(static_name, name);
        }
    }
}
#[test]
fn ephemeral_algorithm_name_is_not_retained() {
    let mut owner = {
        let name = std::ffi::CString::new("sHa256").unwrap();
        HashContext::new(&name).unwrap()
    };
    owner.as_mut().init();
    assert_eq!(owner.as_ref().name(), c"SHA256");
    assert_eq!(owner.as_ref().size(), 32);
}
use ffmpeg::libavutil::hash::name;
#[test]
fn batch10_static_names_and_invalid_indices() {
    assert!(name(i32::MIN).is_none());
    assert!(name(-1).is_none());
    assert!(name(i32::MAX).is_none());
    let first: &'static std::ffi::CStr = name(0).unwrap();
    assert_eq!(first, c"MD5");
    for i in 0..64 {
        if let Some(s) = name(i) {
            assert!(!s.to_bytes().is_empty());
        }
    }
    assert_eq!(name(0), Some(first));
}
use ffmpeg::libavutil::{ffi, hmac::HmacType};
#[test]
fn algorithms_and_unknown_values_are_plain_values() {
    for algorithm in [
        HmacType::MD5,
        HmacType::SHA1,
        HmacType::SHA224,
        HmacType::SHA256,
        HmacType::SHA384,
        HmacType::SHA512,
    ] {
        assert_eq!(HmacType::from_raw(algorithm.into_raw()), algorithm);
    }
    for value in [6, 7, u32::MAX, 1 << 31] {
        assert_eq!(
            HmacType::from_raw(ffi::AVHMACType(value)).into_raw().0,
            value
        );
    }
}
use ffmpeg::libavutil::hmac::Hmac;
#[test]
fn keyed_owners_and_reborrows() {
    for algorithm in [
        HmacType::MD5,
        HmacType::SHA1,
        HmacType::SHA224,
        HmacType::SHA256,
        HmacType::SHA384,
        HmacType::SHA512,
    ] {
        let mut owner = Hmac::new(algorithm, b"").unwrap();
        let shared = owner.as_ref();
        let _copied = shared;
        let mut exclusive = owner.as_mut();
        let _shared = exclusive.as_ref();
        for len in [0, 1, 63, 64, 65, 127, 128, 129, 1024] {
            let key = vec![0xA5; len];
            exclusive.as_mut().init(&key).unwrap();
            drop(key); // C retains no pointer to the key.
        }
    }
}
#[test]
fn repeated_construction_and_destruction() {
    for _ in 0..128 {
        let mut owner = Hmac::new(HmacType::SHA256, &[7; 256]).unwrap();
        owner.as_mut().init(b"").unwrap();
    }
}
#[test]
fn independent_contexts_on_threads() {
    let threads: Vec<_> = (0..4)
        .map(|_| {
            std::thread::spawn(|| {
                // No Send/Sync assertions: each thread constructs and releases its
                // own context, exercising the C allocators without sharing objects.
                for _ in 0..16 {
                    let mut owner = Hmac::new(HmacType::SHA1, b"key").unwrap();
                    owner.as_mut().init(&[0; 129]).unwrap();
                }
            })
        })
        .collect();
    for thread in threads {
        thread.join().unwrap();
    }
}
#[test]
fn allocation_failures_clean_up() {
    const CHILD: &str = "CRUSTIFY_CRYPTO_B3_ALLOC_FAILURE_CHILD";
    if std::env::var_os(CHILD).is_some() {
        // Isolate the process-wide (atomic) allocation cap so parallel tests
        // never inherit it. Every object still comes from its safe constructor.
        ffmpeg::libavutil::mem::set_max_alloc(1);
        assert!(matches!(Hmac::new(HmacType::SHA512, b"key"), Err(-12)));
        assert!(matches!(
            ffmpeg::libavutil::des::Des::new_boxed(&[0; 24], false),
            Err(-12)
        ));
        // On the campaign ABI, AVHMAC is 176 bytes and AVSHA512 is 208.
        // This admits the parent but rejects its child hash allocation,
        // exercising C's cleanup before a Rust owner can be formed.
        ffmpeg::libavutil::mem::set_max_alloc(200);
        assert!(matches!(Hmac::new(HmacType::SHA512, b"key"), Err(-12)));
        ffmpeg::libavutil::mem::set_max_alloc(usize::MAX);
        let _restored = Hmac::new(HmacType::SHA512, b"key").unwrap();
        return;
    }
    let status = std::process::Command::new(std::env::current_exe().unwrap())
        .args([
            "--exact",
            "hmac::allocation_failures_clean_up",
            "--test-threads=1",
        ])
        .env(CHILD, "1")
        .status()
        .unwrap();
    assert!(status.success());
}
//! Public safe context lifecycle, input lifetimes, and exclusive reborrows.
use ffmpeg::libavutil::md5::{Md5, Md5Box, Md5Mut, Md5Ref};
#[test]
fn lifecycle_and_foreign_writes() {
    let mut context = Md5::new().unwrap();
    let shared: Md5Ref<'_> = context.as_ref();
    let _copy = shared;
    let mut outer = context.as_mut();
    {
        let mut inner: Md5Mut<'_> = outer.as_mut();
        let mut input = vec![0xab; 129];
        inner.update(&input[1..]); // deliberately unaligned, two full blocks
        input.fill(0); // no retained C pointer may read the modified input
        drop(input);
        inner.update(&[]);
        let _ = inner.finalize();
        let _ = inner.finalize(); // all C post-final states remain memory-safe
        inner.update(b"after final");
        let _ = inner.finalize();
    }
    outer.reset();
    outer.update(b"abc");
    assert_eq!(
        outer.finalize(),
        [
            0x90, 0x01, 0x50, 0x98, 0x3c, 0xd2, 0x4f, 0xb0, 0xd6, 0x96, 0x3f, 0x7d, 0x28, 0xe1,
            0x7f, 0x72
        ]
    );
    drop(context);
    // Exercise construction through the policy as well as the type constructor.
    let mut context = Md5Box::new().unwrap();
    assert_eq!(
        context.as_mut().finalize(),
        [
            0xd4, 0x1d, 0x8c, 0xd9, 0x8f, 0x00, 0xb2, 0x04, 0xe9, 0x80, 0x09, 0x98, 0xec, 0xf8,
            0x42, 0x7e
        ]
    );
}
#[test]
fn block_edges_and_drop_without_finalizing() {
    for len in 0..=192 {
        let data: Vec<_> = (0..len).map(|i| i as u8).collect();
        let mut context = Md5::new().unwrap();
        let mut borrow = context.as_mut();
        for chunk in data.chunks(7) {
            borrow.update(chunk);
            borrow.update(&[]);
        }
        let _ = borrow.finalize();
        borrow.reset();
        borrow.update(&data);
        // Drop with a partially filled context; no finalizer is required.
    }
}
use ffmpeg::libavutil::md5::context_size;
#[test]
fn batch10_immutable_size_across_threads() {
    let size: &'static i32 = context_size();
    assert!(*size > 0);
    let workers: Vec<_> = (0..4)
        .map(|_| {
            std::thread::spawn(move || {
                for _ in 0..100 {
                    assert!(std::ptr::eq(size, context_size()));
                }
            })
        })
        .collect();
    for worker in workers {
        worker.join().unwrap();
    }
}
#[test]
fn batch10_digest_boundary_lengths() {
    use ffmpeg::libavutil::md5::sum;
    let data: Vec<_> = (0..2049).map(|i| i as u8).collect();
    assert_eq!(
        sum(b""),
        [
            0xd4, 0x1d, 0x8c, 0xd9, 0x8f, 0x00, 0xb2, 0x04, 0xe9, 0x80, 0x09, 0x98, 0xec, 0xf8,
            0x42, 0x7e
        ]
    );
    for len in [0, 1, 55, 56, 63, 64, 65, 119, 120, 128, 2048] {
        let independent = data[1..1 + len].to_vec();
        assert_eq!(sum(&data[1..1 + len]), sum(&independent));
    }
}
//! Public safe context lifecycle, input lifetimes, and exclusive reborrows.
use ffmpeg::libavutil::murmur3::{Murmur3, Murmur3Box, Murmur3Mut, Murmur3Ref};
#[test]
fn lifecycle_and_foreign_writes() {
    let mut context = Murmur3::with_seed(u64::MAX).unwrap();
    let shared: Murmur3Ref<'_> = context.as_ref();
    let _copy = shared;
    let mut outer = context.as_mut();
    {
        let mut inner: Murmur3Mut<'_> = outer.as_mut();
        let mut input = vec![0xab; 33];
        inner.update(&input[1..]); // deliberately unaligned, two full blocks
        input.fill(0); // update must not retain pointers across Rust reborrows
        drop(input);
        inner.update(&[]);
        let _ = inner.finalize();
        let _ = inner.finalize();
        inner.update(b"after final");
        let _ = inner.finalize();
    }
    outer.reset_seeded(0);
    assert_eq!(outer.finalize(), [0; 16]);
    outer.reset();
    outer.update(b"abc");
    let _ = outer.finalize();
    drop(context);
    let mut context = Murmur3Box::new().unwrap();
    context.as_mut().reset_seeded(0);
    assert_eq!(context.as_mut().finalize(), [0; 16]);
}
#[test]
fn block_edges_and_drop_without_finalizing() {
    for len in 0..=96 {
        let data: Vec<_> = (0..len).map(|i| i as u8).collect();
        let mut context = Murmur3::new().unwrap();
        let mut borrow = context.as_mut();
        for chunk in data.chunks(3) {
            borrow.update(chunk);
            borrow.update(&[]);
        }
        let _ = borrow.finalize();
        borrow.reset_seeded(len as u64);
        borrow.update(&data);
    }
}
