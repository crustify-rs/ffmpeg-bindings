//! Safe wrappers over `libavutil/des.h`.
//!
//! [`Des`] is resource-free, so it can live inline or behind [`DesBox`].
//! Copies are independent contexts: an inline value is `Copy`, and a box
//! clones through `av_memdup`. C retains no pointer passed to
//! initialization. All three key schedules are initialized, including the
//! two inactive schedules in single-DES mode.
//! DES is obsolete and should not be used for new security protocols.
use core::ptr::{NonNull, addr_of, addr_of_mut};
use ffibox::{CNew, CZeroable, define_ctype};
use super::ffi;
use super::mem::{Heap, HeapBox};
// SAFETY: the generated handles match the public ffi::AVDES layout; raw
// fields are integers or fixed arrays, and borrow lifetimes govern access.
define_ctype!(
    /// Wraps: AVDES
    ///
    /// The public DES layout. Fields are reached through [`DesRef`] and
    /// [`DesMut`], never references to a C-owned object.
    ///
    /// Handles cannot outlive their owner:
    /// ```compile_fail,E0597
    /// use ffmpeg::libavutil::des::Des;
    /// let view;
    /// {
    ///     let owner = Des::new_boxed(&[0; 8], false).unwrap();
    ///     view = owner.as_ref();
    /// }
    /// let _ = view.round_keys();
    /// ```
    #[derive(Clone, Copy)]
    Des,
    DesRef,
    DesMut,
    ffi::AVDES
);
/// A C-allocated DES context, freed through the existing `av_free` policy.
/// Cloning copies the context into a fresh `av_memdup` block.
pub type DesBox = HeapBox<Des>;
// An all-zero context has single-DES mode and zero round keys, accepted by
// every accessor and C operation; the context owns no resources.
// SAFETY: zero initializes the integer flag and every fixed integer array.
unsafe impl CZeroable for Des {}
/// Wraps: av_des_alloc
// av_des_alloc returns a fresh, zero-filled AVDES allocation or NULL.
// SAFETY: zero is a valid Des; Heap frees its av_malloc-family storage.
unsafe impl CNew<Des> for Heap {
    fn c_new(&self) -> Option<NonNull<Des>> {
        // SAFETY: av_des_alloc takes no arguments and retains no Rust state.
        let raw = unsafe { ffi::av_des_alloc() };
        NonNull::new(raw.cast())
    }
}
impl Des {
    /// Initializes an inline context with an 8-byte DES or 24-byte triple-DES
    /// key. Returns `AVERROR(EINVAL)` (-22) for any other key length.
    /// `decrypt` is accepted as in C, but the current C implementation ignores it.
    pub fn new(key: &[u8], decrypt: bool) -> Result<Self, i32> {
        let mut context = Self::zeroed();
        context.as_mut().init(key, decrypt)?;
        Ok(context)
    }
    /// Allocates and initializes a context. Returns -22 for an invalid key
    /// length or `AVERROR(ENOMEM)` (-12) if C cannot allocate its storage.
    pub fn new_boxed(key: &[u8], decrypt: bool) -> Result<DesBox, i32> {
        key_bits(key.len())?;
        let mut context = DesBox::new().ok_or(-12)?;
        context.as_mut().init(key, decrypt)?;
        Ok(context)
    }
}
fn key_bits(len: usize) -> Result<i32, i32> {
    match len {
        8 => Ok(64),
        24 => Ok(192),
        _ => Err(-22),
    }
}
impl DesRef<'_> {
    /// Field: AVDES.triple_des
    ///
    /// The raw mode flag. C treats any nonzero value as triple-DES.
    pub fn triple_des(&self) -> i32 {
        // SAFETY: the shared handle addresses an initialized context; the
        // projection reads only its scalar flag and creates no reference.
        unsafe { addr_of!((*self.as_ptr()).triple_des).read() }
    }
    /// Field: AVDES.round_keys
    ///
    /// A copy of all three 16-round schedules, including inactive schedules.
    pub fn round_keys(&self) -> [[u64; 16]; 3] {
        // SAFETY: safe constructors initialize every schedule, and the
        // shared handle keeps the whole context alive and unwritten.
        unsafe { addr_of!((*self.as_ptr()).round_keys).read() }
    }
}
impl DesMut<'_> {
    /// Wraps: av_des_init
    ///
    /// Reinitializes with an 8- or 24-byte key. Invalid lengths return -22
    /// without changing any field. In single-DES mode C leaves the other
    /// two schedules unchanged. The input is read only during this call.
    pub fn init(&mut self, key: &[u8], decrypt: bool) -> Result<(), i32> {
        let bits = key_bits(key.len())?;
        let mode = i32::from(decrypt);
        // SAFETY: the handle grants exclusive access to a live AVDES, and
        // bits is 64 or 192 with the corresponding 8 or 24 readable key
        // bytes. C reads the key during the call only and initializes the
        // selected schedules without changing the others.
        let result = unsafe { ffi::av_des_init(self.as_mut_ptr(), key.as_ptr(), bits, mode) };
        if result < 0 { Err(result) } else { Ok(()) }
    }
    /// Sets the raw mode flag; every integer value is valid for C.
    /// Shared and exclusive reborrows cannot overlap:
    /// ```compile_fail,E0502
    /// use ffmpeg::libavutil::des::Des;
    /// let mut owner = Des::new(&[0; 8], false).unwrap();
    /// let mut exclusive = owner.as_mut();
    /// let shared = exclusive.as_ref();
    /// exclusive.set_triple_des(1);
    /// let _ = shared.triple_des();
    /// ```
    /// Nor can two exclusive handles be used at once:
    /// ```compile_fail,E0499
    /// use ffmpeg::libavutil::des::Des;
    /// let mut owner = Des::new(&[0; 8], false).unwrap();
    /// let mut outer = owner.as_mut();
    /// let mut inner = outer.as_mut();
    /// outer.set_triple_des(1);
    /// inner.set_triple_des(0);
    /// ```
    pub fn set_triple_des(&mut self, flag: i32) {
        // SAFETY: the handle exclusively borrows an initialized AVDES; the
        // scalar field accepts any i32 and the projection creates no reference.
        unsafe { addr_of_mut!((*self.as_mut_ptr()).triple_des).write(flag) }
    }
    /// Replaces all three schedules with fully initialized integer arrays.
    pub fn set_round_keys(&mut self, keys: [[u64; 16]; 3]) {
        // SAFETY: the handle grants exclusive access, the fixed array has
        // exactly the field's layout, and all u64 values are valid round keys.
        unsafe { addr_of_mut!((*self.as_mut_ptr()).round_keys).write(keys) }
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn invalid_lengths_leave_state_unchanged() {
        let mut value = Des::zeroed();
        value.as_mut().set_triple_des(i32::MIN);
        value.as_mut().set_round_keys([[u64::MAX; 16]; 3]);
        for length in [0, 1, 7, 9, 16, 23, 25, 256] {
            assert!(matches!(Des::new(&vec![0; length], false), Err(-22)));
            assert!(matches!(Des::new_boxed(&vec![0; length], false), Err(-22)));
            assert_eq!(value.as_mut().init(&vec![0; length], false), Err(-22));
            assert_eq!(value.as_ref().triple_des(), i32::MIN);
            assert_eq!(value.as_ref().round_keys(), [[u64::MAX; 16]; 3]);
        }
    }
    #[test]
    fn layout_matches_and_raw_adoption_roundtrips() {
        assert_eq!(
            core::mem::size_of::<Des>(),
            core::mem::size_of::<ffi::AVDES>()
        );
        assert_eq!(
            core::mem::align_of::<Des>(),
            core::mem::align_of::<ffi::AVDES>()
        );
        let owner = Des::new_boxed(&[0; 24], true).unwrap();
        let keys = owner.as_ref().round_keys();
        let raw = owner.into_c();
        // SAFETY: into_c surrendered exactly one live, initialized,
        // av_malloc-family allocation; no other owner or handle exists.
        let restored = unsafe { DesBox::from_c(raw) }.unwrap();
        assert_eq!(restored.as_ref().round_keys(), keys);
    }
    // No FFI: also run under Miri to check the by-value copy strategy.
    #[test]
    fn inline_copies_are_independent_contexts() {
        let mut original = Des::zeroed();
        original.as_mut().set_triple_des(1);
        original.as_mut().set_round_keys([[7; 16]; 3]);
        let copy = original;
        original.as_mut().set_triple_des(0);
        original.as_mut().set_round_keys([[9; 16]; 3]);
        assert_eq!(copy.as_ref().triple_des(), 1);
        assert_eq!(copy.as_ref().round_keys(), [[7; 16]; 3]);
        assert_eq!(original.as_ref().round_keys(), [[9; 16]; 3]);
    }
    #[test]
    fn boxed_clones_are_independent_allocations() {
        let mut original = Des::new_boxed(&[0x5A; 24], false).unwrap();
        let clone = original.clone();
        assert_ne!(clone.as_c_ptr(), original.as_c_ptr());
        assert_eq!(clone.as_ref().triple_des(), 1);
        assert_eq!(clone.as_ref().round_keys(), original.as_ref().round_keys());
        original.as_mut().init(&[0xC3; 8], true).unwrap();
        assert_eq!(original.as_ref().triple_des(), 0);
        assert_eq!(clone.as_ref().triple_des(), 1);
        assert_ne!(
            clone.as_ref().round_keys()[0],
            original.as_ref().round_keys()[0]
        );
        drop(original);
        let again = clone.clone();
        assert_eq!(again.as_ref().round_keys(), clone.as_ref().round_keys());
    }
    #[test]
    fn rust_only_zeroed_fields_and_reborrows() {
        let mut value = Des::zeroed();
        assert_eq!(value.as_ref().round_keys(), [[0; 16]; 3]);
        let mut exclusive = value.as_mut();
        exclusive.as_mut().set_round_keys([[u64::MAX; 16]; 3]);
        for flag in [0, 1, -1, i32::MIN, i32::MAX] {
            exclusive.as_mut().set_triple_des(flag);
            let shared = exclusive.as_ref();
            assert_eq!(shared.triple_des(), flag);
            assert_eq!(shared.round_keys(), [[u64::MAX; 16]; 3]);
        }
    }
}
//! Owned and borrowed contexts for `libavutil/hash.h`.
//!
//! C keeps the representation private. A context owns its selected algorithm's
//! storage; CRC32 instead borrows an immutable static table, and adler32 needs
//! no child allocation. C has no clone, refcount, or field-disposal primitive.
use core::ffi::{CStr, c_int};
use core::ptr::{self, NonNull};
use ffibox::{CBox, CDrop, define_ctype};
use super::ffi;
define_ctype!(
    /// Wraps: AVHashContext
    ///
    /// A C hash context, owned as a [`HashContextBox`]. The public C API is
    /// opaque, so there are no field accessors or inline Rust-owned values.
    /// Handles require an allocated context with a valid algorithm; shared
    /// operations only read metadata and do not inspect the hashing state.
    HashContext,
    HashContextRef,
    HashContextMut,
    ffi::AVHashContext
);
/// Wraps: av_hash_freep
///
/// Releases the context and its algorithm storage exactly once. The CRC
/// table is static and is not freed.
#[derive(Clone, Copy, Debug, Default)]
pub struct HashContextFree;
// SAFETY: av_hash_freep releases precisely one av_hash_alloc allocation and
// its children, matching every successful constructor branch.
unsafe impl CDrop<HashContext> for HashContextFree {
    unsafe fn c_drop(&self, ptr: NonNull<HashContext>) {
        // Adapts the C pointer-to-pointer release to the sole-owner policy.
        let mut slot = ptr.as_ptr().cast::<ffi::AVHashContext>();
        // SAFETY: CDrop's caller transfers the uniquely owned av_hash_alloc
        // allocation. C frees its child and then the context, and clears only
        // this writable local slot; it does not retain the slot's address.
        unsafe { ffi::av_hash_freep(&mut slot) };
    }
}
/// The sole owner of a C hash context. Not `Clone`: copying its private bytes
/// would duplicate child ownership. Thread traits are intentionally withheld.
///
/// A handle cannot outlive its owner:
/// ```compile_fail
/// use ffmpeg::libavutil::hash::HashContext;
/// let view = {
///     let hash = HashContext::new(c"MD5").unwrap();
///     hash.as_ref()
/// };
/// let _ = view.size();
/// ```
/// Shared and exclusive handles cannot alias:
/// ```compile_fail
/// use ffmpeg::libavutil::hash::HashContext;
/// let mut hash = HashContext::new(c"MD5").unwrap();
/// let shared = hash.as_ref();
/// hash.as_mut().init();
/// let _ = shared.size();
/// ```
/// An exclusive reborrow freezes its parent handle:
/// ```compile_fail
/// use ffmpeg::libavutil::hash::HashContext;
/// let mut hash = HashContext::new(c"MD5").unwrap();
/// let mut parent = hash.as_mut();
/// let mut child = parent.as_mut();
/// parent.init();
/// child.init();
/// ```
pub type HashContextBox = CBox<HashContext, HashContextFree>;
impl HashContext {
    /// Wraps: av_hash_alloc
    ///
    /// Allocates and initializes the named algorithm (case-insensitive).
    /// Returns C's negative error code for an unknown algorithm or allocation
    /// failure. The name is read only during allocation, never retained.
    #[allow(clippy::new_ret_no_self)]
    pub fn new(name: &CStr) -> Result<HashContextBox, c_int> {
        let mut context = ptr::null_mut();
        // SAFETY: context is a writable local output slot; name is a live
        // NUL-terminated string. C reads the name, retains no input pointer,
        // and hands over a fresh allocation on success, NULL on failure.
        let result = unsafe { ffi::av_hash_alloc(&mut context, name.as_ptr()) };
        if result < 0 {
            return Err(result);
        }
        // SAFETY: successful av_hash_alloc produced a uniquely owned context
        // with a valid algorithm and children, releasable by av_hash_freep.
        // The policy may release it even before hashing state is initialized.
        let mut owner = unsafe { HashContextBox::from_c(context) }
            .expect("av_hash_alloc succeeded without an allocation");
        owner.as_mut().init();
        Ok(owner)
    }
}
impl HashContextRef<'_> {
    /// Wraps: av_hash_get_name
    ///
    /// The algorithm's canonical name, backed by C's immutable static table.
    pub fn name(&self) -> &'static CStr {
        // SAFETY: this handle keeps a valid allocated context alive. C only
        // reads its algorithm and returns a non-NULL NUL-terminated string
        // in static const hashdesc storage, independent of the context's life.
        unsafe { CStr::from_ptr(ffi::av_hash_get_name(self.as_ptr())) }
    }
    /// Wraps: av_hash_get_size
    ///
    /// The number of bytes in this algorithm's binary digest.
    pub fn size(&self) -> usize {
        // SAFETY: the live allocated context has an algorithm selected by
        // av_hash_alloc. C only reads it and returns its positive digest size.
        unsafe { ffi::av_hash_get_size(self.as_ptr()) as usize }
    }
}
impl HashContextMut<'_> {
    /// Wraps: av_hash_init
    ///
    /// Initializes or resets the hashing state, including after finalization.
    pub fn init(&mut self) {
        // SAFETY: this exclusive handle keeps an allocated context and its
        // children alive, excludes competing access, and C initializes all
        // hashing state for its valid algorithm. No pointer is retained.
        unsafe { ffi::av_hash_init(self.as_mut_ptr()) };
    }
}
/// Wraps: av_hash_names
///
/// Name at a C hash registry index, or `None` for an invalid index.
/// The registry and its NUL-terminated names are immutable static storage.
pub fn name(index: i32) -> Option<&'static CStr> {
    // SAFETY: every integer index is checked by C; no input pointers.
    let ptr = unsafe { ffi::av_hash_names(index) };
    if ptr.is_null() {
        None
    } else {
        // SAFETY: the non-null result points to an immutable, NUL-terminated
        // name in hash.c's static hashdesc array; it is never freed.
        Some(unsafe { CStr::from_ptr(ptr) })
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn unknown_names_are_errors() {
        for name in [c"", c"not a hash", c"SHA999", c"\xff"] {
            assert_eq!(HashContext::new(name).err(), Some(-(ffi::EINVAL as c_int)));
        }
    }
    #[test]
    fn owner_round_trip_and_null_adoption() {
        // SAFETY: NULL adopts no allocation and must return None.
        assert!(unsafe { HashContextBox::from_c(ptr::null_mut()) }.is_none());
        let owner = HashContext::new(c"MD5").unwrap();
        let raw = owner.into_c();
        // SAFETY: into_c transferred this sole live allocation; no handles
        // remain, and the same release policy adopts it exactly once.
        let mut owner = unsafe { HashContextBox::from_c(raw) }.unwrap();
        owner.as_mut().init();
        assert_eq!(owner.as_ref().name(), c"MD5");
    }
}
//! Safe wrappers over `libavutil/hmac.h`.
//!
//! [`HmacBox`] owns both the opaque context and its private MD5, SHA or
//! SHA512 hash allocation. C copies/hashes the key during initialization;
//! it does not retain the input pointer. There is no C clone operation, and
//! byte copying the opaque context would duplicate its owned hash pointer.
use ffibox::{CBox, CPlainElem, define_ctype, impl_cdrop};
use super::ffi;
/// Wraps: AVHMACType
/// Handwritten
///
/// The hash algorithm selected by an HMAC context.
///
/// This resource-free value preserves every C integer encoding, including
/// unknown values (which `av_hmac_alloc` rejects with NULL). No ffibox
/// ownership primitive is needed for an enum.
#[repr(transparent)]
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub struct HmacType(ffi::AVHMACType);
impl HmacType {
    pub const MD5: Self = Self(ffi::AVHMACType::AV_HMAC_MD5);
    pub const SHA1: Self = Self(ffi::AVHMACType::AV_HMAC_SHA1);
    pub const SHA224: Self = Self(ffi::AVHMACType::AV_HMAC_SHA224);
    pub const SHA256: Self = Self(ffi::AVHMACType::AV_HMAC_SHA256);
    pub const SHA384: Self = Self(ffi::AVHMACType::AV_HMAC_SHA384);
    pub const SHA512: Self = Self(ffi::AVHMACType::AV_HMAC_SHA512);
    /// Preserves a C algorithm value, including an unknown encoding.
    pub const fn from_raw(raw: ffi::AVHMACType) -> Self {
        Self(raw)
    }
    /// The C encoding of this algorithm.
    pub const fn into_raw(self) -> ffi::AVHMACType {
        self.0
    }
}
impl From<ffi::AVHMACType> for HmacType {
    fn from(raw: ffi::AVHMACType) -> Self {
        Self::from_raw(raw)
    }
}
impl From<HmacType> for ffi::AVHMACType {
    fn from(value: HmacType) -> Self {
        value.into_raw()
    }
}
// SAFETY: the transparent wrapper and bindgen's integer newtype have the
// same layout; every integer bit pattern is valid and has no C-side identity.
unsafe impl CPlainElem for HmacType {}
// SAFETY: the generated handles name the opaque ffi::AVHMAC pointer type.
// C alone allocates/accesses its body; no Rust inline value is constructed.
define_ctype!(
    /// Wraps: AVHMAC
    ///
    /// Opaque layout reached only through C. A safe constructor initializes
    /// both the algorithm callbacks and the hash state with a key.
    /// The body is private to `hmac.c`, so there are no field accessors,
    /// zeroed values, inline constructors, or byte-copy clone strategy.
    Hmac,
    HmacRef,
    HmacMut,
    ffi::AVHMAC
);
/// Wraps: av_hmac_free
///
/// Releases the private hash allocation, then the HMAC context.
#[derive(Clone, Copy, Debug, Default)]
pub struct HmacFree;
impl_cdrop!(HmacFree, Hmac, ffi::av_hmac_free);
/// Sole ownership of a keyed HMAC context. Handles borrow the owner, and
/// neither a handle nor its reborrow can outlive it.
///
/// ```compile_fail,E0597
/// use ffmpeg::libavutil::hmac::{Hmac, HmacType};
/// let view;
/// {
///     let owner = Hmac::new(HmacType::MD5, b"key").unwrap();
///     view = owner.as_ref();
/// }
/// std::hint::black_box(view);
/// ```
pub type HmacBox = CBox<Hmac, HmacFree>;
impl Hmac {
    /// Wraps: av_hmac_alloc
    ///
    /// Allocates and keys a context. Returns -12 on allocation failure (or
    /// an unknown algorithm value), and -22 if the key length exceeds C's
    /// `unsigned int` range. Even an empty key initializes the hash state.
    ///
    /// The algorithm is a typed value; unknown integer encodings preserved
    /// by [`HmacType`] are rejected by C without forming an owner.
    pub fn new(algorithm: HmacType, key: &[u8]) -> Result<HmacBox, i32> {
        key_len(key.len())?;
        // SAFETY: C checks the algorithm value and returns either NULL or a
        // fresh context with valid callbacks and a private owned hash object.
        let raw = unsafe { ffi::av_hmac_alloc(algorithm.into_raw()) };
        // SAFETY: a non-NULL result is uniquely owned, released together with
        // its hash by av_hmac_free. That destructor also accepts the state
        // before key initialization, so early failure cannot leak it.
        let mut context = unsafe { HmacBox::from_c(raw) }.ok_or(-12)?;
        context.as_mut().init(key)?;
        Ok(context)
    }
}
fn key_len(len: usize) -> Result<u32, i32> {
    u32::try_from(len).map_err(|_| -22)
}
impl HmacMut<'_> {
    /// Wraps: av_hmac_init
    ///
    /// Restarts the hash with a copied authentication key. Long keys are
    /// hashed down to the selected digest size by C. Returns -22 before
    /// touching the context if the key length exceeds `unsigned int`.
    pub fn init(&mut self, key: &[u8]) -> Result<(), i32> {
        let len = key_len(key.len())?;
        // Give memcpy a live pointer even for an empty key, not the dangling
        // sentinel of an empty Rust slice. C keeps neither pointer.
        let empty = 0u8;
        let source = if key.is_empty() {
            &raw const empty
        } else {
            key.as_ptr()
        };
        // SAFETY: the handle exclusively borrows a context from av_hmac_alloc
        // with a valid algorithm/hash allocation. source supplies len readable
        // bytes; C copies or hashes them and retains only its own key bytes.
        unsafe { ffi::av_hmac_init(self.as_mut_ptr(), source, len) };
        Ok(())
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn representations_and_conversions() {
        assert_eq!(size_of::<HmacType>(), size_of::<ffi::AVHMACType>());
        assert_eq!(align_of::<HmacType>(), align_of::<ffi::AVHMACType>());
        for raw in [0, 1, 2, 3, 4, 5, 6, u32::MAX, 1 << 31] {
            let c = ffi::AVHMACType(raw);
            let value = HmacType::from(c);
            assert_eq!(ffi::AVHMACType::from(value), c);
            let copy = value;
            assert_eq!(value, copy);
            assert!(!format!("{value:?}").is_empty());
        }
    }
    #[test]
    fn length_conversion_rejects_truncation() {
        assert_eq!(key_len(0), Ok(0));
        assert_eq!(key_len(u32::MAX as usize), Ok(u32::MAX));
        if usize::BITS > u32::BITS {
            assert_eq!(key_len(u32::MAX as usize + 1), Err(-22));
        }
    }
    #[test]
    fn rejects_unknown_algorithm_and_raw_adoption_roundtrips() {
        assert!(matches!(
            Hmac::new(HmacType::from_raw(ffi::AVHMACType(u32::MAX)), b"key"),
            Err(-12)
        ));
        let owner = Hmac::new(HmacType::SHA512, b"key").unwrap();
        let raw = owner.into_c();
        // SAFETY: into_c surrendered this keyed context and its private hash;
        // no other owner or handle exists, and HmacFree is its paired releaser.
        let mut restored = unsafe { HmacBox::from_c(raw) }.unwrap();
        restored.as_mut().init(b"new key").unwrap();
    }
}
lrwxrwxrwx 1 root root 23 Oct 11 09:39 crustify/builds -> /target/crustify/builds
// Build logic shared by every `*-sys` crate, `include!`d from each crate's build.rs.
//
// The C side is never built here: it links the prebuilt FFmpeg variant named by
// `CRUSTIFY_FFMPEG_VARIANT` (default `plain`) from `crustify/build.json`, or the
// directory in `CRUSTIFY_FFMPEG_BUILD_DIR` for a private build.
//
// Bindings come from `wrapper.h` restricted to the crate's agent-owned
// `allowlist.txt` plus the orchestrator-owned `api-types.txt` (every public type). Items published by the link units in `deps` are blocklisted and
// reached through their crates' re-exports instead, so each C type has one Rust type.
// Allowlisted `static inline` functions get compiled wrappers (bindgen
// `wrap_static_fns`), and `shim.c` holds the `crustify_<NAME>` macro shims.
use std::env;
use std::path::{Path, PathBuf};
fn repo_root() -> PathBuf {
    // crustify/rust/<crate>/ -> repo root
    let manifest = PathBuf::from(env::var("CARGO_MANIFEST_DIR").unwrap());
    manifest.ancestors().nth(3).unwrap().to_path_buf()
}
fn build_dir(root: &Path) -> PathBuf {
    println!("cargo:rerun-if-env-changed=CRUSTIFY_FFMPEG_BUILD_DIR");
    println!("cargo:rerun-if-env-changed=CRUSTIFY_FFMPEG_VARIANT");
    if let Ok(dir) = env::var("CRUSTIFY_FFMPEG_BUILD_DIR") {
        return PathBuf::from(dir);
    }
    let variant = env::var("CRUSTIFY_FFMPEG_VARIANT").unwrap_or_else(|_| "plain".into());
    let build_json = root.join("crustify/build.json");
    println!("cargo:rerun-if-changed={}", build_json.display());
    let spec: serde_json::Value =
        serde_json::from_str(&std::fs::read_to_string(&build_json).expect("crustify/build.json"))
            .expect("valid build.json");
    let dir = spec["variants"][&variant]["dir"]
        .as_str()
        .unwrap_or_else(|| panic!("no variant {variant:?} in crustify/build.json"));
    root.join(dir)
}
/// Parse `allowlist.txt`: `function|type|var|item <regex>` per line, `#` comments.
fn allowlist(path: &Path) -> Vec<(String, String)> {
    println!("cargo:rerun-if-changed={}", path.display());
    std::fs::read_to_string(path)
        .unwrap_or_default()
        .lines()
        .map(|l| l.split('#').next().unwrap().trim())
        .filter(|l| !l.is_empty())
        .map(|l| {
            let (kind, pat) = l.split_once(char::is_whitespace).expect("`<kind> <regex>`");
            (kind.to_string(), pat.trim().to_string())
        })
        .collect()
}
/// Parse `api-types.txt`: one type regex per line, `#` comments.
fn allowlist_types(path: &Path) -> Vec<String> {
    println!("cargo:rerun-if-changed={}", path.display());
    std::fs::read_to_string(path)
        .unwrap_or_default()
        .lines()
        .map(|l| l.split('#').next().unwrap().trim().to_string())
        .filter(|l| !l.is_empty())
        .collect()
}
/// `lib`: link unit (e.g. "libavcodec"); `deps`: link units it links against.
pub fn build(lib: &str, deps: &[&str]) {
    let root = repo_root();
    let build = build_dir(&root);
    let manifest = PathBuf::from(env::var("CARGO_MANIFEST_DIR").unwrap());
    let out = PathBuf::from(env::var("OUT_DIR").unwrap());
    assert!(
        build.join(lib).join(format!("{lib}.so")).exists(),
        "{lib}.so missing under {}: build the variant first (crustify/build.json)",
        build.display()
    );
    let includes = [root.clone(), build.clone(), manifest.clone()];
    let mut b = bindgen::Builder::default()
        .header(manifest.join("wrapper.h").to_str().unwrap())
        .clang_args(includes.iter().map(|i| format!("-I{}", i.display())))
        .allowlist_item("crustify_.*")
        .default_enum_style(bindgen::EnumVariation::NewType { is_bitfield: false, is_global: false })
        .derive_default(true)
        .generate_comments(true)
        .wrap_static_fns(true)
        .wrap_static_fns_path(out.join("static_fns"))
        .parse_callbacks(Box::new(bindgen::CargoCallbacks::new()));
    for (kind, pat) in allowlist(&manifest.join("allowlist.txt")) {
        b = match kind.as_str() {
            "function" => b.allowlist_function(pat),
            "type" => b.allowlist_type(pat),
            "var" => b.allowlist_var(pat),
            "item" => b.allowlist_item(pat),
            k => panic!("allowlist.txt: unknown kind {k:?}"),
        };
    }
    for pat in allowlist_types(&manifest.join("api-types.txt")) {
        b = b.allowlist_type(pat);
    }
    for d in deps {
        // Definitions in the dependency's headers, and forward declarations of its
        // types in ours, both belong to the dependency's crate.
        b = b.blocklist_file(format!(".*/{d}/[^/]*\\.h"));
        for pat in allowlist_types(&manifest.join(format!("../{d}-sys/api-types.txt"))) {
            b = b.blocklist_type(pat);
        }
    }
    // bindgen writes static_fns.c only when the allowlist reaches a static
    // inline function, so drop a previous build's copy rather than compile it.
    let static_fns = out.join("static_fns.c");
    let _ = std::fs::remove_file(&static_fns);
    b.generate()
        .expect("bindgen")
        .write_to_file(out.join("bindings.rs"))
        .expect("write bindings.rs");
    let mut cc = cc::Build::new();
    cc.file(manifest.join("shim.c"))
        .includes(&includes)
        .include(&manifest)
        .warnings(false);
    if static_fns.exists() {
        cc.file(&static_fns);
    }
    cc.compile(&format!("crustify_{lib}_shim"));
    println!("cargo:rerun-if-changed={}", manifest.join("shim.c").display());
    println!("cargo:rerun-if-changed={}", manifest.join("shim.h").display());
    println!("cargo:rerun-if-changed={}", manifest.join("wrapper.h").display());
    let lib_dir = build.join(lib);
    println!("cargo:rustc-link-search=native={}", lib_dir.display());
    println!("cargo:rustc-link-lib=dylib={}", &lib[3..]);
    // DT_RPATH, not DT_RUNPATH: it also resolves the FFmpeg libraries' own NEEDED entries.
    println!("cargo:rustc-link-arg=-Wl,--disable-new-dtags");
    println!("cargo:rustc-link-arg=-Wl,-rpath,{}", lib_dir.display());
    println!("cargo:lib_dir={}", lib_dir.display());
}
// Embed each linked FFmpeg library's directory as an rpath so the crate's tests and
// examples run against the prebuilt variant the `-sys` crates linked. DT_RPATH, not
// DT_RUNPATH: it also resolves the FFmpeg libraries' own NEEDED entries.
fn main() {
    println!("cargo:rustc-link-arg=-Wl,--disable-new-dtags");
    for lib in ["AVUTIL", "SWRESAMPLE", "SWSCALE", "AVCODEC", "AVFORMAT", "AVFILTER", "AVDEVICE"] {
        if let Ok(dir) = std::env::var(format!("DEP_{lib}_LIB_DIR")) {
            println!("cargo:rustc-link-arg=-Wl,-rpath,{dir}");
        }
    }
}
