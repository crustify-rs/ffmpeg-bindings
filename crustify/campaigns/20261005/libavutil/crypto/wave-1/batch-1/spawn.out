#!/bin/bash
# prep.sh <translate|review> <link-unit> <subsystem> <wave> <batch...>
# Creates the wave integration branch at the sub-campaign tip (never checked out),
# artifact dirs, verbatim batch.json, batch branches and worktrees with shared state.
set -euo pipefail
cd /target
C=20261005; mode=$1; LU=$2; S=$3; W=$4; shift 4
SUB=crustify/subcampaigns/$C/$LU/$S
if [ "$mode" = translate ]; then
  WB=crustify/waves/$C/$LU/$S/wave-$W; BBP=crustify/batches/$C/$LU/$S/wave-$W; AD=crustify/campaigns/$C/$LU/$S/wave-$W
else
  WB=crustify/reviews/$C/$LU/$S/wave-$W; BBP=crustify/review-batches/$C/$LU/$S/wave-$W; AD=crustify/campaigns/$C/$LU/$S/review-wave-$W
fi
# A review wave starts from its translation wave's landed tip.
BASE=$SUB; [ "$mode" = translate ] || BASE=crustify/waves/$C/$LU/$S/wave-$W
git branch "$WB" "$BASE"
mkdir -p "$AD"; git rev-parse "$BASE" > "$AD/base"
for B in "$@"; do
  mkdir -p "$AD/batch-$B"
  python3 - "$mode" "$LU" "$S" "$W" "$B" "$AD/batch-$B/batch.json" <<'PY'
import json, sys
mode, lu, sub, w, b, out = sys.argv[1:]
s = json.load(open("crustify/campaigns/20261005/schedule.json"))
L = next(x for x in s["link_units"] if x["name"] == lu)
S = next(x for x in L["subsystems"] if x["name"] == sub)
batch = S["waves"][int(w)]["batches"][int(b)]
if mode == "review":
    batch = dict(batch, objective="review")
json.dump(batch, open(out, "w"), indent=2); open(out, "a").write("\n")
PY
  git branch "$BBP/batch-$B" "$WB"
  WT=crustify/.worktrees/$BBP/batch-$B
  git worktree add -q "$WT" "$BBP/batch-$B"
  for p in .providers builds fate-suite; do ln -s /target/crustify/$p "$WT/crustify/$p"; done
  mkdir -p "$WT/crustify/wavefront"
  ln -s /target/crustify/wavefront/codeql "$WT/crustify/wavefront/codeql"
  [ -d /target/crustify/wavefront/.cache ] && ln -s /target/crustify/wavefront/.cache "$WT/crustify/wavefront/.cache"
  echo "prepared $WT"
