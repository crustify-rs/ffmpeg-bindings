#!/bin/bash
# rerun_poc.sh <poc dir relative to repo> <rev> <mode: asan|plain>
# Copies the PoC from the review tip into the measurement worktree checked out at <rev>,
# builds and runs it, prints the exit status. The worktree copy is removed afterwards.
set -uo pipefail
P=$1; REV=$2; MODE=$3
V=/target/crustify/.worktrees/orchestrator/core-wave-0-cov
/target/crustify/tmp/ensure-wt.sh $V >&2 || exit 1
RB=${RB:-crustify/reviews/20261005/libavutil/core/wave-0}
git -C $V checkout -q --detach $REV
rm -rf "${V:?}/${P:?}"; mkdir -p $V/$P
git -C /target archive $RB $P | tar -x -C $V
cd $V/$P
name=$(sed -n 's/^name = "\(.*\)"/\1/p' Cargo.toml | head -1)
T=/tmp/poc-target-$name
if [ $MODE = asan ]; then
  B=/target/crustify/builds/asan-ubsan
  CRUSTIFY_FFMPEG_VARIANT=asan-ubsan RUSTFLAGS=-Zsanitizer=address CARGO_TARGET_DIR=$T cargo +nightly build -q --offline -Zbuild-std --target x86_64-unknown-linux-gnu 2>&1 | grep -E '^error' | head -3
  LD_LIBRARY_PATH=$(printf '%s:' $B/lib*) $T/x86_64-unknown-linux-gnu/debug/$name > /tmp/poc-$name-$REV.out 2>&1
else
  # The -sys rpath does not reach a dependent binary: put the plain build's libraries on the path.
  LD_LIBRARY_PATH=$(printf '%s:' /target/crustify/builds/plain/lib*) CARGO_TARGET_DIR=$T cargo run -q --offline > /tmp/poc-$name-$REV.out 2>&1
fi
rc=$?
echo "$name @ $(git -C $V rev-parse --short=10 HEAD): exit $rc"
grep -E 'runtime error|ERROR: AddressSanitizer|SUMMARY|DIFFER|agree|filled|panicked' /tmp/poc-$name-$REV.out | sort | uniq -c | head -8
rm -rf "${V:?}/${P:?}"
CRUSTIFY_MSAN_CC=/usr/lib/llvm-23/bin/clang
CARGO_HOME=/work/.cargo
RUSTUP_HOME=/root/.rustup
CARGO_TERM_COLOR=never
