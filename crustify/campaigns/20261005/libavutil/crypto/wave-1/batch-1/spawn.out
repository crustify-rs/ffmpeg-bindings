 run "bsan-${name%%::*}" timeout 900 cargo bsan test --manifest-path "$M" -p ffmpeg --test ub_safe "$name" -- --exact
 done
 ;;
 miri)
 export CARGO_TARGET_DIR="$D/miri"
 run miri-safe cargo +nightly miri test --manifest-path "$M" -p ffmpeg --no-default-features --features libavutil --test ub_safe des::rust_only_layout_projection -- --exact
 run miri-validate cargo +nightly miri test --manifest-path "$M" -p ffmpeg --no-default-features --features libavutil --lib libavutil::des::unit_tests::crypt_validation_and_unchanged_buffers -- --exact
 run miri-length cargo +nightly miri test --manifest-path "$M" -p ffmpeg --no-default-features --features libavutil --lib libavutil::hmac::unit_tests::length_conversion_rejects_truncation -- --exact
 ;;
 scan)
 export CARGO_TARGET_DIR="$D/scan"
 run scan crustify scan-unsafe crustify/rust/ffmpeg --json --sites unsafe_fns_pub_smell raw_ptr_pub_smell ref_to_type_wrapper_smell field_proj_outside_impl
 ;;
esac
SH
