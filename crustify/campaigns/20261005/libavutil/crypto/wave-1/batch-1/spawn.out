/// Never freed, so no owner and no policy: a `'static` borrow under the lock.
pub fn registry() -> CGuardedRef<'static, Registry> {
    unsafe { CGuardedRef::from_ptr(addr_of_mut!(sys::registry)) }.unwrap()
}
let mut g = registry().lock();           // registry_lock
let n = g.as_ref().count();
g.as_locked().set_count(n + 1);          // registry_unlock when `g` drops
```
### An opaque payload — no erased owner
A `void *` crossing FFI is never a [`CBox`] or [`CArc`]: both own only
`define_ctype!` layout types. What the payload really is decides the owner:
- **bytes** (an arena block, an I/O buffer) → `CVec<u8, P>` (or
  `CVec<MaybeUninit<u8>, P>` before it is filled), released through `CLenDrop`;
- **a C struct the caller knows** → `CBox<Foo, P>`, or `CArc<Foo, P>` when
  counted, after `define_ctype!`.
Neither `CBox` nor `CArc` owns a `c_void`: an erased payload whose type Rust
chooses (a refcounted user object, say) gets its own typed owner over the C
routines.
```rust,no_run
use core::mem::MaybeUninit;
use ffibox::{impl_clendrop, CVec};
mod sys {
    use core::ffi::c_void;
    extern "C" {
        pub fn arena_alloc(n: usize) -> *mut c_void;
        pub fn arena_free(p: *mut c_void);
    }
}
unsafe fn arena_free_len(ptr: *mut u8, _byte_len: usize) {
    unsafe { sys::arena_free(ptr.cast()) }
}
#[derive(Clone, Copy, Debug, Default)]
pub struct ArenaFree;
impl_clendrop!(ArenaFree, arena_free_len);
/// Arena bytes: a buffer, not an opaque object.
pub type ArenaBuf = CVec<MaybeUninit<u8>, ArenaFree>;
let mut buf = unsafe { ArenaBuf::from_raw_parts(sys::arena_alloc(64).cast(), 64) }.unwrap();
buf.as_mut_slice().fill(MaybeUninit::new(0));
let buf = unsafe { buf.assume_init() }; // CVec<u8, ArenaFree>
// `arena_free` runs here.
```
### By value — `CVal`
```rust,no_run
use ffibox::{define_ctype, impl_cdispose, CVal, CZeroable};
mod sys {
    #[repr(C)] pub struct buf_st { pub ptr: *mut u8, pub len: usize }
    #[repr(C)] pub struct rational_st { pub num: i32, pub den: i32 }
    extern "C" {
        pub fn buf_init(b: *mut buf_st, n: usize) -> i32;
        pub fn buf_dispose(b: *mut buf_st);
    }
}
define_ctype!(Buf, BufRef, BufMut, sys::buf_st);
//! C allocation observes the enum's ABI values, including invalid encodings.
use ffmpeg::libavutil::{ffi, hmac::HmacType};
fn c_accepts(algorithm: ffi::AVHMACType) -> bool {
    // SAFETY: C accepts all enum integers and returns NULL for unknown ones.
    // A successful allocation is uniquely owned, and even an uninitialized
    // hashing state is valid for av_hmac_free. No pointer escapes this helper.
    unsafe {
        let context = ffi::av_hmac_alloc(algorithm);
        let success = !context.is_null();
        ffi::av_hmac_free(context);
        success
    }
}
#[test]
fn algorithm_values_match_c_consumption() {
    for (safe, raw) in [
        (HmacType::MD5, ffi::AVHMACType::AV_HMAC_MD5),
        (HmacType::SHA1, ffi::AVHMACType::AV_HMAC_SHA1),
        (HmacType::SHA224, ffi::AVHMACType::AV_HMAC_SHA224),
        (HmacType::SHA256, ffi::AVHMACType::AV_HMAC_SHA256),
        (HmacType::SHA384, ffi::AVHMACType::AV_HMAC_SHA384),
        (HmacType::SHA512, ffi::AVHMACType::AV_HMAC_SHA512),
    ] {
        assert_eq!(safe.into_raw(), raw);
        assert_eq!(c_accepts(safe.into_raw()), c_accepts(raw));
        assert!(c_accepts(safe.into_raw()));
    }
    for value in [6, 100, u32::MAX, 1 << 31] {
        let raw = ffi::AVHMACType(value);
        let safe = HmacType::from_raw(raw);
        assert_eq!(c_accepts(safe.into_raw()), c_accepts(raw));
        assert!(!c_accepts(safe.into_raw()));
    }
}
use ffmpeg::libavutil::hmac::Hmac;
struct Reference(*mut ffi::AVHMAC);
impl Reference {
    fn new(algorithm: ffi::AVHMACType) -> Self {
        // SAFETY: C validates algorithm and allocates a fresh context, owned
        // by this fixture and released through the paired av_hmac_free.
        let ptr = unsafe { ffi::av_hmac_alloc(algorithm) };
        assert!(!ptr.is_null());
        Self(ptr)
    }
}
impl Drop for Reference {
    fn drop(&mut self) {
        // SAFETY: the fixture owns this context and its private hash uniquely;
        // av_hmac_free releases both exactly once.
        unsafe { ffi::av_hmac_free(self.0) }
    }
}
#[test]
fn keyed_construction_and_reinitialization_agree() {
    for (algorithm, digest_len) in [
        (HmacType::MD5, 16),
        (HmacType::SHA1, 20),
        (HmacType::SHA224, 28),
        (HmacType::SHA256, 32),
        (HmacType::SHA384, 48),
        (HmacType::SHA512, 64),
    ] {
        let raw = Reference::new(algorithm.into_raw());
        let mut safe = Hmac::new(algorithm, b"").unwrap();
        for len in [0, 1, 63, 64, 65, 127, 128, 129, 1024] {
            let key = vec![0xA5; len];
