/// Wraps: av_md5_sum
///
/// Compute the 16-byte MD5 digest (not suitable for cryptographic security).
pub fn sum(input: &[u8]) -> [u8; 16] {
    let mut digest = [0; 16];
    let empty = 0u8;
    let source = if input.is_empty() {
        &raw const empty
    } else {
        input.as_ptr()
    };
