cat >> crustify/rust/ffmpeg/tests/ub_safe/des.rs <<'RS'
#[test]
fn independent_crypt_contexts_on_threads() {
    let workers: Vec<_> = (0..4).map(|_| std::thread::spawn(|| {
        let context = Des::new(&[3; 24], false).unwrap();
        let mut data = [7; 80];
        for _ in 0..16 {
            context.as_ref().crypt_in_place(&mut data, None, false).unwrap();
            context.as_ref().crypt_in_place(&mut data, None, true).unwrap();
            let _ = context.as_ref().mac(&data).unwrap();
        }
    })).collect();
    for worker in workers { worker.join().unwrap(); }
}
RS
