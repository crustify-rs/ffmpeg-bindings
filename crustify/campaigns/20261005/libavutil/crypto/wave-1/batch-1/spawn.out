run() { local n=$1; shift; "$@" > "$D/$n.log" 2>&1; s=$?; echo "$n:$s" | tee -a "$D/status.log"; return $s; }
case "$1" in
 workspace)
 export CRUSTIFY_FFMPEG_VARIANT=asan-ubsan CRUSTIFY_FFMPEG_BUILD_DIR="$D/c/asan-ubsan" CARGO_TARGET_DIR="$D/workspace-asan"
 export RUSTFLAGS='"'-C linker=clang -C link-arg=-fsanitize=address -C link-arg=-fsanitize=undefined' RUSTDOCFLAGS='-C linker=clang -C link-arg=-fsanitize=address -C link-arg=-fsanitize=undefined'
 export ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
 run workspace-full cargo test --workspace --manifest-path \""'$M"
 run workspace-runtime cargo test --workspace --manifest-path "$M" -- --skip compile_fail
 ;;
 asan|tsan)
 if [ "$1" = asan ]; then v=asan-ubsan; san=address; else v=tsan; san=thread; fi
 export CRUSTIFY_FFMPEG_VARIANT=$v CRUSTIFY_FFMPEG_BUILD_DIR="$D/c/$v" CARGO_TARGET_DIR="$D/$1"
 export RUSTFLAGS="-Zsanitizer=$san" RUSTDOCFLAGS="-Zsanitizer=$san"
 export ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
 for tu in des hash hmac md5 murmur3; do
 run "$1-$tu" cargo +nightly test -Zbuild-std --target x86_64-unknown-linux-gnu --manifest-path "$M" -p ffmpeg "$tu::"
 done
 ;;
 bsan)
 export CRUSTIFY_FFMPEG_VARIANT=bsan CARGO_TARGET_DIR="$D/bsan" BSAN_OPTIONS=gc_hang_threshold_ms=600000
 unset CRUSTIFY_FFMPEG_BUILD_DIR RUSTFLAGS RUSTDOCFLAGS
