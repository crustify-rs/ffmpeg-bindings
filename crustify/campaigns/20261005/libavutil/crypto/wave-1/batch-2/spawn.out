fn allocation_failure_is_contained_in_a_child_process() {
    const CHILD: &str = "CRUSTIFY_CRYPTO_BATCH6_ALLOC_CHILD";
    if std::env::var_os(CHILD).is_some() {
        // Only this exact test runs in the child, so this process-global
