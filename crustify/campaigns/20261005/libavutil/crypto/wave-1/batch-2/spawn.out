 import re
 for owner,out,iv in [('owner','output','iv'),('constructed','constructed_output','constructed_iv')]:
  pat=r'\\s*ffi::av_'+mod+r'_crypt\\(\\s*'+owner+r'\\.as_c_ptr\\(\\),\\s*'+out+r'\\.as_mut_ptr\\(\\),\\s*input\\.as_ptr\\(\\),\\s*3,\\s*if cbc \\{\\s*'+iv+r'\\.as_mut_ptr\\(\\)\\s*\\} else \\{\\s*core::ptr::null_mut\\(\\)\\s*\\},\\s*decrypt,\\s*\\);'
  s=re.sub(pat, f'\\n                    {owner}.as_mut().crypt(&mut {out}, &input, if cbc {{ Some(&mut {iv}) }} else {{ None }}, decrypt "'!= 0).unwrap();'"',s)
