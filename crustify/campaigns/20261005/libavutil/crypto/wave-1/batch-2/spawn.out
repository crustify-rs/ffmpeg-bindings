#[test]
fn batch2_in_place_multi_call_buffers_and_iv_match_c() {{
    let mut owner = {new};
    let reference = {new};
    for cbc in [false, true] {{
        let mut iv = [0x38; {block}];
        let mut expected_iv = iv;
        for decrypt in [false, true, true, false] {{
            for count in [0, 1, 2, 17] {{
                let mut data: Vec<_> = (0..count * {block} + 1).map(|i| (i * 37) as u8).collect();
                let mut expected = data.clone();
                owner.as_mut().crypt_in_place(&mut data[1..], if cbc {{ Some(&mut iv) }} else {{ None }}, decrypt).unwrap();
                // SAFETY: reference uniquely owns an initialized independent C
                // context with no handles. Buffer covers count blocks and the
                // separate IV covers one; C explicitly permits exact overlap.
                unsafe {{ ffi::av_{module}_crypt(reference.as_c_ptr(), expected[1..].as_mut_ptr(), expected[1..].as_ptr(), count as i32,
                     if cbc {{ expected_iv.as_mut_ptr() }} else {{ core::ptr::null_mut() }}, i32::from(decrypt)) }};
                assert_eq"'!(data, expected);
                assert_eq!(iv, expected_iv);
                let mut output = vec![0xa5; data.len() + {block}];
                let mut expected_output = output.clone();
                owner.as_mut().crypt(&mut output[1..], &data[1..], if cbc {{ Some(&mut iv) }} else {{ None }}, decrypt).unwrap();
                // SAFETY: independent initialized context and disjoint input,
                // output, IV; only count full blocks are read/written.
                unsafe {{ ffi::av_{module}_crypt(reference.as_c_ptr(), expected_output[1..].as_mut_ptr(), expected[1..].as_ptr(), count as i32,
                     if cbc {{ expected_iv.as_mut_ptr() }} else {{ core::ptr::null_mut() }}, i32::from(decrypt)) }};
                assert_eq!(output, expected_output);
                assert_eq!(iv, expected_iv);
                assert!(output[data.len()..].iter().all(|&b| b == 0xa5));
            }}
        }}
    }}
}}
