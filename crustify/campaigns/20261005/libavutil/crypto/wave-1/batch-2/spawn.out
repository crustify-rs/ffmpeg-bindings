            let original = data.clone();
            let mut iv = [7; {block}];
            let initial_iv = iv;
            // Unaligned byte buffers are legal; C uses unaligned byte-order loads.
            let mut parent = owner.as_mut();
            parent.as_mut().crypt_in_place(&mut data[1..], if cbc {{ Some(&mut iv) }} else {{ None }}, false).unwrap();
            iv = initial_iv;
            parent.as_mut().crypt_in_place(&mut data[1..], if cbc {{ Some(&mut iv) }} else {{ None }}, true).unwrap();
