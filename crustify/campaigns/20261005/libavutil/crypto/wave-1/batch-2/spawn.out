    #[test]
    fn rejected_buffers_are_unchanged() {
        let mut owner = Tea::new(&[0; 16], 64).unwrap();
        let mut output = [0x7b; 8];
        let mut iv = [0x8c; 8];
        assert_eq!(
            owner
                .as_mut()
                .as_ref()
                .crypt(&mut output, &[0; 8 - 1], Some(&mut iv), false),
            Err(-22)
        );
        assert_eq!(
            owner
                .as_mut()
                .as_ref()
                .crypt(&mut output[..1], &[0; 8], Some(&mut iv), true),
            Err(-22)
        );
        assert_eq!(
            owner
                .as_mut()
                .as_ref()
                .crypt_in_place(&mut output[..1], Some(&mut iv), true),
            Err(-22)
        );
        assert_eq!(output, [0x7b; 8]);
        assert_eq!(iv, [0x8c; 8]);
    }
    #[test]
    fn layout_matches_ffi() {
        assert_eq!(
            core::mem::size_of::<Tea>(),
            core::mem::size_of::<ffi::AVTEA>()
        );
        assert_eq!(
            core::mem::align_of::<Tea>(),
            core::mem::align_of::<ffi::AVTEA>()
        );
        assert_eq!(output, [0x7b; 16]);
        assert_eq!(iv, [0x8c; 16]);
    }
