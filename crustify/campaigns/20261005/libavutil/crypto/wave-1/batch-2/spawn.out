   178	    pub fn update(&mut self, data: &[u8]) {
   179	        // SAFETY: the handle exclusively borrows an initialized full C context;
   180	        // nonempty data provides len readable bytes; empty input uses a real static
   181	        // byte for C's zero-length memcpy. C retains no pointer.
   182	        unsafe {
   183	            ffi::av_sha_update(
   184	                self.as_mut_ptr(),
   185	                if data.is_empty() {
   186	                    c"".as_ptr().cast()
   187	                } else {
   188	                    data.as_ptr()
   189	                },
   190	                data.len(),
   191	            )
   192	        }
   193	    }
   194	
   195	    /// Wraps: av_sha_final
   196	    ///
   197	    /// Finish the current message. The digest occupies the prefix of the returned
   198	    /// array; bytes beyond the selected algorithm's digest length are zero.
   199	    /// The maximum-size output remains safe even after changing the algorithm.
   200	    /// Reinitialize the context before starting another message.
   201	    pub fn finalize(&mut self) -> [u8; 32] {
   202	        let mut digest = [0; 32];
   203	        // SAFETY: exclusive initialized context; the output covers the largest
   204	        // supported digest. C writes only the active digest and retains no pointer.
   205	        unsafe { ffi::av_sha_final(self.as_mut_ptr(), digest.as_mut_ptr()) };
   206	        digest
   207	    }
   208	}
