fn fast_parts<T>(buf: &mut HeapVec<T>) -> (*mut T, c_uint) {
    let (ptr, len) = core::mem::take(buf).into_raw_parts();
    let size = c_uint::try_from(len).expect("an av_fast buffer fits unsigned int");
