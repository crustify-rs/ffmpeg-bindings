mod unit_tests {
    use super::*;
    #[test]
    fn rejects_invalid_lengths_before_ffi() {
        for len in [0, 1, 4, 17, 128] {
            assert!(matches!(
                Cast5::new(&vec![0; len]),
                Err(InitError::InvalidKeyLength)
            ));
        }
        assert_eq!(key_bits(&[0; 5]), Ok(40));
        assert_eq!(key_bits(&[0; 16]), Ok(128));
    }
    #[test]
    fn errors_describe_the_failure() {
