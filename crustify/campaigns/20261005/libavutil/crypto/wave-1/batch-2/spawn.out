impl {ty}Mut<'"'_> {{
    /// Wraps: av_{module}_crypt
    ///
    /// Encrypt ("'`decrypt = false`) or decrypt whole {block}-byte blocks. A mutable
    /// IV selects CBC and is updated after each block; `None` selects ECB.
    /// Output bytes beyond `src.len()` remain untouched. Partial blocks, short
    /// outputs and block counts above C INT_MAX return EINVAL before any mutation.
    pub fn crypt(&mut self, dst: &mut [u8], src: &[u8],
                 iv: Option<&mut [u8; {block}]>, decrypt: bool) -> Result<(), i32> {{
        let count = crypt_count(src.len(), dst.len())?;
        // SAFETY: exclusive initialized context; validation covers all count
        // blocks in disjoint input/output slices. The optional IV is one exclusive
        // block and cannot alias either slice. C retains no pointers.
        unsafe {{ ffi::av_{module}_crypt(self.as_mut_ptr(), dst.as_mut_ptr(), src.as_ptr(),
                  count, iv.map_or(core::ptr::null_mut(), |iv| iv.as_mut_ptr()),
                  i32::from(decrypt)) }};
        Ok(())
    }}
    /// The in-place form of `crypt`, with the same validation and IV semantics.
    pub fn crypt_in_place(&mut self, data: &mut [u8],
                         iv: Option<&mut [u8; {block}]>, decrypt: bool) -> Result<(), i32> {{
        let count = crypt_count(data.len(), data.len())?;
        // SAFETY: exclusive context and full writable blocks; C supports exact
        // source/destination overlap, saving ciphertext before overwriting during
        // CBC decryption. IV is a disjoint exclusive block; no pointer is retained.
        unsafe {{ ffi::av_{module}_crypt(self.as_mut_ptr(), data.as_mut_ptr(), data.as_ptr(),
                  count, iv.map_or(core::ptr::null_mut(), |iv| iv.as_mut_ptr()),
                  i32::from(decrypt)) }};
        Ok(())
    }}
}}
