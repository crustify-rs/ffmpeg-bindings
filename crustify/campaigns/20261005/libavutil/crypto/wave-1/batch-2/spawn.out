            core::mem::size_of::<Option<Sha512Box>>(),
            core::mem::size_of::<*mut ()>()
        );
        assert_eq!(
            core::mem::size_of::<Sha512Ref<'_>>(),
            core::mem::size_of::<*mut ()>()
        );
        assert_eq!(
            core::mem::size_of::<Sha512Mut<'_>>(),
            core::mem::size_of::<*mut ()>()
        );
    }
    #[test]
    fn owner_raw_round_trip() {
