            let mut output = vec![0; length + 1];
            parent.as_mut().crypt(&mut output[1..], &data[1..], if cbc {{ Some(&mut iv) }} else {{ None }}, false).unwrap();
            data.fill(0); // C must not retain the input
            parent.as_mut().crypt_in_place(&mut output[1..], if cbc {{ Some(&mut iv) }} else {{ None }}, true).unwrap();
        }}
    }}
}}
