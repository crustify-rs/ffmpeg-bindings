/// ```
pub type TeaBox = CBox<Tea, TeaFree>;
/// Storage-only release of an `av_tea_alloc` context. Unlike [`Heap`], it
/// offers no generic allocator: the opaque layout's Rust size is zero, so
/// only C can size a TEA context.
#[derive(Clone, Copy, Debug, Default)]
pub struct TeaFree;
/// Wraps: av_free
// SAFETY: TeaBox adopts only `av_tea_alloc` storage, which owns no sub-allocations;
// Heap's av_free releases that av_malloc-family block once without reading it.
unsafe impl CDrop<Tea> for TeaFree {
    unsafe fn c_drop(&self, ptr: NonNull<Tea>) {
        // SAFETY: CDrop's caller transfers the unique av_malloc-family claim.
        unsafe { <Heap as CDrop<Tea>>::c_drop(&Heap, ptr) }
    }
}
impl Tea {
    /// Wraps: av_tea_alloc
    ///
    /// Allocate and initialize a context; `None` means allocation failed.
    /// `rounds` is passed unchanged (64 is the standard round count).
    /// The key is copied, so its borrow ends when this call returns.
    pub fn new(key: &[u8; 16], rounds: i32) -> Option<TeaBox> {
        // SAFETY: the allocator returns fresh, zero-filled C storage with no
        // nested resources. TeaFree frees it with the paired av_free. The owner
        // stays private until init has established the context's key/rounds.
        let mut owner = unsafe { TeaBox::from_c(ffi::av_tea_alloc()) }?;
        owner.as_mut().init(key, rounds);
        Some(owner)
    }
}
impl TeaMut<'_> {
    /// Wraps: av_tea_init
    ///
    /// Replace the key and round count. C copies the 16 key bytes and retains
    /// no pointer to the key. All signed round counts are accepted by C.
    pub fn init(&mut self, key: &[u8; 16], rounds: i32) {
        // SAFETY: the handle exclusively borrows a full C allocation. C writes
        // only that context and reads exactly the 16 live key bytes, retaining
        // neither pointer. The scalar round count is stored without arithmetic.
        unsafe { ffi::av_tea_init(self.as_mut_ptr(), key.as_ptr(), rounds) }
    }
}
/// Wraps: av_tea_size
///
/// The C context's size in bytes, borrowed from immutable C static storage.
pub fn context_size() -> &'static i32 {
    // SAFETY: C defines this global as `const int = sizeof(context)`; it has
    // static lifetime and no writer anywhere in the library.
    unsafe { &ffi::av_tea_size }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn layout_matches_ffi() {
        assert_eq!(
            core::mem::size_of::<Tea>(),
            core::mem::size_of::<ffi::AVTEA>()
        );
        assert_eq!(
            core::mem::align_of::<Tea>(),
            core::mem::align_of::<ffi::AVTEA>()
        );
        assert_eq!(
            core::mem::size_of::<TeaRef<'_>>(),
            core::mem::size_of::<usize>()
        );
        assert_eq!(
            core::mem::size_of::<TeaMut<'_>>(),
            core::mem::size_of::<usize>()
        );
    }
    #[test]
    #[cfg(not(miri))]
    fn raw_ownership_round_trip() {
        let owner = Tea::new(&[7; 16], 64).unwrap();
        let ptr = owner.into_c();
        // SAFETY: into_c transferred the sole live allocation, still initialized
        // and paired with TeaFree's av_free; no borrow remains.
        let owner = unsafe { TeaBox::from_c(ptr) }.unwrap();
        drop(owner);
    }
}
//! Owned and borrowed views of the opaque Twofish key schedule.
//!
//! C stores inline subkeys and lookup tables, never the supplied key pointer.
//! The public header exposes no fields or clone routine. Storage remains
//! C-allocated and is released by the [`TwofishFree`] policy.
use core::{fmt, ptr::NonNull};
use ffibox::{CBox, CDrop, define_ctype};
use super::{ffi, mem::Heap};
define_ctype!(
    /// Wraps: AVTWOFISH
    ///
    /// An initialized Twofish context. Its private C fields are not exposed.
    /// No `Send`/`Sync` guarantee is added.
    ///
    /// An exclusive reborrow freezes its parent:
    /// ```compile_fail
    /// use ffmpeg::libavutil::twofish::Twofish;
    /// let (mut owner, _) = Twofish::new(&[0; 16], 128).unwrap();
    /// let mut parent = owner.as_mut();
    /// let mut child = parent.as_mut();
    /// parent.init(&[1; 16], 128).unwrap();
    /// child.init(&[2; 16], 128).unwrap();
    /// ```
    /// A shared handle keeps its owner alive:
    /// ```compile_fail
    /// use ffmpeg::libavutil::twofish::Twofish;
    /// let (owner, _) = Twofish::new(&[0; 16], 128).unwrap();
    /// let shared = owner.as_ref();
    /// drop(owner);
    /// let _copy = shared;
    /// ```
    Twofish, TwofishRef, TwofishMut, ffi::AVTWOFISH
);
/// Sole ownership of a C-allocated Twofish context, freed with `av_free`.
///
/// The opaque layout has no Rust size, so there is no Rust-sized allocation:
///
/// ```compile_fail,E0277
/// use ffmpeg::libavutil::twofish::TwofishBox;
/// let _ = TwofishBox::new_uninit();
/// ```
pub type TwofishBox = CBox<Twofish, TwofishFree>;
/// Storage-only release of an `av_twofish_alloc` context. Unlike [`Heap`], it
/// offers no generic allocator: the opaque layout's Rust size is zero, so
/// only C can size a Twofish context.
#[derive(Clone, Copy, Debug, Default)]
pub struct TwofishFree;
/// Wraps: av_free
// SAFETY: TwofishBox adopts only `av_twofish_alloc` storage, which owns no sub-allocations;
// Heap's av_free releases that av_malloc-family block once without reading it.
unsafe impl CDrop<Twofish> for TwofishFree {
    unsafe fn c_drop(&self, ptr: NonNull<Twofish>) {
        // SAFETY: CDrop's caller transfers the unique av_malloc-family claim.
        unsafe { <Heap as CDrop<Twofish>>::c_drop(&Heap, ptr) }
    }
}
/// C's successful initialization return value.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum InitStatus {
    /// The bit count was exactly 128, 192 or 256 (C returns zero).
    Exact,
    /// C padded or truncated the supplied key (C returns one).
    Adjusted,
}
/// Initialization failed before modifying the context.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum InitError {
    /// Negative bit counts are rejected by C with `AVERROR(EINVAL)`.
    NegativeKeyBits,
    /// C would read more bytes than the supplied key contains.
    KeyTooShort { required: usize, actual: usize },
    /// The C allocator returned null.
    AllocationFailed,
}
impl fmt::Display for InitError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::NegativeKeyBits => f.write_str("negative Twofish key bit count"),
            Self::KeyTooShort { required, actual } => {
                write!(f, "Twofish requires {required} key bytes, got {actual}")
            }
            Self::AllocationFailed => f.write_str("Twofish allocation failed"),
        }
    }
}
impl std::error::Error for InitError {}
fn validate_key(key: &[u8], key_bits: i32) -> Result<(), InitError> {
    if key_bits < 0 {
        return Err(InitError::NegativeKeyBits);
    }
    // C reads floor(bits / 8), capped at 32; partial bytes are ignored.
    let required = (key_bits.min(256) / 8) as usize;
    if key.len() < required {
        return Err(InitError::KeyTooShort {
            required,
            actual: key.len(),
        });
    }
    Ok(())
}
impl Twofish {
    /// Wraps: av_twofish_alloc
    ///
    /// Allocate a fully initialized context and return C's initialization
    /// status. Zero bits (including an empty key), partial bytes and counts
    /// above 256 are accepted as in C: missing bits are zero-padded, partial
    /// bytes ignored, and keys above 256 bits truncated to 32 bytes.
    pub fn new(key: &[u8], key_bits: i32) -> Result<(TwofishBox, InitStatus), InitError> {
        validate_key(key, key_bits)?;
        // SAFETY: fresh zero-filled C storage has only inline scalar fields,
        // and TwofishFree releases it using the paired av_free. No owner escapes
        // before init fills all fields subsequently read by the C cipher.
        let mut owner = unsafe { TwofishBox::from_c(ffi::av_twofish_alloc()) }
            .ok_or(InitError::AllocationFailed)?;
        let status = owner.as_mut().init(key, key_bits)?;
        Ok((owner, status))
    }
}
impl TwofishMut<'_> {
    /// Wraps: av_twofish_init
    ///
    /// Replace the key schedule, preserving C's padding/truncation status.
    /// An invalid bit count or short slice leaves the old schedule unchanged.
    /// The key is read only during this call and need not outlive the context.
    pub fn init(&mut self, key: &[u8], key_bits: i32) -> Result<InitStatus, InitError> {
        validate_key(key, key_bits)?;
        // SAFETY: this handle exclusively borrows a full C context; validation
        // guarantees nonnegative bits and at least min(bits, 256)/8 readable
        // bytes. Even for zero bytes the slice pointer is nonnull. C copies
        // the key into local storage, writes only the context, and retains no
        // pointers. It returns 0 or 1 after filling the entire key schedule.
        let status = unsafe { ffi::av_twofish_init(self.as_mut_ptr(), key.as_ptr(), key_bits) };
        Ok(if status == 0 {
            InitStatus::Exact
        } else {
            InitStatus::Adjusted
        })
    }
}
/// Wraps: av_twofish_size
///
/// The C context's size in bytes, borrowed from immutable C static storage.
pub fn context_size() -> &'static i32 {
    // SAFETY: C defines this global as `const int = sizeof(context)`; it has
    // static lifetime and no writer anywhere in the library.
    unsafe { &ffi::av_twofish_size }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn layout_matches_ffi() {
        assert_eq!(
            core::mem::size_of::<Twofish>(),
            core::mem::size_of::<ffi::AVTWOFISH>()
        );
        assert_eq!(
            core::mem::align_of::<Twofish>(),
            core::mem::align_of::<ffi::AVTWOFISH>()
        );
        assert_eq!(
            core::mem::size_of::<TwofishRef<'_>>(),
            core::mem::size_of::<usize>()
        );
        assert_eq!(
            core::mem::size_of::<TwofishMut<'_>>(),
            core::mem::size_of::<usize>()
        );
    }
    #[test]
    fn validation_and_errors() {
        assert_eq!(validate_key(&[], i32::MIN), Err(InitError::NegativeKeyBits));
        assert_eq!(validate_key(&[], 7), Ok(()));
        assert_eq!(
            validate_key(&[], 8),
            Err(InitError::KeyTooShort {
                required: 1,
                actual: 0
            })
        );
        assert_eq!(validate_key(&[0; 32], i32::MAX), Ok(()));
        assert_eq!(
            InitError::NegativeKeyBits.to_string(),
            "negative Twofish key bit count"
        );
        assert_eq!(
            InitError::KeyTooShort {
                required: 32,
                actual: 1
            }
            .to_string(),
            "Twofish requires 32 key bytes, got 1"
        );
        assert_eq!(
            InitError::AllocationFailed.to_string(),
            "Twofish allocation failed"
        );
        assert_eq!(InitStatus::Exact, InitStatus::Exact);
        assert_ne!(InitStatus::Exact, InitStatus::Adjusted);
    }
    #[test]
    #[cfg(not(miri))]
    fn raw_ownership_round_trip() {
        let (owner, _) = Twofish::new(&[7; 16], 128).unwrap();
        let ptr = owner.into_c();
        // SAFETY: into_c transferred the sole initialized allocation and no
        // borrow remains. TwofishFree is still the matching release policy.
        let owner = unsafe { TwofishBox::from_c(ptr) }.unwrap();
        drop(owner);
    }
}
//! Safe layout and lifecycle for `libavutil/xtea.h`.
//!
//! The public layout has sixteen key words, although C's initializers and
//! cipher routines use only the first four. Initialization preserves the
//! remaining twelve words. No pointers or resources are stored in the object.
//! Inline values need no teardown; [`XteaBox`] uses `av_xtea_alloc` and the
//! existing [`Heap`] policy's `av_free`. There is no C refcount or cloner;
//! copies of the words are independent values, and heap clones use `av_memdup`.
//! Cipher operations are left to the separately scheduled symbol wrappers.
use core::marker::PhantomData;
use core::ptr::{NonNull, addr_of, addr_of_mut};
use ffibox::{CNew, CZeroable, define_ctype};
use super::ffi;
use super::mem::{Heap, HeapBox};
define_ctype!(
    /// Wraps: AVXTEA
    ///
    /// Layout-compatible XTEA key storage, held inline or through [`XteaBox`].
    /// Getters copy the words rather than referencing foreign memory.
    ///
    /// A handle cannot outlive its owner:
    /// ```compile_fail,E0597
    /// use ffmpeg::libavutil::xtea::Xtea;
    /// let view = {
    ///     let value = Xtea::from_key_words([0; 16]);
    ///     value.as_ref()
    /// };
    /// let _ = view.key();
    /// ```
    /// Shared and mutable reborrows cannot overlap:
    /// ```compile_fail,E0502
    /// use ffmpeg::libavutil::xtea::Xtea;
    /// let mut value = Xtea::from_key_words([0; 16]);
    /// let mut exclusive = value.as_mut();
    /// let shared = exclusive.as_ref();
    /// exclusive.set_key([1; 16]);
    /// let _ = shared.key();
    /// ```
    #[derive(Clone, Copy)]
    Xtea,
    XteaRef,
    XteaMut,
    ffi::AVXTEA
);
/// Sole owner of an `av_malloc`-family XTEA context; freed by `av_free`.
/// `XteaBox::new()` calls `av_xtea_alloc` and returns zero key words, or
/// `None` on allocation failure. Initialize through its exclusive handle.
pub type XteaBox = HeapBox<Xtea>;
// SAFETY: every field is a u32; all-zero is exactly av_xtea_alloc's initial
// state. Every accessor and initializer accepts it; av_free reads no fields.
unsafe impl CZeroable for Xtea {}
/// Wraps: av_xtea_alloc
// SAFETY: av_xtea_alloc returns a fresh aligned, zero-filled AVXTEA, or NULL.
// Xtea is layout-compatible and all-zero valid; Heap frees it with av_free.
unsafe impl CNew<Xtea> for Heap {
    fn c_new(&self) -> Option<NonNull<Xtea>> {
        // SAFETY: av_xtea_alloc has no arguments or preconditions and retains
        // no pointer to the returned storage.
        NonNull::new(unsafe { ffi::av_xtea_alloc() }.cast())
    }
}
impl Xtea {
    /// Build inline storage from all sixteen words without calling C.
    /// Every word is accepted; the cipher uses only words zero through three.
    #[must_use]
    pub const fn from_key_words(key: [u32; 16]) -> Self {
        Self(ffi::AVXTEA { key }, PhantomData)
    }
    /// Initialize inline storage with a 16-byte big-endian key.
    /// The unused twelve words start at zero.
    #[must_use]
    pub fn new(key: &[u8; 16]) -> Self {
        let mut value = Self::zeroed();
        value.as_mut().init(key);
        value
    }
    /// Initialize inline storage with a 16-byte little-endian key.
    /// The unused twelve words start at zero.
    #[must_use]
    pub fn new_le(key: &[u8; 16]) -> Self {
        let mut value = Self::zeroed();
        value.as_mut().init_le(key);
        value
    }
}
impl XteaRef<'_> {
    /// Field: AVXTEA.key
    ///
    /// Copy all sixteen words, including the twelve unused by the cipher.
    #[must_use]
    pub fn key(&self) -> [u32; 16] {
        // SAFETY: the shared handle keeps an initialized AVXTEA alive and
        // excludes writes. Projection forms no reference to foreign storage.
        unsafe { addr_of!((*self.as_ptr()).key).read() }
    }
}
impl XteaMut<'_> {
    /// Field: AVXTEA.key
    ///
    /// Replace all sixteen key words. No byte-order conversion is performed.
    pub fn set_key(&mut self, key: [u32; 16]) {
        // SAFETY: the exclusive handle grants sole access to the live object;
        // writing the projected array initializes every word without aliasing.
        unsafe { addr_of_mut!((*self.as_mut_ptr()).key).write(key) }
    }
    /// Wraps: av_xtea_init
    ///
    /// Replace the first four words with the big-endian 16-byte key.
    /// The other twelve words are preserved. The key is not retained.
    pub fn init(&mut self, key: &[u8; 16]) {
        // SAFETY: the handle grants exclusive access to initialized storage;
        // key supplies the 16 readable bytes C consumes without retaining it.
        unsafe { ffi::av_xtea_init(self.as_mut_ptr(), key.as_ptr()) }
    }
    /// Wraps: av_xtea_le_init
    ///
    /// Replace the first four words with the little-endian 16-byte key.
    /// The other twelve words are preserved. The key is not retained.
    pub fn init_le(&mut self, key: &[u8; 16]) {
        // SAFETY: as for init: exclusive context, exactly 16 readable key
        // bytes, and neither pointer is retained by C.
        unsafe { ffi::av_xtea_le_init(self.as_mut_ptr(), key.as_ptr()) }
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn ffi_free_layout_and_value_copy() {
        assert_eq!(size_of::<Xtea>(), size_of::<ffi::AVXTEA>());
        assert_eq!(align_of::<Xtea>(), align_of::<ffi::AVXTEA>());
        assert_eq!(size_of::<Xtea>(), 16 * size_of::<u32>());
        let mut original = Xtea::from_key_words([u32::MAX; 16]);
        #[allow(clippy::clone_on_copy)]
        let copy = original.clone();
        original.as_mut().set_key([0; 16]);
        assert_eq!(copy.as_ref().key(), [u32::MAX; 16]);
        assert_eq!(Xtea::zeroed().as_ref().key(), [0; 16]);
    }
    #[test]
    fn raw_owner_roundtrip() {
        let owner = XteaBox::new().unwrap();
        let ptr = owner.into_c();
        // SAFETY: into_c surrendered the sole live av_xtea_alloc allocation;
        // no intervening access occurred, and Heap is its av_free policy.
        let mut owner = unsafe { XteaBox::from_c(ptr) }.unwrap();
        owner.as_mut().set_key([u32::MAX; 16]);
        assert_eq!(owner.as_ref().key(), [u32::MAX; 16]);
    }
    #[test]
    fn allocation_failure_returns_none() {
        const MARKER: &str = "CRUSTIFY_XTEA_ALLOC_FAILURE_CHILD";
        if std::env::var_os(MARKER).is_none() {
            let status = std::process::Command::new(std::env::current_exe().unwrap())
                .args([
                    "--exact",
                    "libavutil::xtea::unit_tests::allocation_failure_returns_none",
                    "--test-threads=1",
                ])
                .env(MARKER, "1")
                .status()
                .unwrap();
            assert!(status.success());
            return;
        }
        super::super::mem::set_max_alloc(size_of::<Xtea>() - 1);
        let result = XteaBox::new();
        super::super::mem::set_max_alloc(usize::MAX);
        assert!(result.is_none());
    }
}
//! Safe wrappers over `libavutil/mem.h`.
//!
//! [`Heap`] is the lifecycle policy of the `av_malloc` family: every block
//! `av_malloc`, `av_mallocz`, `av_malloc_array`, `av_calloc` or `av_memdup`
//! returns is released by `av_free`. Owners name it as their policy:
//!
//! - one object: [`HeapBox<T>`], built by `HeapBox::<T>::new_zeroed()`
//!   (`av_mallocz`) or `HeapBox::<T>::new_uninit()` (`av_malloc`), and
//!   `Clone` (`av_memdup`) when `T: Copy`;
//! - an array: [`HeapVec<T>`], built by [`alloc_array`] (`av_malloc_array`),
//!   [`alloc_array_zeroed`] / [`alloc_cell_array_zeroed`] (`av_calloc`),
//!   [`alloc_array_from_fn`], or `HeapVec::from_slice` and `Clone`
//!   (`av_memdup`).
//!
//! The policy frees storage only. A wrapped type whose object owns
//! sub-allocations is released by its own destructor policy instead.
//!
//! [`StringHeap`] is the same allocator as a string policy: a NUL-terminated
//! string from `av_strdup`, `av_strndup` or any other `av_malloc`-family
//! routine is a [`HeapString`], built by [`string_from_c_str`] (`av_strdup`)
//! or [`string_from_bytes_until_nul`] (`av_strndup`), `Clone` through
//! `av_strdup`, and released by `av_free`.
//!
//! The `av_realloc` family resizes those arrays: [`realloc_array`] and
//! [`realloc_bytes`] hand the array back on failure, [`realloc_array_or_free`]
//! frees it, and [`realloc_array_in_place`] / [`realloc_bytes_in_place`]
//! resize the array in a slot, leaving it empty on failure.
//! [`resize_array_with`] resizes an initialised array, filling what it adds.
//! A resized block keeps `realloc`'s alignment, not `av_malloc`'s.
//! [`checked_size_mul`] is the overflow-checked size product they compute.
//!
//! Two growable owners keep C's in-place growth protocols:
//!
//! - [`DynArray<T>`] is the `av_dynarray` family's `(tab, nb)` pair, grown by
//!   [`push_or_clear`](DynArray::push_or_clear) (`av_dynarray2_add`) and, for
//!   pointer elements, [`push_ptr_or_clear`](DynArray::push_ptr_or_clear)
//!   (`av_dynarray_add`) and [`try_push_ptr`](DynArray::try_push_ptr)
//!   (`av_dynarray_add_nofree`), and released by `av_freep`;
//! - [`FastBuffer`] and [`ZeroedFastBuffer`] are the `(ptr, size)` pair of a
//!   buffer reused while large enough, grown by `av_fast_realloc`,
//!   `av_fast_malloc` and `av_fast_mallocz`, and released by `av_free`.
//!
//! [`set_max_alloc`] sets the process-wide size limit every one of these
//! allocations obeys, and [`copy_back_reference`] is the LZ77-style
//! overlapping copy within one buffer.
use core::ffi::{CStr, c_char, c_double, c_int, c_longlong, c_uint, c_void};
use core::fmt;
use core::marker::PhantomData;
use core::mem::{MaybeUninit, align_of, size_of};
use core::ptr::NonNull;
use ffibox::{
    CAlloc, CAllocZeroed, CBox, CCell, CDrop, CDupClone, CPlainElem, CSlice, CSliceMut, CStrBox,
    CVec, CZeroable, impl_cdupclone_str, impl_clenclone, impl_clendrop,
};
use super::ffi;
/// Alignment of every `av_malloc`-family block: `ALIGN` in `mem.c` is 64, 32
/// or 16 by the build's SIMD configuration, and never less than 16.
const ALIGN: usize = 16;
/// The `av_malloc` family's allocator and `av_free`, as one policy.
///
/// Thread-agnostic: a block may be freed on any thread, so the owners it
/// parameterizes cross threads on their elements' terms.
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
pub struct Heap;
/// One object in an `av_malloc`-family block, released by `av_free`.
pub type HeapBox<T> = CBox<T, Heap>;
/// An array in an `av_malloc`-family block, released by `av_free`.
pub type HeapVec<T> = CVec<T, Heap>;
/// Wraps: av_free
// SAFETY: `av_free` releases any `av_malloc`-family block exactly once and
// never reads it, so it is sound for storage before (`MaybeUninit<T>`) and
// after it holds a `T`. It releases the storage only: a `T` owning
// sub-allocations is adopted under its own destructor policy, as `CAlloc`
// leaves to the policy to document.
unsafe impl<T> CDrop<T> for Heap {
    #[inline]
    unsafe fn c_drop(&self, ptr: NonNull<T>) {
        // SAFETY: the caller hands over a live `av_malloc`-family block whose
        // claim it owns; `av_free` releases it once.
        unsafe { ffi::av_free(ptr.as_ptr().cast()) }
    }
}
/// Wraps: av_free
///
/// # Safety
///
/// `ptr` must be a live `av_malloc`-family block the caller owns.
unsafe fn free_len(ptr: *mut u8, _byte_len: usize) {
    // SAFETY: the caller hands over a live block it owns; `av_free` releases
    // the whole block whatever its length, touching none of it.
    unsafe { ffi::av_free(ptr.cast()) }
}
impl_clendrop!(Heap, free_len);
/// Wraps: av_memdup
///
/// # Safety
///
/// `ptr` must be valid for reads of `byte_len` bytes, from any allocator.
unsafe fn memdup(ptr: *mut u8, byte_len: usize) -> *mut u8 {
    // SAFETY: the caller guarantees `byte_len` readable bytes at `ptr`, which
    // `av_memdup` only reads. It returns a fresh `av_malloc(byte_len)` block,
    // aligned to `ALIGN` and released by `av_free`, or NULL on failure.
    unsafe { ffi::av_memdup(ptr.cast_const().cast(), byte_len) }.cast()
}
impl_clenclone!(Heap, memdup, align = ALIGN);
