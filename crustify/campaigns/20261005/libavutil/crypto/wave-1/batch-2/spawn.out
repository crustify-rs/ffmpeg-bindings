//! Safe ownership and borrowing of `libavutil/murmur3.h`'s opaque context.
//!
//! Implements C's 128-bit MurmurHash3 variant for 64-bit platforms. This is a
//! non-cryptographic hash. Context storage and private layout remain C-owned.
use core::ptr::NonNull;
use ffibox::{CBox, CDrop, CNew, define_ctype};
use super::ffi;
define_ctype!(
    /// Wraps: AVMurMur3
    ///
    /// Opaque MurmurHash3 context. No private fields are exposed by C's API.
    Murmur3, Murmur3Ref, Murmur3Mut, ffi::AVMurMur3
);
/// Allocation and release policy for an initialized MurmurHash3 context.
#[derive(Clone, Copy, Debug, Default)]
pub struct Murmur3Free;
/// Sole owner of a MurmurHash3 context, released through `av_free`.
///
/// The opaque layout has no Rust size, so there is no Rust-sized allocation:
///
/// ```compile_fail,E0277
/// use ffmpeg::libavutil::murmur3::Murmur3Box;
/// let _ = Murmur3Box::new_uninit();
/// ```
pub type Murmur3Box = CBox<Murmur3, Murmur3Free>;
/// Wraps: av_free
// SAFETY: the owner hands this policy one uniquely owned av_malloc-family
// context allocation. The context has no child resources; av_free releases
// the whole allocation without reading its state.
unsafe impl CDrop<Murmur3> for Murmur3Free {
    unsafe fn c_drop(&self, ptr: NonNull<Murmur3>) {
        // SAFETY: the caller transfers the live context allocation to this
        // release policy exactly once. av_free accepts its erased pointer.
        unsafe { ffi::av_free(ptr.as_ptr().cast()) }
    }
}
/// Wraps: av_murmur3_alloc
// SAFETY: allocation uses C's full private size, init establishes all state
// invariants, and the paired release policy calls av_free exactly once.
unsafe impl CNew<Murmur3> for Murmur3Free {
    fn c_new(&self) -> Option<NonNull<Murmur3>> {
        // SAFETY: allocation has no preconditions and returns a fresh C context
        // or NULL, which is rejected before attempting initialization.
        let ptr = NonNull::new(unsafe { ffi::av_murmur3_alloc() })?;
        // SAFETY: a fresh, uniquely owned, correctly sized C context.
        unsafe { ffi::av_murmur3_init(ptr.as_ptr()) };
        Some(ptr.cast())
    }
}
impl Murmur3 {
    /// Allocate and initialize with C's fixed seed, or `None` on allocation failure.
    pub fn new() -> Option<Murmur3Box> {
        Murmur3Box::new()
    }
    /// Allocate and initialize with a caller-selected seed.
    pub fn with_seed(seed: u64) -> Option<Murmur3Box> {
        let mut context = Self::new()?;
        context.as_mut().reset_seeded(seed);
        Some(context)
    }
}
impl Murmur3Mut<'_> {
    /// Wraps: av_murmur3_init
    ///
    /// Restart hashing with C's fixed seed, discarding all previous state.
    pub fn reset(&mut self) {
        // SAFETY: the exclusive handle keeps the full C context live; init
        // initializes in place and neither reads nor retains previous input.
        unsafe { ffi::av_murmur3_init(self.as_mut_ptr()) }
    }
    /// Wraps: av_murmur3_init_seeded
    ///
    /// Restart hashing with the given seed, discarding all previous state.
    pub fn reset_seeded(&mut self, seed: u64) {
        // SAFETY: exclusive access to the full context allocation. Every u64
        // seed is accepted and init initializes all context fields in place.
        unsafe { ffi::av_murmur3_init_seeded(self.as_mut_ptr(), seed) }
    }
    /// Wraps: av_murmur3_update
    ///
    /// Append bytes, borrowed only for the duration of the C call.
    pub fn update(&mut self, data: &[u8]) {
        // SAFETY: exclusive initialized context and len readable input bytes;
        // C does not mutate or retain the input and accepts empty slices.
        unsafe { ffi::av_murmur3_update(self.as_mut_ptr(), data.as_ptr(), data.len()) }
    }
    /// Wraps: av_murmur3_final
    ///
    /// Output the 16 digest bytes in C's little-endian order. This zero-pads
    /// the partial block as C does; use [`Self::reset`] or [`Self::reset_seeded`]
    /// before starting a new message.
    pub fn finalize(&mut self) -> [u8; 16] {
        let mut digest = [0; 16];
        // SAFETY: exclusive initialized context and exactly 16 writable bytes;
        // C writes every output byte and retains neither pointer.
        unsafe { ffi::av_murmur3_final(self.as_mut_ptr(), digest.as_mut_ptr()) };
        digest
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    #[cfg_attr(miri, ignore)]
    fn allocation_failure() {
        const FLAG: &str = "CRUSTIFY_MURMUR3_FAILURE_CHILD";
        if std::env::var_os(FLAG).is_some() {
            // SAFETY: this isolated child runs only this exact test, before any
            // FFmpeg allocation, so no concurrent C allocator reads or writes
            // the process-global limit. Rust's allocator does not use this limit.
            unsafe { ffi::av_max_alloc(0) };
            assert!(Murmur3::new().is_none());
            assert!(Murmur3::with_seed(u64::MAX).is_none());
            return;
        }
        let status = std::process::Command::new(std::env::current_exe().unwrap())
            .args([
                "--exact",
                "libavutil::murmur3::unit_tests::allocation_failure",
                "--test-threads=1",
            ])
            .env(FLAG, "1")
            .status()
            .unwrap();
        assert!(status.success());
    }
    #[test]
    fn layout_and_handle_sizes() {
        use core::mem::{align_of, size_of};
        assert_eq!(size_of::<Murmur3>(), size_of::<ffi::AVMurMur3>());
        assert_eq!(align_of::<Murmur3>(), align_of::<ffi::AVMurMur3>());
        assert_eq!(size_of::<Murmur3Ref<'_>>(), size_of::<usize>());
        assert_eq!(size_of::<Murmur3Mut<'_>>(), size_of::<usize>());
        assert_eq!(size_of::<Option<Murmur3Box>>(), size_of::<usize>());
    }
    #[test]
    #[cfg_attr(miri, ignore)]
    fn owner_round_trip_and_null_adoption() {
        let owner = Murmur3::with_seed(0).unwrap();
        let ptr = owner.into_c();
        // SAFETY: into_c handed us the sole initialized C allocation, with no
        // surviving handles. Adoption restores its matching release policy.
        let mut owner = unsafe { Murmur3Box::from_c(ptr) }.unwrap();
        assert_eq!(owner.as_mut().finalize(), [0; 16]);
        // SAFETY: NULL is rejected without accessing storage or adopting it.
        assert!(unsafe { Murmur3Box::from_c(core::ptr::null_mut()) }.is_none());
    }
    #[test]
    #[cfg_attr(miri, ignore)]
    fn borrowed_raw_seams_preserve_identity() {
        let mut owner = Murmur3::new().unwrap();
        let shared = owner.as_ref();
        // SAFETY: owner keeps the context alive and only shared handles exist.
        let borrowed = unsafe { Murmur3Ref::from_ptr(shared.as_ptr().cast_mut()) }.unwrap();
        assert_eq!(borrowed.as_ptr(), shared.as_ptr());
        let mut exclusive = owner.as_mut();
        // SAFETY: exclusive is unused until this shorter exclusive borrow ends;
        // the owner keeps initialized C storage alive throughout.
        let mut borrowed = unsafe { Murmur3Mut::from_ptr(exclusive.as_mut_ptr()) }.unwrap();
        borrowed.update(b"seam");
        borrowed.reset_seeded(0);
        assert_eq!(borrowed.finalize(), [0; 16]);
    }
}
//! Safe layouts and lifecycle for `libavutil/rc4.h`.
//!
//! RC4 is obsolete and must not be used for new security-sensitive protocols.
//! The context owns no resources: it may live inline or in an [`Rc4Box`].
use core::ptr::{NonNull, addr_of, addr_of_mut};
use ffibox::{CBox, CNew, CSlice, CSliceMut, CZeroable, define_ctype};
use super::{ffi, mem::Heap};
define_ctype!(
    /// Wraps: AVRC4
    ///
    /// Resource-free RC4 state. Copies are independent stream checkpoints.
    #[derive(Clone, Copy)]
    Rc4, Rc4Ref, Rc4Mut, ffi::AVRC4
);
/// A sole C-allocated RC4 context, released by the existing [`Heap`] policy.
/// No thread-safety assertion is made for the wrapped C type:
///
/// ```compile_fail,E0277
/// use ffmpeg::libavutil::rc4::Rc4Box;
/// fn requires_send<T: Send>() {}
/// requires_send::<Rc4Box>();
/// ```
pub type Rc4Box = CBox<Rc4, Heap>;
// SAFETY: every field is an integer or byte array, and all-zero is accepted
// by every accessor and C operation. `av_rc4_crypt` truncates x/y to bytes;
// no permutation invariant is required for memory safety. Heap frees only storage.
unsafe impl CZeroable for Rc4 {}
/// Wraps: av_rc4_alloc
// SAFETY: av_rc4_alloc returns a fresh, zero-filled AVRC4 (or NULL), with
// exactly Rc4's layout; Heap releases that av_malloc-family allocation.
unsafe impl CNew<Rc4> for Heap {
    fn c_new(&self) -> Option<NonNull<Rc4>> {
        // SAFETY: the allocator has no arguments or preconditions.
        NonNull::new(unsafe { ffi::av_rc4_alloc() }.cast())
    }
}
impl Rc4 {
    /// Allocate and initialize an RC4 stream. Errors are negative AVERROR codes:
    /// EINVAL for an empty/oversized key, ENOMEM if allocation fails.
    /// Encryption and decryption use identical initialization.
    pub fn new(key: &[u8]) -> Result<Rc4Box, i32> {
        key_bits(key.len())?;
        let mut context = Rc4Box::new().ok_or(-12)?;
        context.as_mut().init(key)?;
        Ok(context)
    }
    /// Initialize resource-free, Rust-owned inline storage.
    pub fn from_key(key: &[u8]) -> Result<Self, i32> {
        let mut context = Self::zeroed();
        context.as_mut().init(key)?;
        Ok(context)
    }
}
fn key_bits(len: usize) -> Result<i32, i32> {
    if len == 0 || len > (i32::MAX / 8) as usize {
        return Err(-22);
    }
    Ok((len * 8) as i32)
}
impl<'a> Rc4Ref<'a> {
    /// Field: AVRC4.x
    pub fn x(&self) -> i32 {
        // SAFETY: the shared handle keeps this initialized integer alive.
        unsafe { addr_of!((*self.as_ptr()).x).read() }
    }
    /// Field: AVRC4.y
    pub fn y(&self) -> i32 {
        // SAFETY: the shared handle keeps this initialized integer alive.
        unsafe { addr_of!((*self.as_ptr()).y).read() }
    }
    /// Field: AVRC4.state
    ///
    /// A shared view of all 256 bytes, tied to the context borrow rather than a
    /// Rust reference over C-owned memory.
    pub fn state(&self) -> CSlice<'a, u8> {
        // SAFETY: state is an initialized inline 256-byte array in the live
        // context. Its projected pointer is non-null; the view cannot outlive
        // the context borrow or overlap any safe mutable access.
        unsafe {
            let ptr = addr_of!((*self.as_ptr()).state).cast::<u8>().cast_mut();
            CSlice::from_raw_parts(NonNull::new_unchecked(ptr), 256)
        }
    }
}
impl Rc4Mut<'_> {
    /// Wraps: av_rc4_init
    ///
    /// Reset the stream with a nonempty byte key. Rejects empty keys (C
    /// reads past them) and lengths whose bit count cannot fit a C int,
    /// leaving the old state untouched. The key is not retained.
    pub fn init(&mut self, key: &[u8]) -> Result<(), i32> {
        let bits = key_bits(key.len())?;
        // SAFETY: this handle is exclusive; C writes the complete context,
        // reads only within the nonempty key (at most its first 256 bytes),
        // and retains neither pointer. bits is a positive multiple of eight.
        let result = unsafe { ffi::av_rc4_init(self.as_mut_ptr(), key.as_ptr(), bits, 0) };
        if result < 0 { Err(result) } else { Ok(()) }
    }
    /// Set the C index verbatim; C truncates it to a byte when used.
    pub fn set_x(&mut self, value: i32) {
        // SAFETY: the exclusive handle permits writing this initialized field;
        // every i32 is valid and C indexes with its byte-sized truncation.
        unsafe { addr_of_mut!((*self.as_mut_ptr()).x).write(value) }
    }
    /// Set the C index verbatim; C truncates it to a byte when used.
    pub fn set_y(&mut self, value: i32) {
        // SAFETY: as set_x, for the y field.
        unsafe { addr_of_mut!((*self.as_mut_ptr()).y).write(value) }
    }
    /// Exclusively reborrow the 256 state bytes; arbitrary byte values are
    /// memory-safe, though changing them changes the stream algorithm.
    pub fn state_mut(&mut self) -> CSliceMut<'_, u8> {
        // SAFETY: state is an initialized inline 256-byte array; this handle
        // grants exclusive access, and the view's lifetime freezes the handle
        // until the reborrow ends. No reference covers the C array.
        unsafe {
            let ptr = addr_of_mut!((*self.as_mut_ptr()).state).cast::<u8>();
            CSliceMut::from_raw_parts(NonNull::new_unchecked(ptr), 256)
        }
    }
    /// Replace all state bytes without retaining the input.
    pub fn set_state(&mut self, state: &[u8; 256]) {
        // SAFETY: the exclusive handle permits overwriting this array;
        // all byte values are valid and reading state copies a Rust array.
        unsafe { addr_of_mut!((*self.as_mut_ptr()).state).write(*state) }
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn key_length_boundaries() {
        assert_eq!(key_bits(0), Err(-22));
        assert_eq!(key_bits(1), Ok(8));
        let max = (i32::MAX / 8) as usize;
        assert_eq!(key_bits(max), Ok(i32::MAX & !7));
        assert_eq!(key_bits(max + 1), Err(-22));
        assert_eq!(key_bits(usize::MAX), Err(-22));
    }
    #[test]
    fn inline_layout_and_copy_are_ffi_free() {
        assert_eq!(
            core::mem::size_of::<Rc4>(),
            core::mem::size_of::<ffi::AVRC4>()
        );
        assert_eq!(
            core::mem::align_of::<Rc4>(),
            core::mem::align_of::<ffi::AVRC4>()
        );
        let mut context = Rc4::zeroed();
        context.as_mut().set_x(i32::MIN);
        context.as_mut().set_y(i32::MAX);
        context.as_mut().set_state(&[7; 256]);
        let copy = context;
        assert!(context.as_mut().state_mut().set_elem(255, 9));
        assert_eq!(copy.as_ref().x(), i32::MIN);
        assert_eq!(copy.as_ref().y(), i32::MAX);
        assert_eq!(copy.as_ref().state().elem(255), Some(7));
        assert_eq!(context.as_ref().state().elem(255), Some(9));
    }
    #[test]
    fn raw_adoption_round_trip_uses_the_same_heap_policy() {
        let original = Rc4::new(b"key").unwrap();
        let ptr = original.into_c();
        // SAFETY: into_c transfers this initialized, uniquely owned allocation;
        // no intervening access occurred, and Heap releases it through av_free.
        let owner = unsafe { Rc4Box::from_c(ptr) }.unwrap();
        assert_eq!(owner.as_ref().x(), 1);
    }
    #[test]
    fn empty_key_is_rejected_without_mutating_state() {
        let mut context = Rc4::zeroed();
        context.as_mut().set_x(42);
        assert_eq!(context.as_mut().init(&[]), Err(-22));
        assert_eq!(context.as_ref().x(), 42);
        assert!(Rc4::new(&[]).is_err());
        assert!(Rc4::from_key(&[]).is_err());
    }
}
//! Safe opaque layout and lifecycle for `libavutil/ripemd.h`.
//!
//! C alone knows the context's size and private fields. No inline constructor,
//! zeroable marker or generic allocation policy is supplied for this layout.
use core::ptr::NonNull;
use ffibox::{CBox, CDrop, define_ctype};
use super::{ffi, mem::Heap};
define_ctype!(
    /// Wraps: AVRIPEMD
    ///
    /// An opaque, initialized C hashing context, held behind an [`RipemdBox`].
    Ripemd, RipemdRef, RipemdMut, ffi::AVRIPEMD
);
/// Sole ownership of a complete C-allocated hashing context.
/// No thread-safety assertion is made for the wrapped C type:
///
/// ```compile_fail,E0277
/// use ffmpeg::libavutil::ripemd::RipemdBox;
/// fn requires_send<T: Send>() {}
/// requires_send::<RipemdBox>();
/// ```
pub type RipemdBox = CBox<Ripemd, RipemdFree>;
/// Storage-only release through the existing av_malloc-family policy. Unlike
/// Heap, this policy offers no generic allocator for the incomplete C layout.
#[derive(Clone, Copy, Debug, Default)]
pub struct RipemdFree;
// SAFETY: RipemdBox adopts only av_ripemd_alloc storage, released by Heap's
// av_free policy; the context has no owned sub-allocations or field disposer.
unsafe impl CDrop<Ripemd> for RipemdFree {
    unsafe fn c_drop(&self, ptr: NonNull<Ripemd>) {
        // SAFETY: CDrop's caller transfers the unique av_malloc-family claim.
        unsafe { <Heap as CDrop<Ripemd>>::c_drop(&Heap, ptr) }
    }
}
/// The four digest sizes accepted by C initialization.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum DigestBits {
    Bits128,
    Bits160,
    Bits256,
    Bits320,
}
impl DigestBits {
    /// Number of bits in the digest.
    pub const fn bits(self) -> i32 {
        match self {
            Self::Bits128 => 128,
            Self::Bits160 => 160,
            Self::Bits256 => 256,
            Self::Bits320 => 320,
        }
    }
    /// Number of output bytes required by this algorithm.
    pub const fn digest_len(self) -> usize {
        (self.bits() / 8) as usize
    }
}
impl TryFrom<i32> for DigestBits {
    type Error = i32;
    fn try_from(bits: i32) -> Result<Self, Self::Error> {
        match bits {
            128 => Ok(Self::Bits128),
            160 => Ok(Self::Bits160),
            256 => Ok(Self::Bits256),
            320 => Ok(Self::Bits320),
            _ => Err(-22),
        }
    }
}
impl Ripemd {
    /// Wraps: av_ripemd_alloc
    ///
    /// Allocate through C and initialize for the chosen digest size before
    /// publishing the owner. None means C allocation failed.
    pub fn new(bits: DigestBits) -> Option<RipemdBox> {
        // SAFETY: C's allocator has no arguments or preconditions and returns
        // its actual private context size, zero-filled, or NULL.
        let ptr = NonNull::new(unsafe { ffi::av_ripemd_alloc() })?;
        // SAFETY: ptr uniquely owns the full C allocation. Initialization
        // writes the active state and installs a static transform function;
        // the enum admits only supported sizes, for which C returns zero.
        let result = unsafe { ffi::av_ripemd_init(ptr.as_ptr(), bits.bits()) };
        // No Rust operation can unwind between allocation and initialization.
        // Account for a mismatched foreign implementation without leaking.
        if result < 0 {
            // SAFETY: the unpublished av_malloc-family block is owned here;
            // av_free reads none of its possibly incomplete contents.
            unsafe { ffi::av_free(ptr.as_ptr().cast()) };
            return None;
        }
        // SAFETY: C has now fully initialized the context for every safe
        // operation. Ownership is unique and RipemdFree pairs it with av_free.
        unsafe { RipemdBox::from_c(ptr.as_ptr()) }
    }
}
impl RipemdMut<'_> {
    /// Wraps: av_ripemd_init
    ///
    /// Reset the context for a supported digest size. C retains no pointer
    /// to caller-owned data. Returns C's status (zero for these four sizes).
    pub fn init(&mut self, bits: DigestBits) -> Result<(), i32> {
        // SAFETY: this handle exclusively borrows a full initialized C
        // context; bits admits only sizes C accepts. C retains no pointer.
        let result = unsafe { ffi::av_ripemd_init(self.as_mut_ptr(), bits.bits()) };
        if result < 0 { Err(result) } else { Ok(()) }
    }
}
/// Wraps: av_ripemd_size
///
/// The C context's size in bytes, borrowed from immutable C static storage.
pub fn context_size() -> &'static i32 {
    // SAFETY: C defines this global as `const int = sizeof(context)`; it has
    // static lifetime and no writer anywhere in the library.
    unsafe { &ffi::av_ripemd_size }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn digest_sizes_are_exhaustive_and_ffi_free() {
        for (bits, len) in [(128, 16), (160, 20), (256, 32), (320, 40)] {
            let size = DigestBits::try_from(bits).unwrap();
            assert_eq!(size.bits(), bits);
            assert_eq!(size.digest_len(), len);
        }
        for bits in [i32::MIN, -1, 0, 127, 129, 512, i32::MAX] {
            assert_eq!(DigestBits::try_from(bits), Err(-22));
        }
    }
    #[test]
    fn raw_adoption_round_trip_keeps_the_full_c_allocation() {
        let owner = Ripemd::new(DigestBits::Bits320).unwrap();
        let ptr = owner.into_c();
        // SAFETY: into_c transfers the initialized unique allocation, and
        // RipemdFree is its matching storage-only av_free release policy.
        let mut owner = unsafe { RipemdBox::from_c(ptr) }.unwrap();
        owner.as_mut().init(DigestBits::Bits128).unwrap();
    }
}
