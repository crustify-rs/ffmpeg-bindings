 entries=[f for f in cov['files'] if f['file'].endswith('/'+m+'.c')]
 f=entries[0]
 funcs={x['name']:x['execution_count'] for x in f['functions']}
 lines=f['lines']; selected=[x for x in lines if x.get('function_name','') in Path('/tmp/crustify-crypto-b2/names').read_text().split()]
 print(m,'TU',sum(x['count']>0 for x in lines),'/',len(lines),'selected',sum(x['count']>0 for x in selected),'/',len(selected))
 print('uncovered selected',[(x['line_number'],x.get('function_name')) for x in selected if x['count']==0]);print('functions',funcs)
 rows[m]={'tu_lines_hit':sum(x['count']>0 for x in lines),'tu_lines':len(lines),'selected_lines_hit':sum(x['count']>0 for x in selected),'selected_lines':len(selected),'functions':funcs,'uncovered':[(x['line_number'],x.get('function_name')) for x in selected if x['count']==0]}
(D/'c-summary.json').write_text(json.dumps(rows,indent=2))
TC=Path('/root/.rustup/toolchains/nightly-x86_64-unknown-linux-gnu/lib/rustlib/x86_64-unknown-linux-gnu/bin')
profiles=list(D.glob('*.profraw'));subprocess.run([str(TC/'llvm-profdata'),'merge','-sparse','-o',str(D/'rust.profdata'),*map(str,profiles)],check=True)
exes=[p for p in Path('/tmp/crustify-crypto-b2/cov-target/debug/deps').glob('*') if p.name.split('-')[0] in ['ffmpeg','equiv','ub_safe','ub_unsafe'] and p.is_file() and p.stat().st_mode&0o111]
cmd=[str(TC/'llvm-cov'),'export','-format=lcov','-instr-profile',str(D/'rust.profdata'),str(exes[0])]
for exe in exes[1:]: cmd+=['-object',str(exe)]
lcov=subprocess.run(cmd,capture_output=True,text=True,check=True).stdout;(D/'rust.lcov').write_text(lcov)
cur=None;hit={}
for l in lcov.splitlines():
 if l.startswith('SF:'):cur=l[3:]
 if cur and any(cur.endswith('/libavutil/'+m+'.rs') for m in mods) and l.startswith('DA:'):
  line,count=l[3:].split(',')[:2];hit.setdefault(cur,{})[int(line)]=hit.get(cur,{}).get(int(line),0)+int(count)
for path,lines in hit.items():
 source=Path(path).read_text().splitlines();end=next((i+1 for i,s in enumerate(source) if s=='#[cfg(test)]'),len(source)+1)
 relevant={i:c for i,c in lines.items() if i<end}
 print(Path(path).name,'Rust production',sum(c>0 for c in relevant.values()),'/',len(relevant),'uncovered',[(i,source[i-1].strip()) for i,c in relevant.items() if c==0])
