/opt/venv/bin/wavefront . --config crustify/wavefront/configs/wavefront-config.json query symbols --name $(cat /tmp/crustify-crypto-w1-b0/names) --callees --depth 3 > /tmp/crustify-crypto-w1-b0/callees.json' in /target/crustify/.worktrees/crustify/batches/20261005/libavutil/crypto/wave-1/batch-0
