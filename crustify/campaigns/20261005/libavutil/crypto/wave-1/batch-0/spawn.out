{method}(&mut data, &[0; {b}], Some(&mut iv), Direction::Encrypt), Err(CryptError::LengthMismatch));         assert_eq!(context.as_mut().{method}_in_place(&mut data[..{b}-1], Some(&mut iv), Direction::Decrypt), Err(CryptError::IncompleteBlock));         assert_eq!(data, [0x99; {b}*2]);         assert_eq!(iv, [0x77; {b}]);     }}  '''         s=s[:idx]+unit+s[idx:];p.write_text(s) PY python3 /tmp/crustify-crypto-w1-b0/tests.py CARGO_TARGET_DIR=/tmp/crustify-crypto-w1-b0/plain cargo check -p libavutil-sys --manifest-path crustify/rust/Cargo.toml > /tmp/crustify-crypto-w1-b0/sys-check.log 2>&1 && CARGO_TARGET_DIR=/tmp/crustify-crypto-w1-b0/plain cargo test -p libavutil-sys --manifest-path crustify/rust/Cargo.toml > /tmp/crustify-crypto-w1-b0/sys-test.log 2>&1 CARGO_TARGET_DIR=/tmp/crustify-crypto-w1-b0/plain cargo test -p ffmpeg --manifest-path crustify/rust/Cargo.toml --lib --tests --no-run > /tmp/crustify-crypto-w1-b0/compile.log 2>&1; tail -80 /tmp/crustify-crypto-w1-b0/compile.log
