/bin/bash -lc "cat > /tmp/crustify-crypto-w1-b0/emit.py <<'PY'
from pathlib import Path
base=Path('crustify/rust/ffmpeg/libavutil')
aes=base/'aes.rs'
s=aes.read_text().replace('//"'! Processing routines are wrapped by the symbol batch, not this lifecycle module.'"','//"'! Processing borrows buffers synchronously, with distinct disjoint and in-place APIs.'"')
pos=s.index('/// Failure to construct')
s=s[:pos]+'''/// Buffer validation failure. Rejected calls leave context, output and IV unchanged.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum CryptError {
    LengthMismatch,
    IncompleteBlock,
    CountOverflow,
}
impl fmt::Display for CryptError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str(match self {
            Self::LengthMismatch => \"source and destination lengths differ\",
            Self::IncompleteBlock => \"buffer length is not a whole number of blocks\",
            Self::CountOverflow => \"buffer count exceeds C's int range\",
        })
    }
}
impl std::error::Error for CryptError {}
pub(crate) fn buffer_count(dst_len: usize, src_len: usize, block: usize) -> Result<i32, CryptError> {
    if dst_len "'!= src_len {
        return Err(CryptError::LengthMismatch);
    }
    if !src_len.is_multiple_of(block) {
        return Err(CryptError::IncompleteBlock);
    }
    i32::try_from(src_len / block).map_err(|_| CryptError::CountOverflow)
}
'"'''+s[pos:]
aes.write_text(s)
for module,ty,block in [('aes','Aes',16),('blowfish','Blowfish',8),('camellia','Camellia',16),('cast5','Cast5',8)]:
    file=base/(module+'.rs'); s=file.read_text()
    if module"'!='"'aes': s+='\\nuse super::aes::{CryptError, Direction, buffer_count};\\n'
    functions=[('crypt','av_'+module+'_crypt', module"'!='"'cast5')]
    if module=='cast5': functions+=[('crypt_cbc','av_cast5_crypt2',True)]
    for method,fn,hasiv in functions:
        ivarg=f', iv: Option<&mut [u8; {block}]>' if hasiv else ''
        dirarg=', direction: Direction' if module"'!='"'aes' else ''
        ivcall=', iv.map_or(core::ptr::null_mut(), |iv| iv.as_mut_ptr())' if hasiv else ''
        direction='direction.as_int()' if module"'!='"'aes' else '0'
        lock='        let _guard = lock_c_access();\\n' if module=='camellia' else ''
        anchor='    /// Wraps: '+fn+'\\n'
        description=('    /// Process whole blocks with the direction selected by initialization.\\n'
                     '    /// C ignores its redundant decrypt argument.\\n') if module=='aes' else '    /// Encrypt or decrypt whole blocks.\\n'
        if hasiv: description+='    /// "'`None` selects ECB; `Some` selects CBC and updates the IV after each block.'"\\n'
        description+='    /// Buffers must have equal lengths; errors leave all state unchanged.\\n'
        if module=='aes': description+='    /// These modes provide no authentication or padding.\\n'
        s+=f'''\\nimpl {ty}Mut<'_> {{
{anchor}    ///
{description}    pub fn {method}(&mut self, dst: &mut [u8], src: &[u8]{ivarg}{dirarg}) -> Result<(), CryptError> {{
        let count = buffer_count(dst.len(), src.len(), {block})?;
        if count == 0 {{ return Ok(()); }}
{lock}        // SAFETY: the exclusive handle addresses an initialized full context;
        // equal-length disjoint slices hold count whole blocks, and any IV is
        // a separate writable {block}-byte array. C retains no buffer pointers.
'''
        if module=='camellia': s+='        // The guard also excludes every safe writer/reader of C\\'s global SP.\\n'
        s+=f'''        unsafe {{ ffi::{fn}(self.as_mut_ptr(), dst.as_mut_ptr(), src.as_ptr(), count{ivcall}, {direction}) }};
        Ok(())
    }}
    /// In-place form of ["'`Self::{method}`], with the same modes and validation.
    pub fn {method}_in_place(&mut self, data: &mut [u8]{ivarg}{dirarg}) -> Result<(), CryptError> {{
        let count = buffer_count(data.len(), data.len(), {block})?;
        if count == 0 {{ return Ok(()); }}
{lock}        let ptr = data.as_mut_ptr();
        // SAFETY: one exclusive slice provides count whole readable/writable
        // blocks. C explicitly supports src == dst, preserving ciphertext before
        // CBC decryption writes it. The initialized context and optional IV are
        // exclusively borrowed and disjoint; no pointer is retained.
'"'''
        if module=='camellia': s+='        // The guard excludes all safe accesses to the shared C lookup table.\\n'
        s+=f'''        unsafe {{ ffi::{fn}(self.as_mut_ptr(), ptr, ptr, count{ivcall}, {direction}) }};
        Ok(())
