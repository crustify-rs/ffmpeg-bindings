s=s.replace('pub fn get() -> u32 {\\n', 'pub fn get() -> u32 {\\n    let _guard = lock_seed_access();\\n').replace('// preconditions; it fills a local of its own.', '// pointer preconditions. The lock excludes other safe users of its\\n    // static timing-jitter fallback state.')
