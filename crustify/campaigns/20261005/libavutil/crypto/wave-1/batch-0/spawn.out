static int read_random(uint8_t *dst, size_t len, const char *file)
{
#if HAVE_UNISTD_H
    FILE *fp = avpriv_fopen_utf8(file, "r");
    size_t err;
    if (!fp)
        return AVERROR_UNKNOWN;
    setvbuf(fp, NULL, _IONBF, 0);
    err = fread(dst, 1, len, fp);
    fclose(fp);
    if (err != len)
        return AVERROR_UNKNOWN;
    return 0;
#else
    return AVERROR(ENOSYS);
#endif
}
