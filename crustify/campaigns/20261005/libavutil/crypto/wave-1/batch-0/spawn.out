pub fn context_size() -> &'static i32 {
    // SAFETY: C defines this global as `const int = sizeof(context)`; it has
    // static lifetime and no writer anywhere in the library.
    unsafe { &ffi::av_camellia_size }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    #[cfg(not(miri))]
    fn rejected_buffers_are_atomic() {
        let key = [0; 16];
        let mut context = Camellia::new(&key).unwrap();
        let mut data = [0x99; 16 * 2];
        let mut iv = [0x77; 16];
        assert_eq!(
            context
                .as_ref()
                .crypt(&mut data, &[0; 16], Some(&mut iv), Direction::Encrypt),
            Err(CryptError::LengthMismatch)
        );
        assert_eq!(
            context
                .as_ref()
                .crypt_in_place(&mut data[..16 - 1], Some(&mut iv), Direction::Decrypt),
            Err(CryptError::IncompleteBlock)
        );
        assert_eq!(data, [0x99; 16 * 2]);
        assert_eq!(iv, [0x77; 16]);
    }
    #[test]
    fn invalid_key_lengths() {
        for len in [0, 1, 15, 17, 23, 25, 31, 33] {
            assert!(matches!(
                Camellia::new(&vec![0; len]),
                Err(InitError::InvalidKeyLength)
            ));
        }
        assert_eq!(key_bits(&[0; 16]), Ok(128));
        assert_eq!(key_bits(&[0; 24]), Ok(192));
        assert_eq!(key_bits(&[0; 32]), Ok(256));
    }
    #[test]
    fn lock_recovers_after_rust_unwind() {
        let unwind = std::panic::catch_unwind(|| {
            let _guard = lock_c_access();
            panic!("exercise lock poisoning without touching C");
        });
        assert!(unwind.is_err());
        drop(lock_c_access());
    }
    #[test]
    fn raw_owner_round_trip() {
        let context = Camellia::new(&[0; 16]).unwrap();
        let ptr = context.into_c();
        // SAFETY: ptr came from this owner's into_c; no intervening access or
        // free occurred, and its unique ownership is transferred back once.
        let mut context = unsafe { CamelliaBox::from_c(ptr) }.unwrap();
        context.as_mut().init(&[1; 32]).unwrap();
    }
}
use super::aes::{CryptError, Direction, buffer_count};
impl CamelliaRef<'_> {
    /// Wraps: av_camellia_crypt
    ///
    /// Encrypt or decrypt whole blocks.
    /// `None` selects ECB; `Some` selects CBC and updates the IV after each block.
    /// Buffers must have equal lengths; errors leave all state unchanged.
    pub fn crypt(
        &self,
        dst: &mut [u8],
        src: &[u8],
        iv: Option<&mut [u8; 16]>,
        direction: Direction,
    ) -> Result<(), CryptError> {
        let count = buffer_count(dst.len(), src.len(), 16)?;
        if count == 0 {
            return Ok(());
        }
        let _guard = lock_c_access();
        // SAFETY: the shared handle addresses an initialized full context;
        // equal-length disjoint slices hold count whole blocks, and any IV is
        // a separate writable 16-byte array. C retains no buffer pointers.
        // The guard also excludes every safe writer/reader of C's global SP.
        unsafe {
            ffi::av_camellia_crypt(
                self.as_ptr().cast_mut(),
                dst.as_mut_ptr(),
                src.as_ptr(),
                count,
                iv.map_or(core::ptr::null_mut(), |iv| iv.as_mut_ptr()),
                direction.as_int(),
            )
        };
        Ok(())
    }
    /// In-place form of [`Self::crypt`], with the same modes and validation.
    pub fn crypt_in_place(
        &self,
        data: &mut [u8],
        iv: Option<&mut [u8; 16]>,
        direction: Direction,
    ) -> Result<(), CryptError> {
        let count = buffer_count(data.len(), data.len(), 16)?;
        if count == 0 {
            return Ok(());
        }
        let _guard = lock_c_access();
        let ptr = data.as_mut_ptr();
        // SAFETY: one exclusive slice provides count whole readable/writable
        // blocks. C explicitly supports src == dst, preserving ciphertext before
        // CBC decryption writes it. The initialized context and optional IV are
        // borrowed without writers and disjoint; no pointer is retained.
        // The guard excludes all safe accesses to the shared C lookup table.
        unsafe {
            ffi::av_camellia_crypt(
                self.as_ptr().cast_mut(),
                ptr,
                ptr,
                count,
                iv.map_or(core::ptr::null_mut(), |iv| iv.as_mut_ptr()),
                direction.as_int(),
            )
        };
        Ok(())
    }
}
    /// Their representation is architecture-dependent.
    pub fn entries(&self) -> &[u32] {
        &self.entries
    }
    /// Wraps: av_crc
    ///
    /// Update a CRC from its previous value (or the polynomial's initial value).
    /// For non-little-endian tables C uses its documented byte-swapped form.
    pub fn update(&self, initial: u32, input: &[u8]) -> u32 {
        // SAFETY: private entries came from successful initialization and cannot
        // be modified through this shared borrow; the full allocation stays alive.
        unsafe { update_raw(self.entries.as_ptr(), initial, input) }
    }
}
/// A copyable, shared handle to C's immutable process-lifetime standard table.
///
/// This stores its identifier rather than a fixed-size slice: accelerated C
/// tables can have only 17 words, unlike the generic 1024-word tables. No C
/// memory is owned, exposed as a Rust reference, modified or freed by the handle.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct StandardTable {
    id: CrcId,
}
/// Wraps: av_crc_get_table
///
/// Borrow a standard table. Unknown identifiers return `None`. C initializes
/// generic tables under its once-control before returning; later uses are read-only.
pub fn get_table(id: CrcId) -> Option<StandardTable> {
    // SAFETY: C validates every enum encoding and returns NULL for unsupported
    // values, or a fully initialized immutable table with static lifetime.
    let ptr = unsafe { ffi::av_crc_get_table(id.into_raw()) };
    (!ptr.is_null()).then_some(StandardTable { id })
}
impl StandardTable {
    /// Update through the borrowed standard table, without changing it.
    pub fn update(&self, initial: u32, input: &[u8]) -> u32 {
        // SAFETY: get_table admitted only supported identifiers. Every lookup
        // returns an initialized immutable static table; C retains no input.
        unsafe { update_raw(ffi::av_crc_get_table(self.id.into_raw()), initial, input) }
    }
}
/// # Safety
/// `table` must address an initialized table accepted by av_crc, kept alive
/// and immutable for this synchronous call (including any dispatch constants).
unsafe fn update_raw(table: *const u32, initial: u32, input: &[u8]) -> u32 {
    // Give even a short/empty input a live prefix and suffix: the generic
    // fast C path forms `end - 3` before checking the loop condition. This
    // keeps that pointer within an allocation, including at length zero.
    if input.len() < 3 {
        let mut padded = [0u8; 8];
        padded[3..3 + input.len()].copy_from_slice(input);
        // SAFETY: the caller supplies an initialized C table.
        // Input lives at offset 3 in an 8-byte allocation, so C's pointer
        // arithmetic is in bounds, and it reads only input.len() bytes.
        unsafe { ffi::av_crc(table, initial, padded.as_ptr().add(3), input.len()) }
    } else {
        // SAFETY: the caller guarantees an initialized, unmodified table; the input is
        // readable for its length, and `end - 3` remains in bounds.
        // C retains no pointers and writes neither shared input.
        unsafe { ffi::av_crc(table, initial, input.as_ptr(), input.len()) }
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn standard_handle_traits() {
        let table = StandardTable { id: CrcId::ATM_8 };
        let copy = table;
        assert_eq!(table, copy);
        assert!(format!("{copy:?}").contains("ATM_8"));
    }
    #[test]
    fn layout_and_unknown_values() {
        assert_eq!(size_of::<CrcId>(), size_of::<ffi::AVCRCId>());
        assert_eq!(align_of::<CrcId>(), align_of::<ffi::AVCRCId>());
        for value in [0, 7, 8, 9, u32::MAX] {
            let id = CrcId::from(ffi::AVCRCId(value));
            let raw: ffi::AVCRCId = id.into();
            assert_eq!(raw.0, value);
        }
        assert_eq!(
            format!("{:?}", CrcId::from_raw(ffi::AVCRCId(99))),
            "CrcId(99)"
        );
    }
    #[test]
    fn constant_debug_names() {
        for (id, name) in [
            (CrcId::ATM_8, "ATM_8"),
            (CrcId::ANSI_16, "ANSI_16"),
            (CrcId::CCITT_16, "CCITT_16"),
            (CrcId::IEEE_32, "IEEE_32"),
            (CrcId::IEEE_32_LE, "IEEE_32_LE"),
            (CrcId::ANSI_16_LE, "ANSI_16_LE"),
            (CrcId::IEEE_24, "IEEE_24"),
            (CrcId::EBU_8, "EBU_8"),
        ] {
            assert_eq!(format!("{id:?}"), format!("CrcId::{name}"));
        }
    }
    #[test]
    fn invalid_parameters_are_errors() {
        for bits in [0, 7, 33, 255] {
            assert!(Table::new(false, bits, 1, TableSize::Compact).is_err());
        }
        assert!(Table::new(true, 8, 256, TableSize::Fast).is_err());
    }
    #[test]
    fn table_traits_and_debug() {
        let size = TableSize::Fast;
        assert_eq!(size, TableSize::Fast);
        assert_ne!(size, TableSize::Compact);
        assert_eq!(format!("{size:?}"), "Fast");
        let table = Table::new(true, 32, 0xedb88320, size).unwrap();
        let clone = table.clone();
        assert_eq!(table.entries(), clone.entries());
        assert!(format!("{clone:?}").starts_with("Table { entries:"));
    }
}
