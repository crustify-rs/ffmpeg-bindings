//! UB tests against the safe public API.
#![forbid(unsafe_code)]
mod aes;
mod aes_ctr;
mod avstring;
mod avutil;
mod blowfish;
mod bprint;
mod bswap;
mod cast5;
mod crc;
mod channel_layout;
mod common;
mod cpu;
mod csp;
mod des;
mod dict;
mod error;
mod eval;
mod file;
mod hash;
