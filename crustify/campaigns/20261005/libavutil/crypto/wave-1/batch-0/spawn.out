use ffmpeg::libavutil::aes_ctr::{AesCtr, AesCtrRef};
fn shared_views(view: AesCtrRef<'_>) {
    let _copy = view;
    let _second = view;
}
#[test]
fn lifecycle_reborrows() {
    for seed in 0..32 {
        let mut owner = {
            let key = [seed; 16];
            AesCtr::new(&key).unwrap()
        }; // the constructor must copy, not retain, the stack key.
        shared_views(owner.as_ref());
        let mut handle = owner.as_mut();
        shared_views(handle.as_ref());
        {
            let mut reborrow = handle.as_mut();
            reborrow.init(&[seed + 1; 16]).unwrap();
            shared_views(reborrow.as_ref());
        }
        handle.init(&[seed + 2; 16]).unwrap();
        shared_views(handle.as_ref());
    }
}
use ffmpeg::libavutil::cast5::{Cast5, InitError};
#[test]
fn keys_are_copied_and_handles_reborrow_exclusively() {
    for initial_len in 5..=16 {
        let mut owner = {
            let key = vec![0xa5; initial_len];
            Cast5::new(&key).unwrap()
        }; // No key storage remains alive here.
        let shared = owner.as_ref();
        let _shared_copy = shared;
        let mut exclusive = owner.as_mut();
        for len in 5..=16 {
            let key = vec![len as u8; len];
            exclusive.as_mut().init(&key).unwrap();
            let _shared_reborrow = exclusive.as_ref();
        }
        for len in [0, 1, 4, 17, 64] {
            assert_eq!(
                exclusive.init(&vec![0; len]),
                Err(InitError::InvalidKeyLength)
            );
        }
        exclusive.init(&[0; 5]).unwrap();
    } // Each allocation freed once, after all of its handles expire.
}
#[test]
fn repeated_construction_and_destruction() {
    for i in 0..256 {
        let mut owner = Cast5::new(&[i as u8; 16]).unwrap();
        owner.as_mut().init(&[i as u8; 5]).unwrap();
    }
}
#[test]
fn allocation_failure_returns_an_error_without_an_owner() {
    // Isolate the process-wide allocator limit from every other test.
    const ISOLATED: &str = "CRUSTIFY_CAST5_ALLOC_FAILURE_CHILD";
    if std::env::var_os(ISOLATED).is_none() {
        let status = std::process::Command::new(std::env::current_exe().unwrap())
            .args([
                "--exact",
                "cast5::allocation_failure_returns_an_error_without_an_owner",
                "--test-threads=1",
            ])
            .env(ISOLATED, "1")
            .status()
            .unwrap();
        assert!(status.success());
        return;
    }
    ffmpeg::libavutil::mem::set_max_alloc(0);
    assert!(matches!(
        Cast5::new(&[0; 5]),
        Err(InitError::AllocationFailed)
    ));
    // Invalid input is still rejected before even attempting allocation.
    assert!(matches!(
        Cast5::new(&[0; 4]),
        Err(InitError::InvalidKeyLength)
    ));
    ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
    drop(Cast5::new(&[0; 16]).unwrap());
}
use ffmpeg::libavutil::cast5::context_size;
#[test]
fn batch10_immutable_size_across_threads() {
    let size: &'static i32 = context_size();
    assert!(*size > 0);
    let workers: Vec<_> = (0..4)
        .map(|_| {
            std::thread::spawn(move || {
                for _ in 0..100 {
                    assert!(std::ptr::eq(size, context_size()));
                }
            })
        })
        .collect();
    for worker in workers {
        worker.join().unwrap();
    }
}
//! Observe the private lifecycle state through the unchanged C processing API.
use ffmpeg::libavutil::{aes_ctr::AesCtr, ffi};
struct Reference(*mut ffi::AVAESCTR);
impl Reference {
    fn new() -> Self {
        // SAFETY: allocation has no preconditions; the test releases it once.
        let ptr = unsafe { ffi::av_aes_ctr_alloc() };
        assert!(!ptr.is_null());
        Self(ptr)
    }
}
impl Drop for Reference {
    fn drop(&mut self) {
        // SAFETY: this fixture solely owns the C allocation.
        unsafe { ffi::av_aes_ctr_free(self.0) }
    }
}
/// # Safety
/// ptr must be an initialized full CTR context, exclusively accessed for this call.
unsafe fn observe(ptr: *mut ffi::AVAESCTR, len: usize) -> (Vec<u8>, [u8; 16]) {
    let input = vec![0x61; len.max(1)];
    let mut output = vec![0; len.max(1)];
    // SAFETY: caller supplies exclusive initialized context; buffers are valid
    // for len bytes, including a real address on the zero-length path.
    unsafe { ffi::av_aes_ctr_crypt(ptr, output.as_mut_ptr(), input.as_ptr(), len as i32) };
    // SAFETY: get_iv returns the inline, fully initialized counter[16]. Copy it
    // immediately; no reference to C memory survives a subsequent write or free.
    let iv = unsafe { ffi::av_aes_ctr_get_iv(ptr).cast::<[u8; 16]>().read() };
    output.truncate(len);
    (output, iv)
}
#[test]
fn constructors_and_reset_partial_block_match_c() {
    let reference = Reference::new();
    let mut key = [0x42; 16];
    let mut owner = AesCtr::new(&key).unwrap();
    assert_eq!(
        // SAFETY: full reference storage and exactly 16 key bytes, copied by C.
        unsafe { ffi::av_aes_ctr_init(reference.0, key.as_ptr()) },
        0
    );
    key.fill(0); // initialization must not retain the key.
    for seed in 0..3 {
        for len in [0, 1, 15, 17, 31, 1] {
            // SAFETY: both contexts initialized and exclusively observed.
            let actual = unsafe { observe(owner.as_c_ptr(), len) };
            // SAFETY: independently owned initialized reference context.
            let expected = unsafe { observe(reference.0, len) };
            assert_eq!(actual, expected);
        }
        // Reset after ending on a partial block: next crypt must not use old scratch.
        owner.as_mut().init(&[seed; 16]).unwrap();
        assert_eq!(
            // SAFETY: full reference allocation, exactly 16 key bytes, no retained alias.
            unsafe { ffi::av_aes_ctr_init(reference.0, [seed; 16].as_ptr()) },
            0
        );
        // SAFETY: both have just been reinitialized; counters must be zero.
        let actual = unsafe { observe(owner.as_c_ptr(), 0) };
        // SAFETY: same initialized reference allocation.
        let expected = unsafe { observe(reference.0, 0) };
        assert_eq!(actual, (Vec::new(), [0; 16]));
        assert_eq!(actual, expected);
    }
}
