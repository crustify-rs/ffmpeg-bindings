symbol\n        // batch.', '// Observe the Rust schedule through the safe cipher wrapper.')  # Extra invalid-init checkpoint in Twofish.  s=re.sub(r'\s*ffi::av_twofish_crypt\(\s*owner.as_c_ptr\(\),\s*output.as_mut_ptr\(\),\s*input.as_ptr\(\),\s*3,\s*core::ptr::null_mut\(\),\s*0,\s*\);','\n            owner.as_mut().crypt(&mut output, &input, None, false).unwrap();',s)  # Safe-side wrappers should not remain surrounded by unnecessary unsafe blocks.  s=re.sub(r'                unsafe \{\n(\s*constructed.as_mut\(\).*?;)\n                \}',r'\1',s,flags=re.S)  p.write_text(s) p=base/'equiv/rc4.rs';s=p.read_text();s=re.sub(r'\s*ffi::av_rc4_crypt\(\s*wrapped.as_c_ptr\(\),\s*actual.as_mut_ptr\(\),\s*core::ptr::null\(\),\s*count as i32,\s*core::ptr::null_mut\(\),\s*0,\s*\);','',s);s=s.replace('                assert_eq!(actual, expected);','                wrapped.as_mut().keystream(&mut actual).unwrap();\n                assert_eq!(actual, expected);');p.write_text(s) # Safe UB tests, one exact-name case per TU for BSan foreign writes/reborrows. for mod,ty,variants in [('ripemd','Ripemd','[DigestBits::Bits128, DigestBits::Bits160, DigestBits::Bits256, DigestBits::Bits320]'),('sha','Sha','ALGORITHMS'),('sha512','Sha512','ALGORITHMS')]:  p=base/f'ub_safe/{mod}.rs';s=p.read_text();s+=f''' #[test] fn batch2_foreign_writes_across_reborrows() {{     let data: Vec<u8> = (0..1025).map(|i| i as u8).collect();     for algorithm in {variants} {{         let mut owner = {ty}::new(algorithm).unwrap();         for length in [0, 1, 55, 56, 63, 64, 65, 111, 112, 127, 128, 129, 1025] {{             let mut parent = owner.as_mut();             { 'parent.init(algorithm).unwrap();' if mod=='ripemd' else 'parent.init(algorithm);' }             for chunk in data[..length].chunks(7) {{                 let mut input = chunk.to_vec();                 parent.as_mut().update(&input);                 input.fill(0); // input is not retained across the next reborrow             }}             parent