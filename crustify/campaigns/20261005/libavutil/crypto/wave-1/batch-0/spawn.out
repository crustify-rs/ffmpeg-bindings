/// Observe an initialized, exclusively accessed C context.
/// # Safety
/// ptr must address a full initialized AES context; no other handle is used here.
unsafe fn observe(ptr: *mut ffi::AVAES, direction: Direction) -> ([u8; 64], [u8; 16]) {
    let input = [0x45; 64];
    let mut output = [0; 64];
    let mut iv = [0x31; 16];
    let decrypt = i32::from(direction == Direction::Decrypt);
    for offset in [0, 32] {
        // SAFETY: caller provides a live initialized context. These disjoint
        // local buffers each have 32 bytes at offset; IV is writable for 16 bytes.
        unsafe {
            ffi::av_aes_crypt(
                ptr,
                output.as_mut_ptr().add(offset),
                input.as_ptr().add(offset),
                2,
                iv.as_mut_ptr(),
                decrypt,
            )
        };
    }
    (output, iv)
}
#[test]
fn constructors_and_reinitialization_match_c() {
    let reference = Reference::new();
    for direction in [Direction::Encrypt, Direction::Decrypt] {
        for len in [16, 24, 32] {
            let mut key = vec![0x91; len];
            let mut owner = Aes::new(&key, direction).unwrap();
            assert_eq!(
                // SAFETY: reference owns full C storage; key has exactly len valid bytes.
                unsafe {
                    ffi::av_aes_init(
                        reference.0,
                        key.as_ptr(),
                        (len * 8) as i32,
                        i32::from(direction == Direction::Decrypt),
                    )
                },
                0
            );
            key.fill(0); // both initializers copied the original key.
            // SAFETY: both independently owned contexts have been initialized;
            // no borrowed handle remains alive across their exclusive C observers.
            assert_eq!(unsafe { observe(owner.as_c_ptr(), direction) }, unsafe {
                observe(reference.0, direction)
            });
            for next_len in [32, 24, 16] {
                let key = vec![next_len as u8; next_len];
                owner.as_mut().init(&key, direction).unwrap();
                assert_eq!(
                    // SAFETY: full reference storage, valid key length; no retained alias.
                    unsafe {
                        ffi::av_aes_init(
                            reference.0,
                            key.as_ptr(),
                            (next_len * 8) as i32,
                            i32::from(direction == Direction::Decrypt),
                        )
                    },
                    0
                );
                // SAFETY: successful reinitialization restored both key schedules.
                let actual = unsafe { observe(owner.as_c_ptr(), direction) };
                // SAFETY: same reference context validity and exclusive access.
                let expected = unsafe { observe(reference.0, direction) };
                assert_eq!(actual, expected);
            }
        }
    }
}
use ffmpeg::libavutil::aes;
#[test]
fn batch10_size_is_the_c_global() {
    for _ in 0..4 {
        // SAFETY: this global is an immutable const int with static lifetime.
        let raw = unsafe { &ffi::av_aes_size };
        assert_eq!(aes::context_size(), raw);
        assert!(std::ptr::eq(aes::context_size(), raw));
    }
}
fn observe(owner: &mut Cast5Box, input: &[u8; 16], decrypt: bool) -> [u8; 16] {
    let mut output = [0; 16];
    // SAFETY: the owner is initialized and exclusively borrowed; both arrays
    // contain two complete 8-byte blocks and do not overlap. C keeps no
    // pointers and writes exactly the output array.
    unsafe {
        ffi::av_cast5_crypt(
            owner.as_c_ptr(),
            output.as_mut_ptr(),
            input.as_ptr(),
            2,
            i32::from(decrypt),
        )
    };
    output
}
#[test]
fn constructors_and_reinitialization_match_independent_c_contexts() {
    let input = *b"0123456789abcdef";
    for initial_len in 5..=16 {
        let key = vec![initial_len as u8; initial_len];
        let mut rust = Cast5::new(&key).unwrap();
        let mut c = c_context(&key);
        for len in 5..=16 {
            let encrypted = observe(&mut rust, &input, false);
            assert_eq!(encrypted, observe(&mut c, &input, false));
            assert_eq!(observe(&mut rust, &encrypted, true), input);
            assert_eq!(observe(&mut c, &encrypted, true), input);
            let key = vec![(len * 7) as u8; len];
            rust.as_mut().init(&key).unwrap();
            // SAFETY: c owns a full context, key has len initialized bytes;
            // C only replaces round keys, retaining no pointer.
            let bits = (len * 8) as i32;
            // SAFETY: key has bits/8 bytes and c is exclusively owned.
            let result = unsafe { ffi::av_cast5_init(c.as_c_ptr(), key.as_ptr(), bits) };
            assert_eq!(result, 0);
            assert_eq!(
                observe(&mut rust, &input, false),
                observe(&mut c, &input, false)
            );
        }
        for len in [0, 4, 17] {
            let invalid_key = vec![0; len];
            assert_eq!(
                rust.as_mut().init(&invalid_key),
                Err(InitError::InvalidKeyLength)
            );
            // SAFETY: invalid bit lengths are rejected before C reads the
            // key or writes the full, live context, even for an empty slice.
            let ptr = invalid_key.as_ptr();
            let bits = (len * 8) as i32;
            // SAFETY: invalid bits are rejected before any pointer access.
            let result = unsafe { ffi::av_cast5_init(c.as_c_ptr(), ptr, bits) };
            assert!(result < 0);
            assert_eq!(
                observe(&mut rust, &input, false),
                observe(&mut c, &input, false)
            );
        }
    }
}
