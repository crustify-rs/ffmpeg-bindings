import json, subprocess, concurrent.futures
from pathlib import Path
out=Path('/tmp/crustify-crypto-w1-b0')
records=json.load(open(out/'records.json'))
def block(name,array=False,mutable=False,nullable=False,lifetime=None,note=''):
 return dict(scalar=None if array else {'by_val':True},array={'by_val':True} if array else None,string=False,owned=False,borrowed={'lifetime': lifetime or 'arg:'+name},nullable=nullable,mutable=mutable,note=note)
jobs=[]
for r in records:
 if r['_analysis']['submitted'] and not r['_analysis']['pending']: continue
 findings={'lifetime':None,'ptr_args':{}}
 for p in r['ptr_args']:
  name=p['name'];array=name in ['src','dst','iv']; mutable=name in ['dst','iv','xl','xr'] and not p['const']
  if not array and name not in ['xl','xr']: mutable=r['name'].startswith('av_aes') and r['name']"'!='"'av_aes_ctr_get_iv'
  note='Synchronous borrow only; no caller buffer or context pointer is stored, transferred, freed or cloned.'
  if name in ['src','dst']:
   note+= ' Count is bytes for CTR, 16-byte blocks for AES/Camellia, 8-byte blocks for Blowfish/CAST5. Exact src==dst is supported; partially overlapping ranges are not exposed.'
  if name=='iv':
   note+= ' Setters copy 8-byte nonce or 16-byte full counter. CBC needs a separate whole writable block, updates it per block; NULL selects ECB.'
  if r['name']=='av_aes_crypt' and name=='a': note+=' Key initialization selects direction; decrypt argument is ignored. Software processing writes inline scratch state.'
  if r['name']=='av_camellia_crypt' and name=='cs': note+=' Reads schedule and global SP; synchronize with every initialization rewriting SP.'
  if r['name']=='av_aes_ctr_set_random_iv': note+=' C random-seed timing-jitter fallback has unsynchronized static state; safe callers share random_seed::get mutex.'
  findings['ptr_args'][str(p['position'])]={'ptr':block(name,array,mutable,name=='iv' and 'crypt' in r['name'],note=note)}
 if r['ptr_ret']:
  if r['name']=='av_aes_ctr_get_iv':
   findings['ptr_ret']={'ptr':block('return',True,lifetime='arg:a',note='Non-null inline counter[16], borrowed while context lives and unchanged. Safe API copies a snapshot, never retains a C reference.')}
  else:
   findings['ptr_ret']={'ptr':block('return',True,nullable=True,lifetime='static',note='C-owned immutable static table after once initialization. NULL for unsupported IDs. Architecture-specific extents: generic 1024 words (257 with CONFIG_SMALL), x86 accelerated 17, aarch64 alternate constants. Never free, mutate or assume one fixed array length.')}
 p=out/(r['name']+'-findings.json');p.write_text(json.dumps(findings));jobs.append((r['name'],p))
def submit(job):
 name,p=job
 r=subprocess.run(['/opt/venv/bin/wavefront','.', '--config','crustify/wavefront/configs/wavefront-config.json','query','symbols','--name',name,'--update',str(p)],capture_output=True,text=True)
 (out/(name+'-update.log')).write_text(r.stdout+r.stderr)
 return (name,r.returncode)
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
 for result in pool.map(submit,jobs): print(result,flush=True)
