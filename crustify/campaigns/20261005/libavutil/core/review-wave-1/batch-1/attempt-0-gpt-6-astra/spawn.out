#!/bin/bash
# Run one ub_safe test under BSan with an RSS watchdog (kills above 6 GB).
B=/tmp/crustify-b12-bsan/bsan/x86_64-unknown-linux-gnu/debug/build/ffmpeg/0ab049226a9bcd4e/out/ub_safe-0ab049226a9bcd4e
t=$1
start=$(date +%s)
BSAN_OPTIONS=gc_hang_threshold_ms=600000 CRUSTIFY_FFMPEG_VARIANT=bsan $B --exact "$t" --test-threads=1 > /tmp/crustify-b12-src/one.log 2>&1 &
pid=$!
peak=0
while kill -0 $pid 2>/dev/null; do
  rss=$(ps -o rss= -p $pid 2>/dev/null | tr -d ' ')
  [ -n "$rss" ] && [ "$rss" -gt "$peak" ] && peak=$rss
  if [ -n "$rss" ] && [ "$rss" -gt 6000000 ]; then kill $pid; echo "$t: KILLED at rss=${rss}KB after $(( $(date +%s)-start ))s"; exit 0; fi
  if [ $(( $(date +%s)-start )) -gt 900 ]; then kill $pid; echo "$t: TIMEOUT peak=${peak}KB"; exit 0; fi
  sleep 2
done
wait $pid; rc=$?
echo "$t: rc=$rc peak=${peak}KB $(( $(date +%s)-start ))s $(grep -o 'test result: [a-z]*' /tmp/crustify-b12-src/one.log)"
