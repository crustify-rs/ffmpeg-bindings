//! Safe wrappers over `libavutil/rational.h`.
//!
//! [`Rational`] is `AVRational`: a numerator and a denominator, two `int`s
//! that C passes and returns by value, embeds by value in its public structs
//! (time bases, frame rates, aspect ratios) and lists in arrays. It owns
//! nothing, so it has no destructor and copies as a value. It lives inline,
//! built by [`Rational::new`] (`av_make_q`), [`Rational::from_raw`] or
//! `Rational::zeroed()`; one in an `av_malloc`-family block is a
//! [`HeapBox<Rational>`](super::mem::HeapBox) (`new_zeroed`, and `Clone`
//! through `av_memdup`), and an array of them a
//! [`HeapVec<Rational>`](super::mem::HeapVec) from
//! [`alloc_cell_array_zeroed`](super::mem::alloc_cell_array_zeroed). A field
//! of a wrapped C struct is reached as a [`RationalRef`] or [`RationalMut`]
//! over the projected place.
//!
//! The value is not reduced and either part may be zero or negative: C stores
//! `0/0` for "unset" (a zeroed context's time base), `1/0` and `-1/0` for the
//! infinities `av_d2q` returns, and unreduced fractions wherever its users
//! write them, so every accessor takes any pair of `int`s.
//!
//! [`reduce`] brings a 64-bit fraction to lowest terms within a bound, as
//! [`Reduced`]: the closest [`Rational`] whose terms fit, and whether it is
//! exact.
//!
//! Arithmetic and comparison go through C. `+`, `-`, `*` and `/` reduce their
//! result to lowest terms within `i32::MAX`, approximating it when it does not
//! fit; equality and order are by value (`1/2 == 2/4`), with `x/0` an
//! infinity and `0/0` unordered, like NaN. [`Rational::to_f64`] and
//! [`Rational::from_f64`] convert to and from floating point, and
//! [`Rational::nearest`] picks the candidate closest to a value.
use core::cmp::Ordering;
use core::fmt;
use core::ops::{Add, Div, Mul, Sub};
use core::ptr::{addr_of, addr_of_mut};
use ffibox::{CZeroable, define_ctype};
use super::ffi;
define_ctype!(
    /// Wraps: AVRational
    ///
    /// A rational number as a pair of `int`s, neither reduced nor checked.
    /// Its getters are on [`RationalRef`] (`as_ref()`), its setters on
    /// [`RationalMut`] (`as_mut()`).
    #[derive(Clone, Copy)]
    Rational,
    RationalRef,
    RationalMut,
    ffi::AVRational
);
// SAFETY: all-zero is `0/0`, a value C itself stores for an unset rational
// (every zero-initialised context's time base) and every accessor accepts as
// the two integers it is; the type has no teardown to reject it.
unsafe impl CZeroable for Rational {}
// SAFETY: an `AVRational` is 8 bytes of plain data, two `int`s with no
// pointer, sub-allocation or tie to the thread that wrote them, so a value, or
// an exclusive handle to one, moves between threads as an `[i32; 2]` does.
unsafe impl Send for Rational {}
// SAFETY: as for `Rational`: the handle is the only access to the pair.
unsafe impl Send for RationalMut<'_> {}
// SAFETY: nothing reachable through a shared handle writes: `RationalRef` has
// getters only, and the struct has no interior mutability, so concurrent
// shared access reads unchanging bytes, as through `&[i32; 2]`.
unsafe impl Sync for Rational {}
// SAFETY: as for `Sync for Rational`: copies of a shared handle only read.
unsafe impl Send for RationalRef<'_> {}
// SAFETY: as above.
unsafe impl Sync for RationalRef<'_> {}
// SAFETY: `&RationalMut` reaches the pair only through `as_ref`, a shared
// handle; the setters need `&mut`.
unsafe impl Sync for RationalMut<'_> {}
impl Rational {
    /// Wraps: av_make_q
    ///
    /// The rational `num / den`, as given: not reduced, and a zero or
    /// negative denominator is kept.
    #[must_use]
    pub fn new(num: i32, den: i32) -> Self {
        // SAFETY: `av_make_q` takes both parts by value, has no
        // preconditions, and returns the struct by value.
        Self::from_raw(unsafe { ffi::av_make_q(num, den) })
    }
    /// The rational C encodes as `raw`, whatever its parts.
    #[inline]
    #[must_use]
    pub const fn from_raw(raw: ffi::AVRational) -> Self {
        Self(raw, core::marker::PhantomData)
    }
    /// The C encoding of this rational, for passing it by value.
    #[inline]
    #[must_use]
    pub const fn into_raw(self) -> ffi::AVRational {
        self.0
    }
}
impl From<ffi::AVRational> for Rational {
    #[inline]
    fn from(raw: ffi::AVRational) -> Self {
        Self::from_raw(raw)
    }
}
impl From<Rational> for ffi::AVRational {
    #[inline]
    fn from(q: Rational) -> Self {
        q.into_raw()
    }
}
impl fmt::Debug for Rational {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        self.as_ref().fmt(f)
    }
}
impl fmt::Debug for RationalRef<'_> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_struct("Rational")
            .field("num", &self.num())
            .field("den", &self.den())
            .finish()
    }
}
impl RationalRef<'_> {
    /// Field: AVRational.num
    ///
    /// The numerator.
    #[must_use]
    pub fn num(&self) -> i32 {
        // SAFETY: a read of the `num` field projected through the shared
        // handle's pointer to a live, initialised `AVRational`; every bit
        // pattern is a valid `int`.
        unsafe { addr_of!((*self.as_ptr()).num).read() }
    }
    /// Field: AVRational.den
    ///
    /// The denominator, possibly zero or negative.
    #[must_use]
    pub fn den(&self) -> i32 {
        // SAFETY: a read of the `den` field projected through the shared
        // handle's pointer to a live, initialised `AVRational`; every bit
        // pattern is a valid `int`.
        unsafe { addr_of!((*self.as_ptr()).den).read() }
    }
    /// A copy of the whole rational, independent of the place it was read
    /// from.
    #[must_use]
    pub fn get(&self) -> Rational {
        // SAFETY: a read of the whole live, initialised `AVRational` through
        // the shared handle's pointer; it is two `int`s, so the byte copy is
        // a complete, independent value.
        Rational::from_raw(unsafe { self.as_ptr().read() })
    }
}
impl RationalMut<'_> {
    /// Field: AVRational.num
    ///
    /// Sets the numerator, leaving the denominator as it is.
    pub fn set_num(&mut self, num: i32) {
        // SAFETY: a write of the `num` field projected through the exclusive
        // handle's pointer to a live `AVRational`; the old value owns nothing
        // to leak.
        unsafe { addr_of_mut!((*self.as_mut_ptr()).num).write(num) }
    }
    /// Field: AVRational.den
    ///
    /// Sets the denominator, leaving the numerator as it is; zero and
    /// negative values are stored as given.
    pub fn set_den(&mut self, den: i32) {
        // SAFETY: a write of the `den` field projected through the exclusive
        // handle's pointer to a live `AVRational`; the old value owns nothing
        // to leak.
        unsafe { addr_of_mut!((*self.as_mut_ptr()).den).write(den) }
    }
    /// Overwrites both parts with `q`'s.
    pub fn set(&mut self, q: Rational) {
        // SAFETY: a write of the whole `AVRational` through the exclusive
        // handle's pointer to a live one; the old value owns nothing to leak.
        unsafe { self.as_mut_ptr().write(q.into_raw()) }
    }
}
/// A fraction [`reduce`] brought to lowest terms.
#[derive(Clone, Copy, Debug)]
pub struct Reduced {
    /// The fraction: its numerator carries the sign, and its denominator is
    /// never negative, 0 for a source with a zero denominator.
    pub value: Rational,
    /// Whether `value` is the source fraction itself rather than the closest
    /// approximation whose terms stay within the bound.
    pub exact: bool,
}
/// Wraps: av_reduce
///
/// `num / den` in lowest terms, both terms at most `max` in magnitude: the
/// exact fraction when it fits, and otherwise its closest approximation within
/// the bound (by continued fractions), with [`Reduced::exact`] cleared. A zero
/// `max` still yields terms of magnitude up to 1, as in C.
///
/// `None` for arguments C cannot reduce without undefined behaviour, which
/// the call never reaches:
///
/// - a negative `max`: C's result terms are `int`, and a negative bound gives
///   meaningless terms or overflows when negating them;
/// - `num` or `den` equal to `i64::MIN`, whose absolute value C takes with a
///   signed negation that overflows.
///
/// The bound is an `i32` because each term of the result is one: C narrows
/// the terms of a wider bound to `int` and overflows negating the result.
#[must_use]
pub fn reduce(num: i64, den: i64, max: i32) -> Option<Reduced> {
    if max < 0 || num == i64::MIN || den == i64::MIN {
        return None;
    }
    let (mut dst_num, mut dst_den) = (0, 0);
    // SAFETY: both out-parameters are live, writable locals C only stores to.
    // `num` and `den` are not `INT64_MIN` and `max` lies in `0..=INT_MAX`, so
    // every term stays within `int` and none of C's arithmetic overflows.
    let exact = unsafe { ffi::av_reduce(&mut dst_num, &mut dst_den, num, den, max.into()) };
    Some(Reduced {
        value: Rational::from_raw(ffi::AVRational {
            num: dst_num,
            den: dst_den,
        }),
        exact: exact != 0,
    })
}
impl Rational {
    /// Wraps: av_inv_q
    ///
    /// The reciprocal `den / num`: the two parts swapped, so `0/d` becomes
    /// `d/0` and the sign stays where it was.
    #[must_use]
    pub fn recip(self) -> Self {
        // SAFETY: `av_inv_q` takes the struct by value and only swaps its
        // parts.
        Self::from_raw(unsafe { ffi::av_inv_q(self.into_raw()) })
    }
    /// Wraps: av_q2d
    ///
    /// The value as an `f64`: `num as f64 / den as f64`, so `x/0` is an
    /// infinity of `x`'s sign and `0/0` is NaN.
    #[must_use]
    pub fn to_f64(self) -> f64 {
        // SAFETY: `av_q2d` takes the struct by value and divides in floating
        // point, which is defined for a zero denominator.
        unsafe { ffi::av_q2d(self.into_raw()) }
    }
    /// Wraps: av_d2q
    ///
    /// The closest rational to `d` whose terms are at most `max` in
    /// magnitude: `0/0` for NaN, `1/0` or `-1/0` beyond `±(i32::MAX + 3)`
    /// (the infinities included), and otherwise the reduction of `d` as a
    /// fraction over a power of two (see [`reduce`]).
    ///
    /// `None` for a negative `max`, which C's reduction cannot bound.
    #[must_use]
    pub fn from_f64(d: f64, max: i32) -> Option<Self> {
        if max < 0 {
            return None;
        }
        // SAFETY: `av_d2q` takes its arguments by value. A NaN or a magnitude
        // beyond `INT_MAX + 3` returns before any conversion; otherwise the
        // scaled `d` lies strictly within `int64_t` (`|d| < 2^e` over the
        // denominator `2^(63 - e)`), and a non-negative `max` keeps
        // `av_reduce` within `int`.
        Some(Self::from_raw(unsafe { ffi::av_d2q(d, max) }))
    }
    /// Wraps: av_nearer_q
    ///
    /// Compares how near `a` and `b` are to `self`: [`Less`](Ordering::Less)
    /// when `a` is nearer, [`Greater`](Ordering::Greater) when `b` is, and
    /// [`Equal`](Ordering::Equal) at the same distance. (C returns 1, -1 and 0
    /// for these.)
    ///
    /// `None` where C has no meaningful answer and overflows computing one:
    /// when `a` and `b` are unordered ([`partial_cmp`](PartialOrd::partial_cmp)
    /// is `None`, as with a `0/0`), and when both denominators are
    /// `i32::MIN`. A negative denominator in `self`, or in exactly one of `a`
    /// and `b`, gives a meaningless but defined answer, as in C.
    #[must_use]
    pub fn cmp_distance(self, a: Self, b: Self) -> Option<Ordering> {
        let (ra, rb) = (a.into_raw(), b.into_raw());
        // C doubles the product of the denominators and multiplies its
        // verdict by `av_cmp_q(b, a)`, which is `INT_MIN` for unordered
        // values.
        if (ra.den == i32::MIN && rb.den == i32::MIN) || b.partial_cmp(&a).is_none() {
            return None;
        }
        // SAFETY: `av_nearer_q` takes the structs by value. With at most one
        // denominator `INT_MIN`, `2 * q1.den * q2.den` and the median's
        // numerator stay within `int64_t`; with `b` and `a` ordered,
        // `av_cmp_q(b, a)` is -1, 0 or 1, so the final product cannot
        // overflow.
        match unsafe { ffi::av_nearer_q(self.into_raw(), ra, rb) } {
            1 => Some(Ordering::Less),
            0 => Some(Ordering::Equal),
            _ => Some(Ordering::Greater),
        }
    }
    /// Wraps: av_find_nearest_q_idx
    ///
    /// The index of the candidate nearest `self`, the first one on a tie, as
    /// [`cmp_distance`](Self::cmp_distance) orders them.
    ///
    /// C reads its list up to an entry with a zero denominator (its `{0, 0}`
    /// terminator), so only the candidates before the first such entry are
    /// compared; `None` when there are none. `None` too when C would overflow
    /// comparing two candidates whose denominators are both `i32::MIN`:
    /// when the first compared candidate has one (C compares it with itself)
    /// or two of them do.
    #[must_use]
    pub fn nearest(self, candidates: &[Self]) -> Option<usize> {
        let end = candidates
            .iter()
            .position(|q| q.as_ref().den() == 0)
            .unwrap_or(candidates.len());
        let list = &candidates[..end];
        let min_dens = list.iter().filter(|q| q.as_ref().den() == i32::MIN).count();
        if list.first()?.as_ref().den() == i32::MIN || min_dens > 1 {
            return None;
        }
        let terminated: Vec<ffi::AVRational> = list
            .iter()
            .map(|q| q.into_raw())
            .chain([ffi::AVRational { num: 0, den: 0 }])
            .collect();
        // SAFETY: `terminated` is a live array of `AVRational`s ending in the
        // `{0, 0}` entry, the only one with a zero denominator, which C reads
        // up to and never writes. Every comparison C makes is between two
        // entries with nonzero denominators, never both `INT_MIN`, which
        // `av_nearer_q` handles without overflow (see `cmp_distance`).
        let i = unsafe { ffi::av_find_nearest_q_idx(self.into_raw(), terminated.as_ptr()) };
        usize::try_from(i).ok()
    }
    /// Wraps: av_q2intfloat
    ///
    /// The bits of the IEEE 754 single-precision float nearest the value,
    /// ties away from zero: C computes them in integer arithmetic, so they do
    /// not depend on the platform's floating point. `0/0` is the quiet NaN
    /// `0xffc0_0000`, `0/d` is `+0.0`, and `x/0` is the infinity of `x`'s
    /// sign.
    ///
    /// `None` when either part is `i32::MIN`, whose magnitude C cannot take.
    ///
    /// Diverges from C for `x/0` with `x` negative: C drops the sign and
    /// returns `+inf`; this returns `-inf` (`0xff80_0000`).
    #[must_use]
    pub fn to_f32_bits(self) -> Option<u32> {
        let ffi::AVRational { num, den } = self.into_raw();
        if num == i32::MIN || den == i32::MIN {
            return None;
        }
        // C normalizes the sign into the numerator, then takes its magnitude
        // and shifts the sign into bit 31 of an `int`, which overflows. C
        // computes the other 31 bits from the magnitudes alone, so they come
        // from the non-negative value, and the sign bit is set here.
        let (num, den) = if den < 0 { (-num, -den) } else { (num, den) };
        let (num, sign) = if num < 0 { (-num, 1 << 31) } else { (num, 0) };
        // SAFETY: `av_q2intfloat` takes the struct by value. Both parts are
        // non-negative, so C negates neither and its sign is 0; its shifts
        // stay below 64 bits for `int` terms.
        let bits = unsafe { ffi::av_q2intfloat(ffi::AVRational { num, den }) };
        Some(bits | sign)
    }
    /// Wraps: av_gcd_q
    ///
    /// The largest rational of which both `self` and `other` are integer
    /// multiples, the greatest common divisor of the numerators over the
    /// least common multiple of the denominators, when that multiple is below
    /// `max_den`; `None` otherwise.
    ///
    /// `None` too when both denominators are zero, which C divides by. A
    /// zero denominator in one of them gives a zero multiple, as in C.
    #[must_use]
    pub fn gcd(self, other: Self, max_den: i32) -> Option<Self> {
        let (a, b) = (self.into_raw(), other.into_raw());
        if a.den == 0 && b.den == 0 {
            return None;
        }
        // C's decision, computed as C does: `av_gcd` is zero only for two
        // zero denominators, and each `int` quotient times an `int` fits.
        let g = super::mathematics::gcd(a.den.into(), b.den.into());
        let lcm = (i64::from(a.den) / g) * i64::from(b.den);
        if lcm >= i64::from(max_den) {
            return None;
        }
        // SAFETY: `av_gcd_q` takes the structs by value; with a nonzero
        // denominator `av_gcd(a.den, b.den)` is nonzero, so its one division
        // is defined, and `lcm < max_den` selects the computed result rather
        // than `def`.
        Some(Self::from_raw(unsafe { ffi::av_gcd_q(a, b, max_den, a) }))
    }
}
/// Value equality, as C compares: `1/2 == 2/4`, `1/0 == 2/0`, and `0/0`
/// equals nothing, itself included, like NaN.
impl PartialEq for Rational {
    fn eq(&self, other: &Self) -> bool {
        self.partial_cmp(other) == Some(Ordering::Equal)
    }
}
impl PartialOrd for Rational {
    /// Wraps: av_cmp_q
    ///
    /// Orders the values, with `x/0` as the infinity of `x`'s sign. `None`
    /// where C reports `INT_MIN`: when either is `0/0`, or one is `0/d` and
    /// the other `0/0`.
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        // SAFETY: `av_cmp_q` takes the structs by value; its cross products
        // are computed in `int64_t`, where their difference cannot overflow
        // for `int` terms.
        match unsafe { ffi::av_cmp_q(self.into_raw(), other.into_raw()) } {
            0 => Some(Ordering::Equal),
            1 => Some(Ordering::Greater),
            -1 => Some(Ordering::Less),
            _ => None,
        }
    }
}
impl Add for Rational {
    type Output = Self;
    /// Wraps: av_add_q
    ///
    /// The sum, in lowest terms when it fits, and otherwise its closest
    /// approximation with terms within `i32::MAX` (see [`reduce`]).
    ///
    /// `i32::MIN/i32::MIN + i32::MIN/i32::MIN` overflows in C; it is computed
    /// as `1/1 + 1/1`, the same value, which C reduces to the same `2/1`.
    fn add(self, rhs: Self) -> Self {
        let (mut b, mut c) = (self.into_raw(), rhs.into_raw());
        if [b.num, b.den, c.num, c.den] == [i32::MIN; 4] {
            b = ffi::AVRational { num: 1, den: 1 };
            c = b;
        }
        // SAFETY: `av_add_q` takes the structs by value. Each cross product
        // is at most 2^62 in magnitude, reached only by `INT_MIN * INT_MIN`;
        // their sum reaches 2^63 only for the operands replaced above, so it
        // fits `int64_t`, and `av_reduce` with `INT_MAX` handles every
        // fraction of such terms.
        Self::from_raw(unsafe { ffi::av_add_q(b, c) })
    }
}
impl Sub for Rational {
    type Output = Self;
    /// Wraps: av_sub_q
    ///
    /// The difference, in lowest terms when it fits, and otherwise its
    /// closest approximation with terms within `i32::MAX` (see [`reduce`]).
    fn sub(self, rhs: Self) -> Self {
        // SAFETY: `av_sub_q` takes the structs by value. The difference of the
        // cross products lies within `±(2^63 - 2^31)`, since only
        // `INT_MIN * INT_MIN` reaches 2^62 and a product reaches at most
        // `2^62 - 2^31` below zero, and `av_reduce` with `INT_MAX` handles
        // every fraction of such terms.
        Self::from_raw(unsafe { ffi::av_sub_q(self.into_raw(), rhs.into_raw()) })
    }
}
impl Mul for Rational {
    type Output = Self;
    /// Wraps: av_mul_q
    ///
    /// The product, in lowest terms when it fits, and otherwise its closest
    /// approximation with terms within `i32::MAX` (see [`reduce`]).
    fn mul(self, rhs: Self) -> Self {
        // SAFETY: `av_mul_q` takes the structs by value; each product of two
        // `int`s fits `int64_t`, and `av_reduce` with `INT_MAX` handles every
        // fraction of such terms.
        Self::from_raw(unsafe { ffi::av_mul_q(self.into_raw(), rhs.into_raw()) })
    }
}
impl Div for Rational {
    type Output = Self;
    /// Wraps: av_div_q
    ///
    /// The quotient, `self` times `rhs`'s reciprocal, in lowest terms when it
    /// fits, and otherwise its closest approximation with terms within
    /// `i32::MAX`; dividing by `0/d` gives an infinity or `0/0`.
    fn div(self, rhs: Self) -> Self {
        // SAFETY: `av_div_q` takes the structs by value and multiplies by the
        // swapped divisor through `av_mul_q`, defined for every `int` term
        // (see `mul`).
        Self::from_raw(unsafe { ffi::av_div_q(self.into_raw(), rhs.into_raw()) })
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    use core::mem::{align_of, offset_of, size_of};
    use crate::libavutil::mem::HeapBox;
    #[test]
    fn layout_matches_the_c_struct() {
        assert_eq!(size_of::<Rational>(), size_of::<ffi::AVRational>());
        assert_eq!(align_of::<Rational>(), align_of::<ffi::AVRational>());
        assert_eq!((size_of::<Rational>(), align_of::<Rational>()), (8, 4));
        assert_eq!(offset_of!(ffi::AVRational, num), 0);
        assert_eq!(offset_of!(ffi::AVRational, den), 4);
        assert_eq!(size_of::<RationalRef<'_>>(), size_of::<*const ()>());
        assert_eq!(size_of::<RationalMut<'_>>(), size_of::<*const ()>());
    }
    #[test]
    fn value_is_send_sync_and_copy() {
        fn send_sync<T: Send + Sync>() {}
        fn copy<T: Copy>() {}
        send_sync::<Rational>();
        send_sync::<RationalRef<'_>>();
        send_sync::<RationalMut<'_>>();
        send_sync::<HeapBox<Rational>>();
        copy::<Rational>();
        copy::<RationalRef<'_>>();
        let a = Rational::from_raw(ffi::AVRational { num: 1, den: 2 });
        let mut b = a;
        b.as_mut().set_num(3);
        assert_eq!((a.as_ref().num(), b.as_ref().num()), (1, 3));
    }
    #[test]
    fn zeroed_is_zero_over_zero() {
        let z = Rational::zeroed();
        assert_eq!((z.as_ref().num(), z.as_ref().den()), (0, 0));
    }
    #[test]
    fn raw_conversions_round_trip_every_part() {
        for (num, den) in [
            (0, 0),
            (1, 0),
            (-1, 0),
            (i32::MIN, -1),
            (i32::MAX, i32::MIN),
            (6, 4),
        ] {
            let raw = ffi::AVRational { num, den };
            let q = Rational::from(raw);
            assert_eq!((q.as_ref().num(), q.as_ref().den()), (num, den));
            let back = ffi::AVRational::from(q);
            assert_eq!((back.num, back.den), (num, den));
            let back = Rational::from_raw(raw).into_raw();
            assert_eq!((back.num, back.den), (num, den));
        }
    }
    #[test]
    fn const_from_raw_builds_constants() {
        const MS: Rational = Rational::from_raw(ffi::AVRational { num: 1, den: 1000 });
        assert_eq!((MS.as_ref().num(), MS.as_ref().den()), (1, 1000));
        const RAW: ffi::AVRational = MS.into_raw();
        assert_eq!((RAW.num, RAW.den), (1, 1000));
    }
    #[test]
    fn setters_write_one_part_through_reborrows() {
        let mut q = Rational::zeroed();
        let mut m = q.as_mut();
        m.as_mut().set_num(-7);
        assert_eq!((m.as_ref().num(), m.as_ref().den()), (-7, 0));
        m.set_den(i32::MIN);
        assert_eq!((m.as_ref().num(), m.as_ref().den()), (-7, i32::MIN));
        m.set(Rational::from_raw(ffi::AVRational { num: 2, den: 3 }));
        assert_eq!((q.as_ref().num(), q.as_ref().den()), (2, 3));
    }
    #[test]
    fn get_copies_out_of_the_place() {
        let mut q = Rational::from_raw(ffi::AVRational { num: 5, den: 9 });
        let copy = q.as_ref().get();
        q.as_mut().set_num(0);
        assert_eq!((copy.as_ref().num(), copy.as_ref().den()), (5, 9));
        assert_eq!(q.as_ref().get().as_ref().num(), 0);
    }
    #[test]
    fn debug_shows_both_parts() {
        let q = Rational::from_raw(ffi::AVRational { num: -1, den: 0 });
        assert_eq!(format!("{q:?}"), "Rational { num: -1, den: 0 }");
        assert_eq!(format!("{:?}", q.as_ref()), format!("{q:?}"));
    }
    #[test]
    fn handles_borrow_a_c_owned_struct() {
        let mut raw = ffi::AVRational {
            num: 30000,
            den: 1001,
        };
        // SAFETY: `raw` is a live, initialised struct outliving the handle,
        // and no other access to it happens while the handle is used.
        let mut m = unsafe { RationalMut::from_ptr(&raw mut raw) }.unwrap();
        assert_eq!((m.as_ref().num(), m.as_ref().den()), (30000, 1001));
        m.set_den(1000);
        assert_eq!((raw.num, raw.den), (30000, 1000));
        // SAFETY: `raw` is live and only read while the shared handle lives.
        let r = unsafe { RationalRef::from_ptr(&raw mut raw) }.unwrap();
        assert_eq!(r.get().as_ref().den(), 1000);
        // SAFETY: NULL is rejected before anything is borrowed.
        assert!(unsafe { RationalRef::from_ptr(core::ptr::null_mut()) }.is_none());
        // SAFETY: as above.
        assert!(unsafe { RationalMut::from_ptr(core::ptr::null_mut()) }.is_none());
    }
    #[test]
    fn c_fills_an_inline_value_through_the_exclusive_handle() {
        // The path a wrapper over an `AVRational *` out-parameter takes
        // (`av_opt_get_q`, `av_parse_ratio`): C stores into Rust's inline
        // storage through the exclusive handle's pointer, and the handles
        // read it back afterwards.
        let mut q = Rational::zeroed();
        let mut m = q.as_mut();
        // SAFETY: both fields are projected from the exclusive handle's
        // pointer to a live `AVRational` nothing else accesses during the
        // call; `av_reduce` stores one `int` through each, and the terms
        // are within `int` with a positive bound, so none of its arithmetic
        // overflows.
        let exact = unsafe {
            ffi::av_reduce(
                addr_of_mut!((*m.as_mut_ptr()).num),
                addr_of_mut!((*m.as_mut_ptr()).den),
                60000,
                2002,
                i32::MAX.into(),
            )
        };
        assert_eq!(exact, 1);
        assert_eq!((m.as_ref().num(), m.as_ref().den()), (30000, 1001));
        let num = m.as_ref().num();
        m.set_num(-num);
        assert_eq!((q.as_ref().num(), q.as_ref().den()), (-30000, 1001));
        assert_eq!(q.as_ref().get().into_raw().den, 1001);
    }
    #[test]
    fn heap_boxed_rational_reads_writes_and_clones() {
        let mut a = HeapBox::<Rational>::new_zeroed().unwrap();
        assert_eq!((a.as_ref().num(), a.as_ref().den()), (0, 0));
        a.as_mut()
            .set(Rational::from_raw(ffi::AVRational { num: 1, den: 25 }));
        let b = a.clone();
        a.as_mut().set_den(50);
        assert_eq!((a.as_ref().den(), b.as_ref().den()), (50, 25));
        let mut slot = HeapBox::<Rational>::new_uninit().unwrap();
        // SAFETY: `as_c_ptr` addresses 8 writable, aligned bytes `slot` owns.
        unsafe { slot.as_c_ptr().write(ffi::AVRational { num: 4, den: 3 }) };
        // SAFETY: the write above initialised the whole struct.
        let c = unsafe { slot.assume_init() };
        assert_eq!((c.as_ref().num(), c.as_ref().den()), (4, 3));
    }
    /// A reduction's numerator, denominator and exactness.
    fn parts(r: Option<Reduced>) -> Option<(i32, i32, bool)> {
        r.map(|r| (r.value.as_ref().num(), r.value.as_ref().den(), r.exact))
    }
    #[test]
    fn arguments_c_would_overflow_on_are_rejected_before_the_call() {
        assert!(reduce(1, 2, -1).is_none());
        assert!(reduce(1, 2, i32::MIN).is_none());
        assert!(reduce(i64::MIN, 3, i32::MAX).is_none());
        assert!(reduce(3, i64::MIN, i32::MAX).is_none());
        assert!(reduce(i64::MIN, i64::MIN, 0).is_none());
    }
    #[test]
    fn reduces_to_lowest_terms() {
        assert_eq!(parts(reduce(-6, 4, i32::MAX)), Some((-3, 2, true)));
        assert_eq!(parts(reduce(6, -4, i32::MAX)), Some((-3, 2, true)));
        assert_eq!(parts(reduce(-6, -4, i32::MAX)), Some((3, 2, true)));
    }
    #[test]
    fn approximates_beyond_the_bound() {
        // 355/113 is the best approximation of pi with terms <= 1000.
        let pi = reduce(3_141_592_653_589_793, 1_000_000_000_000_000, 1000);
        assert_eq!(parts(pi), Some((355, 113, false)));
        let tiny = parts(reduce(1, i64::MAX, 100)).unwrap();
        assert_eq!((tiny.0, tiny.2), (0, false));
    }
    #[test]
    fn zero_terms_reduce_exactly() {
        assert_eq!(parts(reduce(0, 5, 10)), Some((0, 1, true)));
        assert_eq!(parts(reduce(7, 0, 10)), Some((1, 0, true)));
        assert_eq!(parts(reduce(0, 0, 10)), Some((0, 0, true)));
    }
    /// `num/den`, for brevity.
    fn q(num: i32, den: i32) -> Rational {
        Rational::new(num, den)
    }
    /// A rational's parts.
    fn nd(r: Rational) -> (i32, i32) {
        (r.as_ref().num(), r.as_ref().den())
    }
    #[test]
    fn equality_and_order_are_by_value() {
        assert_eq!(q(1, 2), q(2, 4));
        assert_eq!(q(1, 2), q(-1, -2));
        assert_eq!(q(1, 0), q(7, 0));
        assert_ne!(q(1, 0), q(-1, 0));
        assert!(q(-1, 0) < q(i32::MIN, 1));
        assert!(q(i32::MAX, 1) < q(1, 0));
        assert!(q(1, 3) < q(1, 2));
        assert!(q(1, -3) > q(1, -2));
        // `0/0` is unordered, against itself too, like NaN.
        assert_ne!(q(0, 0), q(0, 0));
        assert_eq!(q(0, 0).partial_cmp(&q(0, 0)), None);
        assert_eq!(q(0, 0).partial_cmp(&q(1, 2)), None);
        assert_eq!(q(0, 0).partial_cmp(&q(5, 0)), None);
        assert_eq!(q(0, 5).partial_cmp(&q(0, -3)), Some(Ordering::Equal));
        assert_eq!(q(0, 5).partial_cmp(&q(3, 0)), Some(Ordering::Less));
    }
    #[test]
    fn arithmetic_reduces_and_approximates() {
        assert_eq!(nd(q(1, 2) + q(1, 3)), (5, 6));
        assert_eq!(nd(q(1, 2) - q(1, 3)), (1, 6));
        assert_eq!(nd(q(2, 3) * q(3, 4)), (1, 2));
        assert_eq!(nd(q(2, 3) / q(4, 3)), (1, 2));
        assert_eq!(nd(q(1, 2) / q(0, 1)), (1, 0));
        assert_eq!(nd(q(-1, 2) / q(0, 1)), (-1, 0));
        // Beyond `i32` terms, the closest approximation that fits.
        let r = q(1, i32::MAX) * q(1, i32::MAX);
        assert_eq!(nd(r), (0, 1));
    }
    #[test]
    fn min_over_min_sum_is_computed_as_one_plus_one() {
        // C overflows `INT64_MAX` forming this sum's numerator.
        let m = q(i32::MIN, i32::MIN);
        assert_eq!(nd(m + m), (2, 1));
        assert_eq!(nd(m + q(1, 1)), (2, 1));
        assert_eq!(nd(m - m), (0, 1));
        assert_eq!(nd(m * m), (1, 1));
        assert_eq!(nd(m / m), (1, 1));
    }
    #[test]
    fn recip_and_float_conversions() {
        assert_eq!(nd(q(0, 5).recip()), (5, 0));
        assert_eq!(nd(q(-3, 7).recip()), (7, -3));
        assert_eq!(q(1, 4).to_f64(), 0.25);
        assert_eq!(q(-1, 0).to_f64(), f64::NEG_INFINITY);
        assert!(q(0, 0).to_f64().is_nan());
        assert_eq!(Rational::from_f64(0.25, 100).map(nd), Some((1, 4)));
        assert_eq!(Rational::from_f64(f64::NAN, 100).map(nd), Some((0, 0)));
        assert_eq!(Rational::from_f64(-1e300, 100).map(nd), Some((-1, 0)));
        assert_eq!(Rational::from_f64(f64::INFINITY, 0).map(nd), Some((1, 0)));
        assert!(Rational::from_f64(0.5, -1).is_none());
        assert!(Rational::from_f64(0.5, i32::MIN).is_none());
    }
    #[test]
    fn cmp_distance_rejects_what_c_overflows_on() {
        assert_eq!(q(1, 3).cmp_distance(q(1, 4), q(1, 2)), Some(Ordering::Less));
        assert_eq!(
            q(1, 3).cmp_distance(q(1, 2), q(1, 4)),
            Some(Ordering::Greater)
        );
        assert_eq!(
            q(1, 2).cmp_distance(q(1, 4), q(3, 4)),
            Some(Ordering::Equal)
        );
        // Unordered candidates: C multiplies its verdict by `INT_MIN`.
        assert_eq!(q(1, 2).cmp_distance(q(1, 3), q(0, 0)), None);
        assert_eq!(q(1, 2).cmp_distance(q(0, 0), q(1, 3)), None);
        // Both denominators `INT_MIN`: C doubles their product.
        let m = q(1, i32::MIN);
        assert_eq!(q(1, 2).cmp_distance(m, m), None);
        assert!(q(1, 2).cmp_distance(m, q(1, 3)).is_some());
    }
    #[test]
    fn nearest_scans_to_the_first_zero_denominator() {
        let rates = [q(24000, 1001), q(24, 1), q(25, 1), q(30000, 1001)];
        assert_eq!(q(25, 1).nearest(&rates), Some(2));
        assert_eq!(q(239, 10).nearest(&rates), Some(0));
        assert_eq!(q(1000, 1).nearest(&rates), Some(3));
        // Ties go to the first candidate.
        assert_eq!(q(1, 2).nearest(&[q(1, 4), q(3, 4)]), Some(0));
        assert_eq!(q(1, 2).nearest(&[]), None);
        // A zero denominator ends C's list.
        assert_eq!(q(25, 1).nearest(&[q(0, 0), q(25, 1)]), None);
        assert_eq!(q(25, 1).nearest(&[q(24, 1), q(7, 0), q(25, 1)]), Some(0));
    }
    #[test]
    fn nearest_rejects_two_min_denominators() {
        let m = q(1, i32::MIN);
        assert_eq!(q(1, 2).nearest(&[m]), None);
        assert_eq!(q(1, 2).nearest(&[q(1, 3), m, m]), None);
        // One, not first, is never compared with itself. (Its negative
        // denominator makes C's verdict meaningless, but defined.)
        assert!(q(0, 1).nearest(&[q(1, 3), m]).is_some());
        // One past the terminator is not read.
        assert_eq!(
            q(0, 1).nearest(&[q(1, 3), m, q(0, 0), m]),
            q(0, 1).nearest(&[q(1, 3), m])
        );
    }
    #[test]
    fn f32_bits_match_rust_floats() {
        for (num, den) in [
            (1, 2),
            (-1, 2),
            (1, -2),
            (-3, -4),
            (1, 3),
            (-2, 3),
            (i32::MAX, 1),
            (1, i32::MAX),
            (-7, 1),
            (30000, 1001),
        ] {
            let want = (num as f32 / den as f32).to_bits();
            assert_eq!(q(num, den).to_f32_bits(), Some(want), "{num}/{den}");
        }
        assert_eq!(q(0, 0).to_f32_bits(), Some(0xffc0_0000));
        assert_eq!(q(0, 5).to_f32_bits(), Some(0));
        assert_eq!(q(0, -5).to_f32_bits(), Some(0));
        assert_eq!(q(3, 0).to_f32_bits(), Some(f32::INFINITY.to_bits()));
    }
    #[test]
    fn f32_bits_keep_the_sign_of_negative_infinity() {
        // C returns `+inf` here: it strips the sign before testing `den == 0`.
        assert_eq!(q(-3, 0).to_f32_bits(), Some(f32::NEG_INFINITY.to_bits()));
    }
    #[test]
    fn f32_bits_reject_min_parts() {
        assert_eq!(q(i32::MIN, 1).to_f32_bits(), None);
        assert_eq!(q(1, i32::MIN).to_f32_bits(), None);
        assert_eq!(
            q(i32::MIN + 1, 1).to_f32_bits(),
            Some((-(i32::MAX as f32)).to_bits())
        );
    }
    #[test]
    fn gcd_is_the_common_step() {
        assert_eq!(q(1, 24).gcd(q(1, 30), 1000).map(nd), Some((1, 120)));
        assert_eq!(q(3, 4).gcd(q(9, 8), 1000).map(nd), Some((3, 8)));
        // The multiple must be below `max_den`.
        assert_eq!(q(1, 24).gcd(q(1, 30), 120), None);
        assert_eq!(q(1, 24).gcd(q(1, 30), 121).map(nd), Some((1, 120)));
        // C divides by zero for two zero denominators.
        assert_eq!(q(1, 0).gcd(q(2, 0), i32::MAX), None);
        // One zero denominator: the multiple is 0.
        assert_eq!(q(4, 0).gcd(q(6, 5), 1).map(nd), Some((2, 0)));
        assert_eq!(q(4, 5).gcd(q(6, 0), 1).map(nd), Some((2, 0)));
    }
    #[test]
    fn rejections_before_the_call_touch_no_c() {
        // Built without `av_make_q`, so the test runs where C cannot (Miri).
        let r = |num, den| Rational::from_raw(ffi::AVRational { num, den });
        let m = r(1, i32::MIN);
        assert_eq!(r(1, 2).nearest(&[]), None);
        assert_eq!(r(1, 2).nearest(&[r(0, 0), r(1, 2)]), None);
        assert_eq!(r(1, 2).nearest(&[r(9, 0)]), None);
        assert_eq!(r(1, 2).nearest(&[m, r(1, 3)]), None);
        assert_eq!(r(1, 2).nearest(&[r(1, 3), m, r(1, 4), m]), None);
        assert_eq!(r(1, 2).cmp_distance(m, m), None);
        assert_eq!(r(i32::MIN, 3).to_f32_bits(), None);
        assert_eq!(r(3, i32::MIN).to_f32_bits(), None);
        assert_eq!(r(1, 0).gcd(r(1, 0), i32::MAX), None);
        assert_eq!(r(0, 0).gcd(r(5, 0), 0), None);
        assert!(Rational::from_f64(1.0, -1).is_none());
    }
}
//! Safe wrappers over `libavutil/mathematics.h`.
//!
//! [`Rounding`] is the rounding argument of the rescaling functions: one of
//! five methods, optionally with the pass-through of `i64::MIN` / `i64::MAX`.
//!
//! [`compare_mod`], [`bessel_i0`] and [`gcd`] (the integer greatest common
//! divisor) are plain numeric functions over the C implementations, and
//! [`rescale`] computes `a * b / c` without intermediate overflow, rounding to
//! nearest. [`rescale_rounded`] takes the rounding, and
//! [`rescale_rational`] and [`rescale_rational_rounded`] multiply by a ratio
//! of two [`Rational`]s, converting a timestamp between time bases.
//!
//! [`compare_timestamps`], [`rescale_delta`] and [`add_stable`] work on
//! timestamps, each in its own time base. Each wrapper rejects, with `None`,
//! the arguments on which C would overflow, divide by zero or abort, before
//! the call.
use core::cmp::Ordering;
use core::fmt;
use super::ffi;
use super::rational::Rational;
/// Wraps: AVRounding
///
/// The rounding of a rescale: a method ([`ZERO`](Self::ZERO),
/// [`INF`](Self::INF), [`DOWN`](Self::DOWN), [`UP`](Self::UP) or
/// [`NEAR_INF`](Self::NEAR_INF)), optionally combined with
/// [`pass_min_max`](Self::pass_min_max).
///
/// C's `enum AVRounding` mixes the methods with a flag bit, so any `unsigned`
/// fits it, and `av_rescale_rnd` returns `INT64_MIN` for any value that is not
/// a method, alone or ORed with `AV_ROUND_PASS_MINMAX`. A `Rounding` holds
/// only those accepted values; [`TryFrom`] rejects the others, and the value
/// passes to C unchanged through [`From`], as a layout-compatible newtype.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct Rounding(ffi::AVRounding);
impl Rounding {
    /// Round toward zero (`AV_ROUND_ZERO`).
    pub const ZERO: Self = Self(ffi::AVRounding::AV_ROUND_ZERO);
    /// Round away from zero (`AV_ROUND_INF`).
    pub const INF: Self = Self(ffi::AVRounding::AV_ROUND_INF);
    /// Round toward negative infinity (`AV_ROUND_DOWN`).
    pub const DOWN: Self = Self(ffi::AVRounding::AV_ROUND_DOWN);
    /// Round toward positive infinity (`AV_ROUND_UP`).
    pub const UP: Self = Self(ffi::AVRounding::AV_ROUND_UP);
    /// Round to nearest, halfway cases away from zero (`AV_ROUND_NEAR_INF`).
    pub const NEAR_INF: Self = Self(ffi::AVRounding::AV_ROUND_NEAR_INF);
    /// The `AV_ROUND_PASS_MINMAX` bit.
    const PASS_MINMAX: u32 = ffi::AVRounding::AV_ROUND_PASS_MINMAX.0;
    /// Returns this rounding with `AV_ROUND_PASS_MINMAX` set: a rescale passes
    /// `i64::MIN` and `i64::MAX` (and so `AV_NOPTS_VALUE`) through unchanged,
    /// and rounds every other value by this method.
    #[must_use]
    pub const fn pass_min_max(self) -> Self {
        Self(ffi::AVRounding(self.0.0 | Self::PASS_MINMAX))
    }
    /// Whether `AV_ROUND_PASS_MINMAX` is set.
    pub const fn passes_min_max(self) -> bool {
        self.0.0 & Self::PASS_MINMAX != 0
    }
    /// The rounding method alone, with `AV_ROUND_PASS_MINMAX` cleared.
    #[must_use]
    pub const fn method(self) -> Self {
        Self(ffi::AVRounding(self.0.0 & !Self::PASS_MINMAX))
    }
    /// The C value, for a raw call.
    pub const fn as_raw(self) -> ffi::AVRounding {
        self.0
    }
    /// The value as `Rounding`, when `av_rescale_rnd` accepts it: a method,
    /// alone or with `AV_ROUND_PASS_MINMAX`.
    pub const fn from_raw(raw: ffi::AVRounding) -> Option<Self> {
        match raw.0 & !Self::PASS_MINMAX {
            0..=3 | 5 => Some(Self(raw)),
            _ => None,
        }
    }
    /// The method's C name.
    const fn method_name(self) -> &'static str {
        match self.method().0 {
            ffi::AVRounding::AV_ROUND_ZERO => "ZERO",
            ffi::AVRounding::AV_ROUND_INF => "INF",
            ffi::AVRounding::AV_ROUND_DOWN => "DOWN",
            ffi::AVRounding::AV_ROUND_UP => "UP",
            _ => "NEAR_INF",
        }
    }
}
impl fmt::Debug for Rounding {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str("Rounding::")?;
        f.write_str(self.method_name())?;
        if self.passes_min_max() {
            f.write_str(".pass_min_max()")?;
        }
        Ok(())
    }
}
impl From<Rounding> for ffi::AVRounding {
    fn from(rounding: Rounding) -> Self {
        rounding.as_raw()
    }
}
impl TryFrom<ffi::AVRounding> for Rounding {
    type Error = InvalidRounding;
    fn try_from(raw: ffi::AVRounding) -> Result<Self, Self::Error> {
        Self::from_raw(raw).ok_or(InvalidRounding(raw.0))
    }
}
/// An `enum AVRounding` value that is not a rounding method, alone or with
/// `AV_ROUND_PASS_MINMAX`; `av_rescale_rnd` rejects it with `INT64_MIN`.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub struct InvalidRounding(pub u32);
impl fmt::Display for InvalidRounding {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "invalid AVRounding value {:#x}", self.0)
    }
}
impl std::error::Error for InvalidRounding {}
/// Wraps: av_compare_mod
///
/// Compares `a % m` with `b % m` for a power-of-two `m`: the wrapped
/// difference of the low `log2(m)` bits of `a` and `b`, read as a signed
/// value in `1 - m / 2..=m / 2`, so it is negative, zero or positive as `a`
/// lags, matches or leads `b` modulo `m` (as sequence numbers that wrap).
///
/// A modulus that is not a power of two gives a meaningless but defined
/// result, as in C; `m == 0` compares the whole 64 bits.
#[inline]
pub fn compare_mod(a: u64, b: u64, m: u64) -> i64 {
    // SAFETY: `av_compare_mod` takes and returns integers by value and
    // touches no memory; its arithmetic is unsigned, defined for every input.
    unsafe { ffi::av_compare_mod(a, b, m) }
}
/// Wraps: av_bessel_i0
///
/// The zeroth-order modified Bessel function of the first kind, `I0(x)`,
/// from C's minimax rational approximations. Even in `x`; NaN yields NaN and
/// a large `|x|` overflows to infinity.
#[inline]
pub fn bessel_i0(x: f64) -> f64 {
    // SAFETY: `av_bessel_i0` takes and returns a double by value and reads
    // only its own constant tables.
    unsafe { ffi::av_bessel_i0(x) }
}
/// Wraps: av_gcd
///
/// The greatest common divisor of `a` and `b`, up to sign: non-negative when
/// both are, `b` when `a` is 0 and `a` when `b` is 0 (so `gcd(0, 0) == 0`). A
/// divisor of `2^63` comes back as `i64::MIN`, its bit pattern: `gcd(i64::MIN,
/// i64::MIN)` is `i64::MIN`.
#[must_use]
pub fn gcd(a: i64, b: i64) -> i64 {
    // SAFETY: `av_gcd` takes its arguments by value and has no preconditions.
    unsafe { ffi::av_gcd(a, b) }
}
/// Wraps: av_rescale
///
/// `a * b / c`, computed without intermediate overflow and rounded to
/// nearest, halfway cases away from zero ([`Rounding::NEAR_INF`]).
///
/// `None` when C rejects the arguments or the result does not fit an `i64`:
/// `c <= 0`, `b < 0`, or a quotient beyond the `i64` range. C reports each of
/// these as `INT64_MIN`, which is never a rescaled value: the smallest result
/// it returns is `-i64::MAX`.
#[must_use]
pub fn rescale(a: i64, b: i64, c: i64) -> Option<i64> {
    // SAFETY: `av_rescale` takes integers by value, reads no memory and
    // handles every argument, rejecting with `INT64_MIN` what it cannot
    // rescale.
    let r = unsafe { ffi::av_rescale(a, b, c) };
    (r != i64::MIN).then_some(r)
}
/// C's `INT64_MIN` result of a rescale, read as the value it is: the
/// pass-through of `a == i64::MIN` under [`Rounding::pass_min_max`] when C
/// accepted `b` and `c`, and otherwise C's report that the arguments are
/// rejected or the quotient does not fit.
fn rescaled(r: i64, a: i64, b: i64, c: i64, rounding: Rounding) -> Option<i64> {
    let passed = a == i64::MIN && rounding.passes_min_max() && b >= 0 && c > 0;
    (r != i64::MIN || passed).then_some(r)
}
/// Wraps: av_rescale_rnd
///
/// `a * b / c`, computed without intermediate overflow and rounded by
/// `rounding`. Under [`Rounding::pass_min_max`], `i64::MIN` and `i64::MAX`
/// pass through unchanged.
///
/// `None` when C rejects the arguments or the result does not fit an `i64`:
/// `c <= 0`, `b < 0`, or a quotient beyond the `i64` range. C reports each of
/// these as `INT64_MIN`, which a rescale otherwise only returns as the
/// passed-through `i64::MIN`.
#[must_use]
pub fn rescale_rounded(a: i64, b: i64, c: i64, rounding: Rounding) -> Option<i64> {
    // SAFETY: `av_rescale_rnd` takes integers by value, reads no memory and
    // handles every argument, rejecting with `INT64_MIN` what it cannot
    // rescale; `rounding` is one of the values it accepts.
    let r = unsafe { ffi::av_rescale_rnd(a, b, c, rounding.into()) };
    rescaled(r, a, b, c, rounding)
}
/// Wraps: av_rescale_q_rnd
///
/// `a * bq / cq`, the value `a` in units of `bq` expressed in units of `cq`
/// (a timestamp from one time base to another), rounded by `rounding`. Under
/// [`Rounding::pass_min_max`], `i64::MIN` (`AV_NOPTS_VALUE`) and `i64::MAX`
/// pass through unchanged.
///
/// `None` as for [`rescale_rounded`] of `a`, `bq.num * cq.den` and
/// `cq.num * bq.den`: in particular when that divisor is not positive or that
/// multiplier is negative, as for a time base with a non-positive part.
#[must_use]
pub fn rescale_rational_rounded(
    a: i64,
    bq: Rational,
    cq: Rational,
    rounding: Rounding,
) -> Option<i64> {
    let (b, c) = (bq.into_raw(), cq.into_raw());
    // SAFETY: `av_rescale_q_rnd` takes its arguments by value, forms the
    // multiplier and divisor as products of two `int`s in `int64_t`, which
    // fit, and passes them to `av_rescale_rnd` (see `rescale_rounded`).
    let r = unsafe { ffi::av_rescale_q_rnd(a, b, c, rounding.into()) };
    rescaled(
        r,
        a,
        i64::from(b.num) * i64::from(c.den),
        i64::from(c.num) * i64::from(b.den),
        rounding,
    )
}
/// Wraps: av_rescale_q
///
/// [`rescale_rational_rounded`] rounding to nearest, halfway cases away from
/// zero ([`Rounding::NEAR_INF`]): `a` in units of `bq` expressed in units of
/// `cq`.
///
/// `None` as for [`rescale_rational_rounded`]; `i64::MIN` is rescaled as
/// `-i64::MAX`, never passed through.
#[must_use]
pub fn rescale_rational(a: i64, bq: Rational, cq: Rational) -> Option<i64> {
    // SAFETY: as for `rescale_rational_rounded`, with `AV_ROUND_NEAR_INF`.
    let r = unsafe { ffi::av_rescale_q(a, bq.into_raw(), cq.into_raw()) };
    (r != i64::MIN).then_some(r)
}
/// Wraps: av_compare_ts
///
/// Orders the timestamp `ts_a` in time base `tb_a` against `ts_b` in `tb_b`.
///
/// As in C, the answer is meaningful only when each timestamp, expressed in
/// the other's time base, fits an `i64`, and both time bases are positive;
/// otherwise it is an arbitrary but defined ordering.
#[must_use]
pub fn compare_timestamps(ts_a: i64, tb_a: Rational, ts_b: i64, tb_b: Rational) -> Ordering {
    // SAFETY: `av_compare_ts` takes its arguments by value. It multiplies the
    // timestamps directly only when they and the `int` cross products of the
    // time bases are all within `INT_MAX`, and otherwise compares through
    // `av_rescale_rnd`, which handles every argument.
    unsafe { ffi::av_compare_ts(ts_a, tb_a.into_raw(), ts_b, tb_b.into_raw()) }.cmp(&0)
}
/// Wraps: av_rescale_delta
///
/// Rescales the timestamp `in_ts` from `in_tb` to `out_tb`, keeping
/// successive packets' known durations: call it once per packet of a stream,
/// with `duration` the packet's length in units of `fs_tb` (samples,
/// typically), and the same `last` every time. `last` is the stream's state,
/// a timestamp in `fs_tb`: start it at `i64::MIN` (`AV_NOPTS_VALUE`).
///
/// While the position `last` predicts lies within one and a half units of
/// `in_tb` of `in_ts`, the result follows `last` (and so the summed
/// durations), clipped to within half a unit of `in_ts`, rather than the
/// rounded `in_ts`; otherwise, or when `in_tb` is no coarser than `out_tb`,
/// it is a plain [`rescale_rational`].
///
/// `None`, with `last` unchanged, for arguments C rejects or overflows on:
/// `in_ts == i64::MIN` and a negative `duration` (on which C aborts the
/// process), and a step whose intermediate timestamps leave the `i64` range
/// (`in_ts` beyond `±(2^62 - 1)` once rounding is needed, or a rescaled
/// value too close to `i64::MAX` to add `duration` to). `None` also when C
/// cannot represent the result in `out_tb`; `last` is then updated as C
/// updates it.
pub fn rescale_delta(
    in_tb: Rational,
    in_ts: i64,
    fs_tb: Rational,
    duration: i32,
    last: &mut i64,
    out_tb: Rational,
) -> Option<i64> {
    if in_ts == i64::MIN || duration < 0 {
        return None;
    }
    // C's control flow, run ahead with the same C rescales to find the
    // additions it would overflow; `None` from a rescale is C's `INT64_MIN`.
    let rnd = |a, r| rescale_rational_rounded(a, in_tb, fs_tb, r).unwrap_or(i64::MIN);
    let simple = || {
        rnd(in_ts, Rounding::NEAR_INF)
            .checked_add(duration.into())
            .map(drop)
    };
    let (i, o) = (in_tb.into_raw(), out_tb.into_raw());
    if *last == i64::MIN
        || duration == 0
        || i64::from(i.num) * i64::from(o.den) <= i64::from(o.num) * i64::from(i.den)
    {
        simple()?;
    } else {
        let twice = in_ts.checked_mul(2)?;
        let a = rnd(twice.checked_sub(1)?, Rounding::DOWN) >> 1;
        // `twice` is even, so `twice + 1` fits.
        let b = rnd(twice + 1, Rounding::UP).checked_add(1)? >> 1;
        // `2 * a` and `2 * b` fit: both are halves of an `i64`.
        if *last < (2 * a).checked_sub(b)? || *last > (2 * b).checked_sub(a)? {
            simple()?;
        }
        // Otherwise C adds `duration` to `last` clipped into `a..=b`, which
        // lies within `±2^62`, so the sum fits.
    }
    // SAFETY: `last` is a live, exclusive `int64_t` C reads and overwrites
    // during the call only. `in_ts` is not `AV_NOPTS_VALUE` and `duration` is
    // non-negative, so neither assertion aborts, and the run above took C's
    // path with C's own rescales and found none of its additions,
    // subtractions or doublings out of range.
    let r = unsafe {
        ffi::av_rescale_delta(
            in_tb.into_raw(),
            in_ts,
            fs_tb.into_raw(),
            duration,
            last,
            out_tb.into_raw(),
        )
    };
    (r != i64::MIN).then_some(r)
}
/// Wraps: av_add_stable
///
/// The timestamp `ts`, in time base `ts_tb`, advanced by `inc` units of
/// `inc_tb`, such that adding the same increment repeatedly accumulates no
/// rounding error: the result stays on the grid of `inc_tb` multiples that
/// `ts` lies on. The sum saturates at the `i64` range, and `ts` comes back
/// unchanged when an increment is shorter than one unit of `ts_tb` but not
/// expressible in it, or when C cannot rescale `ts`.
///
/// `None` where C overflows or divides by zero, which the call never reaches:
///
/// - `inc` beyond the `i32` range: C narrows it to `int` and adds the wrong
///   value;
/// - a zero numerator of `ts_tb`, or `inc_tb` whose product with `inc` has a
///   zero denominator;
/// - an increment that is a whole negative number of `ts_tb` units (negative
///   increments are not supported by C: shorter ones return `ts` unchanged).
#[must_use]
pub fn add_stable(ts_tb: Rational, ts: i64, inc_tb: Rational, inc: i64) -> Option<i64> {
    // C's divisibility test, computed as C does, through the same
    // `av_mul_q`.
    let step = if inc == 1 {
        inc_tb
    } else {
        inc_tb * Rational::new(i32::try_from(inc).ok()?, 1)
    };
    let (s, t) = (step.into_raw(), ts_tb.into_raw());
    let m = i64::from(s.num) * i64::from(t.den);
    let d = i64::from(s.den) * i64::from(t.num);
    if d == 0 || (m % d == 0 && m / d < 0) {
        return None;
    }
    // SAFETY: `av_add_stable` takes its arguments by value. `inc` fits an
    // `int`, so C's `(AVRational){inc, 1}` is the value multiplied above, and
    // `m` and `d` are C's: `d` is nonzero, so `m % d` and `m / d` are
    // defined, and a quotient that divides exactly is non-negative, so
    // `INT64_MAX - m / d` does not overflow. The rest rescales through
    // `av_rescale_q` and saturates.
    Some(unsafe { ffi::av_add_stable(ts_tb.into_raw(), ts, inc_tb.into_raw(), inc) })
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    const METHODS: [Rounding; 5] = [
        Rounding::ZERO,
        Rounding::INF,
        Rounding::DOWN,
        Rounding::UP,
        Rounding::NEAR_INF,
    ];
    #[test]
    fn methods_carry_the_c_values() {
        let raw: Vec<u32> = METHODS.iter().map(|r| r.as_raw().0).collect();
        assert_eq!(raw, [0, 1, 2, 3, 5]);
        assert_eq!(Rounding::UP.pass_min_max().as_raw().0, 3 | 8192);
        assert_eq!(size_of::<Rounding>(), size_of::<ffi::AVRounding>());
    }
    #[test]
    fn flag_toggles_without_touching_the_method() {
        for r in METHODS {
            assert!(!r.passes_min_max());
            let p = r.pass_min_max();
            assert!(p.passes_min_max());
            assert_ne!(p, r);
            assert_eq!(p.pass_min_max(), p);
            assert_eq!(p.method(), r);
            assert_eq!(r.method(), r);
        }
    }
    #[test]
    fn from_raw_accepts_methods_with_or_without_the_flag() {
        for v in [0, 1, 2, 3, 5] {
            for raw in [v, v | 8192] {
                let r = Rounding::from_raw(ffi::AVRounding(raw)).unwrap();
                assert_eq!(r.as_raw().0, raw);
                assert_eq!(Rounding::try_from(ffi::AVRounding(raw)), Ok(r));
                assert_eq!(ffi::AVRounding::from(r), ffi::AVRounding(raw));
            }
        }
    }
    #[test]
    fn from_raw_rejects_everything_else() {
        for raw in [
            4,
            6,
            7,
            8,
            4096,
            8192 | 4,
            8192 | 6,
            16384,
            8192 | 16384,
            1 << 31,
            u32::MAX,
        ] {
            assert_eq!(Rounding::from_raw(ffi::AVRounding(raw)), None, "{raw:#x}");
            assert_eq!(
                Rounding::try_from(ffi::AVRounding(raw)),
                Err(InvalidRounding(raw))
            );
        }
    }
    #[test]
    fn debug_names_the_method_and_the_flag() {
        let names: Vec<String> = METHODS.iter().map(|r| format!("{r:?}")).collect();
        assert_eq!(
            names,
            [
                "Rounding::ZERO",
                "Rounding::INF",
                "Rounding::DOWN",
                "Rounding::UP",
                "Rounding::NEAR_INF"
            ]
        );
        assert_eq!(
            format!("{:?}", Rounding::NEAR_INF.pass_min_max()),
            "Rounding::NEAR_INF.pass_min_max()"
        );
    }
    #[test]
    fn debug_forwards_writer_errors() {
        /// Accepts `budget` writes, then fails.
        struct Budget(usize);
        impl fmt::Write for Budget {
            fn write_str(&mut self, _: &str) -> fmt::Result {
                self.0 = self.0.checked_sub(1).ok_or(fmt::Error)?;
                Ok(())
            }
        }
        let r = Rounding::UP.pass_min_max();
        for budget in 0..3 {
            assert_eq!(
                fmt::write(&mut Budget(budget), format_args!("{r:?}")),
                Err(fmt::Error)
            );
        }
        assert_eq!(fmt::write(&mut Budget(3), format_args!("{r:?}")), Ok(()));
    }
    #[test]
    fn compare_mod_orders_wrapped_residues() {
        assert!(compare_mod(0x11, 0x02, 0x10) < 0);
        assert!(compare_mod(0x11, 0x02, 0x20) > 0);
        assert_eq!(compare_mod(0x1234, 0x5634, 0x100), 0);
        // Sequence numbers across the wrap: 1 follows 0xffff by 2.
        assert_eq!(compare_mod(1, 0xffff, 0x1_0000), 2);
        assert_eq!(compare_mod(0xffff, 1, 0x1_0000), -2);
        // Half the modulus away stays positive.
        assert_eq!(compare_mod(8, 0, 16), 8);
        assert_eq!(compare_mod(9, 0, 16), -7);
        assert_eq!(compare_mod(0, u64::MAX, 0), 1);
    }
    #[test]
    fn bessel_i0_is_even_and_grows() {
        assert_eq!(bessel_i0(0.0), 1.0);
        assert_eq!(bessel_i0(-0.0), 1.0);
        for x in [0.5, 1.0, 14.9, 15.0, 15.1, 100.0] {
            assert_eq!(bessel_i0(x), bessel_i0(-x));
            assert!(bessel_i0(x) > 1.0);
        }
        assert!((bessel_i0(1.0) - 1.266_065_877_752_008_4).abs() < 1e-12);
        assert!(bessel_i0(f64::NAN).is_nan());
        assert_eq!(bessel_i0(1e4), f64::INFINITY);
    }
    #[test]
    fn invalid_rounding_reports_the_value() {
        let e = Rounding::try_from(ffi::AVRounding(8196)).unwrap_err();
        assert_eq!(e.to_string(), "invalid AVRounding value 0x2004");
        let _: &dyn std::error::Error = &e;
    }
    /// `num/den`, for brevity.
    fn q(num: i32, den: i32) -> Rational {
        Rational::new(num, den)
    }
    #[test]
    fn rescaled_tells_pass_through_from_rejection() {
        let pass = Rounding::DOWN.pass_min_max();
        assert_eq!(rescaled(i64::MIN, i64::MIN, 1, 1, pass), Some(i64::MIN));
        assert_eq!(rescaled(i64::MIN, i64::MIN, 0, 1, pass), Some(i64::MIN));
        // C rejects a bad `b` or `c` before it passes anything through.
        assert_eq!(rescaled(i64::MIN, i64::MIN, -1, 1, pass), None);
        assert_eq!(rescaled(i64::MIN, i64::MIN, 1, 0, pass), None);
        assert_eq!(rescaled(i64::MIN, i64::MIN, 1, 1, Rounding::DOWN), None);
        assert_eq!(rescaled(i64::MIN, 5, 1, 1, pass), None);
        assert_eq!(rescaled(-3, i64::MIN, 1, 1, Rounding::DOWN), Some(-3));
    }
    #[test]
    fn rescale_rounded_rounds_and_passes_through() {
        assert_eq!(rescale_rounded(7, 1, 2, Rounding::ZERO), Some(3));
        assert_eq!(rescale_rounded(7, 1, 2, Rounding::INF), Some(4));
        assert_eq!(rescale_rounded(-7, 1, 2, Rounding::DOWN), Some(-4));
        assert_eq!(rescale_rounded(-7, 1, 2, Rounding::UP), Some(-3));
        assert_eq!(rescale_rounded(-7, 1, 2, Rounding::NEAR_INF), Some(-4));
        let pass = Rounding::NEAR_INF.pass_min_max();
        assert_eq!(rescale_rounded(i64::MIN, 3, 7, pass), Some(i64::MIN));
        assert_eq!(rescale_rounded(i64::MAX, 3, 7, pass), Some(i64::MAX));
        assert_eq!(
            rescale_rounded(i64::MIN, 1, 1, Rounding::NEAR_INF),
            Some(-i64::MAX)
        );
        assert_eq!(rescale_rounded(1, 1, 0, Rounding::UP), None);
        assert_eq!(rescale_rounded(1, -1, 1, Rounding::UP), None);
        assert_eq!(rescale_rounded(i64::MAX, 2, 1, Rounding::UP), None);
        assert_eq!(rescale_rounded(i64::MIN, 1, 0, pass), None);
    }
    #[test]
    fn rescale_rational_converts_time_bases() {
        assert_eq!(
            rescale_rational(90_000, q(1, 90_000), q(1, 1000)),
            Some(1000)
        );
        assert_eq!(
            rescale_rational_rounded(1, q(1, 3), q(1, 1), Rounding::UP),
            Some(1)
        );
        assert_eq!(rescale_rational(1, q(1, 3), q(1, 1)), Some(0));
        assert_eq!(rescale_rational(1, q(1, 3), q(0, 1)), None);
        assert_eq!(rescale_rational(1, q(-1, 3), q(1, 1)), None);
        assert_eq!(
            rescale_rational(i64::MIN, q(1, 1), q(1, 1)),
            Some(-i64::MAX)
        );
        let pass = Rounding::ZERO.pass_min_max();
        assert_eq!(
            rescale_rational_rounded(i64::MIN, q(1, 1), q(1, 2), pass),
            Some(i64::MIN)
        );
        assert_eq!(
            rescale_rational_rounded(i64::MIN, q(1, 1), q(0, 2), pass),
            None
        );
    }
    #[test]
    fn compare_timestamps_orders_across_time_bases() {
        let (ms, us) = (q(1, 1000), q(1, 1_000_000));
        assert_eq!(compare_timestamps(1, ms, 1000, us), Ordering::Equal);
        assert_eq!(compare_timestamps(1, ms, 999, us), Ordering::Greater);
        assert_eq!(compare_timestamps(1, ms, 1001, us), Ordering::Less);
        let big = 1 << 40;
        assert_eq!(
            compare_timestamps(big, ms, big * 1000 + 1, us),
            Ordering::Less
        );
    }
    #[test]
    fn rescale_delta_rejects_what_c_aborts_on() {
        let mut last = 77;
        let tb = q(1, 44_100);
        assert_eq!(rescale_delta(tb, i64::MIN, tb, 1024, &mut last, tb), None);
        assert_eq!(rescale_delta(tb, 0, tb, -1, &mut last, tb), None);
        assert_eq!(last, 77);
    }
    #[test]
    fn rescale_delta_rejects_overflowing_steps() {
        let (coarse, fine) = (q(1, 1000), q(1, 48_000));
        // Rounding is needed (`in_tb` coarser than `out_tb`, `last` set): C
        // doubles `in_ts`.
        let mut last = 0;
        assert_eq!(
            rescale_delta(coarse, 1 << 62, fine, 1, &mut last, fine),
            None
        );
        assert_eq!(
            rescale_delta(coarse, -(1 << 62), fine, 1, &mut last, fine),
            None
        );
        assert_eq!(last, 0);
        // The plain path adds `duration` to a rescale near `i64::MAX`.
        let mut last = i64::MIN;
        let one = q(1, 1);
        assert_eq!(rescale_delta(one, i64::MAX, one, 1, &mut last, one), None);
        assert_eq!(last, i64::MIN);
        assert_eq!(
            rescale_delta(one, i64::MAX - 1, one, 1, &mut last, one),
            Some(i64::MAX - 1)
        );
        assert_eq!(last, i64::MAX);
        // `2 * in_ts + 1` rescales to `i64::MAX`, to which C adds 1.
        let (half, mut last) = (q(1, 2), 0);
        assert_eq!(
            rescale_delta(one, (1 << 62) - 1, one, 1, &mut last, half),
            None
        );
        // The upper bound overflows while the lower does not: C's
        // `2 * a - b` then overflows.
        let fine = q(1, 1 << 20);
        assert_eq!(rescale_delta(one, 1 << 42, fine, 1, &mut last, fine), None);
        // Both bounds overflow, `last` falls outside them, and the plain
        // path adds `duration` to a rescale near `i64::MAX`.
        assert_eq!(
            rescale_delta(one, (1 << 62) - 1, half, 2, &mut last, half),
            None
        );
        assert_eq!(last, 0);
        assert_eq!(
            rescale_delta(one, (1 << 62) - 1, half, 1, &mut last, half),
            Some(i64::MAX - 1)
        );
        assert_eq!(last, i64::MAX);
    }
    #[test]
    fn rescale_delta_follows_known_durations() {
        // 1024-sample packets at 44.1 kHz, stamped in milliseconds.
        let (ms, sr) = (q(1, 1000), q(1, 44_100));
        let mut last = i64::MIN;
        let mut out = Vec::new();
        for i in 0..6 {
            // Stamps within half a millisecond of the true position.
            let in_ts = rescale_rational(i * 1024, sr, ms).unwrap();
            out.push(rescale_delta(ms, in_ts, sr, 1024, &mut last, sr).unwrap());
        }
        assert_eq!(out, [0, 1024, 2048, 3072, 4096, 5120]);
        assert_eq!(last, 6 * 1024);
    }
    #[test]
    fn add_stable_accumulates_no_error() {
        let (ts_tb, inc_tb) = (q(1, 1000), q(1, 44_100));
        let mut ts = 0;
        for _ in 0..44_100 / 1024 * 10 {
            ts = add_stable(ts_tb, ts, inc_tb, 1024).unwrap();
        }
        // 430 packets of 1024 samples, 9_984.68 ms, rounded once.
        assert_eq!(ts, 9985);
        assert_eq!(rescale_rational(430 * 1024, inc_tb, ts_tb), Some(ts));
        // Exact multiples add, and saturate nothing.
        assert_eq!(add_stable(q(1, 10), 5, q(1, 2), 3), Some(20));
        assert_eq!(add_stable(q(1, 1), i64::MAX, q(1, 1), 1), Some(i64::MAX));
    }
    #[test]
    fn add_stable_rejects_what_c_overflows_on() {
        let tb = q(1, 1000);
        assert_eq!(add_stable(tb, 0, tb, i64::from(i32::MAX) + 1), None);
        assert_eq!(add_stable(tb, 0, tb, i64::from(i32::MIN) - 1), None);
        assert!(add_stable(tb, 0, tb, i64::from(i32::MIN)).is_none());
        // A zero `ts_tb` numerator or a zero increment denominator divides by
        // zero.
        assert_eq!(add_stable(q(0, 1), 0, tb, 1), None);
        assert_eq!(add_stable(tb, 0, q(1, 0), 1), None);
        // A whole negative number of ticks overflows `INT64_MAX - m / d`.
        assert_eq!(add_stable(tb, 10, tb, -1), None);
        assert_eq!(add_stable(tb, 10, q(-1, 1000), 1), None);
        // A shorter negative increment leaves `ts` as it is.
        assert_eq!(add_stable(q(1, 10), 10, q(-1, 1000), 1), Some(10));
    }
    #[test]
    fn rejections_before_the_call_touch_no_c() {
        // Built without `av_make_q`, so the test runs where C cannot (Miri).
        let r = |num, den| Rational::from_raw(ffi::AVRational { num, den });
        let tb = r(1, 1000);
        let mut last = 5;
        assert_eq!(rescale_delta(tb, i64::MIN, tb, 1, &mut last, tb), None);
        assert_eq!(rescale_delta(tb, 1, tb, -1, &mut last, tb), None);
        assert_eq!(rescale_delta(tb, 1, tb, i32::MIN, &mut last, tb), None);
        assert_eq!(last, 5);
        assert_eq!(add_stable(tb, 0, tb, i64::from(i32::MAX) + 1), None);
        assert_eq!(add_stable(tb, 0, tb, i64::MIN), None);
        assert_eq!(add_stable(tb, 0, tb, i64::MAX), None);
    }
}
//! Safe wrappers over `libavutil/timestamp.h`.
use core::ffi::CStr;
use super::ffi;
use super::rational::{Rational, RationalRef};
/// Wraps: av_ts_make_string
///
/// Writes `ts` into `buf` as decimal text, or `NOPTS` for `AV_NOPTS_VALUE`
/// (`i64::MIN`), and returns that text, borrowed from `buf`.
///
/// ```
/// use ffmpeg::libavutil::{ffi, timestamp::make_string};
/// let mut buf = [0u8; ffi::AV_TS_MAX_STRING_SIZE as usize];
/// assert_eq!(make_string(&mut buf, -42), c"-42");
/// assert_eq!(make_string(&mut buf, i64::MIN), c"NOPTS");
/// ```
pub fn make_string(buf: &mut [u8; ffi::AV_TS_MAX_STRING_SIZE as usize], ts: i64) -> &CStr {
    // SAFETY: `buf` is `AV_TS_MAX_STRING_SIZE` writable bytes, the bound
    // `av_ts_make_string` gives `snprintf`; the returned pointer is `buf`.
    unsafe { ffi::av_ts_make_string(buf.as_mut_ptr().cast(), ts) };
    // `snprintf` NUL-terminated its output within `buf`.
    CStr::from_bytes_until_nul(buf).unwrap_or_default()
}
/// Wraps: av_ts_make_time_string2
///
/// Writes the time `ts` ticks of `time_base` stand for, in seconds, into
/// `buf` and returns that text, borrowed from `buf`; `AV_NOPTS_VALUE`
/// (`i64::MIN`) is `NOPTS`.
///
/// The value `ts * num / den`, computed as a `double`, is printed with six
/// decimals, or with six significant digits when its magnitude is below 1,
/// and loses its trailing zeros and a bare trailing `.`. A zero denominator
/// gives `inf`, `-inf` or, for `0/0` and `0 * inf`, a NaN as `printf` spells
/// it: `-nan` on x86-64 (C's trimming cuts a positive `nan` to `n`).
///
/// ```
/// use ffmpeg::libavutil::{ffi, rational::Rational, timestamp::make_time_string};
/// let mut buf = [0u8; ffi::AV_TS_MAX_STRING_SIZE as usize];
/// assert_eq!(make_time_string(&mut buf, 135_000, Rational::new(1, 90_000)), c"1.5");
/// assert_eq!(make_time_string(&mut buf, 3, Rational::new(1, 1000)), c"0.003");
/// assert_eq!(make_time_string(&mut buf, -1, Rational::new(1, 0)), c"-inf");
/// assert_eq!(make_time_string(&mut buf, i64::MIN, Rational::new(1, 1)), c"NOPTS");
/// ```
pub fn make_time_string(
    buf: &mut [u8; ffi::AV_TS_MAX_STRING_SIZE as usize],
    ts: i64,
    time_base: Rational,
) -> &CStr {
    // SAFETY: `buf` is `AV_TS_MAX_STRING_SIZE` writable bytes, the bound
    // `av_ts_make_time_string2` gives `snprintf` and its NUL store (at most
    // `buf[31]`); `time_base` is passed by value and any pair of `int`s is
    // accepted; the returned pointer is `buf`, which C does not retain.
    unsafe { ffi::av_ts_make_time_string2(buf.as_mut_ptr().cast(), ts, time_base.into_raw()) };
    // C NUL-terminated its output within `buf`.
    CStr::from_bytes_until_nul(buf).unwrap_or_default()
}
/// Wraps: av_ts_make_time_string
///
/// [`make_time_string`], with the time base read through a shared handle, as
/// C reads it through a `const AVRational *`: a time base stored in another
/// object (a field of a wrapped C struct) is passed in place, without first
/// copying it out. Writes the same text into `buf` and returns it, borrowed
/// from `buf`.
///
/// ```
/// use ffmpeg::libavutil::{ffi, rational::Rational, timestamp::make_time_string_by_ref};
/// let mut buf = [0u8; ffi::AV_TS_MAX_STRING_SIZE as usize];
/// let tb = Rational::new(1, 90_000);
/// assert_eq!(make_time_string_by_ref(&mut buf, 135_000, tb.as_ref()), c"1.5");
/// assert_eq!(make_time_string_by_ref(&mut buf, i64::MIN, tb.as_ref()), c"NOPTS");
/// ```
pub fn make_time_string_by_ref<'a>(
    buf: &'a mut [u8; ffi::AV_TS_MAX_STRING_SIZE as usize],
    ts: i64,
    tb: RationalRef<'_>,
) -> &'a CStr {
    // SAFETY: `buf` is `AV_TS_MAX_STRING_SIZE` writable bytes, the bound
    // `av_ts_make_time_string2` gives `snprintf`, and its trimming indexes
    // below that bound (`snprintf` writes at least one character); `tb`
    // points to a live `AVRational` C reads once, by value. The returned
    // pointer is `buf`.
    unsafe { ffi::av_ts_make_time_string(buf.as_mut_ptr().cast(), ts, tb.as_ptr()) };
    // C NUL-terminated its output within `buf`.
    CStr::from_bytes_until_nul(buf).unwrap_or_default()
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn make_string_overwrites_a_dirty_buffer() {
        let mut buf = [b'x'; ffi::AV_TS_MAX_STRING_SIZE as usize];
        assert_eq!(make_string(&mut buf, 0), c"0");
        assert_eq!(&buf[..3], b"0\0x");
        assert_eq!(make_string(&mut buf, i64::MAX), c"9223372036854775807");
        assert_eq!(make_string(&mut buf, i64::MIN + 1), c"-9223372036854775807");
        assert_eq!(make_string(&mut buf, i64::MIN), c"NOPTS");
    }
    #[test]
    fn make_time_string_overwrites_a_dirty_buffer() {
        let mut buf = [b'x'; ffi::AV_TS_MAX_STRING_SIZE as usize];
        let ms = Rational::new(1, 1000);
        assert_eq!(make_time_string(&mut buf, 1500, ms), c"1.5");
        // `snprintf` wrote "1.500000"; the trim stored a NUL after "1.5".
        assert_eq!(&buf[..9], b"1.5\x000000\0");
        assert_eq!(buf[9], b'x');
        assert_eq!(make_time_string(&mut buf, 0, ms), c"0");
        assert_eq!(make_time_string(&mut buf, i64::MIN, ms), c"NOPTS");
    }
    #[test]
    fn make_time_string_trims_as_documented() {
        let mut buf = [0; ffi::AV_TS_MAX_STRING_SIZE as usize];
        let cases: [(i64, i32, i32, &CStr); 12] = [
            (2, 3, 1, c"6"),
            (-5, 1, 10, c"-0.5"),
            (1, 1, 3, c"0.333333"),
            (-2, 1, 3, c"-0.666667"),
            (1, 1, 10_000_000, c"0.0000001"),
            (1, 1, i32::MAX, c"0.000000000465661"),
            (123_456_789, 1, 1000, c"123456.789"),
            (i64::MAX, 1, 1, c"9223372036854775808"),
            (i64::MAX, i32::MAX, 1, c"19807040619342712361531211776"),
            (i64::MIN + 1, i32::MIN, 1, c"19807040628566084398385987584"),
            (1, 1, 0, c"inf"),
            (-1, 1, 0, c"-inf"),
        ];
        for (ts, num, den, text) in cases {
            assert_eq!(
                make_time_string(&mut buf, ts, Rational::new(num, den)),
                text,
                "{ts} {num}/{den}"
            );
        }
        for (ts, num) in [(0, 0), (1, 0), (0, 1)] {
            let nan = make_time_string(&mut buf, ts, Rational::new(num, 0)).to_bytes();
            assert!(nan.ends_with(b"nan") || nan == b"n", "{nan:?}");
        }
    }
    #[test]
    fn make_time_string_by_ref_trims_seconds() {
        let mut buf = [b'x'; ffi::AV_TS_MAX_STRING_SIZE as usize];
        let ms = Rational::new(1, 1000);
        assert_eq!(make_time_string_by_ref(&mut buf, 1500, ms.as_ref()), c"1.5");
        assert_eq!(make_time_string_by_ref(&mut buf, 0, ms.as_ref()), c"0");
        assert_eq!(
            make_time_string_by_ref(&mut buf, -1, ms.as_ref()),
            c"-0.001"
        );
        assert_eq!(
            make_time_string_by_ref(&mut buf, 3, Rational::new(1, 3).as_ref()),
            c"1"
        );
        assert_eq!(
            make_time_string_by_ref(&mut buf, i64::MIN, ms.as_ref()),
            c"NOPTS"
        );
        assert_eq!(
            make_time_string_by_ref(&mut buf, 1, Rational::new(1, 0).as_ref()),
            c"inf"
        );
        assert_eq!(
            make_time_string_by_ref(&mut buf, -1, Rational::new(1, 0).as_ref()),
            c"-inf"
        );
    }
}
