#!/bin/bash
# prep-review-merged.sh <link-unit> <subsystem> <wave>
# One review batch per item kind over the whole wave: batch-0 = types, batch-1 = symbols
# (a single batch-0 when the wave has one kind). Review branch starts at the wave's landed tip.
set -euo pipefail
cd /target
C=20261005; LU=$1; S=$2; W=$3
WB=crustify/reviews/$C/$LU/$S/wave-$W; BBP=crustify/review-batches/$C/$LU/$S/wave-$W
AD=crustify/campaigns/$C/$LU/$S/review-wave-$W
git branch "$WB" crustify/waves/$C/$LU/$S/wave-$W
mkdir -p "$AD"; git rev-parse "$WB" > "$AD/base"
n=$(python3 -I - "$LU" "$S" "$W" "$AD" <<'PY'
import json, sys, os
lu, sub, w, ad = sys.argv[1:]
s = json.load(open("crustify/campaigns/20261005/schedule.json"))
S = next(x for x in next(l for l in s["link_units"] if l["name"] == lu)["subsystems"] if x["name"] == sub)
items = [it for b in S["waves"][int(w)]["batches"] for it in b["items"]]
groups = [[i for i in items if i["kind"] == "type"], [i for i in items if i["kind"] != "type"]]
groups = [g for g in groups if g]
for k, g in enumerate(groups):
    os.makedirs(f"{ad}/batch-{k}", exist_ok=True)
    with open(f"{ad}/batch-{k}/batch.json", "w") as fh:
        json.dump({"objective": "review", "items": g}, fh, indent=2); fh.write("\n")
print(len(groups))
PY
)
for ((B=0; B<n; B++)); do
  git branch "$BBP/batch-$B" "$WB"
  WT=crustify/.worktrees/$BBP/batch-$B
  git worktree add -q "$WT" "$BBP/batch-$B"
  for p in .providers builds fate-suite; do ln -s /target/crustify/$p "$WT/crustify/$p"; done
  mkdir -p "$WT/crustify/wavefront"
  ln -s /target/crustify/wavefront/codeql "$WT/crustify/wavefront/codeql"
  [ -d /target/crustify/wavefront/.cache ] && ln -s /target/crustify/wavefront/.cache "$WT/crustify/wavefront/.cache"
  echo "prepared $WT: $(python3 -I -c "import json,sys;b=json.load(open(sys.argv[1]));print(len(b['items']),'items,',b['items'][0]['kind'])" $AD/batch-$B/batch.json)"
done
exec
