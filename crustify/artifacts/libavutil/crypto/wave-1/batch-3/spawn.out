3714388       00:22  0.0 /bin/bash -c python3 - <<'PY' p='crustify/rust/ffmpeg/libavutil/des.rs' s=open(p).read(); pos=s.index('\nimpl DesMut') s=s[:pos]+''' fn block_count(len: usize) -> Result<i32, i32> {     if !len.is_multiple_of(8) {         return Err(-22);     }     i32::try_from(len / 8).map_err(|_| -22) }  impl DesRef<'_> {     /// Wraps: av_des_crypt     ///     /// Encrypt or decrypt whole 8-byte blocks. `None` selects ECB; an IV     /// selects CBC and is updated for the next call. Returns -22 without     /// changing output or IV for unequal lengths, partial blocks, or a block     /// count exceeding C's `int`. Unaligned byte buffers are supported by     /// C's actual AV_RB64/AV_WB64 implementation despite the header wording.     pub fn crypt(         &self,         dst: &mut [u8],         src: &[u8],         iv: Option<&mut [u8; 8]>,         decrypt: bool,     ) -> Result<(), i32> {         let count = block_count(src.len())?;         if dst.len() != src.len() {             return Err(-22);         }         if count == 0 {             return Ok(());         }         let iv = iv.map_or(core::ptr::null_mut(), |iv| iv.as_mut_ptr());         // SAFETY: the live context is only read by des_encdec and its callers,         // even though C lacks const. Distinct slices supply count whole blocks;         // the optional IV has eight exclusively borrowed bytes. C performs         // unaligned reads/writes and retains no pointer or buffer reference.         unsafe {             ffi::av_des_crypt(self.as_ptr().cast_mut(), dst.as_mut_ptr(),                               src.as_ptr(), count, iv, i32::from(decrypt));         }         Ok(())     }      /// Wraps: av_des_crypt     ///     /// The exact in-place variant of [`Self::crypt`], with the same validation.     pub fn crypt_in_place(         &self,         data: &mut [u8],         iv: Option<&mut [u8; 8]>,         decrypt: bool,     ) -> Result<(), i32> {         let count = block_count(data.len())?;         if count == 0 {             return Ok(());         }         let iv = iv.map_or(core::ptr::null_mut(), |iv| iv.as_mut_ptr());         let ptr = data.as_mut_ptr();         // SAFETY: C reads each eight-byte block before overwriting it and         // supports exact src/dst aliasing, including CBC decryption. The         // context is read-only, data exclusively borrowed, IV disjoint and         // exactly eight bytes. All lengths were checked; no pointer is kept.         unsafe {             ffi::av_des_crypt(self.as_ptr().cast_mut(), ptr, ptr, count,                               iv, i32::from(decrypt));         }         Ok(())     }      /// Wraps: av_des_crypt     ///     /// Encrypt/decrypt zero blocks into `dst`. Uses real zero-filled input:     /// C's advertised NULL input is defective for multiple blocks because     /// it increments NULL and subsequently dereferences the resulting pointer.     pub fn crypt_zeros(         &self,         dst: &mut [u8],         iv: Option<&mut [u8; 8]>,         decrypt: bool,     ) -> Result<(), i32> {         block_count(dst.len())?;         dst.fill(0);         self.crypt_in_place(dst, iv, decrypt)     }      /// Wraps: av_des_mac     ///     /// CBC-MAC of whole blocks. Empty input returns the initial all-zero MAC.     /// The context is borrowed read-only; no input or result pointer is retained.     pub fn mac(&self, src: &[u8]) -> Result<[u8; 8], i32> {         let count = block_count(src.len())?;         let mut mac = [0; 8];         if count != 0 {             // SAFETY: C reads the context without changing it, reads count             // whole unaligned-safe blocks, and overwrites the same eight-byte             // output on each iteration. The buffers cannot overlap and C             // retains neither. Empty input bypasses C's pointer arithmetic.             unsafe { ffi::av_des_mac(self.as_ptr().cast_mut(), mac.as_mut_ptr(),                                      src.as_ptr(), count) };         }         Ok(mac)     }