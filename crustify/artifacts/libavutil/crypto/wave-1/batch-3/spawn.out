     use super::*;
 
     #[test]
+    fn buffer_validation_and_errors() {
+        assert_eq!(block_count(8, 16), Err(CryptError::LengthMismatch));
+        for len in 0..=65 {
+            let expected = if len % 8 == 0 { Ok((len / 8) as i32) }
+                else { Err(CryptError::PartialBlock) };
+            assert_eq!(block_count(len, len), expected);
+        }
+        if usize::BITS > 32 {
+            let max = (i32::MAX as usize) * 8;
+            assert_eq!(block_count(max, max), Ok(i32::MAX));
+            assert_eq!(block_count(max + 8, max + 8), Err(CryptError::TooManyBlocks));
+        }
+        for error in [CryptError::LengthMismatch, CryptError::PartialBlock, CryptError::TooManyBlocks] {
+            assert!(!error.to_string().is_empty());
+            assert_eq!(error.clone(), error);
+        }
+    }
+
+    #[test]
+    fn rejected_buffers_preserve_output_iv_and_key() {
+        let context = Xtea::from_key_words([u32::MAX; 16]);
+        let view = context.as_ref();
+        for le in [false, true] {
+            for direction in [Direction::Encrypt, Direction::Decrypt] {
+                for len in 0..=17 {
+                    let mut dst = vec![0xa5; len];
+                    let mut iv = [0x5a; 8];
+                    assert_eq!(view.process(&mut dst, Some(&[0; 24]), Some(&mut iv), direction, le), Err(CryptError::LengthMismatch));
+                    assert_eq!(dst, vec![0xa5; len]);
+                    assert_eq!(iv, [0x5a; 8]);
+                    if len % 8 != 0 {
+                        assert_eq!(view.process(&mut dst, None, Some(&mut iv), direction, le), Err(CryptError::PartialBlock));
+                        assert_eq!(view.process(&mut dst, Some(&vec![0; len]), Some(&mut iv), direction, le), Err(CryptError::PartialBlock));
+                        assert_eq!(dst, vec![0xa5; len]);
+                        assert_eq!(iv, [0x5a; 8]);
+                    }
+                }
+            }
+        }
+        assert_eq!(view.key(), [u32::MAX; 16]);
+    }
+
+    #[test]
     fn ffi_free_layout_and_value_copy() {
         assert_eq!(size_of::<Xtea>(), size_of::<ffi::AVXTEA>());
         assert_eq!(align_of::<Xtea>(), align_of::<ffi::AVXTEA>());
