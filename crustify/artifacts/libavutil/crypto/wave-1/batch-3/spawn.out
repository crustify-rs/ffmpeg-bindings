iciently large buffer.     pub fn calculate(         &mut self, data: &[u8], key: &[u8], output: &mut [u8],     ) -> Result<usize, i32> {         let data_len = key_len(data.len())?;         let key_len = key_len(key.len())?;         let output_len = key_len_checked(output.len())?;         let empty = 0u8;         let data_ptr = if data.is_empty() { &raw const empty } else { data.as_ptr() };         let key_ptr = if key.is_empty() { &raw const empty } else { key.as_ptr() };         // SAFETY: exclusive context with valid algorithm callbacks; data/key         // supply the checked lengths and live pointers even at length zero.         // C copies/hashes the key, reads input, checks output capacity before         // writing, and keeps only its own key/hash state, not caller pointers.         let result = unsafe {             ffi::av_hmac_calc(self.as_mut_ptr(), data_ptr, data_len, key_ptr,                               key_len, output.as_mut_ptr(), output_len)         };         if result < 0 { Err(result) } else { Ok(result as usize) }     } } ''' +s[pos:]; s=s.replace('let key_len = key_len(key.len())?;', 'let key_size = key_len(key.len())?;').replace('key_len_checked(output.len())?', 'key_len(output.len())?').replace('key_len, output.as_mut_ptr()', 'key_size, output.as_mut_ptr()'); open(p,'w').write(s) p='crustify/rust/libavutil-sys/allowlist.txt'; s=open(p).read(); s+='\n# Crypto wave 1 batch 1: remaining DES/hash/HMAC symbols.\nfunction ^av_des_mac$\nfunction ^av_hash_final_bin$\nfunction ^av_hash_final_hex$\nfunction ^av_hash_final_b64$\nfunction ^av_hmac_calc$\n'; open(p,'w').write(s) PY cargo fmt --manifest-path crustify/rust/Cargo.toml --all; cargo check --manifest-path crustify/rust/Cargo.toml -p libavutil-sys > /tmp/crustify-crypto-b1/sys-check.log 2>&1; cargo test --manifest-path crustify/rust/Cargo.toml -p libavutil-sys > /tmp/crustify-crypto-b1/sys-test.log 2>&1; cargo check --manifest-path crustify/rust/Cargo.toml --workspace > /tmp/crustify-crypto-b1/c