    ///     owner.as_ref()
    /// }
    /// ```
    /// Exclusive handles cannot alias:
    /// ```compile_fail
    /// use ffmpeg::libavutil::tea::Tea;
    /// let mut owner = Tea::new(&[0; 16], 64).unwrap();
    /// let mut first = owner.as_mut();
    /// let mut second = owner.as_mut();
    /// first.init(&[1; 16], 64);
    /// second.init(&[2; 16], 64);
    /// ```
    Tea, TeaRef, TeaMut, ffi::AVTEA
);
