import json, subprocess
from pathlib import Path
base=Path('/tmp/crustify-crypto-batch-1')
def submit(subject,name,doc):
 p=base/f'{name}-findings.json'; p.write_text(json.dumps(doc))
 r=subprocess.run(['wavefront','.', '--config','crustify/wavefront/configs/wavefront-config.json','query',subject,'--name',name,'--update',str(p)],capture_output=True,text=True)
 (base/f'{name}-update.log').write_text(r.stdout+r.stderr)
 if r.returncode: raise Exception(r.stderr)
def ptr(*,array=False,owned=False,mutable=False,nullable=False,note=''):
 return dict(scalar=None if array else {'by_val':True},array={'by_val':True} if array else None,string=False,owned=owned,borrowed=None if owned else {'lifetime':'arg:key' if array else 'arg:ctx'},nullable=nullable,mutable=mutable,note=note)
for algo,ctx in [('blowfish','ctx'),('camellia','cs')]:
 if algo == 'camellia': submit('symbols',f'av_{algo}_alloc',{'ptr_ret':{'ptr':ptr(owned=True,mutable=True,nullable=True,note='Fresh full-sized zeroed singleton; av_free releases it; no nested resources or retained alias.')},'lifetime':{'for':'return','is_dropper':False,'is_disposer':False,'is_cloner':None,'is_constructor':{'alloc':True,'init':False}}})
 submit('symbols',f'av_{algo}_init',{'ptr_args':{'0':{'ptr':dict(ptr(mutable=True,note='Exclusive full-sized context borrowed for call only; inline also supported for Blowfish.'), borrowed={'lifetime':f'arg:{ctx}'})},'1':{'ptr':ptr(array=True,note='Borrowed read-only key for call; never retained. Blowfish requires at least one readable byte and positive int length. Camellia reads exactly key_bits/8 bytes for 128/192/256.')}},'lifetime':{'for':ctx,'is_dropper':False,'is_disposer':False,'is_cloner':None,'is_constructor':{'alloc':False,'init':True}}})
