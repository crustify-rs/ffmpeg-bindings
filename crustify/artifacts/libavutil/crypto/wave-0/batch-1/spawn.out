        objs = []
        for w in WORKLOADS:
            if w in exes: objs += ["-object", exes[w]]
        lc = sh([f"{TC}/llvm-cov", "export", "-format=lcov", "-instr-profile", str(tmp / "m.profdata")] + objs[1:]).stdout
        hit = {}; cur = None
        for line in lc.splitlines():
