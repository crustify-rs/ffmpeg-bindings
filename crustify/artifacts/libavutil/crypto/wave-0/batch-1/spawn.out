            if m: cur = m.group(1); continue
            m = re.match(r"Lines executed:([\d.]+)% of (\d+)", line)
            if m and cur and cur.endswith(f"libavutil/{g.stem}.c"):
                n = int(m.group(2)); tot += n; cov += round(float(m.group(1)) * n / 100)
                cur = None
    shutil.rmtree(tmp)
