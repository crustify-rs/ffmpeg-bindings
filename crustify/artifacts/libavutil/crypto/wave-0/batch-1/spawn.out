 submit('symbols',f'av_{algo}_init',{'ptr_args':{'0':{'ptr':ptr(mutable=True,note='Exclusive full-sized context borrowed for call only; inline also supported for Blowfish.')},'1':{'ptr':ptr(array=True,note='Borrowed read-only key for call; never retained. Blowfish requires at least one readable byte and positive int length. Camellia reads exactly key_bits/8 bytes for 128/192/256.')}},'lifetime':{'for':ctx,'is_dropper':False,'is_disposer':False,'is_cloner':None,'is_constructor':{'alloc':False,'init':True}}})
