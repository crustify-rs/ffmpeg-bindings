submit('types','AVBlowfish',{'_comment_agent':'p is u32[18], s is u32[4][256] (nested dimension omitted in structural oracle array record). No pointers/resources, address identity, field disposal, or C clone. av_blowfish_alloc uses av_mallocz; av_free releases it. av_blowfish_init also fills stack contexts (rtmpe9_sig) and retains neither context nor key. Public arrays support copying getters and replacement setters.'})
submit('types','AVCAMELLIA',{'_comment_agent':'Opaque in public header; concrete body has only Kw[4], Ke[6], K[24] u64 arrays and key_bits int. av_camellia_alloc allocates full av_mallocz storage, freed by av_free, no nested allocations/copy/dispose primitives. init reads exactly 16/24/32 key bytes, stores schedule not pointer. computeSP unconditionally rewrites static SP on every init; all safe init and future crypt operations must share a Rust global lock, even on distinct contexts. Raw C accesses must exclude races.'})
def ptr(*,array=False,owned=False,mutable=False,nullable=False,note=''):
 return dict(scalar=None if array else {'by_val':True},array={'by_val':True} if array else None,string=False,owned=owned,borrowed=None if owned else {'lifetime':'call'},nullable=nullable,mutable=mutable,note=note)
