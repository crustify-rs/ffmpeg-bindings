    test_blowfish(ctx, tmp, ciphertext2, plaintext2, 2, iv, 1, "CBC decryption");
    memcpy(iv, IV, 8);
    test_blowfish(ctx, tmp, tmp, ciphertext2, 2, iv, 0, "Inplace CBC encryption");
    memcpy(iv, IV, 8);
    test_blowfish(ctx, tmp, tmp, plaintext2,  2, iv, 1, "Inplace CBC decryption");
#!/bin/bash
# Re-runs the lib binary single-threaded under BSan, adding each test that
# reports at one of the five glibc strto* end-pointer sites to the skips,
# until it passes or a report elsewhere appears.
SKIP=/target/crustify/.worktrees/crustify/review-batches/20261005/libavutil/options/wave-2/batch-0/crustify/reviews/20261005/libavutil/options/wave-2/batch-0/misc/bsan-gate-strto-end-pointer-false-positives/skip-list.txt
cd /target/crustify/.worktrees/crustify/review-batches/20261005/libavutil/options/wave-2/batch-0/crustify/rust
export BSAN_OPTIONS=gc_hang_threshold_ms=600000 CRUSTIFY_FFMPEG_VARIANT=bsan CARGO_TARGET_DIR=/tmp/rw2b0/bsan-lib
: > /tmp/rw2b0/lib-extra.txt
for i in $(seq 1 60); do
  skips=$(cat $SKIP /tmp/rw2b0/lib-extra.txt | awk '$1=="ffmpeg" {printf " --skip %s", $2}')
  L=/tmp/rw2b0/logs/bsan-land-lib-iter$i.log
  s=$(date +%s); timeout 7000 cargo bsan test -p ffmpeg --lib -- --skip compile_fail --exact --test-threads=1 $skips > $L 2>&1; r=$?
  echo "exit=$r secs=$(( $(date +%s)-s ))" >> $L
  [ $r = 0 ] && { echo "pass at iter $i"; exit 0; }
  site=$(grep -A1 'Undefined Behavior' $L | grep -- '-->' | head -1 | awk '{print $2}'); site=${site##*/}
  t=$(grep -oE '^test [^ ]+ \.\.\. error: Undefined' $L | awk '{print $2}' | head -1)
  case "$site" in eval.c:120:13|eval.c:429:15|eval.c:581:37|parseutils.c:166:13|parseutils.c:391:13) ;; *) echo "other report at iter $i: $site $t"; exit 1;; esac
  [ -n "$t" ] || { echo "no test name at iter $i"; exit 2; }
  echo "ffmpeg $t $site" >> /tmp/rw2b0/lib-extra.txt
done
exit 3
