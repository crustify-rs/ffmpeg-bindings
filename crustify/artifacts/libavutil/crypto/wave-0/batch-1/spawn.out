 try: m=json.loads(line)
 except ValueError: continue
 if m.get('reason')=='compiler-artifact' and m.get('executable') and m['profile']['test']:
  exes['unit' if m['target']['kind']==['lib'] else m['target']['name']]=m['executable']
print(exes,flush=True)
env=dict(os.environ,LLVM_PROFILE_FILE=str(D/'%p-%m.profraw'),GCOV_PREFIX=str(D/'gcda'),GCOV_PREFIX_STRIP='0',CRUSTIFY_FFMPEG_VARIANT='coverage')
