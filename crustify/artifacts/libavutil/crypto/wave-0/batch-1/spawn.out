//! Safe layouts and lifecycle for `libavutil/blowfish.h`.
//!
//! The schedule owns no pointers: inline values and C-allocated boxes both
//! support shared and exclusive handles. Array getters return snapshots, not
//! references to memory C can access. Dropping a box uses [`Heap`](super::mem::Heap).
use super::{ffi, mem::HeapBox};
use core::ptr::{addr_of, addr_of_mut};
use ffibox::{CZeroable, define_ctype};
define_ctype!(
    /// Wraps: AVBlowfish
    ///
    /// A resource-free Blowfish key schedule. Field replacement accepts any
    /// words (all bit patterns are valid), but changes the resulting cipher.
    #[derive(Clone, Copy)]
    Blowfish, BlowfishRef, BlowfishMut, ffi::AVBlowfish
);
// SAFETY: both fields contain only u32 arrays. Zero is valid for every field
// accessor and C crypt operation (though not a meaningful keyed schedule).
// The object owns no resources and av_free does not inspect its contents.
unsafe impl CZeroable for Blowfish {}
/// A sole C-allocated schedule, freed by `av_free`; cloning copies its words.
pub type BlowfishBox = HeapBox<Blowfish>;
/// Failure to construct or initialize a schedule.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum InitError {
    /// C reads at least one byte, and its key length must fit an `int`.
    InvalidKeyLength,
    /// C could not allocate a context.
    AllocationFailed,
}
fn key_len(key: &[u8]) -> Result<i32, InitError> {
    if key.is_empty() {
        return Err(InitError::InvalidKeyLength);
    }
    i32::try_from(key.len()).map_err(|_| InitError::InvalidKeyLength)
}
impl Blowfish {
    /// Initialize a schedule in Rust-owned inline storage.
    ///
    /// Matches C for any nonempty key whose length fits `i32`; C does not
    /// enforce the customary Blowfish key-size limit. The key is not retained.
    pub fn new(key: &[u8]) -> Result<Self, InitError> {
        key_len(key)?;
        let mut context = Self::zeroed();
        context.as_mut().init(key)?;
        Ok(context)
    }
    /// Wraps: av_blowfish_alloc
    ///
    /// Allocate and initialize a sole owner; the key is not retained.
    pub fn new_boxed(key: &[u8]) -> Result<BlowfishBox, InitError> {
        key_len(key)?;
        // SAFETY: C returns a fresh av_mallocz block with two initialized u32
        // arrays, or NULL. Heap frees it with av_free and C retains no pointer.
        let mut context = unsafe { BlowfishBox::from_c(ffi::av_blowfish_alloc()) }
            .ok_or(InitError::AllocationFailed)?;
        context.as_mut().init(key)?;
        Ok(context)
    }
}
impl BlowfishRef<'_> {
    /// Field: AVBlowfish.p
    ///
    /// Copy the 18 round-key words.
    pub fn p(&self) -> [u32; 18] {
        // SAFETY: the shared handle keeps the initialized array alive and
        // excludes writes for this read; projection creates no C reference.
        unsafe { addr_of!((*self.as_ptr()).p).read() }
    }
    /// Field: AVBlowfish.s
    ///
    /// Copy all four 256-word substitution tables.
    pub fn s(&self) -> [[u32; 256]; 4] {
        // SAFETY: as p(), for the complete initialized s array.
        unsafe { addr_of!((*self.as_ptr()).s).read() }
    }
}
impl BlowfishMut<'_> {
    /// Wraps: av_blowfish_init
    ///
    /// Replace the whole schedule. An invalid key leaves the context unchanged.
    pub fn init(&mut self, key: &[u8]) -> Result<(), InitError> {
        let len = key_len(key)?;
        // SAFETY: the exclusive handle addresses a full writable context. C
        // reads key[0..len] cyclically, with len positive and representable,
        // fills both arrays, and retains neither pointer after the call.
        unsafe { ffi::av_blowfish_init(self.as_mut_ptr(), key.as_ptr(), len) };
        Ok(())
    }
    /// Field: AVBlowfish.p
    ///
    /// Replace the round-key words without changing the substitution tables.
    pub fn set_p(&mut self, words: [u32; 18]) {
        // SAFETY: exclusive access to the complete p array; every u32 is valid.
        unsafe { addr_of_mut!((*self.as_mut_ptr()).p).write(words) }
    }
    /// Field: AVBlowfish.s
    ///
    /// Replace the substitution tables without changing the round-key words.
    pub fn set_s(&mut self, tables: [[u32; 256]; 4]) {
        // SAFETY: exclusive access to the complete s array; every u32 is valid.
        unsafe { addr_of_mut!((*self.as_mut_ptr()).s).write(tables) }
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    // No FFI: also run under Miri to check layout, projection and reborrows.
    #[test]
    fn layout_and_field_projections() {
        assert_eq!(size_of::<Blowfish>(), size_of::<ffi::AVBlowfish>());
        assert_eq!(align_of::<Blowfish>(), align_of::<ffi::AVBlowfish>());
        let mut context = Blowfish::zeroed();
        let mut handle = context.as_mut();
        handle.as_mut().set_p([u32::MAX; 18]);
        handle.set_s([[0x1234abcd; 256]; 4]);
        assert_eq!(handle.as_ref().p(), [u32::MAX; 18]);
        assert_eq!(handle.as_ref().s(), [[0x1234abcd; 256]; 4]);
        let copy = context;
        context.as_mut().set_p([0; 18]);
        assert_eq!(copy.as_ref().p(), [u32::MAX; 18]);
    }
    #[test]
    fn invalid_key_preserves_schedule() {
        assert!(matches!(
            Blowfish::new(&[]),
            Err(InitError::InvalidKeyLength)
        ));
        assert!(matches!(
            Blowfish::new_boxed(&[]),
            Err(InitError::InvalidKeyLength)
        ));
        let mut context = Blowfish::zeroed();
        context.as_mut().set_p([42; 18]);
        assert_eq!(context.as_mut().init(&[]), Err(InitError::InvalidKeyLength));
        assert_eq!(context.as_ref().p(), [42; 18]);
    }
    #[test]
    fn raw_owner_round_trip() {
        let context = Blowfish::new_boxed(b"key").unwrap();
        let expected = context.as_ref().p();
        let ptr = context.into_c();
        // SAFETY: ptr came from this owner's into_c; no intervening access or
        // free occurred, and its unique ownership is transferred back once.
        let context = unsafe { BlowfishBox::from_c(ptr) }.unwrap();
        assert_eq!(context.as_ref().p(), expected);
    }
}
//! Safe opaque layout and lifecycle for `libavutil/camellia.h`.
//!
//! C owns the concrete layout and allocation. Contexts own no sub-allocations
//! and retain no key pointer. There is no public C clone operation.
//!
//! Initialization rewrites a shared C lookup table. All safe initialization
//! calls are serialized; future crypt wrappers must use the same internal
//! lock. Raw C calls must exclude concurrent initialization/crypt accesses.
use super::{ffi, mem::HeapBox};
use ffibox::define_ctype;
use std::sync::{Mutex, MutexGuard};
define_ctype!(
    /// Wraps: AVCAMELLIA
    ///
    /// Opaque C context, constructed only behind a pointer as [`CamelliaBox`].
    /// The bindgen layout is opaque: never allocate inline storage for C to use.
    Camellia, CamelliaRef, CamelliaMut, ffi::AVCAMELLIA
);
/// A sole context allocated by `av_camellia_alloc` and freed by `av_free`.
/// Not `Clone`: its layout is private and C publishes no copy routine.
pub type CamelliaBox = HeapBox<Camellia>;
/// Failure to construct or initialize a context.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum InitError {
    /// Camellia accepts exactly 16-, 24-, or 32-byte keys.
    InvalidKeyLength,
    /// C could not allocate a context.
    AllocationFailed,
}
// av_camellia_init calls computeSP, rewriting global SP even after its first
// use. Every safe init AND future crypt wrapper must hold this same lock,
// because crypt reads SP. Raw C callers must exclude concurrent SP access.
static C_ACCESS: Mutex<()> = Mutex::new(());
pub(crate) fn lock_c_access() -> MutexGuard<'static, ()> {
    C_ACCESS
        .lock()
        .unwrap_or_else(|poisoned| poisoned.into_inner())
}
fn key_bits(key: &[u8]) -> Result<i32, InitError> {
    match key.len() {
        16 => Ok(128),
        24 => Ok(192),
        32 => Ok(256),
        _ => Err(InitError::InvalidKeyLength),
    }
}
impl Camellia {
    /// Wraps: av_camellia_alloc
    ///
    /// Allocate and initialize a context. C copies the schedule, not the key
    /// pointer. No construction-phase storage is exposed to the caller.
    pub fn new(key: &[u8]) -> Result<CamelliaBox, InitError> {
        key_bits(key)?;
        // SAFETY: C returns a fresh av_mallocz allocation of the concrete
        // context's full size, or NULL. All its scalar fields are initialized,
        // it owns no other resources, and Heap releases it with av_free.
        let mut context = unsafe { CamelliaBox::from_c(ffi::av_camellia_alloc()) }
            .ok_or(InitError::AllocationFailed)?;
        context.as_mut().init(key)?;
        Ok(context)
    }
}
impl CamelliaMut<'_> {
    /// Wraps: av_camellia_init
    ///
    /// Replace the schedule. An invalid key leaves the context unchanged.
    pub fn init(&mut self, key: &[u8]) -> Result<(), InitError> {
        let bits = key_bits(key)?;
        let _guard = lock_c_access();
        // SAFETY: the exclusive handle addresses the full C allocation. The
        // validated bit count makes C read exactly key.len() bytes, retaining
        // no pointer. The lock excludes other safe accesses to global SP.
        let status = unsafe { ffi::av_camellia_init(self.as_mut_ptr(), key.as_ptr(), bits) };
        assert_eq!(status, 0, "C rejected a validated Camellia key length");
        Ok(())
    }
}
/// Wraps: av_camellia_size
///
/// The C context's size in bytes, borrowed from immutable C static storage.
pub fn context_size() -> &'static i32 {
    // SAFETY: C defines this global as `const int = sizeof(context)`; it has
    // static lifetime and no writer anywhere in the library.
    unsafe { &ffi::av_camellia_size }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn invalid_key_lengths() {
        for len in [0, 1, 15, 17, 23, 25, 31, 33] {
            assert!(matches!(
                Camellia::new(&vec![0; len]),
                Err(InitError::InvalidKeyLength)
            ));
        }
        assert_eq!(key_bits(&[0; 16]), Ok(128));
        assert_eq!(key_bits(&[0; 24]), Ok(192));
        assert_eq!(key_bits(&[0; 32]), Ok(256));
    }
    #[test]
    fn lock_recovers_after_rust_unwind() {
        let unwind = std::panic::catch_unwind(|| {
            let _guard = lock_c_access();
            panic!("exercise lock poisoning without touching C");
        });
        assert!(unwind.is_err());
        drop(lock_c_access());
    }
    #[test]
    fn raw_owner_round_trip() {
        let context = Camellia::new(&[0; 16]).unwrap();
        let ptr = context.into_c();
        // SAFETY: ptr came from this owner's into_c; no intervening access or
        // free occurred, and its unique ownership is transferred back once.
        let mut context = unsafe { CamelliaBox::from_c(ptr) }.unwrap();
        context.as_mut().init(&[1; 32]).unwrap();
    }
}
use core::ptr::{addr_of, addr_of_mut};
use ffmpeg::libavutil::{blowfish::Blowfish, ffi};
#[test]
fn lifecycle_and_field_sequences_match_c() {
    let mut safe = Blowfish::new_boxed(b"initial").unwrap();
    let mut reference = ffi::AVBlowfish::default();
    for len in [1, 8, 24, 56, 72, 128] {
        let key: Vec<u8> = (0..len).map(|i| (i * 37) as u8).collect();
        // SAFETY: full writable inline context and len readable key bytes;
        // the key is nonempty and its length fits int. Neither is retained.
        unsafe { ffi::av_blowfish_init(&mut reference, key.as_ptr(), len) };
        safe.as_mut().init(&key).unwrap();
        let inline = Blowfish::new(&key).unwrap();
        assert_eq!(safe.as_ref().p(), reference.p);
        assert_eq!(safe.as_ref().s(), reference.s);
        assert_eq!(inline.as_ref().p(), reference.p);
        assert_eq!(inline.as_ref().s(), reference.s);
        for decrypt in [0, 1] {
            let (mut a, mut b) = (0x12345678, 0x90abcdef);
            let (mut c, mut d) = (a, b);
            // SAFETY: each context is fully initialized and each word is a
            // separate writable local; crypt retains no pointers.
            unsafe {
                ffi::av_blowfish_crypt_ecb(&mut reference, &mut a, &mut b, decrypt);
                ffi::av_blowfish_crypt_ecb(safe.as_c_ptr(), &mut c, &mut d, decrypt);
            }
            assert_eq!((a, b), (c, d));
        }
        let p = core::array::from_fn(|i| (i as u32).wrapping_mul(0x12345678));
        let s = core::array::from_fn(|i| core::array::from_fn(|j| (i * 256 + j) as u32));
        safe.as_mut().set_p(p);
        safe.as_mut().set_s(s);
        // SAFETY: the inline reference context is exclusively owned; raw
        // projection writes the entire valid arrays without forming references.
        unsafe {
            addr_of_mut!(reference.p).write(p);
            addr_of_mut!(reference.s).write(s);
        }
        assert_eq!(safe.as_ref().p(), reference.p);
        assert_eq!(safe.as_ref().s(), reference.s);
        // SAFETY: the box's pointer addresses a live initialized AVBlowfish;
        // no mutable handle or foreign writer is live during these reads.
        unsafe {
            assert_eq!(addr_of!((*safe.as_c_ptr()).p).read(), p);
            assert_eq!(addr_of!((*safe.as_c_ptr()).s).read(), s);
        }
    }
}
use ffmpeg::libavutil::{
    camellia::{self, Camellia, CamelliaBox},
    ffi,
};
#[test]
fn lifecycle_sequences_match_c() {
    // SAFETY: C returns a fresh zero-filled full-sized context, or NULL.
    // CamelliaBox's Heap policy frees it once with av_free; no C pointer is kept.
    let reference = unsafe { CamelliaBox::from_c(ffi::av_camellia_alloc()) }.unwrap();
    let mut safe = Camellia::new(&[0; 16]).unwrap();
    for len in [16, 24, 32, 16, 32, 24] {
        let key: Vec<u8> = (0..len).map(|i| (i * 37) as u8).collect();
        // SAFETY: full writable C context, exact readable key size and valid
        // key bit count. This is the sole Camellia equivalence test, so raw SP
        // accesses do not run concurrently with any init or crypt call.
        let status = unsafe { ffi::av_camellia_init(reference.as_c_ptr(), key.as_ptr(), len * 8) };
        assert_eq!(status, 0);
        safe.as_mut().init(&key).unwrap();
        drop(key);
        for decrypt in [0, 1] {
            let source = [0x57; 32];
            let (mut a, mut b) = ([0; 32], [0; 32]);
            let (mut iv_a, mut iv_b) = ([0x93; 16], [0x93; 16]);
            for cbc in [false, true] {
                let pa = if cbc {
                    iv_a.as_mut_ptr()
                } else {
                    core::ptr::null_mut()
                };
                let pb = if cbc {
                    iv_b.as_mut_ptr()
                } else {
                    core::ptr::null_mut()
                };
                // SAFETY: initialized full-sized independent contexts; both
                // destinations and source hold two blocks; IVs are writable
                // 16-byte locals or NULL. These sequential calls retain nothing.
                unsafe {
                    ffi::av_camellia_crypt(
                        reference.as_c_ptr(),
                        a.as_mut_ptr(),
                        source.as_ptr(),
                        2,
                        pa,
                        decrypt,
                    );
                    ffi::av_camellia_crypt(
                        safe.as_c_ptr(),
                        b.as_mut_ptr(),
                        source.as_ptr(),
                        2,
                        pb,
                        decrypt,
                    );
                }
                assert_eq!(a, b);
                assert_eq!(iv_a, iv_b);
            }
        }
        // A rejected reinitialization must not disturb the usable schedule.
        assert!(safe.as_mut().init(&[0; 15]).is_err());
        let (mut a, mut b) = ([0; 16], [0; 16]);
        // SAFETY: initialized contexts, one readable/writable block, NULL IV;
        // exclusive sequential raw access, with no retained pointers.
        unsafe {
            ffi::av_camellia_crypt(
                reference.as_c_ptr(),
                a.as_mut_ptr(),
                [0x72; 16].as_ptr(),
                1,
                core::ptr::null_mut(),
                0,
            );
            ffi::av_camellia_crypt(
                safe.as_c_ptr(),
                b.as_mut_ptr(),
                [0x72; 16].as_ptr(),
                1,
                core::ptr::null_mut(),
                0,
            );
        }
        assert_eq!(a, b);
    }
}
#[test]
fn batch10_size_is_the_c_global() {
    for _ in 0..4 {
        // SAFETY: this global is an immutable const int with static lifetime.
        let raw = unsafe { &ffi::av_camellia_size };
        assert_eq!(camellia::context_size(), raw);
        assert!(std::ptr::eq(camellia::context_size(), raw));
    }
}
use ffmpeg::libavutil::blowfish::{Blowfish, BlowfishBox};
#[test]
fn foreign_initialization_across_reborrows() {
    for len in [1, 2, 8, 24, 56, 72, 128] {
        let key = vec![0x5a; len].into_boxed_slice();
        let mut inline = Blowfish::new(&key).unwrap();
        let mut boxed = Blowfish::new_boxed(&key).unwrap();
        let mut zeroed = BlowfishBox::new_zeroed().unwrap();
        assert_eq!(zeroed.as_ref().p(), [0; 18]);
        assert_eq!(zeroed.as_ref().s(), [[0; 256]; 4]);
        zeroed.as_mut().init(&key).unwrap();
        assert_eq!(zeroed.as_ref().p(), boxed.as_ref().p());
        drop(key); // Neither context retained the key.
        assert_eq!(inline.as_ref().p(), boxed.as_ref().p());
        assert_eq!(inline.as_ref().s(), boxed.as_ref().s());
        let original = boxed.as_ref().p();
        let mut copy = boxed.clone();
        {
            let mut outer = boxed.as_mut();
            let mut inner = outer.as_mut();
            inner.init(b"replacement key").unwrap();
            let shared = inner.as_ref();
            assert_ne!(shared.p(), original);
            let twin = shared;
            assert_eq!(shared.p(), twin.p());
            outer.set_p([u32::MAX; 18]);
        }
        inline.as_mut().set_s([[u32::MAX; 256]; 4]);
        assert_eq!(inline.as_ref().s(), [[u32::MAX; 256]; 4]);
        assert_eq!(boxed.as_ref().p(), [u32::MAX; 18]);
        assert_eq!(copy.as_ref().p(), original);
        drop(boxed); // Deep copy has its own allocation.
        copy.as_mut().set_s([[0; 256]; 4]);
        assert_eq!(copy.as_ref().s(), [[0; 256]; 4]);
    }
}
#[test]
fn allocation_failure_is_reported_without_leaking() {
    use ffmpeg::libavutil::{blowfish, camellia, mem};
    const CHILD: &str = "CRUSTIFY_CRYPTO_BATCH1_ALLOC_FAILURE_CHILD";
    if std::env::var_os(CHILD).is_some() {
        // This child runs only this exact test: changing C's process-wide
        // allocation limit cannot affect other tests or constructors.
        mem::set_max_alloc(1);
        assert!(matches!(
            Blowfish::new_boxed(b"key"),
            Err(blowfish::InitError::AllocationFailed)
        ));
        assert!(matches!(
            camellia::Camellia::new(&[0; 16]),
            Err(camellia::InitError::AllocationFailed)
        ));
        // Inline construction requires no C allocation.
        assert!(Blowfish::new(b"key").is_ok());
        return;
    }
    let status = std::process::Command::new(std::env::current_exe().unwrap())
        .args([
            "--exact",
            "blowfish::allocation_failure_is_reported_without_leaking",
            "--nocapture",
        ])
        .env(CHILD, "1")
        .status()
        .unwrap();
    assert!(status.success());
}
use ffmpeg::libavutil::camellia::{Camellia, context_size};
#[test]
fn reinitialize_across_reborrows() {
    let mut context = {
        let key = vec![0x42; 16].into_boxed_slice();
        Camellia::new(&key).unwrap()
    }; // C may not retain the key.
    for len in [24, 32, 16, 32, 24] {
        let key = vec![0xab; len].into_boxed_slice();
        let mut outer = context.as_mut();
        outer.as_mut().init(&key).unwrap();
        let _shared = outer.as_ref();
        outer.init(&key).unwrap();
    }
}
#[test]
fn concurrent_constructors_serialize_global_table() {
    let threads: Vec<_> = (0..8)
        .map(|byte| {
            std::thread::spawn(move || {
                for len in [16, 24, 32, 16, 32] {
                    let mut context = Camellia::new(&vec![byte; len]).unwrap();
                    context.as_mut().init(&[byte; 24]).unwrap();
                }
            })
        })
        .collect();
    for thread in threads {
        thread.join().unwrap();
    }
}
#[test]
fn batch10_immutable_size_across_threads() {
    let size: &'static i32 = context_size();
    assert!(*size > 0);
    let workers: Vec<_> = (0..4)
        .map(|_| {
            std::thread::spawn(move || {
                for _ in 0..100 {
                    assert!(std::ptr::eq(size, context_size()));
                }
            })
        })
        .collect();
    for worker in workers {
        worker.join().unwrap();
    }
}
