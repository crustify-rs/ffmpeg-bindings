"""Per-commit test counts and line coverage for the ffmpeg crate's four workloads.
cov_measure.py <worktree> <out.jsonl> <rev>...
For each rev (checked out detached in <worktree>): count #[test] per workload and run
each workload once, measuring
  - Rust line coverage over authored non-test sources (crustify/rust/ffmpeg, minus tests/
    and #[cfg(test)] modules), from -C instrument-coverage under the nightly toolchain;
  - C line coverage over libavutil's compiled .c TUs, from the `coverage` prebuild, with
    .gcda redirected through GCOV_PREFIX so the shared build is never written.
Workloads: unit (--lib), ub_safe, ub_unsafe, equiv; `all` runs the four together (union).
"""
import json, os, re, subprocess, sys, shutil, tempfile
from pathlib import Path
WT = Path(sys.argv[1]); OUT = Path(sys.argv[2]); REVS = sys.argv[3:]
RUST = WT / "crustify/rust"
TC = "/root/.rustup/toolchains/nightly-x86_64-unknown-linux-gnu/lib/rustlib/x86_64-unknown-linux-gnu/bin"
COVB = Path("/target/crustify/builds/coverage")
TGT = "/tmp/cov-measure-target"
WORKLOADS = ["unit", "ub_safe", "ub_unsafe", "equiv"]
def sh(cmd, **kw):
    return subprocess.run(cmd, check=True, text=True, errors="replace", capture_output=True, **kw)
def test_counts():
    n = {}
    def cnt(paths):
        t = 0
        for p in paths:
            t += len(re.findall(r"^\s*#\[test\]", p.read_text(), re.M))
        return t
    ff = RUST / "ffmpeg"
    n["unit"] = cnt([p for p in ff.rglob("*.rs") if "tests" not in p.relative_to(ff).parts[:1]])
    for w in ["ub_safe", "ub_unsafe", "equiv"]:
        d = ff / "tests" / w
        n[w] = cnt([p for p in d.rglob("*.rs") if "compile_fail" not in p.parts]) if d.is_dir() else 0
    return n
def test_mod_lines(path):
    """Line numbers inside #[cfg(test)] items."""
    lines = path.read_text().splitlines(); out = set(); i = 0
    while i < len(lines):
        if re.match(r"\s*#\[cfg\(test\)\]", lines[i]):
            j = i + 1
            while j < len(lines) and "{" not in lines[j] and not lines[j].rstrip().endswith(";"):
                j += 1
            if j < len(lines) and "{" in lines[j]:
                depth = 0; k = j
                while k < len(lines):
                    depth += lines[k].count("{") - lines[k].count("}")
                    if depth <= 0 and k >= j: break
                    k += 1
                out.update(range(i + 1, k + 2)); i = k + 1; continue
        i += 1
    return out
def has_map(exe):
    r = subprocess.run([f"{TC}/llvm-objdump", "-h", exe], capture_output=True, text=True, errors="replace")
    return "__llvm_covmap" in r.stdout or "__llvm_covfun" in r.stdout
def build():
    env = dict(os.environ, CRUSTIFY_FFMPEG_VARIANT="coverage", CARGO_TARGET_DIR=TGT,
               RUSTFLAGS="-C instrument-coverage")
    r = sh(["cargo", "+nightly", "test", "-p", "ffmpeg", "--lib", "--tests", "--no-run",
            "--message-format=json"], cwd=RUST, env=env)
    exes = {}
    for line in r.stdout.splitlines():
        m = json.loads(line)
        if m.get("reason") == "compiler-artifact" and m.get("executable") and m["profile"]["test"]:
            name = m["target"]["name"]; kind = m["target"]["kind"][0]
            exes["unit" if kind == "lib" else name] = m["executable"]
    return exes
def run(exes, workloads):
    exes = {w: e for w, e in exes.items() if has_map(e)}
    tmp = Path(tempfile.mkdtemp(prefix="covrun-"))
    for w in workloads:
        if w not in exes: continue
        env = dict(os.environ, LLVM_PROFILE_FILE=str(tmp / f"{w}-%p-%m.profraw"),
                   GCOV_PREFIX=str(tmp / "gcda"), GCOV_PREFIX_STRIP="0",
                   CRUSTIFY_FFMPEG_VARIANT="coverage")
        subprocess.run([exes[w], "--skip", "compile_fail", "-q"], cwd=RUST / "ffmpeg", env=env,
                       capture_output=True, text=True, errors="replace")
    # Rust
    raws = list(tmp.glob("*.profraw")); rust = None
    if raws:
        sh([f"{TC}/llvm-profdata", "merge", "-sparse", "-o", str(tmp / "m.profdata")] + [str(p) for p in raws])
        # Every test binary as an object, whatever ran: one fixed line set per rev, so
