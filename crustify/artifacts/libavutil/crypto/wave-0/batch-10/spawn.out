    use core::ffi::c_void;
    extern "C" {
        pub fn arena_alloc(n: usize) -> *mut c_void;
        pub fn arena_free(p: *mut c_void);
    }
}
unsafe fn arena_free_len(ptr: *mut u8, _byte_len: usize) {
    unsafe { sys::arena_free(ptr.cast()) }
}
#[derive(Clone, Copy, Debug, Default)]
//! Safe wrappers over `libavutil/base64.h`.
use super::ffi;
use core::ffi::CStr;
fn encoded_size(input_len: usize) -> Result<usize, i32> {
    // C rejects this bound before evaluating its signed-int size expression.
    if input_len >= (u32::MAX / 4) as usize {
        return Err(-(ffi::EINVAL as i32));
    }
    Ok(input_len.div_ceil(3) * 4 + 1)
}
/// Wraps: av_base64_encode
///
/// Encode into `output`, including a terminating NUL. Return a view tied to
/// its exclusive borrow. Insufficient space or an unrepresentable C length
/// returns `-EINVAL` without writing anything.
pub fn encode<'a>(input: &[u8], output: &'a mut [u8]) -> Result<&'a CStr, i32> {
    let needed = encoded_size(input.len())?;
    let capacity = i32::try_from(output.len()).map_err(|_| -(ffi::EINVAL as i32))?;
    if output.len() < needed {
        return Err(-(ffi::EINVAL as i32));
    }
    // SAFETY: lengths fit C's int arithmetic and output includes `needed`
    // bytes for the encoded data and NUL. The two borrows cannot overlap;
    // C retains neither pointer and returns the output pointer on success.
    let ptr = unsafe {
        ffi::av_base64_encode(
            output.as_mut_ptr().cast(),
            capacity,
            input.as_ptr(),
            input.len() as i32,
        )
    };
    if ptr.is_null() {
        return Err(-(ffi::EINVAL as i32));
    }
    Ok(CStr::from_bytes_with_nul(&output[..needed]).expect("C base64 encoder terminates ASCII"))
}
/// Wraps: av_base64_decode
///
/// Decode into `output`. Like the C implementation, a short destination
/// truncates the decoded bytes but still checks the rest of the input.
/// Invalid data returns C's negative error; earlier bytes may be written.
/// C stops at the first NUL or `=`, without requiring canonical padding.
pub fn decode(input: &CStr, output: &mut [u8]) -> Result<usize, i32> {
    let capacity = i32::try_from(output.len()).map_err(|_| -(ffi::EINVAL as i32))?;
    let mut empty = 0u8;
    let dst = if output.is_empty() {
        &raw mut empty
    } else {
        output.as_mut_ptr()
    };
    // SAFETY: the NUL-terminated input stops C before any read beyond it.
    // C writes at most capacity bytes, including its speculative 4-byte store
    // only when more than 3 bytes remain. A live byte represents empty output.
    // Both buffers are borrowed only for the call and cannot overlap.
    let ret = unsafe { ffi::av_base64_decode(dst, input.as_ptr(), capacity) };
    if ret < 0 { Err(ret) } else { Ok(ret as usize) }
}
/// Wraps: av_base64_decode
///
/// Check C's accepted base64 syntax without producing decoded data.
pub fn validate(input: &CStr) -> Result<(), i32> {
    // SAFETY: a null output selects C's validity-only path; the readable
    // NUL-terminated input bounds every read and C retains no pointer.
    let ret = unsafe { ffi::av_base64_decode(core::ptr::null_mut(), input.as_ptr(), 0) };
    if ret < 0 { Err(ret) } else { Ok(()) }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn rust_size_arithmetic_and_rejections() {
        assert_eq!(encoded_size(0), Ok(1));
        assert_eq!(encoded_size(1), Ok(5));
        assert_eq!(encoded_size(3), Ok(5));
        assert_eq!(encoded_size(4), Ok(9));
        let limit = (u32::MAX / 4) as usize;
        assert_eq!(encoded_size(limit - 1), Ok((limit - 1).div_ceil(3) * 4 + 1));
        assert!(encoded_size(limit).is_err());
        assert!(encoded_size(usize::MAX).is_err());
        let mut output = [0xAA; 4];
        assert!(encode(b"abc", &mut output).is_err());
        assert_eq!(output, [0xAA; 4]);
        assert!(encode(b"", &mut []).is_err());
    }
}
//! Standard polynomial identifiers from `libavutil/crc.h`.
use core::fmt;
use super::ffi;
/// Wraps: AVCRCId
/// Handwritten
///
/// A standard CRC polynomial identifier, layout-compatible with C's enum.
/// It owns no resources and needs no lifecycle or borrowed handles; ffibox
/// has no enum primitive. Unknown C values are preserved, not transmuted to
/// a restricted Rust enum. `AV_CRC_MAX` is an internal sentinel, not a public
/// polynomial, and intentionally has no associated constant.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct CrcId(ffi::AVCRCId);
impl CrcId {
    /// CRC-8, polynomial 0x07.
    pub const ATM_8: Self = Self(ffi::AVCRCId::AV_CRC_8_ATM);
    /// CRC-16, polynomial 0x8005.
    pub const ANSI_16: Self = Self(ffi::AVCRCId::AV_CRC_16_ANSI);
    /// CRC-16, polynomial 0x1021.
    pub const CCITT_16: Self = Self(ffi::AVCRCId::AV_CRC_16_CCITT);
    /// CRC-32, polynomial 0x04c11db7.
    pub const IEEE_32: Self = Self(ffi::AVCRCId::AV_CRC_32_IEEE);
    /// CRC-32 with reversed bit order, polynomial 0xedb88320.
    pub const IEEE_32_LE: Self = Self(ffi::AVCRCId::AV_CRC_32_IEEE_LE);
    /// CRC-16 with reversed bit order, polynomial 0xa001.
    pub const ANSI_16_LE: Self = Self(ffi::AVCRCId::AV_CRC_16_ANSI_LE);
    /// CRC-24, polynomial 0x864cfb.
    pub const IEEE_24: Self = Self(ffi::AVCRCId::AV_CRC_24_IEEE);
    /// CRC-8, polynomial 0x1d.
    pub const EBU_8: Self = Self(ffi::AVCRCId::AV_CRC_8_EBU);
    /// Preserves any C encoding, including unsupported identifiers.
    pub const fn from_raw(raw: ffi::AVCRCId) -> Self {
        Self(raw)
    }
    /// The identifier's exact C encoding.
    pub const fn into_raw(self) -> ffi::AVCRCId {
        self.0
    }
}
impl From<ffi::AVCRCId> for CrcId {
    fn from(raw: ffi::AVCRCId) -> Self {
        Self::from_raw(raw)
    }
}
impl From<CrcId> for ffi::AVCRCId {
    fn from(id: CrcId) -> Self {
        id.into_raw()
    }
}
impl fmt::Debug for CrcId {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        let name = match *self {
            Self::ATM_8 => "ATM_8",
            Self::ANSI_16 => "ANSI_16",
            Self::CCITT_16 => "CCITT_16",
            Self::IEEE_32 => "IEEE_32",
            Self::IEEE_32_LE => "IEEE_32_LE",
            Self::ANSI_16_LE => "ANSI_16_LE",
            Self::IEEE_24 => "IEEE_24",
            Self::EBU_8 => "EBU_8",
            _ => return f.debug_tuple("CrcId").field(&self.0.0).finish(),
        };
        write!(f, "CrcId::{name}")
    }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn layout_and_unknown_values() {
        assert_eq!(size_of::<CrcId>(), size_of::<ffi::AVCRCId>());
        assert_eq!(align_of::<CrcId>(), align_of::<ffi::AVCRCId>());
        for value in [0, 7, 8, 9, u32::MAX] {
            let id = CrcId::from(ffi::AVCRCId(value));
            let raw: ffi::AVCRCId = id.into();
            assert_eq!(raw.0, value);
        }
        assert_eq!(
            format!("{:?}", CrcId::from_raw(ffi::AVCRCId(99))),
            "CrcId(99)"
        );
    }
    #[test]
    fn constant_debug_names() {
        for (id, name) in [
            (CrcId::ATM_8, "ATM_8"),
            (CrcId::ANSI_16, "ANSI_16"),
            (CrcId::CCITT_16, "CCITT_16"),
            (CrcId::IEEE_32, "IEEE_32"),
            (CrcId::IEEE_32_LE, "IEEE_32_LE"),
            (CrcId::ANSI_16_LE, "ANSI_16_LE"),
            (CrcId::IEEE_24, "IEEE_24"),
            (CrcId::EBU_8, "EBU_8"),
        ] {
            assert_eq!(format!("{id:?}"), format!("CrcId::{name}"));
        }
    }
    #[test]
    fn invalid_parameters_are_errors() {
        for bits in [0, 7, 33, 255] {
            assert!(Table::new(false, bits, 1, TableSize::Compact).is_err());
        }
        assert!(Table::new(true, 8, 256, TableSize::Fast).is_err());
    }
    #[test]
    fn table_traits_and_debug() {
        let size = TableSize::Fast;
        assert_eq!(size, TableSize::Fast);
        assert_ne!(size, TableSize::Compact);
        assert_eq!(format!("{size:?}"), "Fast");
        let table = Table::new(true, 32, 0xedb88320, size).unwrap();
        let clone = table.clone();
        assert_eq!(table.entries(), clone.entries());
        assert!(format!("{clone:?}").starts_with("Table { entries:"));
    }
}
/// The two array sizes accepted by C's CRC table initializer.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum TableSize {
    Compact,
    Fast,
}
/// A private, initialized CRC table. Entries cannot be changed by callers:
/// C may put an architecture-specific dispatch tag and constants in them.
/// All storage is Rust-owned; C only borrows it during synchronous calls.
#[derive(Clone, Debug)]
pub struct Table {
    entries: Box<[u32]>,
}
impl Table {
    /// Wraps: av_crc_init
    ///
    /// Initialize a CRC table for a polynomial of 8 through 32 bits. For
    /// little-endian bit order, the polynomial is in reversed representation.
    /// Return C's negative error for invalid bits or polynomial.
    pub fn new(
        little_endian: bool,
        bits: u8,
        polynomial: u32,
        size: TableSize,
    ) -> Result<Self, i32> {
        let len = match size {
            TableSize::Compact => 257,
            TableSize::Fast => 1024,
        };
        // Zero initialization also covers unused entries on accelerated paths.
        let mut entries = vec![0u32; len].into_boxed_slice();
        // SAFETY: entries is exclusive, aligned u32 storage of exactly one of
        // the two accepted byte sizes. C checks bits/poly before shifts and
        // only writes this allocation. It neither frees nor retains it.
        let ret = unsafe {
            ffi::av_crc_init(
                entries.as_mut_ptr(),
                i32::from(little_endian),
                i32::from(bits),
                polynomial,
                (len * 4) as i32,
            )
        };
        if ret < 0 {
            Err(ret)
        } else {
            Ok(Self { entries })
        }
    }
    /// Read-only table words, including initialized but unused entries.
    /// Their representation is architecture-dependent.
    pub fn entries(&self) -> &[u32] {
        &self.entries
    }
    /// Wraps: av_crc
    ///
    /// Update a CRC from its previous value (or the polynomial's initial value).
    /// For non-little-endian tables C uses its documented byte-swapped form.
    pub fn update(&self, initial: u32, input: &[u8]) -> u32 {
        // Give even a short/empty input a live prefix and suffix: the generic
        // fast C path forms `end - 3` before checking the loop condition. This
        // keeps that pointer within an allocation, including at length zero.
        if input.len() < 3 {
            let mut padded = [0u8; 8];
            padded[3..3 + input.len()].copy_from_slice(input);
            // SAFETY: the private table came from successful av_crc_init.
            // Input lives at offset 3 in an 8-byte allocation, so C's pointer
            // arithmetic is in bounds, and it reads only input.len() bytes.
            unsafe {
                ffi::av_crc(
                    self.entries.as_ptr(),
                    initial,
                    padded.as_ptr().add(3),
                    input.len(),
                )
            }
        } else {
            // SAFETY: the table is initialized and unmodified; the input is
            // readable for its length, and `end - 3` remains in bounds.
            // C retains no pointers and writes neither shared input.
            unsafe { ffi::av_crc(self.entries.as_ptr(), initial, input.as_ptr(), input.len()) }
        }
    }
}
//! Safe wrappers over `libavutil/lzo.h`.
use super::ffi;
/// The C error bitmask and both remaining-length out parameters.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct DecodeStatus {
    pub error_flags: i32,
    pub input_remaining: usize,
    pub output_remaining: usize,
}
fn padded(bytes: &[u8], padding: usize) -> Result<Vec<u8>, i32> {
    i32::try_from(bytes.len()).map_err(|_| -(ffi::EINVAL as i32))?;
    let len = bytes
        .len()
        .checked_add(padding)
        .ok_or(-(ffi::EINVAL as i32))?;
    let mut buffer = vec![0; len];
    buffer[..bytes.len()].copy_from_slice(bytes);
    Ok(buffer)
}
/// Wraps: av_lzo1x_decode
///
/// Decode LZO1x with C's required input/output padding hidden in private
/// initialized scratch buffers. Both lengths must fit C's `int`.
/// Return the C status even on malformed input: partial writes and remaining
/// lengths are preserved. C may modify bytes beyond the reported written
/// prefix, but no byte beyond `output` is exposed. No pointers are retained.
pub fn decode(input: &[u8], output: &mut [u8]) -> Result<DecodeStatus, i32> {
    let source = padded(input, ffi::AV_LZO_INPUT_PADDING as usize)?;
    let mut destination = padded(output, ffi::AV_LZO_OUTPUT_PADDING as usize)?;
    let mut in_left = input.len() as i32;
    let mut out_left = output.len() as i32;
    // SAFETY: the independent initialized allocations include C's required
    // readable 8-byte and writable 12-byte padding, even for empty buffers.
    // Both logical lengths fit int. C borrows the buffers and exclusive
    // scalar slots only for this call and never stores or frees a pointer.
    let flags = unsafe {
        ffi::av_lzo1x_decode(
            destination.as_mut_ptr().cast(),
            &raw mut out_left,
            source.as_ptr().cast(),
            &raw mut in_left,
        )
    };
    output.copy_from_slice(&destination[..output.len()]);
    Ok(DecodeStatus {
        error_flags: flags,
        input_remaining: in_left as usize,
        output_remaining: out_left as usize,
    })
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn rust_padding_is_initialized_and_independent() {
        let input = [1, 2, 3];
        let mut copy = padded(&input, 8).unwrap();
        assert_eq!(&copy[..3], &input);
        assert_eq!(&copy[3..], &[0; 8]);
        copy[0] = 9;
        assert_eq!(input[0], 1);
        assert_eq!(padded(&[], 12).unwrap(), vec![0; 12]);
        assert!(padded(&input, usize::MAX).is_err());
    }
}
//! Safe wrappers over `libavutil/uuid.h`.
//! UUIDs are opaque 16-byte values, not allocated foreign objects.
use super::ffi;
use core::ffi::CStr;
/// Wraps: av_uuid_copy
///
/// Copy the complete UUID. This is equivalent to C's inline memcpy, with
/// Rust borrows excluding overlap; there is no foreign lifetime to preserve.
pub fn copy(destination: &mut [u8; 16], source: &[u8; 16]) {
    *destination = *source;
}
/// Wraps: av_uuid_equal
///
/// Compare all sixteen bytes (equivalent to C's inline memcmp).
pub fn equal(left: &[u8; 16], right: &[u8; 16]) -> bool {
    left == right
}
/// Wraps: av_uuid_nil
///
/// Set every byte to zero (equivalent to C's inline memset).
pub fn nil(uuid: &mut [u8; 16]) {
    *uuid = [0; 16];
}
/// Wraps: av_uuid_parse
///
/// Parse C's 36-byte, case-insensitive UUID representation. On failure,
/// return C's error rather than exposing a partially initialized value.
pub fn parse(input: &CStr) -> Result<[u8; 16], i32> {
    let mut uuid = [0; 16];
    // SAFETY: input is NUL-terminated, output is exclusive 16-byte storage.
    // C validates length before reading digits and retains neither pointer.
    let ret = unsafe { ffi::av_uuid_parse(input.as_ptr(), uuid.as_mut_ptr()) };
    if ret < 0 { Err(ret) } else { Ok(uuid) }
}
/// Wraps: av_uuid_parse_range
///
/// Parse a byte range without requiring a terminating NUL. As in C, the
/// four separator positions are skipped, not validated as hyphens.
pub fn parse_range(input: &[u8]) -> Result<[u8; 16], i32> {
    if input.len() != 36 {
        return Err(-(ffi::EINVAL as i32));
    }
    let mut uuid = [0; 16];
    // SAFETY: both endpoints belong to the same 36-byte allocation, the end
    // is one-past and never read; output holds all 16 bytes and cannot alias
    // input. C borrows both only for this call.
    let ret = unsafe {
        ffi::av_uuid_parse_range(
            input.as_ptr().cast(),
            input.as_ptr().add(36).cast(),
            uuid.as_mut_ptr(),
        )
    };
    if ret < 0 { Err(ret) } else { Ok(uuid) }
}
/// Wraps: av_uuid_unparse
///
/// Serialize lowercase text plus its NUL into an exact-size destination.
pub fn unparse<'a>(uuid: &[u8; 16], output: &'a mut [u8; 37]) -> &'a CStr {
    // SAFETY: C reads exactly 16 bytes, writes exactly 37 including NUL,
    // retains no pointers, and Rust borrows exclude overlap.
    unsafe { ffi::av_uuid_unparse(uuid.as_ptr(), output.as_mut_ptr().cast()) };
    CStr::from_bytes_with_nul(output).expect("C UUID formatter terminates ASCII")
}
/// Wraps: av_uuid_urn_parse
///
/// Parse a UUID prefixed by `urn:uuid:` (case-insensitive), as C does.
pub fn urn_parse(input: &CStr) -> Result<[u8; 16], i32> {
    let mut uuid = [0; 16];
    // SAFETY: input is NUL-terminated, output is exclusive 16-byte storage.
    // C checks the prefix and UUID length before reading digits; no retention.
    let ret = unsafe { ffi::av_uuid_urn_parse(input.as_ptr(), uuid.as_mut_ptr()) };
    if ret < 0 { Err(ret) } else { Ok(uuid) }
}
#[cfg(test)]
mod unit_tests {
    use super::*;
    #[test]
    fn rust_inline_equivalents_and_range_rejection() {
        let source = [255; 16];
        let mut destination = [0; 16];
        copy(&mut destination, &source);
        assert!(equal(&destination, &source));
        nil(&mut destination);
        assert!(equal(&destination, &[0; 16]));
        assert!(!equal(&destination, &source));
        for len in [0, 35, 37, 100] {
            assert!(parse_range(&vec![b'0'; len]).is_err());
        }
    }
}
