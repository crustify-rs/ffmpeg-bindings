#[test]
fn batch10_size_is_the_c_global() {{
    for _ in 0..4 {{
        // SAFETY: this global is an immutable const int with static lifetime.
        let raw = unsafe {{ &ffi::av_{m}_size }};
        assert_eq"'!({m}::context_size(), raw);
        assert!(std::ptr::eq({m}::context_size(), raw));
    }}
}}
