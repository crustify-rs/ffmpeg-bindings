#define CRUSTIFY_PIX_FMT_NE(n) { #n, AV_PIX_FMT_##n }
static const struct {
    const char *name;
    enum AVPixelFormat fmt;
} crustify_pix_fmt_ne[] = {
    CRUSTIFY_PIX_FMT_NE(RGB32), CRUSTIFY_PIX_FMT_NE(RGB32_1),
    CRUSTIFY_PIX_FMT_NE(BGR32), CRUSTIFY_PIX_FMT_NE(BGR32_1),
    CRUSTIFY_PIX_FMT_NE(0RGB32), CRUSTIFY_PIX_FMT_NE(0BGR32),
    CRUSTIFY_PIX_FMT_NE(GRAY9), CRUSTIFY_PIX_FMT_NE(GRAY10),
