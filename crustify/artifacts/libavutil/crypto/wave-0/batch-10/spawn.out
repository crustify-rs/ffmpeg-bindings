#"'!/bin/bash
set -euo pipefail
export CRUSTIFY_FFMPEG_VARIANT=asan-ubsan
export CARGO_TARGET_DIR=/tmp/crustify-crypto-b10/asan
export CC=clang-23
export CFLAGS='"'-fsanitize=address,undefined -fno-omit-frame-pointer'
export RUSTFLAGS='-Zsanitizer=address -C linker=clang-23 -C link-arg=-fsanitize=undefined'
export ASAN_OPTIONS=detect_leaks=1
export UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
export TRYBUILD=overwrite
cargo +nightly test --workspace --target x86_64-unknown-linux-gnu --manifest-path crustify/rust/Cargo.toml > /tmp/crustify-crypto-b10/asan-workspace.log 2>&1
SH
bash /tmp/crustify-crypto-b10/asan.sh" in /target/crustify/.worktrees/crustify/batches/20261005/libavutil/crypto/wave-0/batch-10
