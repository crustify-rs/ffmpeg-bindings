#"'!/bin/bash
set -euo pipefail
export CRUSTIFY_FFMPEG_VARIANT=bsan
export CARGO_TARGET_DIR=/tmp/crustify-crypto-b10/bsan
export CC=/root/.rustup/toolchains/bsan/bin/clang
export CFLAGS='"'-fpass-plugin=/root/.rustup/toolchains/bsan/lib/libbsan_plugin.so -fno-omit-frame-pointer'
export BSAN_SYMBOLIZER=/root/.rustup/toolchains/bsan/bin/llvm-symbolizer
export BSAN_OPTIONS=gc_hang_threshold_ms=600000
# Only exact newly-authored tests whose buffers cross a write/read FFI boundary.
for name in \\
  adler32::batch10_stateless_threads_and_reborrows \\
  base64::batch10_roundtrips_truncation_and_reused_buffers \\
  crc::batch10_tables_clone_share_and_stream_unaligned_data \\
  lzo::batch10_hidden_padding_errors_and_reused_destinations \\
  md5::batch10_digest_boundary_lengths \\
  uuid::batch10_copy_nil_equality_parse_and_reborrow
 do
  timeout 1800 cargo bsan test -p ffmpeg --manifest-path crustify/rust/Cargo.toml --test ub_safe \""'$name" -- --exact --test-threads=1 > "/tmp/crustify-crypto-b10/bsan-${name%%::*}.log" 2>&1
 done
