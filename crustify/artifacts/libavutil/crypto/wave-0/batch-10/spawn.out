/* libavutil/channel_layout.h's channel bits (AV_CH_<name>), standard layout
 * masks (AV_CH_LAYOUT_<name>) and standard layouts (AV_CHANNEL_LAYOUT_<name>),
 * which shift enum constants or expand to compound literals bindgen cannot
 * evaluate: the C references for Channel::mask, channel_layout::masks and
 * ChannelLayout's standard constants in equivalence tests. The deprecated
 * FF_API_CHANNEL_LAYOUT_BACK aliases are left out. */
#define CRUSTIFY_AV_CH(n) { #n, AV_CH_##n }
static const struct {
    const char *name;
    uint64_t mask;
} crustify_av_ch[] = {
    CRUSTIFY_AV_CH(FRONT_LEFT), CRUSTIFY_AV_CH(FRONT_RIGHT),
    CRUSTIFY_AV_CH(FRONT_CENTER), CRUSTIFY_AV_CH(LOW_FREQUENCY),
    CRUSTIFY_AV_CH(BACK_LEFT), CRUSTIFY_AV_CH(BACK_RIGHT),
    CRUSTIFY_AV_CH(FRONT_LEFT_OF_CENTER),
    CRUSTIFY_AV_CH(FRONT_RIGHT_OF_CENTER), CRUSTIFY_AV_CH(BACK_CENTER),
    CRUSTIFY_AV_CH(SIDE_LEFT), CRUSTIFY_AV_CH(SIDE_RIGHT),
    CRUSTIFY_AV_CH(TOP_CENTER), CRUSTIFY_AV_CH(TOP_FRONT_LEFT),
    CRUSTIFY_AV_CH(TOP_FRONT_CENTER), CRUSTIFY_AV_CH(TOP_FRONT_RIGHT),
    CRUSTIFY_AV_CH(TOP_BACK_LEFT), CRUSTIFY_AV_CH(TOP_BACK_CENTER),
    CRUSTIFY_AV_CH(TOP_BACK_RIGHT), CRUSTIFY_AV_CH(STEREO_LEFT),
    CRUSTIFY_AV_CH(STEREO_RIGHT), CRUSTIFY_AV_CH(WIDE_LEFT),
    CRUSTIFY_AV_CH(WIDE_RIGHT), CRUSTIFY_AV_CH(SURROUND_DIRECT_LEFT),
    CRUSTIFY_AV_CH(SURROUND_DIRECT_RIGHT), CRUSTIFY_AV_CH(LOW_FREQUENCY_2),
    CRUSTIFY_AV_CH(TOP_SIDE_LEFT), CRUSTIFY_AV_CH(TOP_SIDE_RIGHT),
    CRUSTIFY_AV_CH(BOTTOM_FRONT_CENTER), CRUSTIFY_AV_CH(BOTTOM_FRONT_LEFT),
    CRUSTIFY_AV_CH(BOTTOM_FRONT_RIGHT), CRUSTIFY_AV_CH(SIDE_SURROUND_LEFT),
    CRUSTIFY_AV_CH(SIDE_SURROUND_RIGHT), CRUSTIFY_AV_CH(TOP_SURROUND_LEFT),
    CRUSTIFY_AV_CH(TOP_SURROUND_RIGHT), CRUSTIFY_AV_CH(BINAURAL_LEFT),
    CRUSTIFY_AV_CH(BINAURAL_RIGHT),
};
uint64_t crustify_AV_CH(size_t i, const char **name)
{
    if (i >= FF_ARRAY_ELEMS(crustify_av_ch)) {
        *name = NULL;
        return 0;
    }
    *name = crustify_av_ch[i].name;
    return crustify_av_ch[i].mask;
}
