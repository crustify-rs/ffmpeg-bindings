(r/'ub_safe'/'lzo.rs').write_text('''use ffmpeg::libavutil::lzo::decode;
'''+lzo_common+'''
#[test]
fn batch10_hidden_padding_errors_and_reused_destinations() {
    for input in samples() {
        for capacity in [0, 1, 2, 3, 4, 8, 16, 64, 300, 512] {
            let mut output = vec"'![0xAA; capacity];
            for _ in 0..3 {
                let status = decode(&input, &mut output).unwrap();
                assert!(status.input_remaining <= input.len());
                assert!(status.output_remaining <= output.len());
                output.fill(0xAA);
            }
        }
    }
    let mut output = [0; 9];
    assert_eq!(decode(&[20,b'"'a',b'b',b'c',168,0,17,0,0], &mut output).unwrap().error_flags, 0);
    assert_eq"'!(&output, b"abcabcabc");
    assert_eq!(decode(&[], &mut []).unwrap().error_flags, 3);
}
#[test]
fn batch10_malformed_bounded_corpus() {
    let mut seed = 0x12345678u32;
    for len in 1..65 {
        for _ in 0..16 {
            let input: Vec<_> = (0..len).map(|_| { seed = seed.wrapping_mul(1664525).wrapping_add(1013904223); (seed >> 24) as u8 }).collect();
            let mut output = [0xAA; 96];
            let status = decode(&input, &mut output).unwrap();
            assert!(status.input_remaining <= len);
            assert!(status.output_remaining <= output.len());
        }
    }
}
'"''')
(r/'equiv'/'lzo.rs').write_text('''use ffmpeg::libavutil::{lzo, ffi};
'''+lzo_common+'''
#[test]
fn batch10_errors_remaining_lengths_and_output_match_c() {
    for input in samples() {
        for capacity in [0, 1, 2, 3, 4, 8, 16, 64, 300, 512] {
            let mut safe = vec"'![0xAA; capacity];
            let mut raw = vec![0; capacity + ffi::AV_LZO_OUTPUT_PADDING as usize];
            raw[..capacity].fill(0xAA);
            let mut reference = input.clone();
            reference.resize(input.len() + ffi::AV_LZO_INPUT_PADDING as usize, 0);
            for _ in 0..3 {
                let (mut out_left, mut in_left) = (capacity as i32, input.len() as i32);
                // SAFETY: independent initialized inputs have C'"'s required
                // 8/12 byte padding and int-bounded lengths; scalar slots
                // are exclusive. No pointer is retained or freed by C.
                let flags = unsafe { ffi::av_lzo1x_decode(raw.as_mut_ptr().cast(), &raw mut out_left,
                                                         reference.as_ptr().cast(), &raw mut in_left) };
                let status = lzo::decode(&input, &mut safe).unwrap();
                assert_eq"'!(status.error_flags, flags);
                assert_eq!(status.input_remaining, in_left as usize);
                assert_eq!(status.output_remaining, out_left as usize);
                assert_eq!(safe, raw[..capacity]);
            }
        }
    }
}
'"''')
(r/'ub_safe'/'uuid.rs').write_text('''use ffmpeg::libavutil::uuid;
#[test]
fn batch10_copy_nil_equality_parse_and_reborrow() {
    let mut output = [0; 37];
    for i in 0..=255 {
        let original = [i; 16];
        let mut copy = [0; 16];
        uuid::copy(&mut copy, &original);
        assert"'!(uuid::equal(&copy, &original));
        let text = uuid::unparse(&copy, &mut output);
        assert_eq!(uuid::parse(text).unwrap(), original);
        assert_eq!(uuid::parse_range(text.to_bytes()).unwrap(), original);
        let urn = std::ffi::CString::new([b"URN:UUID:".as_slice(), text.to_bytes()].concat()).unwrap();
        assert_eq!(uuid::urn_parse(&urn).unwrap(), original);
        uuid::nil(&mut copy);
        assert_eq!(copy, [0; 16]);
        output.fill(0);
    }
}
#[test]
fn batch10_parse_invalid_lengths_bytes_and_prefixes() {
    for len in 0..100 {
        if len != 36 {
            let input = std::ffi::CString::new(vec![b'"'0'; len]).unwrap();
            assert"'!(uuid::parse(&input).is_err());
            assert!(uuid::parse_range(input.to_bytes()).is_err());
        }
    }
    for b in 1..=255 {
        let mut text = *b"6021b21e-894e-43ff-8317-1ca891c1c49b";
        text[0] = b;
        let input = std::ffi::CString::new(text).unwrap();
        assert_eq!(uuid::parse(&input), uuid::parse_range(input.to_bytes()));
    }
    for input in [c"", c"urn", c"xurn:uuid:6021b21e-894e-43ff-8317-1ca891c1c49b", c"urn:uuid:"] {
        assert!(uuid::urn_parse(input).is_err());
    }
}
'"''')
(r/'equiv'/'uuid.rs').write_text('''use ffmpeg::libavutil::{uuid, ffi};
#[test]
fn batch10_mutation_and_format_sequences_match_c() {
    let mut safe = [0; 16];
    let mut raw = [0; 16];
    for byte in 0..=255 {
        let source = [byte; 16];
        let independent = source;
        uuid::copy(&mut safe, &source);
        // SAFETY: distinct exact-size 16-byte source and exclusive destination.
        unsafe { ffi::av_uuid_copy(raw.as_mut_ptr(), independent.as_ptr()) };
        assert_eq"'!(safe, raw);
        // SAFETY: both arrays are readable for all sixteen compared bytes.
        let eq = unsafe { ffi::av_uuid_equal(raw.as_ptr(), independent.as_ptr()) };
        assert_eq!(uuid::equal(&safe, &source), eq != 0);
        let mut left = [0xAA; 37];
        let mut right = [0xAA; 37];
        uuid::unparse(&safe, &mut left);
        // SAFETY: readable 16-byte input and independent writable 37-byte output.
        unsafe { ffi::av_uuid_unparse(raw.as_ptr(), right.as_mut_ptr().cast()) };
        assert_eq!(left, right);
        uuid::nil(&mut safe);
        // SAFETY: raw is exclusive writable 16-byte storage.
        unsafe { ffi::av_uuid_nil(raw.as_mut_ptr()) };
        assert_eq!(safe, raw);
        // SAFETY: both arrays are readable for all sixteen compared bytes.
        let eq = unsafe { ffi::av_uuid_equal(raw.as_ptr(), independent.as_ptr()) };
        assert_eq!(uuid::equal(&safe, &source), eq != 0);
    }
}
#[test]
fn batch10_parsers_match_c_including_skipped_separators() {
    let mut inputs: Vec<_> = ["", "6021b21e-894e-43ff-8317-1ca891c1c49b", "6021B21E-894E-43FF-8317-1CA891C1C49B", "6021b21e_894e_43ff_8317_1ca891c1c49b", "6021g21e-894e-43ff-8317-1ca891c1c49b", "6021b21e-894e-43ff-8317-1ca891c1c49z"]
        .into_iter().map(|s| std::ffi::CString::new(s).unwrap()).collect();
    inputs.extend((1..=255).map(|b| { let mut s = *b"6021b21e-894e-43ff-8317-1ca891c1c49b"; s[0] = b; std::ffi::CString::new(s).unwrap() }));
    for input in inputs {
        let mut raw = [0xAA; 16];
        let independent = input.clone();
        // SAFETY: CStr input and exclusive 16-byte output, no retention.
        let ret = unsafe { ffi::av_uuid_parse(independent.as_ptr(), raw.as_mut_ptr()) };
        assert_eq!(uuid::parse(&input), if ret < 0 { Err(ret) } else { Ok(raw) });
        let mut range = vec![0; input.to_bytes().len() + 1];
        range[..input.to_bytes().len()].copy_from_slice(input.to_bytes());
        // SAFETY: both endpoints belong to the same live allocation, end is
        // one-past the logical range and C never reads it; exclusive output.
        let ret = unsafe { ffi::av_uuid_parse_range(range.as_ptr().cast(), range.as_ptr().add(input.to_bytes().len()).cast(), raw.as_mut_ptr()) };
        assert_eq!(uuid::parse_range(input.to_bytes()), if ret < 0 { Err(ret) } else { Ok(raw) });
        for prefix in ["urn:uuid:", "URN:UUID:", "UrN:uUiD:", "xurn:uuid:", "urn:uid:"] {
            let urn = std::ffi::CString::new([prefix.as_bytes(), input.to_bytes()].concat()).unwrap();
            let independent = urn.clone();
            // SAFETY: CStr input and exclusive 16-byte output, no retention.
            let ret = unsafe { ffi::av_uuid_urn_parse(independent.as_ptr(), raw.as_mut_ptr()) };
            assert_eq!(uuid::urn_parse(&urn), if ret < 0 { Err(ret) } else { Ok(raw) });
        }
    }
}
