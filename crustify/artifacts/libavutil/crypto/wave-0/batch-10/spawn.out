#!/bin/bash
# usage: bsan_gate.sh <tree> <tag>
T=$1; TAG=$2
cd $T/crustify/rust || exit 2
export BSAN_OPTIONS=gc_hang_threshold_ms=600000 CRUSTIFY_FFMPEG_VARIANT=bsan CARGO_TARGET_DIR=/tmp/rw2b0/bsan-$TAG
cargo bsan test -p ffmpeg --lib --tests --no-run > /tmp/rw2b0/logs/bsan-$TAG-build.log 2>&1 || { echo build failed; exit 3; }
pids=()
for b in "--lib" "--test equiv" "--test ub_safe" "--test ub_unsafe"; do
  n=$(echo $b | awk '{print $NF}' | tr -d -)
  ( s=$(date +%s); timeout 7000 cargo bsan test -p ffmpeg $b -- --skip compile_fail > /tmp/rw2b0/logs/bsan-$TAG-$n.log 2>&1; echo "exit=$? secs=$(( $(date +%s)-s ))" >> /tmp/rw2b0/logs/bsan-$TAG-$n.log ) &
  pids+=($!)
done
wait "${pids[@]}"
echo done
