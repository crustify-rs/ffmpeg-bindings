# Agent-owned bindgen allowlist for libavutil.
# One `<function|type|var|item> <regex>` per line; add only the FFI items a batch needs.
# libavutil/mem.h: the av_malloc family's void lifecycle (raw-lifetime void).
function av_free
function av_malloc
function av_mallocz
function av_malloc_array
function av_calloc
function av_memdup
# libavutil/mem.h: the av_malloc family's string lifecycle (raw-lifetime string).
function av_strdup
function av_strndup
# libavutil/mem.h: the allocation limit, which drives the string tier's
# failure paths in equivalence tests.
function av_max_alloc
# libavutil/log.h, libavutil/opt.h: C readers of AVClassCategory and
# AVClassStateFlags values, which drive the log.h type tier's equivalence tests.
function av_default_get_category
function av_opt_set_int
# libavutil/mem.h: av_memcpy_backptr's 4-byte-period fill writes through
# `union unaligned_64` (AV_WN64), the C reference for intreadwrite's
# `Unaligned64` equivalence tests.
function av_memcpy_backptr
# libavutil/intfloat.h: the C reference for av_intfloat64's and
# av_intfloat32's punning (equivalence tests; static inline, compiled by
# bindgen's wrap_static_fns).
function av_int2double
function av_double2int
function av_int2float
function av_float2int
# libavutil/avutil.h and avstring.h: C consumers of `AVMediaType` and
# `AVEscapeMode`, which observe the encodings in equivalence tests.
function av_get_media_type_string
function av_escape
# libavutil/mathematics.h: the AVRounding consumer whose INT64_MIN return
