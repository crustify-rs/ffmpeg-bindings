from pathlib import Path
import os,json,subprocess,shutil
out=Path('/tmp/crustify-crypto-b10/coverage');out.mkdir(exist_ok=True)
manifest=Path('crustify/rust/Cargo.toml').absolute()
env=dict(os.environ,CRUSTIFY_FFMPEG_VARIANT='coverage',CARGO_TARGET_DIR=str(out/'target'),RUSTFLAGS='-C instrument-coverage')
with (out/'build.log').open('w') as log:
 r=subprocess.run(['cargo','+nightly','test','-p','ffmpeg','--manifest-path',str(manifest),'--lib','--tests','--no-run','--message-format=json'],env=env,text=True,stdout=subprocess.PIPE,stderr=log)
assert r.returncode==0
exes={}
for line in r.stdout.splitlines():
 x=json.loads(line)
 if x.get('reason')=='compiler-artifact' and x.get('executable'):exes[x['target']['name']]=x['executable']
env.update(LLVM_PROFILE_FILE=str(out/'%p-%m.profraw'),GCOV_PREFIX=str(out/'gcda'),GCOV_PREFIX_STRIP='0')
with (out/'run.log').open('w') as log:
 for name in ['equiv','ub_safe']:
  assert subprocess.run([exes[name],'batch10_'],env=env,stdout=log,stderr=log).returncode==0
 for name in ['libavutil::base64::unit_tests::rust_size_arithmetic_and_rejections','libavutil::lzo::unit_tests::rust_padding_is_initialized_and_independent','libavutil::uuid::unit_tests::rust_inline_equivalents_and_range_rejection','libavutil::crc::unit_tests::invalid_parameters_are_errors']:
  assert subprocess.run([exes['ffmpeg'],name,'--exact'],env=env,stdout=log,stderr=log).returncode==0
TC='/root/.rustup/toolchains/nightly-x86_64-unknown-linux-gnu/lib/rustlib/x86_64-unknown-linux-gnu/bin/'
subprocess.run([TC+'llvm-profdata','merge','-sparse','-o',str(out/'coverage.profdata')]+[str(f) for f in out.glob('*.profraw')],check=True)
args=[TC+'llvm-cov','export','-instr-profile='+str(out/'coverage.profdata')]
for e in exes.values():args+=['-object',e]
with (out/'rust.json').open('w') as f:subprocess.run(args,check=True,stdout=f)
work=out/'gcov';work.mkdir(exist_ok=True)
for unit in ['adler32','base64','crc','lzo','md5','uuid','hash']:
 src=Path('/target/crustify/builds/coverage/libavutil')
 shutil.copy(src/(unit+'.gcno'),work/(unit+'.gcno'))
 data=out/'gcda'/str(src).lstrip('/')/(unit+'.gcda')
 if data.exists():shutil.copy(data,work/data.name)
 with (work/(unit+'.log')).open('w') as log:subprocess.run(['gcov','-b','-c',str(work/(unit+'.gcno'))],cwd=work,stdout=log,stderr=log)
print('coverage generated',out)
