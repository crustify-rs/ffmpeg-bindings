==== crustify/rust/ffmpeg/libavutil/cast5.rs
//! Safe lifecycle for the opaque context in `libavutil/cast5.h`.
//!
//! C allocates and frees the context; its private round keys are not public
//! fields. A successful constructor always returns a key-initialized owner.
use core::{fmt, ptr::NonNull};
use ffibox::{CBox, CDrop, define_ctype};
use super::ffi;
define_ctype!(
    /// Wraps: AVCAST5
    ///
    /// Opaque CAST-128 context. Only C knows its size: never allocate this
    /// layout by value or through a generic Rust-size allocator. Use
    /// [`Cast5::new`] to obtain a [`Cast5Box`], whose borrowed handles cannot
    /// outlive it. The context owns no sub-allocations or retained pointers.
    /// No C cloning or reference-counting lifecycle exists.
    ///
    /// A shared handle cannot outlive its owner:
    /// ```compile_fail
    /// use ffmpeg::libavutil::cast5::Cast5;
    /// let handle = {
    ///     let owner = Cast5::new(&[0; 5]).unwrap();
    ///     owner.as_ref()
    /// };
    /// let _copy = handle;
    /// ```
    /// Nor can an exclusive reborrow overlap a shared one:
    /// ```compile_fail
    /// use ffmpeg::libavutil::cast5::Cast5;
    /// let mut owner = Cast5::new(&[0; 5]).unwrap();
    /// let mut exclusive = owner.as_mut();
    /// let shared = exclusive.as_ref();
            InitError::C(-22).to_string(),
            "CAST5 initialization failed: -22"
        );
    }
    #[test]
    fn raw_owner_round_trip_and_borrowed_handles() {
        let owner = Cast5::new(&[0; 5]).unwrap();
        let ptr = owner.into_c();
        // SAFETY: into_c transferred the sole live initialized allocation;
        // no handles remain, and the same Cast5Free policy adopts it once.
        let mut owner = unsafe { Cast5Box::from_c(ptr) }.unwrap();
        let shared = owner.as_ref();
        assert_eq!(shared.as_ptr(), ptr);
        let mut exclusive = owner.as_mut();
        assert_eq!(exclusive.as_mut_ptr(), ptr);
        assert_eq!(exclusive.as_ref().as_ptr(), ptr);
        exclusive.as_mut().init(&[0xff; 16]).unwrap();
    }
}
==== crustify/rust/ffmpeg/libavutil/crc.rs
//! Standard polynomial identifiers from `libavutil/crc.h`.
use core::fmt;
use super::ffi;
/// Wraps: AVCRCId
/// Handwritten
///
/// A standard CRC polynomial identifier, layout-compatible with C's enum.
/// It owns no resources and needs no lifecycle or borrowed handles; ffibox
/// has no enum primitive. Unknown C values are preserved, not transmuted to
/// a restricted Rust enum. `AV_CRC_MAX` is an internal sentinel, not a public
/// polynomial, and intentionally has no associated constant.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct CrcId(ffi::AVCRCId);
impl CrcId {
    /// CRC-8, polynomial 0x07.
    pub const ATM_8: Self = Self(ffi::AVCRCId::AV_CRC_8_ATM);
    /// CRC-16, polynomial 0x8005.
    pub const ANSI_16: Self = Self(ffi::AVCRCId::AV_CRC_16_ANSI);
    /// CRC-16, polynomial 0x1021.
    pub const CCITT_16: Self = Self(ffi::AVCRCId::AV_CRC_16_CCITT);
    /// CRC-32, polynomial 0x04c11db7.
    pub const IEEE_32: Self = Self(ffi::AVCRCId::AV_CRC_32_IEEE);
    /// CRC-32 with reversed bit order, polynomial 0xedb88320.
    pub const IEEE_32_LE: Self = Self(ffi::AVCRCId::AV_CRC_32_IEEE_LE);
    /// CRC-16 with reversed bit order, polynomial 0xa001.
    pub const ANSI_16_LE: Self = Self(ffi::AVCRCId::AV_CRC_16_ANSI_LE);
    /// CRC-24, polynomial 0x864cfb.
    pub const IEEE_24: Self = Self(ffi::AVCRCId::AV_CRC_24_IEEE);
    /// CRC-8, polynomial 0x1d.
    pub const EBU_8: Self = Self(ffi::AVCRCId::AV_CRC_8_EBU);
            "CrcId(99)"
        );
    }
    #[test]
    fn constant_debug_names() {
        for (id, name) in [
            (CrcId::ATM_8, "ATM_8"),
            (CrcId::ANSI_16, "ANSI_16"),
            (CrcId::CCITT_16, "CCITT_16"),
            (CrcId::IEEE_32, "IEEE_32"),
            (CrcId::IEEE_32_LE, "IEEE_32_LE"),
            (CrcId::ANSI_16_LE, "ANSI_16_LE"),
            (CrcId::IEEE_24, "IEEE_24"),
            (CrcId::EBU_8, "EBU_8"),
        ] {
            assert_eq!(format!("{id:?}"), format!("CrcId::{name}"));
        }
    }
}
==== crustify/rust/ffmpeg/libavutil/sha.rs
//! Safe lifecycle and borrowed handles for `libavutil/sha.h`.
//!
//! The body is private to `sha.c`: this opaque layout is used only behind
//! C-allocated pointers, never as inline storage. There are no public fields,
//! sub-allocations, retained input pointers, reference counts, or C clone routines.
//! Owners release their single allocation through [`Heap`]. No `Send` or `Sync`
//! implementation is asserted. Hash update/final operations are left to the
//! symbol route; initialization is bound here to the object's lifecycle.
use core::fmt;
use core::ptr::NonNull;
use ffibox::{CNew, define_ctype};
use super::ffi;
use super::mem::{Heap, HeapBox};
/// A digest variant supported by this context's initializer.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
#[repr(i32)]
pub enum Algorithm {
    /// SHA-1 (160-bit digest).
    Sha1 = 160,
    /// SHA-224 (224-bit digest).
    Sha224 = 224,
    /// SHA-256 (256-bit digest).
    Sha256 = 256,
}
impl Algorithm {
    /// The digest length in bytes.
    #[must_use]
    pub const fn digest_len(self) -> usize {
        self as usize / 8
    }
        assert_eq!(
            core::mem::size_of::<ShaRef<'_>>(),
            core::mem::size_of::<*mut ()>()
        );
        assert_eq!(
            core::mem::size_of::<ShaMut<'_>>(),
            core::mem::size_of::<*mut ()>()
        );
    }
    #[test]
    fn owner_raw_round_trip() {
        let owner = Sha::new(Algorithm::Sha256).unwrap();
        let ptr = owner.into_c();
        // SAFETY: into_c transferred the sole initialized C allocation; no
        // handles exist, and Heap remains its matching release policy.
        let mut owner = unsafe { ShaBox::from_c(ptr) }.unwrap();
        owner.as_mut().init(Algorithm::Sha256);
    }
}
==== crustify/rust/ffmpeg/libavutil/sha512.rs
//! Safe lifecycle and borrowed handles for `libavutil/sha512.h`.
//!
//! The body is private to `sha512.c`: this opaque layout is used only behind
//! C-allocated pointers, never as inline storage. There are no public fields,
//! sub-allocations, retained input pointers, reference counts, or C clone routines.
//! Owners release their single allocation through [`Heap`]. No `Send` or `Sync`
//! implementation is asserted. Hash update/final operations are left to the
//! symbol route; initialization is bound here to the object's lifecycle.
use core::fmt;
use core::ptr::NonNull;
use ffibox::{CNew, define_ctype};
use super::ffi;
use super::mem::{Heap, HeapBox};
/// A digest variant supported by this context's initializer.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
#[repr(i32)]
pub enum Algorithm {
    /// SHA-512/224 (224-bit digest).
    Sha512224 = 224,
    /// SHA-512/256 (256-bit digest).
    Sha512256 = 256,
    /// SHA-384 (384-bit digest).
    Sha384 = 384,
    /// SHA-512 (512-bit digest).
    Sha512 = 512,
}
impl Algorithm {
    /// The digest length in bytes.
    #[must_use]
    pub const fn digest_len(self) -> usize {
        assert_eq!(
            core::mem::size_of::<Sha512Ref<'_>>(),
            core::mem::size_of::<*mut ()>()
        );
        assert_eq!(
            core::mem::size_of::<Sha512Mut<'_>>(),
            core::mem::size_of::<*mut ()>()
        );
    }
    #[test]
    fn owner_raw_round_trip() {
        let owner = Sha512::new(Algorithm::Sha512).unwrap();
        let ptr = owner.into_c();
        // SAFETY: into_c transferred the sole initialized C allocation; no
        // handles exist, and Heap remains its matching release policy.
        let mut owner = unsafe { Sha512Box::from_c(ptr) }.unwrap();
        owner.as_mut().init(Algorithm::Sha512);
