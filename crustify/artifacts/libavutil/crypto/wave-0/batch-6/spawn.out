ning /// lengths are preserved. C may modify bytes beyond the reported written /// prefix, but no byte beyond `output` is exposed. No pointers are retained. pub fn decode(input: &[u8], output: &mut [u8]) -> Result<DecodeStatus, i32> {     let source = padded(input, ffi::AV_LZO_INPUT_PADDING as usize)?;     let mut destination = padded(output, ffi::AV_LZO_OUTPUT_PADDING as usize)?;     let mut in_left = input.len() as i32;     let mut out_left = output.len() as i32;     // SAFETY: the independent initialized allocations include C's required     // readable 8-byte and writable 12-byte padding, even for empty buffers.     // Both logical lengths fit int. C borrows the buffers and exclusive     // scalar slots only for this call and never stores or frees a pointer.     let flags = unsafe {         ffi::av_lzo1x_decode(destination.as_mut_ptr().cast(), &raw mut out_left,                             source.as_ptr().cast(), &raw mut in_left)     };     output.copy_from_slice(&destination[..output.len()]);     Ok(DecodeStatus { error_flags: flags, input_remaining: in_left as usize,                      output_remaining: out_left as usize }) }  #[cfg(test)] mod unit_tests {     use super::*;      #[test]     fn rust_padding_is_initialized_and_independent() {         let input = [1, 2, 3];         let mut copy = padded(&input, 8).unwrap();         assert_eq!(&copy[..3], &input);         assert_eq!(&copy[3..], &[0; 8]);         copy[0] = 9;         assert_eq!(input[0], 1);         assert_eq!(padded(&[], 12).unwrap(), vec![0; 12]);         assert!(padded(&input, usize::MAX).is_err());     } } ''') (root/'uuid.rs').write_text('''//! Safe wrappers over `libavutil/uuid.h`. //! UUIDs are opaque 16-byte values, not allocated foreign objects.  use core::ffi::CStr; use super::ffi;  /// Wraps: av_uuid_copy /// /// Copy the complete UUID. This is equivalent to C's inline memcpy, with /// Rust borrows excluding overlap; there is no foreign lifetime to preserve. pub fn copy(destination: &mut [u8; 16], source: &[u8; 16]) {     *destination = *source; }  /// Wraps: av_uuid_equal /// /// Compare all sixteen bytes (equivalent to C's inline memcmp). pub fn equal(left: &[u8; 16], right: &[u8; 16]) -> bool {     left == right }  /// Wraps: av_uuid_nil /// /// Set every byte to zero (equivalent to C's inline memset). pub fn nil(uuid: &mut [u8; 16]) {     *uuid = [0; 16]; }  /// Wraps: av_uuid_parse /// /// Parse C's 36-byte, case-insensitive UUID representation. On failure, /// return C's error rather than exposing a partially initialized value. pub fn parse(input: &CStr) -> Result<[u8; 16], i32> {     let mut uuid = [0; 16];     // SAFETY: input is NUL-terminated, output is exclusive 16-byte storage.     // C validates length before reading digits and retains neither pointer.     let ret = unsafe { ffi::av_uuid_parse(input.as_ptr(), uuid.as_mut_ptr()) };     if ret < 0 { Err(ret) } else { Ok(uuid) } }  /// Wraps: av_uuid_parse_range /// /// Parse a byte range without requiring a terminating NUL. As in C, the /// four separator positions are skipped, not validated as hyphens. pub fn parse_range(input: &[u8]) -> Result<[u8; 16], i32> {     if input.len() != 36 { return Err(-(ffi::EINVAL as i32)); }     let mut uuid = [0; 16];     // SAFETY: both endpoints belong to the same 36-byte allocation, the end     // is one-past and never read; output holds all 16 bytes and cannot alias     // input. C borrows both only for this call.     let ret = unsafe {         ffi::av_uuid_parse_range(input.as_ptr().cast(), input.as_ptr().add(36).cast(), uuid.as_mut_ptr())     };     if ret < 0 { Err(ret) } else { Ok(uuid) } }  /// Wraps: av_uuid_unparse /// /// Serialize lowercase text plus its NUL into an exact-size destination. pub fn unparse<'a>(uuid: &[u8; 16], output: &'a mut [u8; 37]) -> &'a CStr {     // SAFETY: C reads exactly 16 bytes, writes exactly 37 including NUL,     // retains no pointers, and Rust borrows exclude overlap.     unsafe { ffi::av_uuid_unparse(uuid.as