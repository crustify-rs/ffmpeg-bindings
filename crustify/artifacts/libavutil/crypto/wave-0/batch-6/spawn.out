{
  "_comment": "FFmpeg @ 1019f8f036 prebuilds for crustify campaign 20261005. FFmpeg has no configure switch for deprecated APIs (FF_API_* is hard-defined in version_major.h), so deprecated items are excluded at schedule time, not here. --disable-autodetect keeps the build hermetic; platform/vendor hwcontext backends are out of scope. tsan is kept separate from asan-ubsan (conflicting runtimes); bsan builds the C with the bsan toolchain's matched clang and pass plugin; its runtime is linked once, into executables only, and exported (-rdynamic) to the libraries, which leave __bsan_* undefined. The bsan runtime (bsan 0.1.0, 3f210d63ae) reports a false use-after-free when realloc(NULL, n) runs in a non-inlined function and its result is later freed; av_realloc hits it in the instrumented C executables (ffmpeg, FATE tools), which abort. Rust test binaries under cargo bsan (CRUSTIFY_FFMPEG_VARIANT=bsan) run clean against it, av_realloc(NULL, n) paths included.",
  "version": 3,
  "build_commands": {
    "configure": "./configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite",
    "build": "make -j48",
    "test": "LD_LIBRARY_PATH=$(printf '%s:' \"$PWD\"/lib*) make -k -j48 fate"
  },
  "variants": {
    "plain": {
      "dir": "crustify/builds/plain",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite",
      "build": "make -j48"
    },
    "coverage": {
      "dir": "crustify/builds/coverage",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --toolchain=gcov",
      "build": "make -j48"
    },
    "asan-ubsan": {
      "dir": "crustify/builds/asan-ubsan",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --toolchain=clang-asan-ubsan",
      "build": "make -j48"
    },
    "tsan": {
      "dir": "crustify/builds/tsan",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --toolchain=clang-tsan",
      "build": "make -j48"
    },
    "bsan": {
      "dir": "crustify/builds/bsan",
      "configure": "../../../configure --enable-shared --disable-static --disable-autodetect --enable-pthreads --enable-zlib --disable-doc --disable-stripping --samples=/target/crustify/fate-suite --cc=/root/.rustup/toolchains/bsan/bin/clang --cxx=/root/.rustup/toolchains/bsan/bin/clang++ --extra-cflags='-fpass-plugin=/root/.rustup/toolchains/bsan/lib/libbsan_plugin.so -fno-omit-frame-pointer' --extra-ldexeflags='-rdynamic -Wl,--whole-archive /root/.rustup/toolchains/bsan/lib/libclang_rt.bsan-x86_64.a -Wl,--no-whole-archive' --extra-libs='/root/.rustup/toolchains/bsan/lib/libbsan_rt.a -lgcc_s -lm -lpthread -ldl'",
      "build": "make -j48"
    }
  }
}
[workspace]
resolver = "3"
members = [
    "libavutil-sys",
    "libswresample-sys",
    "libswscale-sys",
    "libavcodec-sys",
    "libavformat-sys",
    "libavfilter-sys",
    "libavdevice-sys",
    "ffmpeg",
]
[workspace.package]
version = "0.1.0"
edition = "2024"
license = "LGPL-2.1-or-later"
publish = false
[workspace.dependencies]
bindgen = { version = "0.73", features = ["experimental"] }
cc = "1.5"
ffibox = { path = "/opt/venv/share/ffibox" }
serde_json = "1"
trybuild = "1"
libavutil-sys = { path = "libavutil-sys" }
libswresample-sys = { path = "libswresample-sys" }
libswscale-sys = { path = "libswscale-sys" }
libavcodec-sys = { path = "libavcodec-sys" }
libavformat-sys = { path = "libavformat-sys" }
libavfilter-sys = { path = "libavfilter-sys" }
libavdevice-sys = { path = "libavdevice-sys" }
[workspace.lints.clippy]
undocumented_unsafe_blocks = "deny"
module_inception = "allow"
[package]
name = "ffmpeg"
description = "Safe Rust wrappers over FFmpeg's public C API"
build = "build.rs"
version.workspace = true
edition.workspace = true
license.workspace = true
publish.workspace = true
[lib]
path = "lib.rs"
[features]
default = ["libavutil", "libswresample", "libswscale", "libavcodec", "libavformat", "libavfilter", "libavdevice"]
libavutil = ["dep:libavutil-sys"]
libswresample = ["dep:libswresample-sys", "libavutil"]
libswscale = ["dep:libswscale-sys", "libavutil"]
libavcodec = ["dep:libavcodec-sys", "libswresample", "libavutil"]
libavformat = ["dep:libavformat-sys", "libavcodec", "libavutil"]
libavfilter = ["dep:libavfilter-sys", "libswscale", "libavformat", "libavcodec", "libswresample", "libavutil"]
libavdevice = ["dep:libavdevice-sys", "libavfilter", "libavformat", "libavcodec", "libavutil"]
[dependencies]
ffibox.workspace = true
libavutil-sys = { workspace = true, optional = true }
libswresample-sys = { workspace = true, optional = true }
libswscale-sys = { workspace = true, optional = true }
libavcodec-sys = { workspace = true, optional = true }
libavformat-sys = { workspace = true, optional = true }
libavfilter-sys = { workspace = true, optional = true }
libavdevice-sys = { workspace = true, optional = true }
[dev-dependencies]
trybuild.workspace = true
[lints]
workspace = true
include!("../sys-build.rs");
fn main() {
    build("libavutil", &[]);
}
/* crustify_<NAME> shims for libavutil function-like macros bindgen cannot bind. */
#ifndef CRUSTIFY_LIBAVUTIL_SHIM_H
#define CRUSTIFY_LIBAVUTIL_SHIM_H
#include <stddef.h>
#include <stdint.h>
#include "libavutil/bprint.h"
#include "libavutil/channel_layout.h"
#include "libavutil/log.h"
#include "libavutil/pixfmt.h"
/* av_vlog with its va_list built from the trailing arguments: stable Rust
 * can call a C variadic function but cannot construct a va_list. */
void crustify_av_vlog(void *avcl, int level, const char *fmt, ...);
/* av_vbprintf with its va_list built from the trailing arguments, as for
 * crustify_av_vlog. */
void crustify_av_vbprintf(AVBPrint *buf, const char *fmt, ...);
/* libavutil/intreadwrite.h's aligned accessors, which expand to member
 * accesses on a pointer cast to av_alias64: the C references for the
 * Alias64 wrapper's equivalence tests. Every pointer must be 8-byte aligned,
 * as the macros require. */
uint64_t crustify_AV_RN64A(const void *p);
void crustify_AV_WN64A(void *p, uint64_t v);
void crustify_AV_COPY64(void *d, const void *s);
void crustify_AV_SWAP64(void *a, void *b);
void crustify_AV_ZERO64(void *d);
/* AV_IS_INPUT_DEVICE / AV_IS_OUTPUT_DEVICE: whether a class category is one
 * of the three input (output) device categories; 1 or 0. */
int crustify_AV_IS_INPUT_DEVICE(AVClassCategory category);
int crustify_AV_IS_OUTPUT_DEVICE(AVClassCategory category);
/* The same accessors over av_alias16 and av_alias32 (AV_SWAP has no 16- or
 * 32-bit form): the C references for the Alias16 / Alias32 equivalence tests.
 * Every pointer must be 2- or 4-byte aligned, as the macros require. */
uint16_t crustify_AV_RN16A(const void *p);
void crustify_AV_WN16A(void *p, uint16_t v);
void crustify_AV_COPY16(void *d, const void *s);
void crustify_AV_ZERO16(void *d);
uint32_t crustify_AV_RN32A(const void *p);
void crustify_AV_WN32A(void *p, uint32_t v);
void crustify_AV_COPY32(void *d, const void *s);
void crustify_AV_ZERO32(void *d);
/* The native-endian AV_PIX_FMT_<name> aliases of libavutil/pixfmt.h, which
 * paste tokens through AV_PIX_FMT_NE and so escape bindgen: the C references
 * for PixelFormat's native-endian constants in equivalence tests. Returns the
 * i-th alias and stores its <name> in *name, or returns AV_PIX_FMT_NONE and
 * stores NULL once i is past the last one. */
enum AVPixelFormat crustify_AV_PIX_FMT_NE(size_t i, const char **name);
/* libavutil/channel_layout.h's channel bits AV_CH_<name> (1ULL << AV_CHAN_<name>),
 * standard layout masks AV_CH_LAYOUT_<name> and standard layouts
 * AV_CHANNEL_LAYOUT_<name> (AV_CHANNEL_LAYOUT_MASK compound literals), which
 * bindgen cannot evaluate: the C references for the channel_layout module's
 * constants in equivalence tests. Each returns the i-th entry of its table
 * and stores its <name> in *name, or stores NULL (and returns 0) once i is
 * past the last one; the deprecated FF_API_CHANNEL_LAYOUT_BACK aliases are
 * left out. crustify_AV_CHANNEL_LAYOUT_MASK(nb, m) is the macro itself. */
uint64_t crustify_AV_CH(size_t i, const char **name);
uint64_t crustify_AV_CH_LAYOUT(size_t i, const char **name);
int crustify_AV_CHANNEL_LAYOUT(size_t i, const char **name, AVChannelLayout *out);
void crustify_AV_CHANNEL_LAYOUT_MASK(int nb, uint64_t m, AVChannelLayout *out);
#endif /* CRUSTIFY_LIBAVUTIL_SHIM_H */
/* bindgen input for libavutil: its in-scope public headers, then the macro shims. */
#include "libavutil/adler32.h"
#include "libavutil/aes.h"
#include "libavutil/aes_ctr.h"
#include "libavutil/ambient_viewing_environment.h"
#include "libavutil/attributes.h"
#include "libavutil/audio_fifo.h"
#include "libavutil/avassert.h"
#include "libavutil/avstring.h"
#include "libavutil/avutil.h"
#include "libavutil/base64.h"
#include "libavutil/blowfish.h"
#include "libavutil/bprint.h"
#include "libavutil/bswap.h"
#include "libavutil/buffer.h"
