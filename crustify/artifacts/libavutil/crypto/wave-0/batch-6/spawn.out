  n=v['target']['name']; exes[n]=v['executable']
P=D/'cov-data'; P.mkdir(exist_ok=True)
env=dict(os.environ,GCOV_PREFIX=str(P/'gcda'),GCOV_PREFIX_STRIP='0',LLVM_PROFILE_FILE=str(P/'%p-%m.profraw'),CRUSTIFY_FFMPEG_VARIANT='coverage')
with (D/'coverage-tests.log').open('w') as log:
 for n in ['ffmpeg','equiv','ub_safe']:
