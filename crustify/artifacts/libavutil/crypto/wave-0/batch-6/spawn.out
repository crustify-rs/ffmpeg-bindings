   subprocess.run([exes[n],pattern],env=env,cwd=R/'ffmpeg',stdout=log,stderr=subprocess.STDOUT,check=True)
raws=list(P.glob('*.profraw')); prof=P/'merged.profdata'
subprocess.run([str(TC/'llvm-profdata'),'merge','-sparse','-o',str(prof),*map(str,raws)],check=True)
objs=[exes[n] for n in ['ffmpeg','equiv','ub_safe']]
args=[str(TC/'llvm-cov'),'export','-format=lcov',f'-instr-profile={prof}',objs[0]]
for obj in objs[1:]: args += ['-object',obj]
out=subprocess.check_output(args,text=True); (D/'rust.lcov').write_text(out)
summary={'rust':{},'c':{}}
cur=None; counts={}
for ln in out.splitlines():
 if ln.startswith('SF:'): cur=ln[3:]
 elif ln.startswith('DA:') and cur:
  k,c=map(int,ln[3:].split(',')[:2]); counts.setdefault(cur,{})[k]=max(counts.get(cur,{}).get(k,0),c)
for tu in ['rc4','ripemd']:
 path=R/'ffmpeg/libavutil'/f'{tu}.rs'; lines=path.read_text().splitlines(); last=next(i for i,ln in enumerate(lines,1) if ln=='#[cfg(test)]')
 d=next((v for f,v in counts.items() if f==str(path)),{})
 d={k:c for k,c in d.items() if k<last}
 summary['rust'][tu]={'covered':sum(c>0 for c in d.values()),'total':len(d),'uncovered':{str(k):lines[k-1] for k,c in d.items() if c==0}}
C=P/'gcov'; C.mkdir(exist_ok=True)
for tu in ['rc4','ripemd']:
 gcno=B/'libavutil'/f'{tu}.gcno'; link=C/gcno.name
 if not link.exists(): link.symlink_to(gcno)
 src=P/'gcda'/str(B/'libavutil'/f'{tu}.gcda').lstrip('/')
 assert src.exists(),src
 shutil.copy(src,C/src.name)
 with (D/f'{tu}-gcov.log').open('w') as log:
