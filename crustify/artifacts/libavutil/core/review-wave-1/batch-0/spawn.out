//! UB tests of `libavutil/bprint.h`'s safe [`PaddedStruct`] constants: they
//! evaluate at compile time, without overflow, and describe the C structure's
//! storage.
use core::mem::{align_of, size_of};
use ffmpeg::libavutil::bprint::PaddedStruct;
use ffmpeg::libavutil::ffi;
type BPrint = ffi::AVBPrint;
// Evaluated in const context: an underflow here fails the build.
const SIZE: usize = <BPrint as PaddedStruct>::SIZE;
const FIELDS_SIZE: usize = <BPrint as PaddedStruct>::FIELDS_SIZE;
const PADDING_LEN: usize = <BPrint as PaddedStruct>::PADDING_LEN;
#[test]
fn constants_describe_the_storage() {
    assert_eq!(FIELDS_SIZE + PADDING_LEN, SIZE);
    assert_eq!(size_of::<BPrint>(), SIZE);
    assert_eq!(SIZE % align_of::<BPrint>(), 0);
    assert_eq!(FIELDS_SIZE % align_of::<BPrint>(), 0);
}
/// UB tests of [`BPrintFields`], `struct ff_pad_helper_AVBPrint`: a value
/// Rust owns, its copies, and its `'static` string, read and written from one
/// thread and from several.
mod fields {
    use core::ffi::CStr;
    use std::sync::Barrier;
    use std::thread;
    use ffmpeg::libavutil::bprint::{BPrintFields, BPrintFieldsMut, PaddedStruct};
    use ffmpeg::libavutil::ffi;
    static GREETING: &CStr = c"Hello, AVBPrint";
    /// Every field set through one exclusive handle, which `fill` reborrows.
    fn fill(mut m: BPrintFieldsMut<'_>, s: Option<&'static CStr>, n: u32) {
        m.set_str(s);
        m.set_len(n);
        m.set_size(n.wrapping_add(1));
        m.set_size_max(n.wrapping_add(2));
        m.set_internal_buffer([n as u8]);
    }
    #[test]
    fn fields_size_is_the_values_size() {
        assert_eq!(
            <ffi::AVBPrint as PaddedStruct>::FIELDS_SIZE,
            size_of::<BPrintFields>()
        );
    }
    #[test]
    fn every_field_reads_back_at_its_extremes() {
        let mut f = BPrintFields::default();
        for (s, n) in [
            (None, 0),
            (Some(c""), 1),
            (Some(GREETING), u32::MAX),
            (Some(c"\x7f\xff"), u32::MAX - 1),
        ] {
            fill(f.as_mut(), s, n);
            let r = f.as_ref();
            assert_eq!(r.str(), s);
            assert_eq!(r.len(), n);
            assert_eq!(r.size(), n.wrapping_add(1));
            assert_eq!(r.size_max(), n.wrapping_add(2));
            assert_eq!(r.internal_buffer(), [n as u8]);
        }
    }
    #[test]
    fn the_exclusive_handle_reborrows_and_reads() {
        let mut f = BPrintFields::new();
        let mut m = f.as_mut();
        fill(m.as_mut(), Some(GREETING), 7);
        // The handle is still usable after the reborrow ended.
        m.set_len(8);
        assert_eq!(m.as_ref().len(), 8);
        assert_eq!(m.as_ref().str(), Some(GREETING));
        // The exclusive handle's last use ends its borrow.
        assert_eq!(f.as_ref().size(), 8);
    }
    #[test]
    fn a_string_read_outlives_the_handle() {
        let mut f = BPrintFields::new();
        f.as_mut().set_str(Some(GREETING));
        let s = {
            let r = f.as_ref();
            r.str()
        };
        assert_eq!(s.map(CStr::to_bytes), Some(&b"Hello, AVBPrint"[..]));
        // Once the string read is done, the field may be overwritten.
        f.as_mut().set_str(None);
        assert_eq!(f.as_ref().str(), None);
    }
    #[test]
    fn copies_are_independent_and_share_the_string() {
        let mut a = BPrintFields::new();
        fill(a.as_mut(), Some(GREETING), 3);
        let mut b = a;
        #[allow(clippy::clone_on_copy)] // the `Clone` impl itself
        let c = a.clone();
        b.as_mut().set_len(4);
        b.as_mut().set_str(Some(c"other"));
        assert_eq!((a.as_ref().len(), b.as_ref().len(), c.as_ref().len()), (3, 4, 3));
        assert_eq!(a.as_ref().str(), Some(GREETING));
        assert_eq!(c.as_ref().str(), Some(GREETING));
        assert_eq!(b.as_ref().str(), Some(c"other"));
        assert_eq!(c.as_ref().str().unwrap().as_ptr(), GREETING.as_ptr());
    }
    #[test]
    fn values_move_through_heap_storage() {
        let mut v: Vec<BPrintFields> = (0..64)
            .map(|i| {
                let mut f = BPrintFields::new();
                fill(f.as_mut(), Some(GREETING), i);
                f
            })
            .collect();
        // Growing reallocates and moves every value.
        v.reserve(1024);
        v.insert(0, BPrintFields::default());
        let boxed = Box::new(v[10]);
        assert_eq!(BPrintFields::as_ref(&boxed).len(), 9);
        for (i, f) in v.iter().enumerate().skip(1) {
            assert_eq!(f.as_ref().len(), i as u32 - 1);
            assert_eq!(f.as_ref().str(), Some(GREETING));
        }
        assert_eq!(v[0].as_ref().str(), None);
    }
    #[test]
    fn shared_values_and_handles_are_read_from_many_threads() {
        let mut f = BPrintFields::new();
        fill(f.as_mut(), Some(GREETING), 42);
        let f = f;
        let r = f.as_ref();
        thread::scope(|s| {
            for _ in 0..4 {
                // `&BPrintFields: Send` and `BPrintFieldsRef: Send`.
                s.spawn(|| {
                    for _ in 0..1000 {
                        assert_eq!(f.as_ref().str(), Some(GREETING));
                        assert_eq!(r.len(), 42);
                    }
                });
            }
        });
    }
    #[test]
    fn values_and_exclusive_handles_move_between_threads() {
        let mut f = BPrintFields::new();
        fill(f.as_mut(), Some(GREETING), 1);
        // `BPrintFields: Send`: a moved copy, written on another thread.
        let moved = thread::spawn(move || {
            f.as_mut().set_len(2);
            f
        })
        .join()
        .unwrap();
        assert_eq!(moved.as_ref().len(), 2);
        // `BPrintFieldsMut: Send`: each thread writes its own value while the
        // others read theirs.
        let mut values = [BPrintFields::new(); 4];
        let barrier = Barrier::new(values.len());
        thread::scope(|s| {
            for (i, f) in values.iter_mut().enumerate() {
                let m = f.as_mut();
                let barrier = &barrier;
                s.spawn(move || {
                    barrier.wait();
                    fill(m, Some(GREETING), i as u32);
                });
            }
        });
        for (i, f) in values.iter().enumerate() {
            assert_eq!(f.as_ref().len(), i as u32);
        }
        // `&BPrintFieldsMut: Send` (`BPrintFieldsMut: Sync`): shared reads
        // through it.
        let mut g = BPrintFields::new();
        fill(g.as_mut(), Some(GREETING), 9);
        let m = g.as_mut();
        thread::scope(|s| {
            for _ in 0..2 {
                s.spawn(|| assert_eq!(m.as_ref().size(), 10));
            }
        });
    }
}
/// UB tests of the print buffer owners, `BPrintBox` and `BPrintOnBuffer`,
/// through the safe API: every `size_init`/`size_max` shape, caller buffers
/// of every length class, each finalizer, truncation, and owners and handles
/// moved and shared across threads.
mod owners {
    use std::thread;
    use ffmpeg::libavutil::bprint::{BPrint, BPrintBox, BPrintOnBuffer, BPrintRef};
    fn under_bsan() -> bool {
        std::env::var("CRUSTIFY_FFMPEG_VARIANT").as_deref() == Ok("bsan")
    }
    /// `size_max` values at every boundary `av_bprint_init` distinguishes.
    const SIZE_MAX: [u32; 9] = [
        BPrint::SIZE_COUNT_ONLY,
        BPrint::SIZE_AUTOMATIC,
        2,
        BPrint::INLINE_CAPACITY - 1,
        BPrint::INLINE_CAPACITY,
        BPrint::INLINE_CAPACITY + 1,
        5000,
        u32::MAX - 1,
        BPrint::SIZE_UNLIMITED,
    ];
    /// `size_init` values around the inline storage, and one no allocator
    /// can satisfy (4 GiB, beyond `av_max_alloc`'s default `INT_MAX`).
    const SIZE_INIT: [u32; 7] = [0, 1, 2, 1004, 1005, 4096, u32::MAX];
    /// Every getter, whose results must be consistent with an empty buffer.
    fn check_empty(r: BPrintRef<'_>) {
        assert_eq!(r.len(), 0);
        assert!(r.is_empty());
        assert_eq!(r.as_bytes(), b"");
        assert_eq!(r.as_c_str(), c"");
        assert!(r.size() <= r.size_max());
        let _ = r.is_inline();
    }
    #[test]
    fn every_init_shape_reads_empty_and_drops() {
        for size_max in SIZE_MAX {
            for size_init in SIZE_INIT {
                let mut buf = BPrint::new(size_init, size_max).unwrap();
                check_empty(buf.as_ref());
                // Inline unless `size_init` asked for more than the inline
                // size, the limit allowed growing, and `av_realloc` could
                // (it refuses more than `INT_MAX` bytes).
                let max = if size_max == BPrint::SIZE_AUTOMATIC {
                    BPrint::INLINE_CAPACITY
                } else {
                    size_max
                };
                let inline = max.min(BPrint::INLINE_CAPACITY);
                let grows =
                    size_init > inline && inline != max && size_init.min(max) <= i32::MAX as u32;
                assert_eq!(buf.as_ref().is_inline(), !grows, "{size_init} {size_max}");
                buf.as_mut().truncate(0);
                buf.as_mut().as_mut().truncate(u32::MAX);
                check_empty(buf.as_mut().as_ref());
            }
        }
    }
    #[test]
    fn each_finalizer_hands_out_the_empty_string() {
        for size_max in SIZE_MAX {
            for size_init in [0, 4096] {
                let s = BPrint::into_string(BPrint::new(size_init, size_max).unwrap()).unwrap();
                assert_eq!(s.as_c_str(), c"");
                let b = BPrint::into_bytes(BPrint::new(size_init, size_max).unwrap()).unwrap();
                assert_eq!(b.as_slice(), b"");
            }
        }
    }
    #[test]
    fn caller_buffers_of_every_length_hold_an_empty_string() {
        for len in [0, 1, 2, 3, 1024, 70_000] {
            let mut out = vec![0xa5_u8; len];
            let mut buf = BPrint::for_buffer(&mut out).unwrap();
            check_empty(buf.as_ref());
            assert_eq!(buf.as_ref().size() as usize, len);
            assert_eq!(buf.as_ref().is_inline(), len == 0);
            buf.as_mut().truncate(0);
            drop(buf);
            if len > 0 {
                assert_eq!(out[0], 0);
                // One slice comparison: BSan retags per element visited.
                assert_eq!(out[1..], vec![0xa5; len - 1][..]);
            }
        }
    }
    /// A buffer past `u32::MAX` bytes is used up to that many. Zeroed pages
    /// cost nothing until touched; skipped under BSan, whose shadow does not
    /// scale to them.
    #[test]
    fn a_caller_buffer_beyond_u32_is_clamped() {
        if under_bsan() {
            return;
        }
        let mut out = vec![0_u8; u32::MAX as usize + 2];
        let buf = BPrint::for_buffer(&mut out).unwrap();
        assert_eq!(buf.as_ref().size(), u32::MAX);
        assert_eq!(buf.as_ref().size_max(), u32::MAX);
        assert_eq!(buf.as_ref().as_bytes(), b"");
    }
    #[test]
    fn owners_and_handles_cross_threads() {
        let mut boxes: Vec<BPrintBox> = (0..4)
            .map(|i| BPrint::new(i * 2000, BPrint::SIZE_UNLIMITED).unwrap())
            .collect();
        // Shared handles read concurrently.
        thread::scope(|s| {
            for b in &boxes {
                let r = b.as_ref();
                s.spawn(move || {
                    for _ in 0..100 {
                        check_empty(r);
                    }
                });
            }
        });
        // Exclusive handles write on other threads.
        thread::scope(|s| {
            for b in &mut boxes {
                let mut m = b.as_mut();
                s.spawn(move || m.truncate(0));
            }
        });
        // Owners finalize and drop where they land.
        let joins: Vec<_> = boxes
            .into_iter()
            .enumerate()
            .map(|(i, b)| {
                thread::spawn(move || {
                    if i % 2 == 0 {
                        BPrint::into_string(b).unwrap().len()
                    } else {
                        drop(b);
                        0
                    }
                })
            })
            .collect();
        for j in joins {
            assert_eq!(j.join().unwrap(), 0);
        }
        let mut out = [0xa5_u8; 32];
        let on: BPrintOnBuffer<'_> = BPrint::for_buffer(&mut out).unwrap();
        thread::scope(|s| {
            s.spawn(move || {
                check_empty(on.as_ref());
                drop(on);
            });
        });
        assert_eq!(out[0], 0);
    }
}
//! UB tests for `libavutil/bprint.h`'s unsafe
//! [`BPrintFieldsMut::set_str_borrowed`], each call within its `# Safety`
//! contract: the string stays valid and unwritten until no copy of the value
//! can return it.
//!
//! [`BPrintFieldsMut::set_str_borrowed`]: ffmpeg::libavutil::bprint::BPrintFieldsMut::set_str_borrowed
use core::ffi::CStr;
use std::ffi::CString;
use std::thread;
use ffmpeg::libavutil::bprint::{BPrintFields, BPrintFieldsMut};
/// Stores `s`, within the contract: per each caller, `s` outlives every read
/// of it through the value and its copies.
fn store(mut m: BPrintFieldsMut<'_>, s: Option<&CStr>) {
    // SAFETY: per each caller, `s` stays alive and unwritten until the field
    // is overwritten or the value and every copy of it are dropped.
    unsafe { m.set_str_borrowed(s) };
}
#[test]
fn a_heap_string_is_read_while_it_lives() {
    for text in ["", "x", "so far", &"long ".repeat(200)] {
        let s = CString::new(text).unwrap();
        let mut f = BPrintFields::new();
        store(f.as_mut(), Some(&s));
        assert_eq!(f.as_ref().str(), Some(s.as_c_str()));
        assert_eq!(f.as_ref().str().unwrap().as_ptr(), s.as_ptr());
        // The value's last read precedes the string's drop.
        drop(s);
    }
}
#[test]
fn none_stores_null() {
    let s = CString::new("gone").unwrap();
    let mut f = BPrintFields::new();
    store(f.as_mut(), Some(&s));
    store(f.as_mut(), None);
    // Nothing refers to `s` any more: it may go first.
    drop(s);
    assert_eq!(f.as_ref().str(), None);
}
#[test]
fn an_overwritten_string_may_be_freed_before_the_value() {
    let first = CString::new("first").unwrap();
    let second = CString::new("second").unwrap();
    let mut f = BPrintFields::new();
    store(f.as_mut(), Some(&first));
    f.as_mut().set_len(5);
    store(f.as_mut(), Some(&second));
    drop(first);
    assert_eq!(f.as_ref().str(), Some(c"second"));
    assert_eq!(f.as_ref().len(), 5);
    // A `'static` string replaces the borrowed one through the safe setter.
    f.as_mut().set_str(Some(c"static"));
    drop(second);
    assert_eq!(f.as_ref().str(), Some(c"static"));
}
#[test]
fn copies_keep_the_string_until_each_is_overwritten() {
    let s = CString::new("shared").unwrap();
    let mut a = BPrintFields::new();
    store(a.as_mut(), Some(&s));
    let mut b = a;
    let c = a;
    assert_eq!(b.as_ref().str().unwrap().as_ptr(), s.as_ptr());
    store(b.as_mut(), None);
    store(a.as_mut(), Some(c"other"));
    // `c` still reads `s`, which lives until the end of the scope.
    assert_eq!(c.as_ref().str(), Some(s.as_c_str()));
    assert_eq!((a.as_ref().str(), b.as_ref().str()), (Some(c"other"), None));
    drop(s);
}
#[test]
fn a_borrowed_string_is_read_from_many_threads() {
    let s = CString::new("threads").unwrap();
    let mut f = BPrintFields::new();
    store(f.as_mut(), Some(&s));
    let f = f;
    // Every thread joins before `s` drops, and nothing writes `s`.
    thread::scope(|scope| {
        for _ in 0..4 {
            scope.spawn(|| {
                let mut copy = f;
                for i in 0..500 {
                    assert_eq!(f.as_ref().str(), Some(s.as_c_str()));
                    copy.as_mut().set_len(i);
                }
            });
        }
    });
    drop(s);
}
//! Equivalence of `FF_PAD_STRUCTURE`'s [`PaddedStruct`] description of
//! `AVBPrint` with the structure size `bprint.c` observes and writes.
use core::ffi::c_char;
use core::mem::{MaybeUninit, offset_of};
use core::ptr::{addr_of, addr_of_mut};
use ffmpeg::libavutil::bprint::PaddedStruct;
use ffmpeg::libavutil::ffi;
const SIZE: usize = <ffi::AVBPrint as PaddedStruct>::SIZE;
/// The C-side state of an `AVBPrint`: `(str, len, size, size_max)`.
fn state(buf: *const ffi::AVBPrint) -> (*mut c_char, u32, u32, u32) {
    // SAFETY: per each caller, `buf` addresses an `AVBPrint` that
    // `av_bprint_init` initialised; the fields are read by value.
    unsafe {
        (
            addr_of!((*buf).str_).read(),
            addr_of!((*buf).len).read(),
            addr_of!((*buf).size).read(),
            addr_of!((*buf).size_max).read(),
        )
    }
}
/// The `size` bytes of the buffer at `str`, which the caller keeps alive.
fn contents<'a>(str: *const c_char, size: u32) -> &'a [u8] {
    // SAFETY: per each caller, `str` is the internal buffer of a live
    // `AVBPrint`, `size` bytes that C has written up to its NUL and that
    // nothing writes while the view lives.
    unsafe { core::slice::from_raw_parts(str.cast(), size as usize) }
}
/// `av_bprint_init(buf, 0, AV_BPRINT_SIZE_AUTOMATIC)` on Rust storage.
fn init_automatic(storage: &mut MaybeUninit<ffi::AVBPrint>) -> *mut ffi::AVBPrint {
    let buf = storage.as_mut_ptr();
    // SAFETY: `buf` is `size_of::<AVBPrint>()` writable bytes, which
    // `av_bprint_init` initialises in place without reading them first.
    unsafe { ffi::av_bprint_init(buf, 0, ffi::AV_BPRINT_SIZE_AUTOMATIC) };
    buf
}
#[test]
fn automatic_storage_is_the_padded_size() {
    let mut storage = MaybeUninit::uninit();
    let buf = init_automatic(&mut storage);
    let (str, len, size, size_max) = state(buf);
    // C sizes the internal buffer as `sizeof(AVBPrint)` past its start.
    let internal = offset_of!(ffi::AVBPrint, reserved_internal_buffer);
    assert_eq!(size as usize, SIZE - internal);
    assert_eq!((len, size_max), (0, size));
    // SAFETY: only the field's address is taken, through the raw pointer.
    let internal_buffer = unsafe { addr_of_mut!((*buf).reserved_internal_buffer) };
    assert_eq!(str, internal_buffer.cast());
    assert_eq!(contents(str, 1), b"\0");
}
#[test]
fn c_fills_the_storage_to_its_last_byte_and_no_further() {
    let mut storage = MaybeUninit::uninit();
    let buf = init_automatic(&mut storage);
    let (str, _, size, _) = state(buf);
    let room = size - 1;
    // Step by step to the brim: everything stays in the structure.
    let mut expect = Vec::new();
    for n in [100, room - 100 - 1, 1] {
        // SAFETY: `buf` is an initialised automatic `AVBPrint`, which
        // `av_bprint_chars` appends to within its `size`.
        unsafe { ffi::av_bprint_chars(buf, b'x' as c_char, n) };
        expect.resize(expect.len() + n as usize, b'x');
        let (s, len, sz, _) = state(buf);
        assert_eq!((s, len, sz), (str, expect.len() as u32, size));
        assert_eq!(
            &contents(str, size)[..=expect.len()],
            [&expect[..], b"\0"].concat()
        );
    }
    // The NUL lands on the structure's last byte, `SIZE - 1`.
    assert_eq!(expect.len(), room as usize);
    let last = str.wrapping_add(room as usize) as usize - buf as usize;
    assert_eq!(last, SIZE - 1);
    // One more is counted but truncated: nothing is written past `SIZE`.
    // SAFETY: as above; a full automatic buffer cannot grow, so C truncates.
    unsafe { ffi::av_bprint_chars(buf, b'y' as c_char, 1) };
    let (s, len, sz, _) = state(buf);
    assert_eq!((s, len, sz), (str, size, size));
    assert_eq!(contents(str, size), [&expect[..], b"\0"].concat());
}
/// Equivalence of [`BPrintFields`], `struct ff_pad_helper_AVBPrint`, with the
/// leading fields of the `AVBPrint` that `bprint.c` initialises and fills: C
/// lays both out alike (the padding only follows the fields), so the header
/// C writes, read as a helper, is what a `BPrintFields` holding C's values
/// reports and stores.
mod fields {
    use core::ffi::{CStr, c_char};
    use core::mem::{MaybeUninit, size_of};
    use ffmpeg::libavutil::bprint::{BPrintFields, PaddedStruct};
    use ffmpeg::libavutil::ffi;
    use super::state;
    /// The fields C wrote at the start of `buf`, read through the helper's
    /// layout.
    fn c_header(buf: *const ffi::AVBPrint) -> ffi::ff_pad_helper_AVBPrint {
        // SAFETY: per each caller, `buf` addresses an `AVBPrint` that
        // `av_bprint_init` initialised. Its first `FIELDS_SIZE` bytes hold
        // the helper's fields at the helper's offsets; the helper's trailing
        // alignment, the only bytes C may have left unwritten, is padding.
        unsafe { buf.cast::<ffi::ff_pad_helper_AVBPrint>().read() }
    }
    /// The raw fields a `BPrintFields` stores.
    fn rust_raw(f: &BPrintFields) -> ffi::ff_pad_helper_AVBPrint {
        // SAFETY: `BPrintFields` is `#[repr(transparent)]` over
        // `ff_pad_helper_AVBPrint`, and `f` is a live, initialised value.
        unsafe { core::ptr::from_ref(f).cast::<ffi::ff_pad_helper_AVBPrint>().read() }
    }
    /// The `BPrintFields` holding the state C keeps in `buf`.
    ///
    /// # Safety
    ///
    /// `buf` is an initialised `AVBPrint` whose string stays unwritten and
    /// alive while the result or a copy reads it.
    unsafe fn mirror(buf: *const ffi::AVBPrint) -> BPrintFields {
        let (str, len, size, size_max) = state(buf);
        let h = c_header(buf);
        let mut f = BPrintFields::new();
        let mut m = f.as_mut();
        // SAFETY: C keeps `str` NUL-terminated within its storage, the
        // internal buffer of `buf`, which the caller keeps alive and
        // unwritten while `f` can read it.
        unsafe { m.set_str_borrowed(Some(CStr::from_ptr(str))) };
        m.set_len(len);
        m.set_size(size);
        m.set_size_max(size_max);
        m.set_internal_buffer([h.reserved_internal_buffer[0] as u8]);
        f
    }
    /// Compares C's header with the helper read of it and with its mirror.
    fn compare(buf: *const ffi::AVBPrint) {
        let (str, len, size, size_max) = state(buf);
        let h = c_header(buf);
        assert_eq!((h.str_, h.len, h.size, h.size_max), (str, len, size, size_max));
        // SAFETY: `buf` is live and initialised, and nothing appends to it
        // while `f` lives.
        let f = unsafe { mirror(buf) };
        let r = f.as_ref();
        assert_eq!((r.len(), r.size(), r.size_max()), (len, size, size_max));
        assert_eq!(r.internal_buffer(), [h.reserved_internal_buffer[0] as u8]);
        // SAFETY: as for `mirror`: C's string is NUL-terminated and alive.
        let c_str = unsafe { CStr::from_ptr(str) };
        assert_eq!(r.str(), Some(c_str));
        let raw = rust_raw(&f);
        assert_eq!(raw.str_, h.str_);
        assert_eq!((raw.len, raw.size, raw.size_max), (h.len, h.size, h.size_max));
        assert_eq!(raw.reserved_internal_buffer, h.reserved_internal_buffer);
    }
    /// `av_bprint_init(buf, 0, size_max)` on Rust storage.
    fn init(storage: &mut MaybeUninit<ffi::AVBPrint>, size_max: u32) -> *mut ffi::AVBPrint {
        let buf = storage.as_mut_ptr();
        // SAFETY: `buf` is `size_of::<AVBPrint>()` writable bytes, which
        // `av_bprint_init` initialises in place; `size_init` 0 never
        // allocates.
        unsafe { ffi::av_bprint_init(buf, 0, size_max) };
        buf
    }
    #[test]
    fn the_helper_is_the_header_size_c_pads() {
        assert_eq!(
            size_of::<BPrintFields>(),
            <ffi::AVBPrint as PaddedStruct>::FIELDS_SIZE
        );
        assert_eq!(
            size_of::<BPrintFields>() + size_of::<[c_char; 1000]>(),
            size_of::<ffi::AVBPrint>()
        );
    }
    #[test]
    fn automatic_buffers_match_after_every_append() {
        let mut storage = MaybeUninit::uninit();
        let buf = init(&mut storage, ffi::AV_BPRINT_SIZE_AUTOMATIC);
        compare(buf);
        // The first byte of the internal buffer moves from NUL to text; the
        // last appends truncate.
        for (c, n) in [(b'a', 1), (b'b', 20), (b'c', 980), (b'd', 2), (b'e', 1000)] {
            // SAFETY: `buf` is an initialised automatic `AVBPrint`, which
            // `av_bprint_chars` appends to within its `size`.
            unsafe { ffi::av_bprint_chars(buf, c as c_char, n) };
            compare(buf);
        }
        let (_, len, size, _) = state(buf);
        assert_eq!((len, size), (2003, 1004));
    }
    #[test]
    fn count_only_buffers_match_after_every_append() {
        let mut storage = MaybeUninit::uninit();
        // `AV_BPRINT_SIZE_COUNT_ONLY`: C counts, but writes only the NUL.
        let buf = init(&mut storage, 0);
        compare(buf);
        for n in [1, 4096, u32::MAX] {
            // SAFETY: `buf` is an initialised count-only `AVBPrint`, which
            // `av_bprint_chars` only counts into.
            unsafe { ffi::av_bprint_chars(buf, b'z' as c_char, n) };
            compare(buf);
        }
        // C stops 5 short of `UINT_MAX`.
        let (_, len, size, size_max) = state(buf);
        assert_eq!((len, size, size_max), (u32::MAX - 5, 0, 0));
    }
}
/// Equivalence of the print buffer owners with `av_bprint_init`,
/// `av_bprint_init_for_buffer` and `av_bprint_finalize` on independently
/// owned C buffers: the state each getter reads after every step of a
/// sequence of C appends, clears and truncations, the string each finalizer
/// hands out, and what a caller buffer holds afterwards.
mod owners {
    use core::ffi::{CStr, c_char, c_uint};
    use core::mem::MaybeUninit;
    use core::ptr::{self, addr_of, addr_of_mut};
    use ffmpeg::libavutil::bprint::{BPrint, BPrintMut, BPrintRef};
    use ffmpeg::libavutil::ffi;
    /// A C-side buffer on its own heap storage, which C initialises in place
    /// and which never moves.
    struct CBuf {
        buf: *mut ffi::AVBPrint,
        /// Whether its string may be finalized (not a caller buffer).
        owned: bool,
    }
    impl CBuf {
        fn storage() -> *mut ffi::AVBPrint {
            Box::into_raw(Box::new(MaybeUninit::<ffi::AVBPrint>::uninit())).cast()
        }
        fn init(size_init: c_uint, size_max: c_uint) -> Self {
            let buf = Self::storage();
            // SAFETY: `buf` is writable storage for one `AVBPrint`.
            unsafe { ffi::av_bprint_init(buf, size_init, size_max) };
            Self { buf, owned: true }
        }
        fn for_buffer(data: &mut [u8]) -> Self {
            let buf = Self::storage();
            // SAFETY: `buf` is writable storage, `data` writable for its
            // length, which outlives every use of `buf` in these tests.
            unsafe {
                ffi::av_bprint_init_for_buffer(buf, data.as_mut_ptr().cast(), data.len() as c_uint)
            };
            Self { buf, owned: false }
        }
        /// `(len, size, size_max, inline, stored bytes, string up to NUL)`.
        fn state(&self) -> State {
            let b = self.buf;
            // SAFETY: `b` is an initialised buffer; fields are read by value,
            // and its string is valid for `size` bytes, written up to its NUL
            // at `min(len, size - 1)`.
            unsafe {
                let str = addr_of!((*b).str_).read();
                let len = addr_of!((*b).len).read();
                let size = addr_of!((*b).size).read();
                let stored = len.min(size.saturating_sub(1)) as usize;
                let bytes = if stored == 0 {
                    Vec::new()
                } else {
                    core::slice::from_raw_parts(str.cast::<u8>(), stored).to_vec()
                };
                let c_str = if size == 0 {
                    Vec::new()
                } else {
                    CStr::from_ptr(str).to_bytes().to_vec()
                };
                State {
                    len,
                    size,
                    size_max: addr_of!((*b).size_max).read(),
                    inline: ptr::eq(str, addr_of_mut!((*b).reserved_internal_buffer).cast()),
                    bytes,
                    c_str,
                }
            }
        }
        /// `av_bprint_finalize(buf, &str)`: its return and the string's
        /// stored bytes, without the NUL (`None` for a count-only buffer,
        /// whose block holds no string).
        fn finalize(mut self) -> (i32, Option<Vec<u8>>) {
            let mut str = ptr::null_mut();
            // SAFETY: an owned, initialised buffer; `str` a writable slot.
            let ret = unsafe { ffi::av_bprint_finalize(self.buf, &mut str) };
            // SAFETY: `size` is the string's length, NUL included.
            let real = unsafe { addr_of!((*self.buf).size).read() } as usize;
            let bytes = (ret == 0 && real > 0).then(|| {
                // SAFETY: C's fresh block holds `real` bytes, the last a NUL.
                unsafe { core::slice::from_raw_parts(str.cast::<u8>(), real - 1) }.to_vec()
            });
            // SAFETY: C's block, ours to free (or NULL).
            unsafe { ffi::av_free(str.cast()) };
            self.owned = false;
            (ret, bytes)
        }
    }
    impl Drop for CBuf {
        fn drop(&mut self) {
            if self.owned {
                // SAFETY: an owned buffer, whose string C frees.
                unsafe { ffi::av_bprint_finalize(self.buf, ptr::null_mut()) };
            }
            // SAFETY: the storage `Box` that `storage` leaked.
            drop(unsafe { Box::from_raw(self.buf.cast::<MaybeUninit<ffi::AVBPrint>>()) });
        }
    }
    #[derive(Debug, PartialEq)]
    struct State {
        len: u32,
        size: u32,
        size_max: u32,
        inline: bool,
        bytes: Vec<u8>,
        c_str: Vec<u8>,
    }
    fn rust_state(r: BPrintRef<'_>) -> State {
        State {
            len: r.len(),
            size: r.size(),
            size_max: r.size_max(),
            inline: r.is_inline(),
            bytes: r.as_bytes().to_vec(),
            c_str: r.as_c_str().to_bytes().to_vec(),
        }
    }
    /// One step, applied alike to both buffers.
    #[derive(Clone, Copy, Debug)]
    enum Op {
        Append(&'static [u8]),
        Chars(u8, u32),
        Clear,
        Truncate(u32),
    }
    /// Appends binary data with NULs, grows past the inline storage,
    /// truncates within and past the stored part, clears, and appends again.
    const OPS: &[Op] = &[
        Op::Append(b"head\0bin\x01"),
        Op::Chars(b'x', 3),
        Op::Truncate(20),
        Op::Truncate(6),
        Op::Chars(b'y', 1500),
        Op::Append(b"tail"),
        Op::Truncate(1003),
        Op::Truncate(1499),
        Op::Clear,
        Op::Clear,
        Op::Append(b"\0lead-nul"),
        Op::Chars(b'z', 0),
        Op::Truncate(0),
        Op::Chars(b'w', 2),
    ];
    /// `op` on a C buffer, truncation as C callers write it (avcodec.c).
    fn c_op(b: *mut ffi::AVBPrint, op: Op) {
        // SAFETY: `b` is an initialised buffer, which these routines append
        // to within its `size`; the truncation writes within `size`.
        unsafe {
            match op {
                Op::Append(d) => {
                    ffi::av_bprint_append_data(b, d.as_ptr().cast(), d.len() as c_uint)
                }
                Op::Chars(c, n) => ffi::av_bprint_chars(b, c as c_char, n),
                Op::Clear => ffi::av_bprint_clear(b),
                Op::Truncate(n) => {
                    if n < (*b).len {
                        (*b).len = n;
                        if (*b).size > 0 {
                            *(*b).str_.add(n.min((*b).size - 1) as usize) = 0;
                        }
                    }
                }
            }
        }
    }
    /// `op` on a Rust buffer: C's appends through the owner's pointer, the
    /// truncation through the safe setter.
    fn rust_op(b: *mut ffi::AVBPrint, m: &mut BPrintMut<'_>, op: Op) {
        match op {
            Op::Truncate(n) => m.truncate(n),
            _ => c_op(b, op),
        }
    }
    const INITS: [(u32, u32); 9] = [
        (0, BPrint::SIZE_UNLIMITED),
        (0, BPrint::SIZE_AUTOMATIC),
        (0, BPrint::SIZE_COUNT_ONLY),
        (0, 10),
        (0, 1500),
        (2000, BPrint::SIZE_UNLIMITED),
        (5000, 3000),
        (1, 2),
        (u32::MAX, BPrint::SIZE_UNLIMITED),
    ];
    #[test]
    fn new_and_its_finalizers_match_av_bprint_init_and_finalize() {
        for (size_init, size_max) in INITS {
            let c = CBuf::init(size_init, size_max);
            let mut r = BPrint::new(size_init, size_max).unwrap();
            let ctx = format!("init({size_init}, {size_max})");
            assert_eq!(rust_state(r.as_ref()), c.state(), "{ctx}");
            for &op in OPS {
                let p = r.as_c_ptr();
                c_op(c.buf, op);
                rust_op(p, &mut r.as_mut(), op);
                assert_eq!(rust_state(r.as_ref()), c.state(), "{ctx} {op:?}");
            }
            let expect = c.state();
            // `into_bytes` against C's finalized string.
            let (ret, c_bytes) = c.finalize();
            assert_eq!(ret, 0);
            match BPrint::into_bytes(r) {
                Ok(bytes) => {
                    assert_eq!(
                        bytes.as_slice(),
                        c_bytes.as_deref().unwrap_or_default(),
                        "{ctx}"
                    );
                    assert_eq!(bytes.as_slice(), expect.bytes);
                }
                Err(e) => panic!("{ctx}: {e}"),
            }
            // `into_string` likewise, after the same sequence.
            let c = CBuf::init(size_init, size_max);
            let mut r = BPrint::new(size_init, size_max).unwrap();
            for &op in OPS {
                let p = r.as_c_ptr();
                c_op(c.buf, op);
                rust_op(p, &mut r.as_mut(), op);
            }
            let (ret, c_bytes) = c.finalize();
            let s = BPrint::into_string(r).unwrap();
            assert_eq!(ret, 0);
            match c_bytes {
                // C's string, read up to its NUL.
                Some(b) => assert_eq!(
                    s.as_bytes(),
                    CStr::from_bytes_until_nul(&[&b[..], b"\0"].concat())
                        .unwrap()
                        .to_bytes()
                ),
                // A count-only buffer: C's block holds no string, the
                // documented divergence; Rust hands back "".
                None => {
                    assert_eq!(expect.size, 0, "{ctx}");
                    assert_eq!(s.as_bytes(), b"");
                }
            }
        }
    }
    #[test]
    fn for_buffer_matches_av_bprint_init_for_buffer() {
        for len in [0, 1, 2, 5, 64, 2048] {
            let mut c_data = vec![0xa5_u8; len];
            let mut r_data = vec![0xa5_u8; len];
            let c = CBuf::for_buffer(&mut c_data);
            let mut r = BPrint::for_buffer(&mut r_data).unwrap();
            assert_eq!(rust_state(r.as_ref()), c.state(), "for_buffer({len})");
            for &op in OPS {
                let p = r.as_c_ptr();
                c_op(c.buf, op);
                rust_op(p, &mut r.as_mut(), op);
                assert_eq!(
                    rust_state(r.as_ref()),
                    c.state(),
                    "for_buffer({len}) {op:?}"
                );
            }
            drop(r);
            drop(c);
            assert_eq!(r_data, c_data, "for_buffer({len})");
        }
    }
    /// Whether this is the isolated child of test `name`; in the parent, runs
    /// the child, asserts it passed, and returns `false`.
    fn isolated(name: &str) -> bool {
        const ISOLATED: &str = "CRUSTIFY_EQUIV_ISOLATED";
        if std::env::var_os(ISOLATED).is_some() {
            return true;
        }
        let status = std::process::Command::new(std::env::current_exe().unwrap())
            .args(["--exact", name, "--test-threads=1", "--nocapture"])
            .env(ISOLATED, "1")
            .status()
            .unwrap();
        assert!(status.success(), "isolated run failed: {status}");
        false
    }
    /// Fills both buffers with `n` bytes of `c`.
    fn fill(c: &CBuf, r: &mut ffmpeg::libavutil::bprint::BPrintBox, n: u32) {
        c_op(c.buf, Op::Chars(b'f', n));
        c_op(r.as_c_ptr(), Op::Chars(b'f', n));
    }
    /// The finalizers' allocation failures, forced by the `av_max_alloc`
    /// limit in an isolated child: an inline string C cannot copy out fails
    /// alike with `AVERROR(ENOMEM)`, and a grown string C cannot shrink is
    /// handed out unshrunk, alike.
    #[test]
    fn finalizing_at_the_av_max_alloc_limit_matches_c() {
        if !isolated("bprint::owners::finalizing_at_the_av_max_alloc_limit_matches_c") {
            return;
        }
        let enomem = -(ffi::ENOMEM as i32);
        // A C and a Rust buffer, both unlimited, starting inline.
        let pair = || {
            (
                CBuf::init(0, BPrint::SIZE_UNLIMITED),
                BPrint::new(0, BPrint::SIZE_UNLIMITED).unwrap(),
            )
        };
        let (c, mut r) = pair();
        fill(&c, &mut r, 100);
        ffmpeg::libavutil::mem::set_max_alloc(50);
        assert_eq!(c.finalize(), (enomem, None));
        assert_eq!(BPrint::into_string(r).map(drop), Err(enomem));
        ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
        let (c, mut r) = pair();
        fill(&c, &mut r, 100);
        ffmpeg::libavutil::mem::set_max_alloc(50);
        assert_eq!(c.finalize(), (enomem, None));
        assert_eq!(BPrint::into_bytes(r).map(drop), Err(enomem));
        ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
        for into_string in [false, true] {
            let (c, mut r) = pair();
            fill(&c, &mut r, 3000);
            assert!(!r.as_ref().is_inline());
            ffmpeg::libavutil::mem::set_max_alloc(100);
            let (ret, c_bytes) = c.finalize();
            assert_eq!(ret, 0);
            let c_bytes = c_bytes.unwrap();
            assert_eq!(c_bytes.len(), 3000);
            if into_string {
                assert_eq!(BPrint::into_string(r).unwrap().as_bytes(), c_bytes);
            } else {
                assert_eq!(BPrint::into_bytes(r).unwrap().as_slice(), c_bytes);
            }
            ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
        }
        // Rust's count-only string, "" where C has no string, needs one
        // byte; at a zero limit it fails as C's own copies do.
        let r = BPrint::new(0, BPrint::SIZE_COUNT_ONLY).unwrap();
        ffmpeg::libavutil::mem::set_max_alloc(0);
        assert_eq!(BPrint::into_string(r).map(drop), Err(enomem));
        ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
    }
}
//! UB tests for `libavutil/log.h`'s unsafe context logging, each call within
//! its `# Safety` contract: NULL, class-less and parented contexts, item-name
//! and category callbacks, level offsets up to the overflow bound, through a
//! formatting Rust callback and through the default callback in every colour
//! mode.
use core::ffi::{CStr, c_char, c_int, c_void};
use core::mem::offset_of;
use core::ptr;
use std::cell::RefCell;
use std::sync::{Mutex, MutexGuard, PoisonError};
use std::thread;
use ffmpeg::libavutil::ffi;
use ffmpeg::libavutil::log::{self, Callback, Flags, Level, Record};
/// Serializes the tests here that touch the process-wide log callback, level
/// or flags; restores the defaults when dropped.
struct LogState(#[allow(dead_code)] MutexGuard<'static, ()>);
impl LogState {
    fn lock() -> Self {
        static LOCK: Mutex<()> = Mutex::new(());
        Self(LOCK.lock().unwrap_or_else(PoisonError::into_inner))
    }
}
impl Drop for LogState {
    fn drop(&mut self) {
        log::set_default_callback();
        log::set_level(Level::INFO);
        log::set_flags(Flags::empty());
    }
}
/// A logging context: its class, the level offset its class locates, and a
/// parent context.
#[repr(C)]
struct Ctx {
    class: *const ffi::AVClass,
    level_offset: c_int,
    parent: *mut c_void,
}
/// The current `LIBAVUTIL_VERSION_INT`, which enables every class member.
const VERSION: c_int = (ffi::LIBAVUTIL_VERSION_MAJOR << 16
    | ffi::LIBAVUTIL_VERSION_MINOR << 8
    | ffi::LIBAVUTIL_VERSION_MICRO) as c_int;
/// Names a context by its level offset, through a static string.
unsafe extern "C" fn item_name(ctx: *mut c_void) -> *const c_char {
    // SAFETY: C calls this only with a `Ctx` of a class naming it.
    let offset = unsafe { (*ctx.cast::<Ctx>()).level_offset };
    if offset % 2 == 0 {
        c"even"
    } else {
        c"odd-named-item"
    }
    .as_ptr()
}
/// Reports the highest category below `AV_CLASS_CATEGORY_NB`.
unsafe extern "C" fn get_category(_: *mut c_void) -> ffi::AVClassCategory {
    ffi::AVClassCategory::AV_CLASS_CATEGORY_DEVICE_INPUT
}
/// The classes the contexts use: plain, with callbacks, with a category C
/// rejects (`NB` and above), too old for offsets and categories, and of a
/// release (micro 100) too old for categories, which C checks apart.
fn classes() -> [ffi::AVClass; 5] {
    let base = ffi::AVClass {
        class_name: c"plain".as_ptr(),
        version: VERSION,
        log_level_offset_offset: offset_of!(Ctx, level_offset) as c_int,
        parent_log_context_offset: offset_of!(Ctx, parent) as c_int,
        category: ffi::AVClassCategory::AV_CLASS_CATEGORY_MUXER,
        ..Default::default()
    };
    [
        base,
        ffi::AVClass {
            class_name: c"callbacks".as_ptr(),
            item_name: Some(item_name),
            get_category: Some(get_category),
            ..base
        },
        ffi::AVClass {
            class_name: c"bad-category".as_ptr(),
            category: ffi::AVClassCategory(1000),
            ..base
        },
        ffi::AVClass {
            class_name: c"old".as_ptr(),
            version: 50 << 16,
            ..base
        },
        ffi::AVClass {
            class_name: c"old-release".as_ptr(),
            version: 50 << 16 | 100,
            ..base
        },
    ]
}
/// Level offsets, with the levels each may be logged at without overflowing
/// an `int`: C adds the offset from `FATAL` up.
const OFFSETS: [(c_int, &[c_int]); 5] = [
    (0, &[c_int::MIN, -8, 0, 8, 56, c_int::MAX]),
    (8, &[-8, 0, 8, 48]),
    (-16, &[-8, 8, 16, c_int::MAX]),
    (c_int::MAX - 8, &[c_int::MIN, -8, 7, 8]),
    (c_int::MIN, &[-8, 8, 56, c_int::MAX]),
];
/// Every context shape over `classes`, with `offset`: NULL, a NULL class, a
/// class without a parent, with a parent of each class, and with a parent
/// whose class is NULL. Returned with the parents, which must outlive them;
/// neither vector grows after it is built, so the addresses stay put.
fn contexts(classes: &[ffi::AVClass; 5], offset: c_int) -> (Vec<Ctx>, Vec<Ctx>) {
    let mut parents: Vec<Ctx> = classes
        .iter()
        .map(|c| Ctx {
            class: c,
            level_offset: 1,
            parent: ptr::null_mut(),
        })
        .chain([Ctx {
            class: ptr::null(),
            level_offset: 0,
            parent: ptr::null_mut(),
        }])
        .collect();
    let mut out = vec![Ctx {
        class: ptr::null(),
        level_offset: offset,
        parent: ptr::null_mut(),
    }];
    for class in classes {
        out.push(Ctx {
            class,
            level_offset: offset,
            parent: ptr::null_mut(),
        });
        for p in &mut parents {
            out.push(Ctx {
                class,
                level_offset: offset,
                parent: (&raw mut *p).cast(),
            });
        }
    }
    (out, parents)
}
thread_local! {
    /// Lines this thread formatted while it captures.
    static LINES: RefCell<Option<Vec<(Level, usize, CStrBuf)>>> = const { RefCell::new(None) };
}
type CStrBuf = std::ffi::CString;
/// Formats each record a capturing thread logs through every method.
struct FormatAll;
impl Callback for FormatAll {
    fn log(record: Record<'_>) {
        if LINES.with(|l| l.borrow().is_none()) {
            return;
        }
        let mut prefix = true;
        let line = record.to_line(&mut prefix).unwrap_or_default();
        for n in [0, 1, 5, 40] {
            let mut buf = vec![0u8; n].into_boxed_slice();
            let _ = record.format_line(&mut buf, &mut true);
            let _ = record.write_line(&mut buf, &mut false);
        }
        let entry = (record.level(), record.context() as usize, line);
        LINES.with(|l| l.borrow_mut().as_mut().unwrap().push(entry));
    }
}
/// Runs `f` with [`FormatAll`] installed; returns this thread's lines.
fn capture(f: impl FnOnce()) -> Vec<(Level, usize, CStrBuf)> {
    LINES.with(|l| *l.borrow_mut() = Some(Vec::new()));
    log::set_callback::<FormatAll>();
    f();
    log::set_default_callback();
    LINES.with(|l| l.borrow_mut().take().unwrap())
}
/// Forwards every record to the default callback.
struct Forward;
impl Callback for Forward {
    fn log(record: Record<'_>) {
        record.log_default();
    }
}
/// Set in the child process an isolated test re-runs itself in.
const ISOLATED: &str = "CRUSTIFY_UB_ISOLATED";
/// Re-runs test `name` in a child per colour mode, its stderr discarded, and
/// returns `true` in the child.
fn in_colour_mode_children(name: &str) -> bool {
    if std::env::var_os(ISOLATED).is_some() {
        return true;
    }
    let modes: [&[(&str, &str)]; 3] = [
        &[("AV_LOG_FORCE_NOCOLOR", "1")],
        &[("AV_LOG_FORCE_COLOR", "1")],
        &[("AV_LOG_FORCE_COLOR", "1"), ("AV_LOG_FORCE_256COLOR", "1")],
    ];
    for env in modes {
        let status = std::process::Command::new(std::env::current_exe().unwrap())
            .args(["--exact", name, "--test-threads=1"])
            .env(ISOLATED, "1")
            .envs(env.iter().copied())
            .stderr(std::process::Stdio::null())
            .status()
            .unwrap();
        assert!(status.success(), "{env:?}: {status}");
    }
    false
}
/// `log::log_with_context`, within its contract.
mod log_with_context {
    use super::*;
    /// Logs `msg` with `ctx` at each level its offset allows.
    fn log_all(ctx: &mut Ctx, msg: &CStr) {
        let levels = OFFSETS
            .iter()
            .find(|(o, _)| *o == ctx.level_offset)
            .unwrap()
            .1;
        for &level in levels {
            // SAFETY: `ctx` is a live `Ctx` whose class is NULL or one of
            // `classes()`: names and callbacks valid for it, a category the
            // callback keeps below NB, an `int` at the level offset that
            // `level` plus it does not overflow from FATAL up, and a NULL or
            // live parent context; nothing writes them during the call.
            unsafe { log::log_with_context((&raw mut *ctx).cast(), Level::from_raw(level), msg) };
        }
    }
    #[test]
    fn null_context_is_the_general_log() {
        let _s = LogState::lock();
        let lines = capture(|| {
            // SAFETY: a NULL context is always valid.
            unsafe { log::log_with_context(ptr::null_mut(), Level::ERROR, c"general\n") };
        });
        assert_eq!(lines.len(), 1);
        assert_eq!((lines[0].0, lines[0].1), (Level::ERROR, 0));
        assert_eq!(lines[0].2.as_bytes(), b"general\n");
    }
    #[test]
    fn every_context_shape_formats_through_a_rust_callback() {
        let _s = LogState::lock();
        let classes = classes();
        log::set_flags(Flags::PRINT_LEVEL);
        for (offset, levels) in OFFSETS {
            let (mut ctxs, _parents) = contexts(&classes, offset);
            let lines = capture(|| {
                for ctx in &mut ctxs {
                    log_all(ctx, c"part ");
                    log_all(ctx, c"end\n");
                }
            });
            assert_eq!(lines.len(), ctxs.len() * levels.len() * 2);
        }
    }
    #[test]
    fn offsets_shift_levels_from_fatal_up() {
        let _s = LogState::lock();
        let classes = classes();
        let mut ctx = Ctx {
            class: &classes[0],
            level_offset: c_int::MAX - 8,
            parent: ptr::null_mut(),
        };
        let lines = capture(|| log_all(&mut ctx, c"x\n"));
        let levels: Vec<c_int> = lines.iter().map(|l| l.0.raw()).collect();
        assert_eq!(levels, [c_int::MIN, -8, 7, c_int::MAX]);
        let mut old = Ctx {
            class: &classes[3],
            level_offset: c_int::MIN,
            parent: ptr::null_mut(),
        };
        let lines = capture(|| log_all(&mut old, c"x\n"));
        let levels: Vec<c_int> = lines.iter().map(|l| l.0.raw()).collect();
        assert_eq!(levels, [-8, 8, 56, c_int::MAX], "too old for offsets");
    }
    #[test]
    fn contexts_are_shared_across_logging_threads() {
        let _s = LogState::lock();
        let classes = classes();
        let (ctxs, parents) = contexts(&classes, 8);
        let addrs: Vec<usize> = ctxs.iter().map(|c| &raw const *c as usize).collect();
        log::set_callback::<FormatAll>();
        thread::scope(|s| {
            for _ in 0..4 {
                let addrs = &addrs;
                s.spawn(move || {
                    for &a in addrs {
                        // SAFETY: as in `log_all`; the contexts outlive the
                        // scope and no thread writes them.
                        unsafe {
                            log::log_with_context(a as *mut c_void, Level::ERROR, c"shared\n")
                        };
                    }
                });
            }
        });
        drop((ctxs, parents));
    }
    /// The default callback reads names and categories, and with colour
    /// indexes its table by category.
    #[test]
    fn every_context_shape_prints_through_the_default_callback() {
        if !in_colour_mode_children(
            "log::log_with_context::every_context_shape_prints_through_the_default_callback",
        ) {
            return;
        }
        let classes = classes();
        log::set_callback::<Forward>();
        log::set_level(Level::TRACE);
        log::set_flags(Flags::PRINT_LEVEL | Flags::SKIP_REPEATED);
        for (offset, _) in OFFSETS {
            let (mut ctxs, _parents) = contexts(&classes, offset);
            for ctx in &mut ctxs {
                log_all(ctx, c"default\n");
            }
        }
    }
}
/// `log::log_fmt_with_context` (`av_log`), within its contract.
mod log_fmt_with_context {
    use super::*;
    /// Logs a formatted line with `ctx` at each level its offset allows.
    fn log_all(ctx: &mut Ctx, n: usize) {
        let levels = OFFSETS
            .iter()
            .find(|(o, _)| *o == ctx.level_offset)
            .unwrap()
            .1;
        for &level in levels {
            // SAFETY: as for `log_with_context` in its suite's `log_all`.
            unsafe {
                log::log_fmt_with_context(
                    (&raw mut *ctx).cast(),
                    Level::from_raw(level),
                    format_args!("{n:>4} %s %n {:.3}\0hidden\n", 1.0 / 3.0),
                )
            };
        }
    }
    #[test]
    fn null_context_is_the_general_log() {
        let _s = LogState::lock();
        let lines = capture(|| {
            // SAFETY: a NULL context is always valid.
            unsafe {
                log::log_fmt_with_context(ptr::null_mut(), Level::ERROR, format_args!("{}\n", 7))
            };
        });
        assert_eq!(lines.len(), 1);
        assert_eq!((lines[0].0, lines[0].1), (Level::ERROR, 0));
        assert_eq!(lines[0].2.as_bytes(), b"7\n");
    }
    #[test]
    fn every_context_shape_formats_through_a_rust_callback() {
        let _s = LogState::lock();
        let classes = classes();
        for (offset, levels) in OFFSETS {
            let (mut ctxs, _parents) = contexts(&classes, offset);
            let lines = capture(|| {
                for (n, ctx) in ctxs.iter_mut().enumerate() {
                    log_all(ctx, n);
                }
            });
            assert_eq!(lines.len(), ctxs.len() * levels.len());
            // The text stops at the NUL, as C's `%s` reads it.
            assert!(lines.iter().all(|l| l.2.as_bytes().ends_with(b" 0.333")));
        }
    }
    #[test]
    fn contexts_are_shared_across_logging_threads() {
        let _s = LogState::lock();
        let classes = classes();
        let (ctxs, parents) = contexts(&classes, 8);
        let addrs: Vec<usize> = ctxs.iter().map(|c| &raw const *c as usize).collect();
        log::set_callback::<FormatAll>();
        thread::scope(|s| {
            for t in 0..4 {
                let addrs = &addrs;
                s.spawn(move || {
                    for &a in addrs {
                        // SAFETY: as in `log_all`; the contexts outlive the
                        // scope and no thread writes them.
                        unsafe {
                            log::log_fmt_with_context(
                                a as *mut c_void,
                                Level::ERROR,
                                format_args!("thread {t}\n"),
                            )
                        };
                    }
                });
            }
        });
        drop((ctxs, parents));
    }
    #[test]
    fn every_context_shape_prints_through_the_default_callback() {
        if !in_colour_mode_children(
            "log::log_fmt_with_context::every_context_shape_prints_through_the_default_callback",
        ) {
            return;
        }
        let classes = classes();
        log::set_callback::<Forward>();
        log::set_level(Level::TRACE);
        for (offset, _) in OFFSETS {
            let (mut ctxs, _parents) = contexts(&classes, offset);
            for (n, ctx) in ctxs.iter_mut().enumerate() {
                log_all(ctx, n);
            }
        }
    }
}
/// `log::log_once_with_context`, within its contract.
mod log_once_with_context {
    use super::*;
    /// `log_once_with_context` for each level `ctx`'s offset allows, as
    /// initial and subsequent level, from both starting states; returns the
    /// states after each call.
    fn once_all(ctx: &mut Ctx) -> Vec<bool> {
        let levels = OFFSETS
            .iter()
            .find(|(o, _)| *o == ctx.level_offset)
            .unwrap()
            .1;
        let mut states = Vec::new();
        for &a in levels {
            for &b in levels {
                for start in [false, true] {
                    let mut state = start;
                    for _ in 0..2 {
                        // SAFETY: as for `log_with_context` in `log_all`;
                        // `state` is this call's own.
                        unsafe {
                            log::log_once_with_context(
                                (&raw mut *ctx).cast(),
                                Level::from_raw(a),
                                Level::from_raw(b),
                                &mut state,
                                c"once\n",
                            )
                        };
                        states.push(state);
                    }
                }
            }
        }
        states
    }
    #[test]
    fn null_context_moves_the_state() {
        let _s = LogState::lock();
        let mut state = false;
        let lines = capture(|| {
            for _ in 0..3 {
                // SAFETY: a NULL context is always valid.
                unsafe {
                    log::log_once_with_context(
                        ptr::null_mut(),
                        Level::ERROR,
                        Level::DEBUG,
                        &mut state,
                        c"o\n",
                    )
                };
            }
        });
        assert!(state);
        let levels: Vec<Level> = lines.iter().map(|l| l.0).collect();
        assert_eq!(levels, [Level::ERROR, Level::DEBUG, Level::DEBUG]);
    }
    #[test]
    fn every_context_shape_and_state() {
        let _s = LogState::lock();
        let classes = classes();
        for (offset, _) in OFFSETS {
            let (mut ctxs, _parents) = contexts(&classes, offset);
            let lines = capture(|| {
                for ctx in &mut ctxs {
                    assert!(once_all(ctx).into_iter().all(|s| s));
                }
            });
            assert!(!lines.is_empty());
        }
    }
    #[test]
    fn states_are_per_thread_and_contexts_shared() {
        let _s = LogState::lock();
        let classes = classes();
        let (ctxs, parents) = contexts(&classes, -16);
        let addrs: Vec<usize> = ctxs.iter().map(|c| &raw const *c as usize).collect();
        log::set_callback::<FormatAll>();
        thread::scope(|s| {
            for _ in 0..4 {
                let addrs = &addrs;
                s.spawn(move || {
                    for &a in addrs {
                        let mut state = false;
                        for _ in 0..3 {
                            // SAFETY: as in `once_all`; the contexts outlive
                            // the scope, no thread writes them, and `state`
                            // is this thread's own.
                            unsafe {
                                log::log_once_with_context(
                                    a as *mut c_void,
                                    Level::WARNING,
                                    Level::TRACE,
                                    &mut state,
                                    c"t\n",
                                )
                            };
                        }
                        assert!(state);
                    }
                });
            }
        });
        drop((ctxs, parents));
    }
    #[test]
    fn every_context_shape_prints_through_the_default_callback() {
        if !in_colour_mode_children(
            "log::log_once_with_context::every_context_shape_prints_through_the_default_callback",
        ) {
            return;
        }
        let classes = classes();
        log::set_callback::<Forward>();
        log::set_level(Level::TRACE);
        let (mut ctxs, _parents) = contexts(&classes, 0);
        for ctx in &mut ctxs {
            once_all(ctx);
        }
    }
}
/// `log::log_with_context` (`av_vlog`) through the default log callback,
/// within its contract: level offsets up to the overflow bound, old classes,
/// parents and threads.
mod vlog {
    use core::ffi::{CStr, c_char, c_int, c_void};
    use core::mem::offset_of;
    use core::ptr;
    use std::thread;
    use ffmpeg::libavutil::ffi;
    use ffmpeg::libavutil::log::{Level, log_with_context};
    const INFO: c_int = ffi::AV_LOG_INFO as c_int;
    const DEBUG: c_int = ffi::AV_LOG_DEBUG as c_int;
    const FATAL: c_int = ffi::AV_LOG_FATAL as c_int;
    /// The first class version `av_vlog` applies a level offset for.
    const OFFSET_VERSION: c_int = (50 << 16) | (15 << 8) | 2;
    /// A version the default callback asks for a category.
    const CATEGORY_VERSION: c_int = (61 << 16) | (6 << 8) | 100;
    /// A context with a level offset and a parent slot, heap-allocated so a read
    /// past it reaches the sanitizers.
    #[repr(C)]
    struct Ctx {
        class: *const ffi::AVClass,
        level_offset: c_int,
        parent: *mut *const ffi::AVClass,
    }
    impl Ctx {
        fn boxed(class: *const ffi::AVClass, level_offset: c_int) -> Box<Self> {
            Box::new(Self {
                class,
                level_offset,
                parent: ptr::null_mut(),
            })
        }
        fn as_obj(&mut self) -> *mut c_void {
            (self as *mut Self).cast()
        }
    }
    /// The context's class name, as `av_default_item_name` gives it.
    unsafe extern "C" fn item_name(ctx: *mut c_void) -> *const c_char {
        // SAFETY: C passes a live context, whose first member is its class.
        unsafe { (*ctx.cast::<*const ffi::AVClass>().read()).class_name }
    }
    /// A category read from the context.
    unsafe extern "C" fn get_category(_ctx: *mut c_void) -> ffi::AVClassCategory {
        ffi::AVClassCategory::AV_CLASS_CATEGORY_FILTER
    }
    fn class(version: c_int, offset: bool, parent: bool) -> Box<ffi::AVClass> {
        Box::new(ffi::AVClass {
            class_name: c"crustify-vlog-unsafe".as_ptr(),
            item_name: Some(item_name),
            version,
            log_level_offset_offset: if offset {
                offset_of!(Ctx, level_offset) as c_int
            } else {
                0
            },
            parent_log_context_offset: if parent {
                offset_of!(Ctx, parent) as c_int
            } else {
                0
            },
            get_category: Some(get_category),
            ..Default::default()
        })
    }
    /// Logs `message` at each of `levels` in `obj`'s context.
    ///
    /// # Safety
    ///
    /// As [`log_with_context`], for every level.
    unsafe fn log_all(obj: *mut c_void, levels: &[c_int], message: &CStr) {
        for &level in levels {
            // SAFETY: the caller's contract.
            unsafe { log_with_context(obj, Level::from_raw(level), message) };
        }
    }
    #[test]
    fn null_context_and_null_class() {
        // SAFETY: NULL is the general log.
        unsafe {
            log_all(
                ptr::null_mut(),
                &[DEBUG, ffi::AV_LOG_TRACE as c_int],
                c"%s%n",
            )
        };
        let mut ctx = Ctx::boxed(ptr::null(), 0);
        // SAFETY: a context whose class pointer is NULL.
        unsafe {
            log_all(
                ctx.as_obj(),
                &[DEBUG, INFO],
                c"crustify ub_unsafe vlog: classless\n",
            )
        };
    }
    #[test]
    fn level_offsets_up_to_the_overflow_bound() {
        let cls = class(OFFSET_VERSION, true, false);
        let trace = ffi::AV_LOG_TRACE as c_int;
        for offset in [c_int::MIN, -1000, -FATAL, 0, 1, 1000, c_int::MAX - trace] {
            let mut ctx = Ctx::boxed(&*cls, offset);
            // SAFETY: `level + offset` stays within `c_int` for these levels, from
            // `FATAL + c_int::MIN` up to exactly `c_int::MAX`.
            unsafe {
                log_all(
                    ctx.as_obj(),
                    &[FATAL, DEBUG, trace],
                    c"crustify ub_unsafe vlog: %%%s\n",
                )
            };
        }
        let mut ctx = Ctx::boxed(&*cls, c_int::MAX - 0xff);
        // SAFETY: levels below `AV_LOG_FATAL` take no offset, and `0xff` sums to
        // exactly `c_int::MAX`.
        unsafe {
            log_all(
                ctx.as_obj(),
                &[ffi::AV_LOG_PANIC as c_int, ffi::AV_LOG_QUIET - 1000, 0xff],
                c"crustify ub_unsafe vlog: below FATAL\n",
            )
        };
    }
    #[test]
    fn offsets_of_old_classes_are_ignored() {
        let old = class(OFFSET_VERSION - 1, true, false);
        let mut ctx = Ctx::boxed(&*old, c_int::MAX);
        // SAFETY: the class predates level offsets, so the `c_int::MAX` offset is
        // never added; the levels the default callback drops.
        unsafe { log_all(ctx.as_obj(), &[DEBUG, c_int::MAX], c"old class") };
    }
    #[test]
    fn printed_lines_name_the_context_and_its_parent() {
        let parent_class = class(CATEGORY_VERSION, false, false);
        let mut parent: *const ffi::AVClass = &*parent_class;
        let child_class = class(CATEGORY_VERSION, true, true);
        let mut ctx = Ctx::boxed(&*child_class, -8);
        for slot in [ptr::null_mut(), &mut parent as *mut _] {
            ctx.parent = slot;
            // SAFETY: a well-formed context whose parent slot is NULL or points
            // at a classed parent; the offset keeps every level in range.
            unsafe {
                log_all(
                    ctx.as_obj(),
                    &[INFO + 8, DEBUG],
                    c"crustify ub_unsafe vlog: child\n",
                )
            };
        }
        let mut null_parent: *const ffi::AVClass = ptr::null();
        ctx.parent = &mut null_parent;
        // SAFETY: the parent slot points to a NULL class pointer.
        unsafe {
            log_all(
                ctx.as_obj(),
                &[INFO + 8],
                c"crustify ub_unsafe vlog: orphan\n",
            )
        };
    }
    #[test]
    fn one_context_logged_from_many_threads() {
        let cls = class(CATEGORY_VERSION, true, false);
        let ctx = Ctx::boxed(&*cls, 16);
        let addr = Box::into_raw(ctx) as usize;
        let workers: Vec<_> = (0..8)
            .map(|i| {
                thread::spawn(move || {
                    for j in 0..200 {
                        let level = if i == 0 && j == 0 { FATAL } else { DEBUG };
                        // SAFETY: the context and class outlive the threads,
                        // which only read them; the offset keeps levels in range.
                        unsafe {
                            log_with_context(
                                addr as *mut c_void,
                                Level::from_raw(level),
                                c"crustify ub_unsafe vlog: threads\n",
                            )
                        };
                    }
                })
            })
            .collect();
        for w in workers {
            w.join().unwrap();
        }
        // SAFETY: `addr` came from `Box::into_raw`, and the threads are done.
        drop(unsafe { Box::from_raw(addr as *mut Ctx) });
        drop(cls);
    }
}
/// UB tests for `libavutil/log.h`'s unsafe `default_item_name`, called within
/// its `# Safety` contract: static and heap classes, NULL names, objects
/// larger than their class pointer, and concurrent readers.
mod item_name {
    use core::ffi::{CStr, c_void};
    use core::ptr::null;
    use std::ffi::CString;
    use ffmpeg::libavutil::ffi;
    use ffmpeg::libavutil::log::default_item_name;
    /// A class, `Sync` to live in a `static`.
    struct Class(ffi::AVClass);
    // SAFETY: the class is immutable and its name is a string literal.
    unsafe impl Sync for Class {}
    static NAMED: Class = Class(ffi::AVClass {
        class_name: c"ub-unsafe-class".as_ptr(),
        // SAFETY: every other member is an integer, a nullable pointer or an
        // `Option` of a function pointer, for which all-zero is valid (NULL).
        ..unsafe { core::mem::zeroed() }
    });
    /// An `AVClass`-enabled object with a payload after its class pointer.
    #[repr(C)]
    struct Obj {
        class: *const ffi::AVClass,
        payload: [u8; 64],
    }
    impl Obj {
        fn new(class: *const ffi::AVClass) -> Self {
            Self {
                class,
                payload: [0xa5; 64],
            }
        }
        fn ctx(&self) -> *const c_void {
            (self as *const Self).cast()
        }
    }
    #[test]
    fn static_class_name_lives_for_static() {
        let name: &'static CStr = {
            let obj = Obj::new(&NAMED.0);
            // SAFETY: `obj` starts with a non-NULL pointer to the live static
            // class, whose name is a literal, so any lifetime holds.
            unsafe { default_item_name(obj.ctx()) }.unwrap()
        };
        // The name outlives the object that reached it.
        assert_eq!(name, c"ub-unsafe-class");
    }
    #[test]
    fn bare_class_pointer_is_the_smallest_object() {
        let fake: *const ffi::AVClass = &NAMED.0;
        // SAFETY: `fake` is readable memory starting with a non-NULL class
        // pointer to the live static class.
        let name = unsafe { default_item_name((&raw const fake).cast()) };
        assert_eq!(name, Some(c"ub-unsafe-class"));
    }
    #[test]
    fn class_pointer_slot_inside_a_larger_object() {
        /// An object whose class pointer is an aligned member, but not its
        /// allocation's first byte: the context points at the member.
        #[repr(C)]
        struct Outer {
            prefix: [u8; 24],
            class: *const ffi::AVClass,
            payload: u64,
        }
        let outer = Box::new(Outer {
            prefix: [0x5a; 24],
            class: &NAMED.0,
            payload: 7,
        });
        let ctx: *const c_void = (&raw const outer.class).cast();
        // SAFETY: `ctx` is the aligned `class` member of the live `outer`,
        // holding a non-NULL pointer to the static class whose name is a
        // literal; no other thread writes either.
        let name = unsafe { default_item_name(ctx) };
        assert_eq!(name, Some(c"ub-unsafe-class"));
        assert_eq!((outer.prefix[0], outer.payload), (0x5a, 7));
    }
    #[test]
    fn null_class_name_reads_as_none() {
        let cls = ffi::AVClass {
            class_name: null(),
            ..Default::default()
        };
        let obj = Obj::new(&cls);
        // SAFETY: `obj` starts with a non-NULL pointer to the live `cls`, which
        // stores NULL as its name.
        assert_eq!(unsafe { default_item_name(obj.ctx()) }, None);
    }
    #[test]
    fn heap_name_is_read_within_its_owner() {
        for text in ["", "h", "heap-allocated-class-name", &"n".repeat(4000)] {
            let name = CString::new(text).unwrap();
            let cls = Box::new(ffi::AVClass {
                class_name: name.as_ptr(),
                ..Default::default()
            });
            let obj = Box::new(Obj::new(&*cls));
            {
                // SAFETY: `obj` starts with a non-NULL pointer to the live `cls`,
                // whose name `name` stays alive and unmodified for this block.
                let read = unsafe { default_item_name(obj.ctx()) }.unwrap();
                assert_eq!(read.to_bytes(), text.as_bytes());
            }
            drop(obj);
            drop(cls);
            drop(name);
        }
    }
    #[test]
    fn object_class_switches_between_calls() {
        let other = ffi::AVClass {
            class_name: c"other".as_ptr(),
            ..Default::default()
        };
        let mut obj = Obj::new(&NAMED.0);
        for (i, cls) in [&NAMED.0, &other, &NAMED.0].into_iter().enumerate() {
            obj.class = cls;
            // SAFETY: `obj` starts with a non-NULL pointer to a live class whose
            // name is a literal; no other thread writes `obj`.
            let name = unsafe { default_item_name(obj.ctx()) }.unwrap();
            assert_eq!(name.as_ptr(), cls.class_name, "step {i}");
        }
        assert_eq!(obj.payload, [0xa5; 64]);
    }
    #[test]
    fn concurrent_readers_share_an_object() {
        /// An object, `Sync` to share across threads.
        struct Shared(Obj);
        // SAFETY: the threads below only read the object and its static class.
        unsafe impl Sync for Shared {}
        let shared = Shared(Obj::new(&NAMED.0));
        std::thread::scope(|s| {
            for _ in 0..4 {
                let shared = &shared;
                s.spawn(move || {
                    for _ in 0..1_000 {
                        // SAFETY: the object starts with a non-NULL pointer to the
                        // static class; every thread only reads it.
                        let name = unsafe { default_item_name(shared.0.ctx()) };
                        assert_eq!(name, Some(c"ub-unsafe-class"));
                    }
                });
            }
        });
    }
}
/// The `log_with_context` route to a raw class's `ClassRef`.
#[path = "../common/class.rs"]
mod class_fixture;
/// UB tests of `AVClass`'s callable handles, each call within its `# Safety`
/// contract: `item_name` on Rust-built and C-named classes (NULL names
/// included), `get_category` returning any value, `query_ranges` succeeding
/// with one or several components, failing and returning no list, from
/// several threads, and `child_next` walking an object's children to the end.
mod class_callbacks {
    use core::ffi::{CStr, c_char, c_int, c_void};
    use core::ptr;
    use std::thread;
    use ffmpeg::libavutil::ffi;
    use ffmpeg::libavutil::log::{Class, ClassCategory, ClassRef};
    use super::LogState;
    use super::class_fixture::with_class;
    use crate::opt::fixture::{CB_FAKE, CB_KEYS, EINVAL, RANGED, UNKNOWN};
    /// An object of a class: its class pointer first, then `children`.
    #[repr(C)]
    struct Obj {
        class: *const ffi::AVClass,
        children: [*mut c_void; 2],
    }
    impl Obj {
        fn new(class: *const ffi::AVClass) -> Self {
            Self {
                class,
                children: [ptr::null_mut(); 2],
            }
        }
        fn as_obj(&mut self) -> *mut c_void {
            (self as *mut Self).cast()
        }
    }
    /// A raw class named `name`, every other member zero.
    fn raw(name: Option<&'static CStr>) -> ffi::AVClass {
        ffi::AVClass {
            class_name: name.map_or(ptr::null(), CStr::as_ptr),
            ..Default::default()
        }
    }
    static OWN: Class = Class::new(c"ub-unsafe-class", ClassCategory::DEMUXER);
    static EMPTY: Class = Class::new(c"", ClassCategory::NA);
    #[test]
    fn item_name_names_objects_of_rust_classes() {
        for class in [&OWN, &EMPTY] {
            let mut obj = Obj::new(class.as_c_ptr());
            let name = class.as_ref().item_name().unwrap();
            // SAFETY: `obj` is a live object whose first member points to
            // `class`, whose `item_name` is `av_default_item_name`; the name
            // is the class's `'static` literal.
            let got: Option<&'static CStr> = unsafe { name.call(obj.as_obj()) };
            assert_eq!(got, class.as_ref().name());
            assert_eq!(
                got.unwrap().as_ptr(),
                class.as_ref().name().unwrap().as_ptr()
            );
        }
    }
    unsafe extern "C" fn null_name(_: *mut c_void) -> *const c_char {
        ptr::null()
    }
    unsafe extern "C" fn any_category(obj: *mut c_void) -> ffi::AVClassCategory {
        // SAFETY: `obj` is an `Obj`, whose first child slot holds the value.
        let v = unsafe { (*obj.cast::<Obj>()).children[0] }.addr();
        ffi::AVClassCategory(v as u32)
    }
    #[test]
    fn item_name_and_get_category_take_any_result() {
        let _s = LogState::lock();
        let mut nameless = raw(None);
        nameless.item_name = Some(ffi::av_default_item_name);
        let mut null = raw(Some(c"null-item"));
        null.item_name = Some(null_name);
        null.get_category = Some(any_category);
        for class in [&nameless, &null] {
            let mut obj = Obj::new(class);
            let o = obj.as_obj();
            // SAFETY: `o` starts with a pointer to a live class without
            // offsets; its callbacks accept `o` and return NULL, a class name
            // or a category.
            let (name, cats) = unsafe {
                with_class(o, |c: Option<ClassRef<'_>>| {
                    let c = c.unwrap();
                    let name = c.item_name().unwrap().call(o).map(CStr::to_owned);
                    let cats = c.get_category().map(|g| {
                        [0, 7, 45, u32::MAX as usize].map(|v| {
                            (*o.cast::<Obj>()).children[0] = ptr::without_provenance_mut(v);
                            g.call(o).value()
                        })
                    });
                    (name, cats)
                })
            };
            assert_eq!(name, None);
            if let Some(cats) = cats {
                assert_eq!(cats, [0, 7, 45, u32::MAX]);
            }
        }
    }
    /// Succeeds without storing a list.
    unsafe extern "C" fn no_list(
        _: *mut *mut ffi::AVOptionRanges,
        _: *mut c_void,
        _: *const c_char,
        _: c_int,
    ) -> c_int {
        0
    }
    #[test]
    fn query_ranges_builds_fails_and_reports_a_missing_list() {
        let _s = LogState::lock();
        let fake = ffi::AV_OPT_SEARCH_FAKE_OBJ as c_int;
        let multi = ffi::AV_OPT_MULTI_COMPONENT_RANGE as c_int;
        let obj = CB_FAKE.as_obj();
        // SAFETY: `obj` is a `const AVClass *` to the fixture's well-formed
        // class, a context `log_with_context` accepts; its callback builds
        // lists per `av_opt_query_ranges`' contract and accepts the fake
        // object with `AV_OPT_SEARCH_FAKE_OBJ`.
        unsafe {
            with_class(obj, |c| {
                let q = c.unwrap().query_ranges().unwrap();
                for flags in [fake, fake | multi] {
                    for key in CB_KEYS.iter().chain(&RANGED).chain(&UNKNOWN) {
                        match q.call(obj, key, flags) {
                            Ok(list) => {
                                let r = list.as_ref();
                                let n = r.range_count() * r.component_count();
                                assert_eq!(r.ranges().len(), n);
                                if *key == c"size" {
                                    assert_eq!(
                                        r.component_count(),
                                        if flags & multi != 0 { 3 } else { 1 }
                                    );
                                }
                            }
                            Err(e) => assert!(e < 0 && (e != EINVAL || *key == c"fail")),
                        }
                    }
                }
                // Several threads at once: each list is independent.
                thread::scope(|s| {
                    for _ in 0..4 {
                        s.spawn(move || {
                            let obj = CB_FAKE.as_obj();
                            for key in RANGED {
                                drop(q.call(obj, key, fake | multi).unwrap());
                            }
                        });
                    }
                });
            });
        }
        let mut empty = raw(Some(c"no-list"));
        empty.query_ranges = Some(no_list);
        let mut obj = Obj::new(&empty);
        let o = obj.as_obj();
        // SAFETY: `o` starts with a pointer to `empty`, whose callback reads
        // nothing and stores no list.
        let ret = unsafe {
            with_class(o, |c| {
                c.unwrap()
                    .query_ranges()
                    .unwrap()
                    .call(o, c"x", 0)
                    .map(drop)
            })
        };
        assert_eq!(ret, Err(-i32::from_le_bytes(*b"BUG!")));
    }
    unsafe extern "C" fn next_child(obj: *mut c_void, prev: *mut c_void) -> *mut c_void {
        // SAFETY: `obj` is an `Obj` with two children.
        let children = unsafe { (*obj.cast::<Obj>()).children };
        match children.iter().position(|&c| c == prev) {
            _ if prev.is_null() => children[0],
            Some(i) if i + 1 < children.len() => children[i + 1],
            _ => ptr::null_mut(),
        }
    }
    #[test]
    fn child_next_walks_the_children_to_the_end() {
        let _s = LogState::lock();
        let child_class = raw(Some(c"child"));
        let mut parent_class = raw(Some(c"parent"));
        parent_class.child_next = Some(next_child);
        let mut kids = [Obj::new(&child_class), Obj::new(&child_class)];
        let mut parent = Obj::new(&parent_class);
        parent.children = [kids[0].as_obj(), kids[1].as_obj()];
        let p = parent.as_obj();
        // SAFETY: `p` starts with a pointer to `parent_class`, whose
        // `child_next` accepts `p` and NULL or a child it returned.
        let walked = unsafe {
            with_class(p, |c| {
                let next = c.unwrap().child_next().unwrap();
                let mut walked = Vec::new();
                let mut prev = ptr::null_mut();
                while let Some(child) = next.call(p, prev) {
                    walked.push(child.as_ptr());
                    prev = child.as_ptr();
                }
                walked
            })
        };
        assert_eq!(walked, [kids[0].as_obj(), kids[1].as_obj()]);
    }
}
/// `default_category` (core wave 1, batch 2), each call within its `# Safety`
/// contract: static and heap classes, the smallest and an embedded class
/// pointer slot, every category value, a class switched between calls, and
/// concurrent readers.
mod default_category {
    use core::ffi::c_void;
    use ffmpeg::libavutil::ffi;
    use ffmpeg::libavutil::log::{ClassCategory, default_category};
    /// A class, `Sync` to live in a `static`.
    struct Class(ffi::AVClass);
    // SAFETY: the class is immutable and its name is a string literal.
    unsafe impl Sync for Class {}
    static DEMUXER: Class = Class(ffi::AVClass {
        class_name: c"ub-unsafe-demuxer".as_ptr(),
        category: ffi::AVClassCategory::AV_CLASS_CATEGORY_DEMUXER,
        // SAFETY: every other member is an integer, a nullable pointer or an
        // `Option` of a function pointer, for which all-zero is valid (NULL).
        ..unsafe { core::mem::zeroed() }
    });
    /// An `AVClass`-enabled object with a payload after its class pointer.
    #[repr(C)]
    struct Obj {
        class: *const ffi::AVClass,
        payload: [u8; 64],
    }
    impl Obj {
        fn new(class: *const ffi::AVClass) -> Self {
            Self {
                class,
                payload: [0x3c; 64],
            }
        }
        fn ctx(&self) -> *const c_void {
            (self as *const Self).cast()
        }
    }
    #[test]
    fn static_class_reads_its_category() {
        let obj = Obj::new(&DEMUXER.0);
        // SAFETY: `obj` starts with a non-NULL pointer to the live static
        // class; nothing writes either.
        let got = unsafe { default_category(obj.ctx()) };
        assert_eq!(got, ClassCategory::DEMUXER);
    }
    #[test]
    fn bare_class_pointer_is_the_smallest_object() {
        let fake: *const ffi::AVClass = &DEMUXER.0;
        // SAFETY: `fake` is a readable, aligned slot holding a non-NULL
        // pointer to the live static class.
        let got = unsafe { default_category((&raw const fake).cast()) };
        assert_eq!(got, ClassCategory::DEMUXER);
    }
    #[test]
    fn class_pointer_slot_inside_a_larger_object() {
        /// An object whose class pointer is an aligned member, not its
        /// allocation's first byte: the context points at the member.
        #[repr(C)]
        struct Outer {
            prefix: [u8; 40],
            class: *const ffi::AVClass,
            payload: u64,
        }
        let outer = Box::new(Outer {
            prefix: [0x5a; 40],
            class: &DEMUXER.0,
            payload: 9,
        });
        // SAFETY: the context is the aligned `class` member of the live
        // `outer`, holding a non-NULL pointer to the static class.
        let got = unsafe { default_category((&raw const outer.class).cast()) };
        assert_eq!(got, ClassCategory::DEMUXER);
        assert_eq!((outer.prefix[39], outer.payload), (0x5a, 9));
    }
    #[test]
    fn every_category_value_of_a_heap_class() {
        let values = (0..=u32::from(u8::MAX)).chain([1 << 16, u32::MAX - 1, u32::MAX]);
        for v in values {
            let cls = Box::new(ffi::AVClass {
                category: ffi::AVClassCategory(v),
                ..Default::default()
            });
            let obj = Box::new(Obj::new(&*cls));
            // SAFETY: `obj` starts with a non-NULL pointer to the live `cls`;
            // both are dropped only after the call.
            let got = unsafe { default_category(obj.ctx()) };
            assert_eq!(got.value(), v);
            drop(obj);
            drop(cls);
        }
    }
    #[test]
    fn object_class_switches_between_calls() {
        let other = ffi::AVClass {
            category: ffi::AVClassCategory::AV_CLASS_CATEGORY_ENCODER,
            ..Default::default()
        };
        let mut obj = Obj::new(&DEMUXER.0);
        for (i, cls) in [&DEMUXER.0, &other, &DEMUXER.0].into_iter().enumerate() {
            obj.class = cls;
            // SAFETY: `obj` starts with a non-NULL pointer to a live class; no
            // other thread writes `obj`.
            let got = unsafe { default_category(obj.ctx()) };
            assert_eq!(got, ClassCategory::from(cls.category), "step {i}");
        }
        assert_eq!(obj.payload, [0x3c; 64]);
    }
    #[test]
    fn concurrent_readers_share_an_object() {
        /// An object, `Sync` to share across threads.
        struct Shared(Obj);
        // SAFETY: the threads below only read the object and its static class.
        unsafe impl Sync for Shared {}
        let shared = Shared(Obj::new(&DEMUXER.0));
        std::thread::scope(|s| {
            for _ in 0..4 {
                let shared = &shared;
                s.spawn(move || {
                    for _ in 0..1_000 {
                        // SAFETY: the object starts with a non-NULL pointer to
                        // the static class; every thread only reads it.
                        let got = unsafe { default_category(shared.0.ctx()) };
                        assert_eq!(got, ClassCategory::DEMUXER);
                    }
                });
            }
        });
    }
