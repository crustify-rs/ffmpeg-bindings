+        for limit in [0, 1, 1023] {
+            set_max_alloc(limit);
+            assert!(BPrint::new(0, BPrint::SIZE_AUTOMATIC).is_none());
+            assert!(BPrint::for_buffer(&mut []).is_none());
+            let mut out = [0xa5; 8];
+            assert!(BPrint::for_buffer(&mut out).is_none());
+            assert_eq!(out, [0xa5; 8]);
+        }
+
