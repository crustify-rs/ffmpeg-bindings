+    #[test]
+    fn a_temporary_class_borrows_its_callers_name() {
+        let name = CString::new("temporary tag").unwrap();
+        let raw = ffi::AVClass {
+            class_name: name.as_ptr(),
+            item_name: Some(ffi::av_default_item_name),
+            ..Default::default()
+        };
+        // SAFETY: the initialized local descriptor and its caller-owned
+        // NUL-terminated name outlive all handles below and are not written.
+        let class = unsafe { ClassRef::from_ptr((&raw const raw).cast_mut()) }.unwrap();
+        let mut obj = &raw const raw;
+        assert_eq!(class.name(), Some(name.as_c_str()));
+        // SAFETY: `obj` is an aligned class-pointer slot; its descriptor and
+        // the borrowed tag remain valid and immutable through the result's use.
+        let item = unsafe { class.item_name().unwrap().call((&raw mut obj).cast()) };
+        assert_eq!(item, class.name());
+        assert_eq!(item.unwrap().as_ptr(), name.as_ptr());
+    }
+
     unsafe extern "C" fn unit_item_name(_: *mut c_void) -> *const c_char {
         c"item".as_ptr()
     }
diff --git a/crustify/rust/ffmpeg/tests/equiv/bprint.rs b/crustify/rust/ffmpeg/tests/equiv/bprint.rs
index 0ba4b3ac144bcfe7374266661a1797d111a7303f..425a5250fe1a7008bfadd075903be57ff724b68d
--- a/crustify/rust/ffmpeg/tests/equiv/bprint.rs
+++ b/crustify/rust/ffmpeg/tests/equiv/bprint.rs
@@ -582,4 +582,39 @@
         assert_eq!(BPrint::into_string(r).map(drop), Err(enomem));
         ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
     }
+
+    /// After a failed growth, later appends remain truncated even when the
+    /// allocation limit is restored. Truncating below capacity permits a
+    /// fresh growth; compare all fields and stored bytes after each step.
+    #[test]
+    fn failed_growth_stays_truncated_until_explicitly_shortened() {
+        if !isolated("bprint::owners::failed_growth_stays_truncated_until_explicitly_shortened") {
+            return;
+        }
+        let c = CBuf::init(0, BPrint::SIZE_UNLIMITED);
+        let mut r = BPrint::new(0, BPrint::SIZE_UNLIMITED).unwrap();
+        ffmpeg::libavutil::mem::set_max_alloc(1024);
+        for n in [2000, 16] {
+            fill(&c, &mut r, n);
+            assert_eq!(rust_state(r.as_ref()), c.state());
+            assert!(r.as_ref().len() >= r.as_ref().size());
+        }
+        ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
+        fill(&c, &mut r, 32);
+        assert_eq!(rust_state(r.as_ref()), c.state());
+        assert!(r.as_ref().is_inline());
+        c_op(c.buf, Op::Truncate(3));
+        r.as_mut().truncate(3);
+        assert_eq!(rust_state(r.as_ref()), c.state());
+        // First move inline bytes to the heap, then grow that allocation
+        // twice: both the memcpy and realloc branches preserve the prefix.
+        for n in [2000, 5000, 20_000] {
+            fill(&c, &mut r, n);
+            assert_eq!(rust_state(r.as_ref()), c.state());
+            assert!(!r.as_ref().is_inline());
+        }
+        let (ret, bytes) = c.finalize();
+        assert_eq!(ret, 0);
+        assert_eq!(BPrint::into_bytes(r).unwrap().as_slice(), bytes.unwrap());
+    }
 }
