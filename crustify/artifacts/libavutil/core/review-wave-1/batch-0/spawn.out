//! UB tests against the safe public API.
#![forbid(unsafe_code)]
mod avstring;
mod avutil;
mod bprint;
mod bswap;
mod common;
mod cpu;
mod error;
mod file;
mod intfloat;
mod intreadwrite;
mod log;
mod mathematics;
mod mem;
mod random_seed;
mod rational;
mod time;
mod timestamp;
/// Programs under `compile_fail/` must be rejected by the compiler.
#[test]
fn compile_fail() {
    let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/ub_safe/compile_fail");
    let any = std::fs::read_dir(&dir)
        .map(|d| d.flatten().any(|e| e.path().extension().is_some_and(|x| x == "rs")))
        .unwrap_or(false);
    if any {
        trybuild::TestCases::new().compile_fail(dir.join("*.rs"));
    }
}
// Embed each linked FFmpeg library's directory as an rpath so the crate's tests and
// examples run against the prebuilt variant the `-sys` crates linked. DT_RPATH, not
// DT_RUNPATH: it also resolves the FFmpeg libraries' own NEEDED entries.
fn main() {
    println!("cargo:rustc-link-arg=-Wl,--disable-new-dtags");
    for lib in ["AVUTIL", "SWRESAMPLE", "SWSCALE", "AVCODEC", "AVFORMAT", "AVFILTER", "AVDEVICE"] {
        if let Ok(dir) = std::env::var(format!("DEP_{lib}_LIB_DIR")) {
            println!("cargo:rustc-link-arg=-Wl,-rpath,{dir}");
        }
    }
}
