/// UB tests of the print buffer owners, `BPrintBox` and `BPrintOnBuffer`,
/// through the safe API: every `size_init`/`size_max` shape, caller buffers
/// of every length class, each finalizer, truncation, and owners and handles
/// moved and shared across threads.
mod owners {
    use std::thread;
    use ffmpeg::libavutil::bprint::{BPrint, BPrintBox, BPrintOnBuffer, BPrintRef};
    fn under_bsan() -> bool {
        std::env::var("CRUSTIFY_FFMPEG_VARIANT").as_deref() == Ok("bsan")
    }
    /// `size_max` values at every boundary `av_bprint_init` distinguishes.
    const SIZE_MAX: [u32; 9] = [
        BPrint::SIZE_COUNT_ONLY,
        BPrint::SIZE_AUTOMATIC,
        2,
        BPrint::INLINE_CAPACITY - 1,
        BPrint::INLINE_CAPACITY,
        BPrint::INLINE_CAPACITY + 1,
        5000,
        u32::MAX - 1,
        BPrint::SIZE_UNLIMITED,
    ];
    /// `size_init` values around the inline storage, and one no allocator
    /// can satisfy (4 GiB, beyond `av_max_alloc`'s default `INT_MAX`).
    const SIZE_INIT: [u32; 7] = [0, 1, 2, 1004, 1005, 4096, u32::MAX];
    /// Every getter, whose results must be consistent with an empty buffer.
    fn check_empty(r: BPrintRef<'_>) {
        assert_eq!(r.len(), 0);
        assert!(r.is_empty());
        assert_eq!(r.as_bytes(), b"");
        assert_eq!(r.as_c_str(), c"");
        assert!(r.size() <= r.size_max());
        let _ = r.is_inline();
    }
    #[test]
    fn every_init_shape_reads_empty_and_drops() {
        for size_max in SIZE_MAX {
            for size_init in SIZE_INIT {
                let mut buf = BPrint::new(size_init, size_max).unwrap();
                check_empty(buf.as_ref());
                // Inline unless `size_init` asked for more than the inline
                // size, the limit allowed growing, and `av_realloc` could
                // (it refuses more than `INT_MAX` bytes).
                let max = if size_max == BPrint::SIZE_AUTOMATIC {
                    BPrint::INLINE_CAPACITY
                } else {
                    size_max
                };
                let inline = max.min(BPrint::INLINE_CAPACITY);
                let grows =
                    size_init > inline && inline != max && size_init.min(max) <= i32::MAX as u32;
                assert_eq!(buf.as_ref().is_inline(), !grows, "{size_init} {size_max}");
                buf.as_mut().truncate(0);
                buf.as_mut().as_mut().truncate(u32::MAX);
                check_empty(buf.as_mut().as_ref());
            }
        }
    }
    #[test]
    fn each_finalizer_hands_out_the_empty_string() {
        for size_max in SIZE_MAX {
            for size_init in [0, 4096] {
                let s = BPrint::into_string(BPrint::new(size_init, size_max).unwrap()).unwrap();
                assert_eq!(s.as_c_str(), c"");
                let b = BPrint::into_bytes(BPrint::new(size_init, size_max).unwrap()).unwrap();
                assert_eq!(b.as_slice(), b"");
            }
        }
    }
    #[test]
    fn caller_buffers_of_every_length_hold_an_empty_string() {
        for len in [0, 1, 2, 3, 1024, 70_000] {
            let mut out = vec![0xa5_u8; len];
            let mut buf = BPrint::for_buffer(&mut out).unwrap();
            check_empty(buf.as_ref());
            assert_eq!(buf.as_ref().size() as usize, len);
            assert_eq!(buf.as_ref().is_inline(), len == 0);
            buf.as_mut().truncate(0);
            drop(buf);
            if len > 0 {
                assert_eq!(out[0], 0);
                // One slice comparison: BSan retags per element visited.
                assert_eq!(out[1..], vec![0xa5; len - 1][..]);
            }
        }
    }
    /// A buffer past `u32::MAX` bytes is used up to that many. Zeroed pages
    /// cost nothing until touched; skipped under BSan, whose shadow does not
    /// scale to them.
    #[test]
    fn a_caller_buffer_beyond_u32_is_clamped() {
        if under_bsan() {
            return;
        }
        let mut out = vec![0_u8; u32::MAX as usize + 2];
        let buf = BPrint::for_buffer(&mut out).unwrap();
        assert_eq!(buf.as_ref().size(), u32::MAX);
        assert_eq!(buf.as_ref().size_max(), u32::MAX);
        assert_eq!(buf.as_ref().as_bytes(), b"");
    }
    #[test]
    fn owners_and_handles_cross_threads() {
        let mut boxes: Vec<BPrintBox> = (0..4)
            .map(|i| BPrint::new(i * 2000, BPrint::SIZE_UNLIMITED).unwrap())
            .collect();
        // Shared handles read concurrently.
        thread::scope(|s| {
            for b in &boxes {
                let r = b.as_ref();
                s.spawn(move || {
                    for _ in 0..100 {
                        check_empty(r);
                    }
                });
            }
        });
        // Exclusive handles write on other threads.
        thread::scope(|s| {
            for b in &mut boxes {
                let mut m = b.as_mut();
                s.spawn(move || m.truncate(0));
            }
        });
        // Owners finalize and drop where they land.
        let joins: Vec<_> = boxes
            .into_iter()
            .enumerate()
            .map(|(i, b)| {
                thread::spawn(move || {
                    if i % 2 == 0 {
                        BPrint::into_string(b).unwrap().len()
                    } else {
                        drop(b);
                        0
                    }
                })
            })
            .collect();
        for j in joins {
            assert_eq!(j.join().unwrap(), 0);
    #[test]
    fn new_and_its_finalizers_match_av_bprint_init_and_finalize() {
        for (size_init, size_max) in INITS {
            let c = CBuf::init(size_init, size_max);
            let mut r = BPrint::new(size_init, size_max).unwrap();
            let ctx = format!("init({size_init}, {size_max})");
            assert_eq!(rust_state(r.as_ref()), c.state(), "{ctx}");
            for &op in OPS {
                let p = r.as_c_ptr();
                c_op(c.buf, op);
                rust_op(p, &mut r.as_mut(), op);
                assert_eq!(rust_state(r.as_ref()), c.state(), "{ctx} {op:?}");
            }
            let expect = c.state();
            // `into_bytes` against C's finalized string.
            let (ret, c_bytes) = c.finalize();
            assert_eq!(ret, 0);
            match BPrint::into_bytes(r) {
                Ok(bytes) => {
                    assert_eq!(
                        bytes.as_slice(),
                        c_bytes.as_deref().unwrap_or_default(),
                        "{ctx}"
                    );
                    assert_eq!(bytes.as_slice(), expect.bytes);
                }
                Err(e) => panic!("{ctx}: {e}"),
            }
            // `into_string` likewise, after the same sequence.
            let c = CBuf::init(size_init, size_max);
            let mut r = BPrint::new(size_init, size_max).unwrap();
            for &op in OPS {
                let p = r.as_c_ptr();
                c_op(c.buf, op);
                rust_op(p, &mut r.as_mut(), op);
            }
            let (ret, c_bytes) = c.finalize();
            let s = BPrint::into_string(r).unwrap();
            assert_eq!(ret, 0);
            match c_bytes {
                // C's string, read up to its NUL.
                Some(b) => assert_eq!(
                    s.as_bytes(),
                    CStr::from_bytes_until_nul(&[&b[..], b"\0"].concat())
                        .unwrap()
                        .to_bytes()
                ),
                // A count-only buffer: C's block holds no string, the
                // documented divergence; Rust hands back "".
                None => {
                    assert_eq!(expect.size, 0, "{ctx}");
                    assert_eq!(s.as_bytes(), b"");
                }
            }
        }
    }
    #[test]
    fn for_buffer_matches_av_bprint_init_for_buffer() {
        for len in [0, 1, 2, 5, 64, 2048] {
            let mut c_data = vec![0xa5_u8; len];
            let mut r_data = vec![0xa5_u8; len];
            let c = CBuf::for_buffer(&mut c_data);
            let mut r = BPrint::for_buffer(&mut r_data).unwrap();
            assert_eq!(rust_state(r.as_ref()), c.state(), "for_buffer({len})");
            for &op in OPS {
                let p = r.as_c_ptr();
                c_op(c.buf, op);
                rust_op(p, &mut r.as_mut(), op);
                assert_eq!(
                    rust_state(r.as_ref()),
                    c.state(),
                    "for_buffer({len}) {op:?}"
                );
            }
            drop(r);
            drop(c);
            assert_eq!(r_data, c_data, "for_buffer({len})");
        }
    }
    /// Whether this is the isolated child of test `name`; in the parent, runs
    /// the child, asserts it passed, and returns `false`.
    fn isolated(name: &str) -> bool {
        const ISOLATED: &str = "CRUSTIFY_EQUIV_ISOLATED";
        if std::env::var_os(ISOLATED).is_some() {
            return true;
        }
        let status = std::process::Command::new(std::env::current_exe().unwrap())
            .args(["--exact", name, "--test-threads=1", "--nocapture"])
            .env(ISOLATED, "1")
            .status()
            .unwrap();
        assert!(status.success(), "isolated run failed: {status}");
        false
    }
    /// Fills both buffers with `n` bytes of `c`.
    fn fill(c: &CBuf, r: &mut ffmpeg::libavutil::bprint::BPrintBox, n: u32) {
        c_op(c.buf, Op::Chars(b'f', n));
        c_op(r.as_c_ptr(), Op::Chars(b'f', n));
    }
    /// The finalizers' allocation failures, forced by the `av_max_alloc`
    /// limit in an isolated child: an inline string C cannot copy out fails
    /// alike with `AVERROR(ENOMEM)`, and a grown string C cannot shrink is
    /// handed out unshrunk, alike.
    #[test]
    fn finalizing_at_the_av_max_alloc_limit_matches_c() {
        if !isolated("bprint::owners::finalizing_at_the_av_max_alloc_limit_matches_c") {
            return;
        }
        let enomem = -(ffi::ENOMEM as i32);
        // A C and a Rust buffer, both unlimited, starting inline.
        let pair = || {
            (
                CBuf::init(0, BPrint::SIZE_UNLIMITED),
                BPrint::new(0, BPrint::SIZE_UNLIMITED).unwrap(),
            )
        };
        let (c, mut r) = pair();
        fill(&c, &mut r, 100);
        ffmpeg::libavutil::mem::set_max_alloc(50);
        assert_eq!(c.finalize(), (enomem, None));
        assert_eq!(BPrint::into_string(r).map(drop), Err(enomem));
        ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
        let (c, mut r) = pair();
        fill(&c, &mut r, 100);
        ffmpeg::libavutil::mem::set_max_alloc(50);
        assert_eq!(c.finalize(), (enomem, None));
        assert_eq!(BPrint::into_bytes(r).map(drop), Err(enomem));
        ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
        for into_string in [false, true] {
            let (c, mut r) = pair();
            fill(&c, &mut r, 3000);
            assert!(!r.as_ref().is_inline());
            ffmpeg::libavutil::mem::set_max_alloc(100);
            let (ret, c_bytes) = c.finalize();
            assert_eq!(ret, 0);
            let c_bytes = c_bytes.unwrap();
            assert_eq!(c_bytes.len(), 3000);
            if into_string {
                assert_eq!(BPrint::into_string(r).unwrap().as_bytes(), c_bytes);
            } else {
                assert_eq!(BPrint::into_bytes(r).unwrap().as_slice(), c_bytes);
            }
            ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
        }
        // Rust's count-only string, "" where C has no string, needs one
        // byte; at a zero limit it fails as C's own copies do.
        let r = BPrint::new(0, BPrint::SIZE_COUNT_ONLY).unwrap();
        ffmpeg::libavutil::mem::set_max_alloc(0);
        assert_eq!(BPrint::into_string(r).map(drop), Err(enomem));
        ffmpeg::libavutil::mem::set_max_alloc(i32::MAX as usize);
    }
}
#!/bin/bash
# Configure and build every build.json variant concurrently; one log per variant.
cd /target
for v in $(jq -r '.variants|keys[]' crustify/build.json); do
  (
    dir=$(jq -r ".variants[\"$v\"].dir" crustify/build.json)
    mkdir -p "$dir" && cd "$dir" &&
    eval "$(jq -r ".variants[\"$v\"].configure" /target/crustify/build.json)" > configure.log 2>&1 &&
    eval "$(jq -r ".variants[\"$v\"].build" /target/crustify/build.json)" > build.log 2>&1
    echo "$v exit $?"
  ) &
done
wait
