+        assert!(buf.as_ref().is_inline());
+        check_empty(buf.as_ref());
+        drop(buf);
+        let mut out = [0xa5; 8];
+        drop(BPrint::for_buffer(&mut out).unwrap());
+        assert_eq!(out, [0, 0xa5, 0xa5, 0xa5, 0xa5, 0xa5, 0xa5, 0xa5]);
+    }
