/bin/bash -lc "set -e
export CRUSTIFY_FFMPEG_VARIANT=asan-ubsan CARGO_TARGET_DIR=/tmp/crustify-review-b0/check
cargo check --workspace > /tmp/crustify-review-b0/check-final.log 2>&1
cargo clippy --workspace > /tmp/crustify-review-b0/clippy-final.log 2>&1
