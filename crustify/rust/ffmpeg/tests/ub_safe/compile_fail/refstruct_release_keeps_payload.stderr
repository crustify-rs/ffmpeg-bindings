error[E0521]: borrowed data escapes outside of closure
 --> tests/ub_safe/compile_fail/refstruct_release_keeps_payload.rs
  |
  |     let slot = Arc::clone(&kept);
  |         ---- `slot` declared here, outside of the closure body
  |     let _ = refstruct::alloc_with_release::<IntFloat64, _>(move |last| {
  |                                                                  ---- `last` is a reference that is only valid in the closure body
  |         *slot.lock().unwrap() = Some(last);
